{%- comment -%}
  Brand eyes exported from the approved landing-page reference.
  Params:
    tone – "dark" | "light" (default: "dark")
{%- endcomment -%}

{%- liquid
  assign eye_tone = tone | default: 'dark'
  assign left_asset = 'gallery-eye-left.svg'
  assign right_asset = 'gallery-eye-right.svg'
  if eye_tone == 'light'
    assign left_asset = 'gallery-eye-left-light.svg'
    assign right_asset = 'gallery-eye-right-light.svg'
  endif
-%}

<span class="brand-eyes brand-eyes--{{ eye_tone }}" aria-hidden="true">
  <img src="{{ left_asset | asset_url }}" alt="" width="39" height="32">
  <img src="{{ right_asset | asset_url }}" alt="" width="39" height="32">
</span>
