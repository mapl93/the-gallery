{%- comment -%}
  Snippet: breadcrumb
  Usage: {% render 'breadcrumb', product: product, collection: collection %}
{%- endcomment -%}

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    <li><a href="{{ routes.root_url }}">Home</a></li>
    {%- if collection -%}
      <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
    {%- endif -%}
    {%- if product -%}
      <li><span aria-current="page">{{ product.title }}</span></li>
    {%- endif -%}
  </ol>
</nav>
