{% doc %}
Renders one canonical Product Card from a Shopify product resource.

@param {product} product - Product resource rendered by the owning section.
@param {string} [media_ratio] - Bounded canonical media ratio: square or portrait. Defaults to square.
@param {boolean} [show_vendor] - Whether to render the optional artist/vendor name. Defaults to true.

@example
{% render 'product-card', product: product %}
{% enddoc %}

{%- assign product_image_alt = product.featured_image.alt | default: product.title -%}
{%- assign product_card_media_ratio = media_ratio | default: 'square' -%}
{%- assign product_card_show_vendor = true -%}
{%- if show_vendor == false -%}
  {%- assign product_card_show_vendor = false -%}
{%- endif -%}
{%- unless product_card_media_ratio == 'portrait' -%}
  {%- assign product_card_media_ratio = 'square' -%}
{%- endunless -%}

<article class="product-card card" data-media-ratio="{{ product_card_media_ratio }}">
  <div class="product-card__media">
    {% if product.available == false %}
      <div class="product-card__badges">
        <span class="badge badge--error">{{ 'products.sold_out' | t }}</span>
      </div>
    {% elsif product.compare_at_price > product.price %}
      <div class="product-card__badges">
        <span class="badge badge--warning">{{ 'products.on_sale' | t }}</span>
      </div>
    {% endif %}

    {%- if product.featured_image != blank -%}
      {{ product.featured_image | image_url: width: 600 | image_tag:
         class: 'product-card__image product-card__image--primary',
         alt: product_image_alt, loading: 'lazy', widths: '300,450,600' }}

      {%- if product.images[1] != blank -%}
        {{ product.images[1] | image_url: width: 600 | image_tag:
           class: 'product-card__image product-card__image--hover',
           alt: '', loading: 'lazy', widths: '300,450,600' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__image--primary' }}
    {%- endif -%}

    <div class="product-card__quick-look">
      <button class="btn btn--sm" type="button"
              aria-label="{{ 'products.quick_look_named' | t: title: product.title | escape }}"
              data-quick-look="{{ product.handle | escape }}">
        {{ 'products.quick_look' | t }}
      </button>
    </div>
  </div>

  <div class="product-card__body">
    {% if product_card_show_vendor and product.vendor != blank %}
      <span class="product-card__vendor">{{ product.vendor | escape }}</span>
    {% endif %}
    <h3 class="product-card__title">
      <a href="{{ product.url | within: collection }}">{{ product.title | escape }}</a>
    </h3>
    {% if product.description != blank %}
      <span class="product-card__description">{{ product.description | strip_html | escape }}</span>
    {% endif %}
  </div>

  <div class="product-card__price">
    {% render 'price', product: product %}
  </div>

</article>
