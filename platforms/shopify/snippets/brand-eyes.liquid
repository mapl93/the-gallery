{% doc %}
  Renders the brand eyes from inline SVG assets.

  @param {string} [tone] - "dark" or "light".
  @param {boolean} [track_pointer] - Enables bounded pointer tracking for the pupils.
  @param {boolean} [blink] - Enables ambient single blinking and double blinking on hover.

  @example
  {% render 'brand-eyes', tone: 'light', track_pointer: true %}
{% enddoc %}

{%- liquid
  assign eye_tone = tone | default: 'dark'
  assign left_asset = 'gallery-eye-left.svg'
  assign right_asset = 'gallery-eye-right.svg'
  if eye_tone == 'light'
    assign left_asset = 'gallery-eye-left-light.svg'
    assign right_asset = 'gallery-eye-right-light.svg'
  endif
-%}

<span
  class="brand-eyes brand-eyes--{{ eye_tone }}"
  aria-hidden="true"
  {% if track_pointer %}data-brand-eyes-track{% endif %}
  {% if blink %}data-brand-eyes-blink{% endif %}
>
  {{ left_asset | inline_asset_content }}
  {{ right_asset | inline_asset_content }}
</span>
