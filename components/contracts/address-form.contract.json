{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.1.0",
  "slug": "address-form",
  "name": "Address Form",
  "registryId": "U7",
  "category": "account",
  "status": "pilot",
  "summary": "Responsive address form wrapper with two-column row support.",
  "dependencies": ["input", "select", "button"],
  "source": {
    "registry": "registry.json#/components/address-form",
    "css": { "file": "components/css/account.css", "selector": ".address-form" },
    "docs": "site/src/content/components/address-form.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".address-form", "className": ".address-form", "required": true, "description": "Address form container." },
    { "name": "fields", "selector": ".address-form__fields", "className": ".address-form__fields", "required": true, "description": "Address field composition region." },
    { "name": "row", "selector": ".address-form__row", "className": ".address-form__row", "required": false, "description": "Two-column address field row." },
    { "name": "actions", "selector": ".address-form__actions", "className": ".address-form__actions", "required": false, "description": "Address form actions." }
  ],
  "variants": [
    { "name": "default", "className": null, "default": true, "description": "Default address form." }
  ],
  "sizes": [
    { "name": "default", "className": null, "default": true, "description": "Default narrow form with responsive rows." }
  ],
  "states": [
    { "name": "default", "selectors": [".address-form"], "description": "Default address form state." },
    { "name": "responsiveRow", "selectors": [".address-form__row"], "description": "Responsive field row that stacks on small viewports." }
  ],
  "behavior": [
    { "name": "formComposition", "selectors": [".address-form__fields", ".address-form__actions"], "description": "Address Form should compose Input, Select, and Button primitives." },
    { "name": "addressSubmit", "selectors": [".address-form"], "events": ["submit"], "description": "Form should create or update an address through the target account API." }
  ],
  "properties": [
    { "name": "fields", "type": "slot", "required": true, "description": "Target-owned address inputs and selects with native autocomplete and validation semantics.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".address-form__fields", "classNames": [".address-form__fields"] }] } },
    { "name": "actions", "type": "slot", "required": false, "description": "Submit and optional cancellation actions.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".address-form__actions", "classNames": [".address-form__actions"] }] } }
  ],
  "tokens": {
    "public": {}
  },
  "accessibility": [
    "Associate every address field with a label.",
    "Composed Input and Select fields preserve their default, error, success, and warning validation semantics.",
    "Use autocomplete attributes where the target supports them.",
    "Expose field validation errors near the affected input.",
    "Protect address editing behind authentication."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/account.css." },
    "shopify": { "status": "planned", "kind": "liquid-css", "notes": "Should map Shopify customer address create/update form fields." },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
