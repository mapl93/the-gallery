{%- comment -%}
  Section: Main Product
  The primary product section for the product template.
  Uses snippets: product-gallery, product-info, product-form,
  variant-selector, price, rating, breadcrumb, certificate-of-authenticity
{%- endcomment -%}

<section class="section">
  <div class="container">
    <div class="product-layout">
      {%- comment -%} Gallery (Left) {%- endcomment -%}
      <div class="product-layout__gallery">
        {% render 'product-gallery', product: product %}
      </div>

      {%- comment -%} Info (Right) {%- endcomment -%}
      <div class="product-layout__info">
        {% render 'product-info', product: product, collection: collection %}

        {%- comment -%} Certificate of Authenticity {%- endcomment -%}
        {% render 'certificate-of-authenticity', product: product %}
      </div>
    </div>
  </div>
</section>

<style>
  .product-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-layout-grid-gap);
  }

  @media (min-width: 768px) {
    .product-layout {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-layout-section-gap);
    }
  }

  .product-layout__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-layout-section-gap);
  }

  @media (min-width: 768px) {
    .product-layout__info {
      position: sticky;
      top: 100px;
      align-self: start;
    }
  }
</style>

{% schema %}
{
  "name": "Product Page",
  "settings": []
}
{% endschema %}
