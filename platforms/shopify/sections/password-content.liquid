{%- comment -%}
  Shopify password page. This is a target-native composition and is not part of
  the neutral Coming Soon contract.
{%- endcomment -%}

{%- liquid
  assign heading_id = 'password-heading-' | append: section.id
  assign newsletter_heading_id = 'password-newsletter-heading-' | append: section.id
  assign newsletter_description_id = 'password-newsletter-description-' | append: section.id
  assign newsletter_email_id = 'password-newsletter-email-' | append: section.id
  assign newsletter_error_id = 'password-newsletter-error-' | append: section.id
  assign modal_id = 'password-dialog-' | append: section.id
  assign modal_title_id = 'password-dialog-title-' | append: section.id
  assign password_input_id = 'password-input-' | append: section.id
  assign password_error_id = 'password-error-' | append: section.id
-%}

<main class="coming-soon" aria-labelledby="{{ heading_id }}">
  {%- if section.settings.background_image != blank -%}
    <img
      class="coming-soon__bg"
      src="{{ section.settings.background_image | image_url: width: 1920 }}"
      alt=""
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
    >
  {%- endif -%}

  <div class="coming-soon__inner">
    <div class="coming-soon__left">
      <div class="password-page__brand">
        {%- render 'logo', variant: section.settings.logo_variant, width: 280, class: 'coming-soon__logo', loading: 'eager' -%}
      </div>

      <h1 class="coming-soon__heading" id="{{ heading_id }}">
        {{- 'password.heading' | t -}}
      </h1>

      {%- assign subtitle_key = 'password.subtitle' | t -%}
      {%- if subtitle_key != 'password.subtitle' -%}
        <p class="coming-soon__subtitle">{{ subtitle_key }}</p>
      {%- endif -%}

      <div class="coming-soon__body">
        <p>{{ 'password.subtext' | t }}</p>
      </div>

      {%- if section.settings.instagram_url != blank or section.settings.email != blank -%}
        <nav class="coming-soon__social" aria-label="{{ 'coming_soon.social_label' | t }}">
          {%- if section.settings.instagram_url != blank -%}
            <a class="link" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">
              Instagram
            </a>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <a class="link" href="mailto:{{ section.settings.email }}">
              {{- section.settings.email -}}
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    </div>

    <div class="coming-soon__right">
      <h2 class="coming-soon__form-header" id="{{ newsletter_heading_id }}">
        {{- 'password.newsletter_heading' | t -}}
      </h2>
      <p class="coming-soon__form-subtext" id="{{ newsletter_description_id }}">
        {{- 'password.newsletter_subtext' | t -}}
      </p>

      {% form 'customer', id: 'password-newsletter', class: 'coming-soon__form' %}
        <input type="hidden" name="contact[tags]" value="password-page,newsletter">
        {%- if form.posted_successfully? -%}
          <p class="input__message" role="status">
            {{- 'password.newsletter_success' | t -}}
          </p>
        {%- else -%}
          <div class="input{% if form.errors %} input--error{% endif %}">
            <label class="input__label" for="{{ newsletter_email_id }}">
              {{- 'coming_soon.newsletter_label' | t -}}
            </label>
            <div class="input__control">
              <input
                class="input__field"
                id="{{ newsletter_email_id }}"
                type="email"
                name="contact[email]"
                placeholder="{{ 'password.newsletter_placeholder' | t }}"
                required
                autocomplete="email"
                aria-describedby="{{ newsletter_description_id }}{% if form.errors %} {{ newsletter_error_id }}{% endif %}"
                {%- if form.errors %} aria-invalid="true"{% endif %}
              >
            </div>
            {%- if form.errors -%}
              <p class="input__message" id="{{ newsletter_error_id }}" role="alert">
                {{- form.errors.messages['email'] -}}
              </p>
            {%- endif -%}
          </div>
          <button type="submit" class="btn">
            {{- 'password.newsletter_submit' | t -}}
          </button>
        {%- endif -%}
      {% endform %}

      <button
        type="button"
        class="btn btn--link"
        data-password-toggle
        aria-haspopup="dialog"
        aria-controls="{{ modal_id }}"
        aria-expanded="false"
      >
        {{- 'password.password_label' | t -}}
      </button>
    </div>
  </div>

  <footer class="coming-soon__footer">
    &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
  </footer>

  <div
    class="modal-overlay"
    id="{{ modal_id }}"
    data-password-modal
    aria-hidden="true"
    hidden
  >
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="{{ modal_title_id }}">
      <header class="modal__header">
        <h2 class="modal__title" id="{{ modal_title_id }}">
          {{- 'password.modal_title' | t -}}
        </h2>
        <button
          type="button"
          class="close-btn modal__close"
          data-password-close
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <svg class="close-btn__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 6 6 18"/>
            <path d="m6 6 12 12"/>
          </svg>
        </button>
      </header>
      <div class="modal__body">
        {% form 'storefront_password', class: 'form password-page__form' %}
          <div class="input{% if form.errors %} input--error{% endif %}">
            <label class="input__label" for="{{ password_input_id }}">
              {{- 'password.placeholder' | t -}}
            </label>
            <div class="input__control">
              <input
                class="input__field"
                id="{{ password_input_id }}"
                type="password"
                name="password"
                placeholder="{{ 'password.placeholder' | t }}"
                required
                autocomplete="current-password"
                {%- if form.errors %} aria-invalid="true" aria-describedby="{{ password_error_id }}"{% endif %}
              >
            </div>
            {%- if form.errors -%}
              <p class="input__message" id="{{ password_error_id }}" role="alert" data-password-error>
                {{- 'password.error' | t -}}
              </p>
            {%- endif -%}
          </div>
          <button type="submit" class="btn">
            {{- 'password.submit' | t -}}
          </button>
        {% endform %}
      </div>
    </div>
  </div>
</main>

<script>
  (function() {
    var modal = document.querySelector('[data-password-modal]');
    var trigger = document.querySelector('[data-password-toggle]');
    if (!modal || !trigger) return;

    var pageRegions = Array.prototype.slice.call(
      document.querySelectorAll('.coming-soon__inner, .coming-soon__footer')
    );
    var restoreTarget = trigger;
    var closeTimer;

    function focusableElements() {
      return Array.prototype.slice.call(modal.querySelectorAll(
        'button:not([disabled]), input:not([disabled]), a[href], select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )).filter(function(element) {
        return !element.hidden && element.getAttribute('aria-hidden') !== 'true';
      });
    }

    function setPageInert(value) {
      pageRegions.forEach(function(region) {
        region.inert = value;
      });
    }

    function openModal(invoker) {
      window.clearTimeout(closeTimer);
      restoreTarget = invoker || trigger;
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');
      setPageInert(true);
      window.requestAnimationFrame(function() {
        var field = modal.querySelector('input[type="password"]');
        if (field) field.focus();
      });
    }

    function closeModal() {
      modal.setAttribute('aria-hidden', 'true');
      trigger.setAttribute('aria-expanded', 'false');
      setPageInert(false);
      var delay = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 200;
      closeTimer = window.setTimeout(function() {
        modal.hidden = true;
      }, delay);
      if (restoreTarget && document.contains(restoreTarget)) restoreTarget.focus();
    }

    trigger.addEventListener('click', function() {
      openModal(trigger);
    });

    modal.querySelectorAll('[data-password-close]').forEach(function(button) {
      button.addEventListener('click', closeModal);
    });

    modal.addEventListener('click', function(event) {
      if (event.target === modal) closeModal();
    });

    modal.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeModal();
        return;
      }
      if (event.key !== 'Tab') return;

      var focusable = focusableElements();
      if (!focusable.length) {
        event.preventDefault();
        return;
      }
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    if (modal.querySelector('[data-password-error]')) openModal(trigger);
  })();
</script>

{% schema %}
{
  "name": "Password Page",
  "tag": "section",
  "class": "section-password",
  "settings": [
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "select",
      "id": "logo_variant",
      "label": "Logo variant",
      "info": "Logos are configured in Theme settings → Logo.",
      "options": [
        { "value": "short", "label": "Short" },
        { "value": "long", "label": "Long" },
        { "value": "wordmark", "label": "Wordmark" },
        { "value": "easter_egg", "label": "Easter egg" }
      ],
      "default": "short"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Decorative full-screen background. A contrast overlay is applied automatically."
    },
    {
      "type": "header",
      "content": "Social & Contact"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact email",
      "info": "Shown as a visible email link."
    }
  ]
}
{% endschema %}
