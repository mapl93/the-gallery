      {"id": "icon", "label": "Icon", "kind": "toggle", "properties": ["icon"]}
    ] },
    { "id": "behavior", "label": "Behavior", "controls": [
      {"id": "announcement", "label": "Announcement", "kind": "segmented", "properties": ["announcement"]}
    ] },
    { "id": "appearance", "label": "Appearance", "controls": [
      {"id": "error", "label": "Error", "kind": "token-swatch", "tokens": {"category": "color", "names": ["--color-feedback-error-default"]}},
      {"id": "radius", "label": "Radius", "kind": "token", "tokens": {"category": "radius", "names": ["--radius-sm"]}}
    ] },
    { "id": "geometry", "label": "Spacing and geometry", "controls": [
      {"id": "gap", "label": "Icon gap", "kind": "token", "tokens": {"category": "spacing", "names": ["--space-inline-error-gap"]}},
      {"id": "padding-x", "label": "Horizontal padding", "kind": "token", "tokens": {"category": "spacing", "names": ["--space-inline-error-padding-x"]}},
      {"id": "padding-y", "label": "Vertical padding", "kind": "token", "tokens": {"category": "spacing", "names": ["--space-inline-error-padding-y"]}},
      {"id": "icon-size", "label": "Icon size", "kind": "token", "tokens": {"category": "spacing", "names": ["--space-inline-error-icon-size"]}, "visibleWhen": {"property": "icon", "equals": true}},
      {"id": "icon-offset", "label": "Icon offset", "kind": "token", "tokens": {"category": "spacing", "names": ["--space-inline-error-icon-offset"]}, "visibleWhen": {"property": "icon", "equals": true}},
      {"id": "text-size", "label": "Text size", "kind": "token", "tokens": {"category": "spacing", "names": ["--space-input-label-size"]}}
    ] },
    { "id": "text-effects", "label": "Typography and effects", "controls": [
      {"id": "background-opacity", "label": "Background opacity", "kind": "token", "tokens": {"category": "opacity", "names": ["--opacity-inline-error-background"]}},
      {"id": "font-family", "label": "Font family", "kind": "token", "tokens": {"category": "typography", "names": ["--font-family-body"]}},
      {"id": "line-height", "label": "Line height", "kind": "token", "tokens": {"category": "typography", "names": ["--typo-body-sm-line-height"]}},
      {"id": "text-weight", "label": "Text weight", "kind": "token", "tokens": {"category": "typography", "names": ["--typo-body-weight"]}}
    ] },
    { "id": "state-colors", "label": "State color inputs", "controls": [
      {"id": "text-primary", "label": "Text primary", "kind": "token-swatch", "tokens": {"category": "color", "names": ["--color-text-primary"]}}
    ] }
  ]
}
