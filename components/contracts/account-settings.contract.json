{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.1.0",
  "slug": "account-settings",
  "name": "Account Settings",
  "registryId": "U9",
  "category": "account",
  "status": "pilot",
  "summary": "Account preferences surface with sections, titles, descriptions, and form-control composition.",
  "dependencies": ["input", "button", "switch"],
  "source": {
    "registry": "registry.json#/components/account-settings",
    "css": { "file": "components/css/account.css", "selector": ".account-settings" },
    "docs": "site/src/content/components/account-settings.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".account-settings", "className": ".account-settings", "required": true, "description": "Account settings container." },
    { "name": "section", "selector": ".account-settings__section", "className": ".account-settings__section", "required": true, "description": "Settings section." },
    { "name": "sectionTitle", "selector": ".account-settings__section-title", "className": ".account-settings__section-title", "required": true, "description": "Settings section title." },
    { "name": "sectionDescription", "selector": ".account-settings__section-description", "className": ".account-settings__section-description", "required": false, "description": "Settings section description." }
  ],
  "variants": [
    { "name": "default", "className": null, "default": true, "description": "Default account settings surface." }
  ],
  "sizes": [
    { "name": "default", "className": null, "default": true, "description": "Default narrow settings form width." }
  ],
  "states": [
    { "name": "default", "selectors": [".account-settings"], "description": "Default settings state." },
    { "name": "lastSection", "selectors": [".account-settings__section:last-child"], "description": "Last section border removal." }
  ],
  "behavior": [
    { "name": "settingsComposition", "selectors": [".account-settings"], "description": "Account Settings should compose Input, Button, and Switch primitives." },
    { "name": "settingsSubmit", "selectors": [".account-settings"], "events": ["submit", "change"], "description": "Settings changes should be validated and submitted to the target account API." }
  ],
  "properties": [
    { "name": "sections", "type": "slot", "required": true, "description": "Target-owned settings sections and their composed controls.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".account-settings", "classNames": [".account-settings"] }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-border-subtle", "--color-text-primary", "--color-text-secondary"],
      "typography": ["--font-family-heading", "--typo-h4-size", "--typo-body-size"]
    }
  },
  "accessibility": [
    "Group settings into titled sections.",
    "Associate every preference control with a label and description when needed.",
    "Composed fields and switches preserve dependency-owned validation and native control semantics.",
    "Confirm or clearly label destructive account actions.",
    "Protect account settings behind authentication."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/account.css." },
    "shopify": { "status": "planned", "kind": "liquid-css-js", "notes": "Should map customer profile, password, and notification preference flows where supported." },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
