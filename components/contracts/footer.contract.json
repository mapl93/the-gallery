{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "footer",
  "name": "Footer",
  "registryId": "C3",
  "category": "global",
  "status": "pilot",
  "summary": "Site footer with responsive link columns and bottom metadata bar.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/footer",
    "css": { "file": "components/css/global.css", "selector": ".footer" },
    "docs": "site/src/content/components/footer.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".footer", "className": ".footer", "required": true, "description": "Footer region." },
    { "name": "grid", "selector": ".footer__grid", "className": ".footer__grid", "required": true, "description": "Responsive footer column grid." },
    { "name": "heading", "selector": ".footer__heading", "className": ".footer__heading", "required": false, "description": "Footer column heading." },
    { "name": "links", "selector": ".footer__links", "className": ".footer__links", "required": false, "description": "Footer link list." },
    { "name": "bottom", "selector": ".footer__bottom", "className": ".footer__bottom", "required": false, "description": "Bottom metadata and legal row." }
  ],
  "variants": [
    { "name": "default", "className": null, "default": true, "description": "Default footer layout." }
  ],
  "sizes": [
    { "name": "default", "className": null, "default": true, "description": "Default full-width footer spacing." }
  ],
  "states": [
    { "name": "default", "selectors": [".footer"], "description": "Default footer state." },
    { "name": "linkHover", "selectors": [".footer__links a:hover"], "description": "Footer link hover state." },
    { "name": "desktopGrid", "selectors": [".footer__grid"], "description": "Desktop breakpoint expands link columns." }
  ],
  "behavior": [
    { "name": "footerNavigation", "selectors": [".footer__links"], "attributes": ["aria-label"], "description": "Footer link groups should be organized as labelled navigation when they contain navigation links." },
    { "name": "legalMetadata", "selectors": [".footer__bottom"], "description": "Bottom bar should expose legal, locale, or brand metadata as readable text." }
  ],
  "properties": [
    { "name": "linkGroups", "type": "slot", "required": true, "description": "Target-owned footer headings and labelled navigation lists.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".footer__grid", "classNames": [".footer__grid"] }] } },
    { "name": "metadata", "type": "slot", "required": false, "description": "Optional legal, locale, copyright, or brand metadata.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".footer__bottom", "classNames": [".footer__bottom"] }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-surface-secondary", "--color-text-secondary", "--color-text-primary", "--color-border-subtle", "--color-border-focus", "--color-text-accent"],
      "spacing": ["--space-layout-section-gap", "--space-layout-container", "--space-layout-grid-gap", "--space-layout-element-gap"],
      "typography": ["--typo-body-size", "--font-family-heading"],
      "transition": ["--transition-fast"],
      "easing": ["--easing-default"]
    }
  },
  "accessibility": [
    "Group footer links with headings or labelled navigation regions.",
    "Keep legal and locale information readable at small type sizes.",
    "Do not make the footer the only route to critical support actions."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/global.css." },
    "shopify": { "status": "planned", "kind": "liquid-css", "notes": "Should map footer menu blocks, brand copy, newsletter, and legal links from theme settings." },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
