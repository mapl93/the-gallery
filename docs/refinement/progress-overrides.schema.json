{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-gallery.local/schemas/component-refinement-progress.json",
  "type": "object",
  "required": ["programVersion", "components"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "programVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "dossierStatus",
          "implementationStatus",
          "evidenceStatus",
          "humanReview",
          "readyForHumanReview"
        ],
        "additionalProperties": false,
        "properties": {
          "dossierStatus": { "type": "string" },
          "implementationStatus": { "type": "string" },
          "evidenceStatus": { "type": "string" },
          "humanReview": { "type": "string" },
          "readyForHumanReview": { "type": "boolean" },
          "report": { "type": ["string", "null"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}
