{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "empty-state",
  "name": "Empty State",
  "registryId": "A13",
  "category": "primitives",
  "status": "pilot",
  "summary": "Empty state primitive for empty collections, carts, and search results with icon, title, message, and optional action composition.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/empty-state",
    "css": {
      "file": "components/css/primitives.css",
      "selector": ".empty-state"
    },
    "docs": "site/src/content/components/empty-state.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".empty-state",
      "className": ".empty-state",
      "required": true,
      "description": "Centered empty-state layout wrapper."
    },
    {
      "name": "icon",
      "selector": ".empty-state__icon",
      "className": ".empty-state__icon",
      "required": false,
      "description": "Optional visual icon or illustration."
    },
    {
      "name": "title",
      "selector": ".empty-state__title",
      "className": ".empty-state__title",
      "required": true,
      "description": "Primary empty-state heading."
    },
    {
      "name": "message",
      "selector": ".empty-state__message",
      "className": ".empty-state__message",
      "required": false,
      "description": "Supporting explanation or next step."
    },
    {
      "name": "action",
      "selector": null,
      "required": false,
      "description": "Optional composed Button or Link that offers one clear recovery action."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default empty state."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default empty-state spacing."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [".empty-state"],
      "description": "Default empty state."
    }
  ],
  "behavior": [
    {
      "name": "emptyContext",
      "selectors": [".empty-state__title", ".empty-state__message"],
      "description": "The title and message should explain what is empty and what the user can do next."
    },
    {
      "name": "actionComposition",
      "selectors": [".empty-state"],
      "description": "Optional actions should compose Button or Link rather than inventing local action styles."
    }
  ],
  "properties": [
    {
      "name": "title",
      "type": "string",
      "required": true,
      "description": "Concise heading that identifies what content is empty.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".empty-state__title" }]
      }
    },
    {
      "name": "message",
      "type": "string",
      "required": false,
      "description": "Optional supporting explanation or next step.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".empty-state__message" }]
      }
    },
    {
      "name": "icon",
      "type": "slot",
      "required": false,
      "description": "Optional decorative icon or illustration that reinforces the visible title.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".empty-state__icon", "classNames": [".empty-state__icon"] }]
      }
    },
    {
      "name": "action",
      "type": "slot",
      "required": false,
      "description": "Optional composed Button or Link that offers one clear recovery action.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".empty-state", "classNames": [".btn"] }]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-text-disabled",
        "--color-text-primary",
        "--color-text-secondary"
      ],
      "spacing": [
        "--space-layout-section-gap"
      ],
      "typography": [
        "--typo-h3-size",
        "--font-family-heading",
        "--typo-body-size"
      ]
    }
  },
  "accessibility": [
    "Use clear title text that identifies the empty state.",
    "Make optional actions keyboard accessible and descriptive.",
    "Treat decorative icons as decorative when the title already communicates the state.",
    "Do not use an empty state when content is still loading; use Skeleton or Spinner instead."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented by class composition in components/css/primitives.css."
    },
    "shopify": {
      "status": "implemented",
      "kind": "liquid-css-class"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "style"
    },
    "compose": {
      "status": "planned",
      "kind": "composable"
    }
  }
}
