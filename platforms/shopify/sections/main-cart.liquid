<script src="{{ 'discount-field.js' | asset_url }}" defer></script>

<section class="section">
  <div class="container">
    {%- unless cart.empty? -%}
      {%- assign cart_summary_placement = section.settings.summary_placement | default: 'sticky' -%}
      {% form 'cart', cart %}
        <section
          class="cart-page{% if cart_summary_placement == 'flow' %} cart-page--summary-flow{% endif %}"
          aria-labelledby="CartPageTitle"
          {% if cart_summary_placement == 'sticky' %}style="--_cart-page-summary-offset: calc(4rem + var(--space-layout-element-gap) + env(safe-area-inset-top));"{% endif %}
        >
          <header class="cart-page__header">
            <h1 class="cart-page__title" id="CartPageTitle">
              {{ 'cart.title' | t }}
            </h1>
            <p class="cart-page__count">
              <bdi>{{ 'cart.item_count' | t: count: cart.item_count }}</bdi>
            </p>
            <a class="cart-page__continue" href="{{ routes.all_products_collection_url }}">
              {{ 'cart.continue_shopping' | t }}
            </a>
          </header>

          <div class="cart-page__layout">
            <div class="cart-page__items">
              <ul class="cart-lines">
                {%- for item in cart.items -%}
                  {%- if settings.gift_wrap_enabled and settings.gift_wrap_product != blank and item.product_id == settings.gift_wrap_product.id -%}
                    {% render 'cart-line-item', item: item, show_quantity: false %}
                  {%- else -%}
                    {% render 'cart-line-item', item: item %}
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>

            <div class="cart-page__summary">
              {% render 'cart-summary', summary_id: 'CartPageSummary', show_express: true %}
            </div>
          </div>
        </section>

        {%- if section.settings.show_cart_note -%}
          {% render 'cart-note',
             expanded: section.settings.cart_note_expanded,
             note_id: 'CartPageNote' %}
        {%- endif -%}

        {%- if settings.gift_wrap_enabled and settings.gift_wrap_product != blank -%}
          {% render 'gift-wrap',
             gift_wrap_product: settings.gift_wrap_product,
             gift_wrap_id: 'CartPageGiftWrap' %}
        {%- endif -%}

        <button type="submit" name="update" class="btn btn--outline btn--full">
          {{ 'cart.update' | t }}
        </button>
      {% endform %}

      <div class="main-cart__discount">
        {% render 'discount-field', discount_id: 'CartPageDiscount' %}
      </div>
    {%- else -%}
      {% render 'cart-empty',
         heading_tag: 'h1',
         icon: 'shopping-bag',
         title: 'cart.empty' | t,
         message: 'cart.empty_message' | t,
         action_label: 'cart.continue_shopping' | t,
         href: routes.all_products_collection_url %}
    {%- endunless -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "settings": [
    {
      "type": "select",
      "id": "summary_placement",
      "label": "t:sections.main_cart.settings.summary_placement",
      "options": [
        {
          "value": "sticky",
          "label": "t:sections.main_cart.settings.summary_placement_sticky"
        },
        {
          "value": "flow",
          "label": "t:sections.main_cart.settings.summary_placement_flow"
        }
      ],
      "default": "sticky"
    },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "t:sections.main_cart.settings.show_cart_note",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "cart_note_expanded",
      "label": "t:sections.main_cart.settings.cart_note_expanded",
      "default": false
    }
  ]
}
{% endschema %}
