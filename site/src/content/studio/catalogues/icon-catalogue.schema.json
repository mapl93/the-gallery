{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-gallery.dev/schema/studio-icon-catalogue.json",
  "title": "The Gallery Studio Icon Catalogue",
  "description": "Site-owned projection of an external icon source for Studio controls.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "package", "packageVersion", "icons"],
  "properties": {
    "$schema": { "const": "./icon-catalogue.schema.json" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "package": { "const": "lucide-react" },
    "packageVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "icons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "label"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
