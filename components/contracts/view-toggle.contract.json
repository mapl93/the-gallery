    { "name": "activeView", "type": "enum", "required": false, "defaultValue": "grid", "values": ["grid", "list"], "description": "Target-owned view mode synchronized across both pressed buttons.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".view-toggle", "attribute": "data-view", "values": { "grid": "grid", "list": "list" } }] } },
    { "name": "disabled", "type": "boolean", "required": false, "defaultValue": false, "description": "Disables both native view buttons.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".view-toggle__btn", "attribute": "disabled", "values": { "true": "", "false": null }, "elements": ["button"] }] } }
