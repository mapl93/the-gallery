{% doc %}
  Native-search overlay. The form remains useful without predictive search.
{% enddoc %}

<div
  class="search-overlay storefront-search-overlay"
  id="StorefrontSearch"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="StorefrontSearchTitle"
  data-storefront-panel="search"
  tabindex="-1"
  inert
  hidden
>
  <form class="search-box" role="search" action="{{ routes.search_url }}" method="get">
    <div class="search-box__header">
      <h2 class="search-box__title" id="StorefrontSearchTitle">{{ 'search.title' | t }}</h2>
      <button
        class="close-btn search-box__close"
        type="button"
        aria-label="{{ 'accessibility.close' | t }}"
        data-storefront-close
      >
        {% render 'icon', name: 'x' %}
      </button>
    </div>
    <label class="visually-hidden search-box__label" for="StorefrontSearchQuery">
      {{ 'search.label' | t }}
    </label>
    <input
      class="search-box__input"
      id="StorefrontSearchQuery"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
      autocomplete="off"
      data-storefront-autofocus
    >
    <button class="btn search-box__submit" type="submit">{{ 'search.submit' | t }}</button>
  </form>
</div>
