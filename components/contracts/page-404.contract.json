{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "page-404",
  "name": "404 Page",
  "registryId": "P1",
  "category": "pages",
  "status": "pilot",
  "summary": "Missing-page composition with explanatory content and optional target-owned recovery search, links, illustration, and suggestions.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/page-404",
    "css": { "file": "components/css/pages.css", "selector": ".page-404" },
    "docs": "site/src/content/components/page-404.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".page-404", "className": ".page-404", "required": true, "description": "Centered missing-page container." },
    { "name": "illustration", "selector": ".page-404__illustration", "className": ".page-404__illustration", "required": false, "description": "Optional media composition." },
    { "name": "code", "selector": ".page-404__code", "className": ".page-404__code", "required": false, "description": "Optional visible error code." },
    { "name": "heading", "selector": ".page-404__heading", "className": ".page-404__heading", "required": true, "description": "Page-level missing-page heading." },
    { "name": "text", "selector": ".page-404__text", "className": ".page-404__text", "required": true, "description": "Explanatory recovery message." },
    { "name": "search", "selector": ".page-404__search", "className": ".page-404__search", "required": false, "description": "Optional native search-form composition." },
    { "name": "searchInput", "selector": ".page-404__search-input", "className": ".page-404__search-input", "required": false, "description": "Search-field sizing hook; canonical field anatomy retains accessible naming, messages, and validation semantics." },
    { "name": "searchButton", "selector": ".page-404__search-btn", "className": ".page-404__search-btn", "required": false, "description": "Search submit action." },
    { "name": "links", "selector": ".page-404__links", "className": ".page-404__links", "required": false, "description": "Target-owned recovery-link group." },
    { "name": "link", "selector": ".page-404__link", "className": ".page-404__link", "required": false, "description": "Single target-owned recovery destination." },
    { "name": "suggestions", "selector": ".page-404__suggestions", "className": ".page-404__suggestions", "required": false, "description": "Optional suggested-content composition." },
    { "name": "suggestionsHeading", "selector": ".page-404__suggestions-heading", "className": ".page-404__suggestions-heading", "required": false, "description": "Optional suggested-content heading." }
  ],
  "variants": [
    { "name": "default", "className": null, "default": true, "description": "Default missing-page presentation." }
  ],
  "sizes": [
    { "name": "default", "className": null, "default": true, "description": "Default centered responsive layout." }
  ],
  "states": [
    { "name": "default", "selectors": [".page-404"], "description": "Default missing-page presentation." },
    { "name": "searchFocusVisible", "selectors": [".page-404__search-input:focus-visible"], "description": "Visible keyboard focus on the optional search field." },
    { "name": "searchButtonHover", "selectors": [".page-404__search-btn:hover"], "description": "Search-action hover presentation." },
    { "name": "searchButtonFocusVisible", "selectors": [".page-404__search-btn:focus-visible"], "description": "Visible keyboard focus on the search action." },
    { "name": "recoveryLinkFocusVisible", "selectors": [".page-404__link:focus-visible"], "description": "Visible keyboard focus on recovery links." }
  ],
  "behavior": [
    {
      "name": "recoverySearch",
      "selectors": [".page-404__search", ".page-404__search-input", ".page-404__search-btn"],
      "attributes": ["role=\"search\""],
      "events": ["submit"],
      "description": "Optional search uses native form submission and an accessible label. Query handling and destination behavior remain target-owned."
    },
    {
      "name": "recoveryLinks",
      "selectors": [".page-404__link"],
      "attributes": ["href"],
      "events": ["click"],
      "description": "Targets provide useful recovery destinations; the component does not define a route inventory."
    },
    {
      "name": "searchFieldComposition",
      "selectors": [".page-404__search", ".page-404__search-input"],
      "description": "When validation or supporting feedback is present, the search field composes canonical field label, message, default, error, success, warning, disabled, and programmatic-association obligations."
    }
  ],
  "properties": [
    {
      "name": "illustration",
      "type": "slot",
      "required": false,
      "description": "Optional target-owned missing-page media.",
      "targetMappings": { "web": [{ "kind": "slot", "selector": ".page-404__illustration", "classNames": [".page-404__illustration"] }] }
    },
    {
      "name": "code",
      "type": "string",
      "required": false,
      "description": "Optional visible error code.",
      "targetMappings": { "web": [{ "kind": "content", "selector": ".page-404__code" }] }
    },
    {
      "name": "heading",
      "type": "string",
      "required": true,
      "description": "Missing-page heading.",
      "targetMappings": { "web": [{ "kind": "content", "selector": ".page-404__heading" }] }
    },
    {
      "name": "message",
      "type": "string",
      "required": true,
      "description": "Explanatory recovery message.",
      "targetMappings": { "web": [{ "kind": "content", "selector": ".page-404__text" }] }
    },
    {
      "name": "search",
      "type": "slot",
      "required": false,
      "description": "Optional target-owned search form and submission action.",
      "targetMappings": { "web": [{ "kind": "slot", "selector": ".page-404__search", "classNames": [".page-404__search", ".page-404__search-input", ".page-404__search-btn"] }] }
    },
    {
      "name": "recoveryLinks",
      "type": "slot",
      "required": false,
      "description": "Optional target-owned recovery destinations.",
      "targetMappings": { "web": [{ "kind": "slot", "selector": ".page-404__links", "classNames": [".page-404__links", ".page-404__link"] }] }
    },
    {
      "name": "suggestions",
      "type": "slot",
      "required": false,
      "description": "Optional target-owned suggested-content heading and items.",
      "targetMappings": { "web": [{ "kind": "slot", "selector": ".page-404__suggestions", "classNames": [".page-404__suggestions", ".page-404__suggestions-heading"] }] }
    }
  ],
  "tokens": {
    "public": {
      "color": ["--color-text-primary", "--color-text-secondary", "--color-border-default", "--color-surface-primary", "--color-border-focus", "--color-border-focus-subtle", "--color-button-primary-bg-default", "--color-button-primary-text-default", "--color-text-accent"],
      "spacing": ["--space-layout-touch-target"],
      "radius": ["--radius-sm"],
      "typography": ["--font-family-heading", "--typo-h2-size", "--typo-body-size", "--typo-body-sm-size", "--typo-h4-size"],
      "transition": ["--transition-fast"],
      "easing": ["--easing-default"]
    }
  },
  "accessibility": [
    "Use one clear page-level heading that communicates the missing-page state.",
    "Provide at least one recovery path and keep target destinations understandable out of context.",
    "Label the optional native search form and field; placeholder text is not the field's only accessible name.",
    "Associate supporting or validation feedback programmatically and reserve aria-invalid for an actual error.",
    "Give meaningful illustration content useful alternative text and mark decorative media accordingly."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/pages.css." },
    "shopify": { "status": "planned", "kind": "liquid-css", "notes": "Should map the 404 template while leaving search handling, recovery destinations, and suggestions target-owned." },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
