{
  "$description": "Light theme overrides. Compile this with primitives, semantics, components, and one viewport mode.",
  "color": {
    "surface": {
      "primary": { "$type": "color", "$value": "{color.gray.0}" },
      "secondary": { "$type": "color", "$value": "{color.gray.100}" },
      "archival": { "$type": "color", "$value": "{color.brown.50}" },
      "statement": { "$type": "color", "$value": "{color.orange.50}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.gray.900}" },
      "secondary": { "$type": "color", "$value": "{color.gray.600}" },
      "archival": { "$type": "color", "$value": "{color.brown.600}" },
      "statement": { "$type": "color", "$value": "{color.orange.600}" },
      "inverse": { "$type": "color", "$value": "{color.gray.0}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.gray.200}" },
      "strong": { "$type": "color", "$value": "{color.gray.900}" },
      "archival": { "$type": "color", "$value": "{color.brown.300}" },
      "statement": { "$type": "color", "$value": "{color.orange.300}" }
    }
  },
  "component": {
    "button": {
      "primary": {
        "background": {
          "default": { "$type": "color", "$value": "{color.gray.700}" },
          "hover": { "$type": "color", "$value": "{color.gray.800}" },
          "active": { "$type": "color", "$value": "{color.gray.950}" }
        },
        "text": { "$type": "color", "$value": "{color.gray.0}" },
        "border": { "$type": "color", "$value": "{color.transparent}" }
      },
      "secondary": {
        "background": {
          "default": { "$type": "color", "$value": "{color.gray.100}" },
          "hover": { "$type": "color", "$value": "{color.gray.200}" },
          "active": { "$type": "color", "$value": "{color.gray.300}" }
        },
        "text": { "$type": "color", "$value": "{color.gray.900}" },
        "border": { "$type": "color", "$value": "{color.transparent}" }
      },
      "outline": {
        "background": {
          "default": { "$type": "color", "$value": "{color.transparent}" },
          "hover": { "$type": "color", "$value": "{color.gray.50}" },
          "active": { "$type": "color", "$value": "{color.gray.100}" }
        },
        "text": { "$type": "color", "$value": "{color.gray.900}" },
        "border": { "$type": "color", "$value": "{color.gray.900}" }
      }
    }
  }
}
