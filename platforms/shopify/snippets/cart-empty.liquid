{% doc %}
  Renders the Cart Empty profile through the canonical Empty State snippet.

  @param {string} title - Required localized cart-empty title.
  @param {string} heading_tag - Required contextually correct h1-h6 element supplied by the host.
  @param {string} [message] - Optional localized recovery guidance.
  @param {string} [icon] - Optional decorative icon name.
  @param {string} [action_label] - Optional localized recovery link label.
  @param {string} [href] - Optional recovery destination paired with action_label.

  @example
  {% render 'cart-empty', heading_tag: 'h1', title: 'cart.empty' | t, action_label: 'cart.continue_shopping' | t, href: routes.all_products_collection_url %}
{% enddoc %}

{% render 'empty-state',
  root_class: 'cart-empty',
  heading_tag: heading_tag,
  icon: icon,
  title: title,
  message: message,
  cta_text: action_label,
  cta_url: href
%}
