<section class="storefront-work" aria-labelledby="StorefrontWorkTitle-{{ section.id }}">
  <header class="storefront-work__header">
    <h1 class="storefront-work__title" id="StorefrontWorkTitle-{{ section.id }}">{{ section.settings.heading }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="storefront-work__intro rte">{{ section.settings.intro }}</div>
    {%- endif -%}
    {%- if section.settings.navigation != blank -%}
      <nav class="storefront-work__navigation" aria-label="{{ section.settings.navigation_label | escape }}">
        {%- for link in section.settings.navigation.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </header>

  {%- if section.blocks.size > 0 -%}
    <ul class="storefront-work__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_image = block.settings.image
          assign card_title = block.settings.title
          assign card_description = block.settings.description
          assign card_eyebrow = block.settings.eyebrow
          assign card_url = block.settings.url
          assign card_price_product = blank

          case block.type
            when 'collection'
              if block.settings.collection != blank
                if card_image == blank
                  assign card_image = block.settings.collection.featured_image
                endif
                if card_title == blank
                  assign card_title = block.settings.collection.title
                endif
                if card_description == blank
                  assign card_description = block.settings.collection.description | strip_html | truncatewords: 30
                endif
                if card_url == blank
                  assign card_url = block.settings.collection.url
                endif
              endif
            when 'product'
              if block.settings.product != blank
                if card_image == blank
                  assign card_image = block.settings.product.featured_media
                endif
                if card_title == blank
                  assign card_title = block.settings.product.title
                endif
                if card_description == blank
                  assign card_description = block.settings.product.description | strip_html | truncatewords: 30
                endif
                if card_url == blank
                  assign card_url = block.settings.product.url
                endif
                if block.settings.show_price
                  assign card_price_product = block.settings.product
                endif
              endif
          endcase

          if card_title == blank
            assign card_title = 'work.untitled' | t
          endif
        -%}

        <li class="storefront-work__item storefront-work__item--{{ block.settings.span }}" {{ block.shopify_attributes }}>
          {%- if card_url != blank -%}<a class="storefront-work-card{% if block.settings.portrait %} storefront-work-card--portrait{% endif %}" href="{{ card_url }}">{%- else -%}<div class="storefront-work-card{% if block.settings.portrait %} storefront-work-card--portrait{% endif %}">{%- endif -%}
            <div class="storefront-work-card__media">
              {%- if card_image != blank -%}
                {{ card_image
                  | image_url: width: 1800
                  | image_tag:
                    widths: '480, 720, 960, 1200, 1500, 1800',
                    sizes: '(min-width: 768px) 66vw, 100vw',
                    loading: 'lazy',
                    alt: card_image.alt | default: card_title
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'storefront-work-card__placeholder placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="storefront-work-card__content">
              {%- if card_eyebrow != blank -%}<span class="storefront-work-card__eyebrow">{{ card_eyebrow }}</span>{%- endif -%}
              <h2 class="storefront-work-card__title">{{ card_title }}</h2>
              {%- if card_description != blank -%}<p class="storefront-work-card__description">{{ card_description }}</p>{%- endif -%}
              {%- if card_price_product != blank -%}{% render 'price', product: card_price_product %}{%- endif -%}
            </div>
          {%- if card_url != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- elsif request.design_mode -%}
    <p>{{ 'work.editor_hint' | t }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Work index",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Work" },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    { "type": "link_list", "id": "navigation", "label": "Work navigation" },
    { "type": "text", "id": "navigation_label", "label": "Navigation label", "default": "Work categories" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "textarea", "id": "description", "label": "Description override" },
        { "type": "url", "id": "url", "label": "Link override" },
        { "type": "checkbox", "id": "portrait", "label": "Portrait image", "default": false },
        {
          "type": "select", "id": "span", "label": "Desktop width", "default": "two-thirds",
          "options": [
            { "value": "third", "label": "One third" },
            { "value": "two-thirds", "label": "Two thirds" },
            { "value": "full", "label": "Full" }
          ]
        }
      ]
    },
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "textarea", "id": "description", "label": "Description override" },
        { "type": "url", "id": "url", "label": "Link override" },
        { "type": "checkbox", "id": "show_price", "label": "Show price", "default": false },
        { "type": "checkbox", "id": "portrait", "label": "Portrait image", "default": true },
        {
          "type": "select", "id": "span", "label": "Desktop width", "default": "third",
          "options": [
            { "value": "third", "label": "One third" },
            { "value": "two-thirds", "label": "Two thirds" },
            { "value": "full", "label": "Full" }
          ]
        }
      ]
    },
    {
      "type": "editorial",
      "name": "Editorial item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title", "default": "Studio study" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "checkbox", "id": "portrait", "label": "Portrait image", "default": false },
        {
          "type": "select", "id": "span", "label": "Desktop width", "default": "full",
          "options": [
            { "value": "third", "label": "One third" },
            { "value": "two-thirds", "label": "Two thirds" },
            { "value": "full", "label": "Full" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "Work index" }]
}
{% endschema %}
