{
  "$description": "The Gallery DTCG spike token subset. This file is intentionally small and isolated from the production token pipeline.",
  "color": {
    "$description": "Color primitives and semantic aliases.",
    "gray": {
      "0": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Pure white."
      },
      "100": {
        "$type": "color",
        "$value": "#f5f5f5",
        "$description": "Light neutral surface."
      },
      "700": {
        "$type": "color",
        "$value": "#404040",
        "$description": "Strong neutral text and controls."
      },
      "900": {
        "$type": "color",
        "$value": "#171717",
        "$description": "Near-black neutral."
      }
    },
    "surface": {
      "primary": {
        "$type": "color",
        "$value": "{color.gray.0}",
        "$description": "Default page or component surface."
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.gray.100}",
        "$description": "Subtle secondary surface."
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.gray.900}",
        "$description": "Default high-emphasis text."
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.gray.0}",
        "$description": "Text on dark or filled surfaces."
      }
    },
    "button": {
      "$description": "Public component-scoped button tokens for target adapters.",
      "primary": {
        "background": {
          "default": {
            "$type": "color",
            "$value": "{color.gray.900}",
            "$description": "Primary button default fill."
          },
          "hover": {
            "$type": "color",
            "$value": "{color.gray.700}",
            "$description": "Primary button hover fill."
          }
        },
        "text": {
          "$type": "color",
          "$value": "{color.text.inverse}",
          "$description": "Primary button text color."
        }
      }
    }
  },
  "space": {
    "$description": "Spacing primitives and semantic component spacing.",
    "scale": {
      "2": {
        "$type": "dimension",
        "$value": "0.5rem",
        "$description": "8px at a 16px base."
      },
      "3": {
        "$type": "dimension",
        "$value": "0.75rem",
        "$description": "12px at a 16px base."
      },
      "4": {
        "$type": "dimension",
        "$value": "1rem",
        "$description": "16px at a 16px base."
      }
    },
    "button": {
      "padding-x": {
        "$type": "dimension",
        "$value": "{space.scale.4}",
        "$description": "Horizontal button padding."
      },
      "padding-y": {
        "$type": "dimension",
        "$value": "{space.scale.3}",
        "$description": "Vertical button padding."
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.scale.2}",
        "$description": "Gap between button icon and label."
      }
    }
  },
  "radius": {
    "$description": "Radius primitives.",
    "md": {
      "$type": "dimension",
      "$value": "0.5rem",
      "$description": "Default medium radius."
    },
    "full": {
      "$type": "dimension",
      "$value": "999rem",
      "$description": "Fully rounded pill radius."
    }
  }
}
