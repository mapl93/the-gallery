    "docs": "site/src/content/components/size-chart.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".size-chart", "className": ".size-chart", "required": true, "description": "Size chart component wrapper." },
    { "name": "trigger", "selector": ".size-chart__trigger", "className": ".size-chart__trigger", "required": true, "description": "Trigger button." },
    { "name": "triggerIcon", "selector": ".size-chart__trigger svg", "required": false, "description": "Optional trigger icon." },
    { "name": "drawer", "selector": ".size-chart__drawer", "className": ".size-chart__drawer", "required": true, "description": "Overlay drawer or modal layer." },
    { "name": "panel", "selector": ".size-chart__panel", "className": ".size-chart__panel", "required": true, "description": "Dialog panel." },
    { "name": "header", "selector": ".size-chart__header", "className": ".size-chart__header", "required": true, "description": "Dialog header." },
    { "name": "title", "selector": ".size-chart__title", "className": ".size-chart__title", "required": true, "description": "Dialog title." },
    { "name": "close", "selector": ".size-chart__close", "className": ".size-chart__close", "required": true, "description": "Close button." },
    { "name": "unitToggle", "selector": ".size-chart__unit-toggle", "className": ".size-chart__unit-toggle", "required": false, "description": "Unit toggle control." },
    { "name": "unitButton", "selector": ".size-chart__unit-btn", "className": ".size-chart__unit-btn", "required": false, "description": "Single unit option." },
    { "name": "table", "selector": ".size-chart__table", "className": ".size-chart__table", "required": true, "description": "Measurement table." },
    { "name": "notes", "selector": ".size-chart__notes", "className": ".size-chart__notes", "required": false, "description": "Fit guide notes." }
  ],
  "variants": [
    { "name": "default", "className": null, "default": true, "description": "Default size chart modal/drawer." }
  ],
  "sizes": [
    { "name": "default", "className": null, "default": true, "description": "Default centered panel size." }
  ],
  "states": [
    { "name": "closed", "selectors": [".size-chart__drawer"], "description": "Hidden drawer state." },
    { "name": "open", "selectors": [".size-chart__drawer[aria-hidden=\"false\"]", ".size-chart__drawer.is-open"], "description": "Open drawer state." },
    { "name": "openPanel", "selectors": [".size-chart__drawer.is-open .size-chart__panel", ".size-chart__drawer[aria-hidden=\"false\"] .size-chart__panel"], "description": "Panel entrance state." },
    { "name": "activeUnit", "selectors": [".size-chart__unit-btn[aria-pressed=\"true\"]", ".size-chart__unit-btn.is-active"], "description": "Active unit option state." },
    { "name": "tableHover", "selectors": [".size-chart__table tr:hover td"], "description": "Table row hover state." }
  ],
  "behavior": [
    { "name": "dialog", "selectors": [".size-chart__drawer[aria-hidden=\"false\"]", ".size-chart__close"], "attributes": ["role=\"dialog\"", "aria-modal=\"true\"", "aria-hidden", "aria-labelledby"], "events": ["click", "Escape"], "description": "Open state should trap or manage focus and close on explicit close or Escape when supported." },
    { "name": "unitToggle", "selectors": [".size-chart__unit-btn[aria-pressed=\"true\"]"], "attributes": ["aria-pressed"], "events": ["click"], "description": "Unit toggles should keep measurement values and pressed state synchronized." },
    { "name": "measurementTable", "selectors": [".size-chart__table"], "attributes": ["<table>", "<th>", "<td>"], "description": "Measurements should remain tabular data in web targets and equivalent native table/list semantics elsewhere." }
  ],
  "properties": [
    { "name": "triggerLabel", "type": "string", "required": true, "description": "Visible label for the chart trigger.", "targetMappings": { "web": [{ "kind": "content", "selector": ".size-chart__trigger" }] } },
    { "name": "title", "type": "string", "required": true, "description": "Visible dialog title.", "targetMappings": { "web": [{ "kind": "content", "selector": ".size-chart__title" }] } },
    { "name": "closeLabel", "type": "string", "required": true, "description": "Accessible name for the close action.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".size-chart__close", "attribute": "aria-label", "valueFrom": "property", "elements": ["button"] }] } },
    { "name": "open", "type": "boolean", "required": false, "defaultValue": false, "description": "Controls overlay visibility and trigger expanded state.", "targetMappings": { "web": [{ "kind": "class", "selector": ".size-chart__drawer", "classNames": [".is-open"] }, { "kind": "attribute", "selector": ".size-chart__drawer", "attribute": "aria-hidden", "values": { "true": "false", "false": "true" } }, { "kind": "attribute", "selector": ".size-chart__trigger", "attribute": "aria-expanded", "values": { "true": "true", "false": "false" }, "elements": ["button"] }] } },
    { "name": "activeUnit", "type": "boolean", "required": false, "defaultValue": false, "description": "Pressed state for an individual unit button.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".size-chart__unit-btn", "attribute": "aria-pressed", "values": { "true": "true", "false": "false" }, "elements": ["button"] }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-surface-primary", "--color-border-subtle", "--color-border-focus", "--color-text-secondary", "--color-text-primary", "--color-surface-secondary", "--color-button-primary-bg-default", "--color-button-primary-bg-hover", "--color-button-primary-text-default", "--color-button-primary-text-hover"],
      "radius": ["--radius-lg", "--radius-sm"],
      "shadow": ["--shadow-xl"],
      "transition": ["--transition-default", "--transition-fast"],
      "easing": ["--easing-default", "--easing-out"],
      "typography": ["--typo-body-sm-size", "--typo-h4-size"]
    }
  },
  "accessibility": [
    "Use dialog semantics for modal targets and preserve focus management.",
    "Keep the trigger and close actions keyboard accessible.",
    "Use table semantics for measurement matrices."
  ],
  "adapters": {
