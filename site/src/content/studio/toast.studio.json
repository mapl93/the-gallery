        { "id": "feedback", "label": "Feedback", "kind": "token-swatch", "tokens": { "category": "color", "match": "^--color-feedback-(info|success|warning|error)-default$" } },
        { "id": "radius", "label": "Radius", "kind": "token", "tokens": { "category": "radius", "names": ["--radius-md"] } },
        { "id": "shadow", "label": "Shadow", "kind": "token", "tokens": { "category": "shadow", "names": ["--shadow-lg"] } },
        { "id": "type-size", "label": "Type size", "kind": "token", "tokens": { "category": "typography", "names": ["--typo-body-sm-size"] } },
        { "id": "type-line-height", "label": "Type line height", "kind": "token", "tokens": { "category": "typography", "names": ["--typo-body-sm-line-height"] } },
        { "id": "spacing", "label": "Spacing", "kind": "token", "tokens": { "category": "spacing", "names": ["--space-layout-element-gap"] } }
      ]
