{
  "$schema": "./studio.schema.json",
  "studioVersion": "0.2.0",
  "slug": "field-wrapper",
  "groups": [
    {
      "id": "content",
      "label": "Content",
      "controls": [
        {
          "id": "label",
          "label": "Label",
          "kind": "text",
          "properties": [
            "label"
          ]
        },
        {
          "id": "control",
          "label": "Canonical control",
          "kind": "slot-composition",
          "properties": [
            "control"
          ]
        },
        {
          "id": "description",
          "label": "Description",
          "kind": "text",
          "properties": [
            "description"
          ]
        },
        {
          "id": "feedback",
          "label": "Feedback",
          "kind": "text",
          "properties": [
            "feedback"
          ]
        },
        {
          "id": "required",
          "label": "Required",
          "kind": "toggle",
          "properties": [
            "required"
          ]
        }
      ]
    },
    {
      "id": "presentation",
      "label": "Presentation",
      "controls": [
        {
          "id": "variant",
          "label": "Feedback",
          "kind": "segmented",
          "properties": [
            "variant"
          ]
        }
      ]
    },
    {
      "id": "appearance",
      "label": "Appearance",
      "controls": [
        {
          "id": "required-marker",
          "label": "Required marker",
          "kind": "token-swatch",
          "tokens": {
            "category": "color",
            "names": [
              "--color-field-required"
            ]
          }
        },
        {
          "id": "text",
          "label": "Label",
          "kind": "token-swatch",
          "tokens": {
            "category": "color",
            "names": [
              "--color-text-primary"
            ]
          }
        },
        {
          "id": "secondary",
          "label": "Description",
          "kind": "token-swatch",
          "tokens": {
            "category": "color",
            "names": [
              "--color-text-secondary"
            ]
          }
        },
        {
          "id": "error",
          "label": "Error",
          "kind": "token-swatch",
          "tokens": {
            "category": "color",
            "names": [
              "--color-feedback-error-default"
            ]
          }
        },
        {
          "id": "success",
          "label": "Success",
          "kind": "token-swatch",
          "tokens": {
            "category": "color",
            "names": [
              "--color-feedback-success-default"
            ]
          }
        },
        {
          "id": "warning",
          "label": "Warning",
          "kind": "token-swatch",
          "tokens": {
            "category": "color",
            "names": [
              "--color-feedback-warning-default"
            ]
          }
        }
      ]
    },
    {
      "id": "geometry",
      "label": "Spacing and geometry",
      "controls": [
        {
          "id": "feedback-icon-gap",
          "label": "Feedback icon gap",
          "kind": "token",
          "tokens": {
            "category": "spacing",
            "names": [
              "--space-field-feedback-icon-gap"
            ]
          },
          "visibleWhen": {
            "property": "variant",
            "equals": "error"
          }
        },
        {
          "id": "feedback-icon-size",
          "label": "Feedback icon size",
          "kind": "token",
          "tokens": {
            "category": "spacing",
            "names": [
              "--space-field-feedback-icon-size"
            ]
          },
          "visibleWhen": {
            "property": "variant",
            "equals": "error"
          }
        },
        {
          "id": "feedback-icon-offset",
          "label": "Feedback icon offset",
          "kind": "token",
          "tokens": {
            "category": "spacing",
            "names": [
              "--space-field-feedback-icon-offset"
            ]
          },
          "visibleWhen": {
            "property": "variant",
            "equals": "error"
          }
        },
        {
          "id": "label-gap",
          "label": "Label gap",
          "kind": "token",
          "tokens": {
            "category": "spacing",
            "names": [
              "--space-input-label-gap"
            ]
          }
        },
        {
          "id": "message-gap",
          "label": "Message gap",
          "kind": "token",
          "tokens": {
            "category": "spacing",
            "names": [
              "--space-input-message-gap"
            ]
          }
        },
        {
          "id": "label-size",
          "label": "Label size",
          "kind": "token",
          "tokens": {
            "category": "spacing",
            "names": [
              "--space-input-label-size"
            ]
          }
        },
        {
          "id": "message-size",
          "label": "Message size",
          "kind": "token",
          "tokens": {
            "category": "spacing",
            "names": [
              "--space-input-message-size"
            ]
          }
        }
      ]
    },
    {
      "id": "typography",
      "label": "Typography and opacity",
      "controls": [
        {
          "id": "font-family",
          "label": "Font family",
          "kind": "token",
          "tokens": {
            "category": "typography",
            "names": [
              "--font-family-body"
            ]
          }
        },
        {
          "id": "text-line-height",
          "label": "Text line height",
          "kind": "token",
          "tokens": {
            "category": "typography",
            "names": [
              "--typo-body-sm-line-height"
            ]
          }
        },
        {
          "id": "label-weight",
          "label": "Label weight",
          "kind": "token",
          "tokens": {
            "category": "typography",
            "names": [
              "--typo-input-label-weight"
            ]
          }
        },
        {
          "id": "message-weight",
          "label": "Message weight",
          "kind": "token",
          "tokens": {
            "category": "typography",
            "names": [
              "--typo-body-weight"
            ]
          }
        }
      ]
    }
  ]
}
