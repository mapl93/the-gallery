{
  "$description": "Public Select popup and indicator decisions. Field geometry and typography reuse Input's public API; native popup rendering remains browser-owned.",
  "component": {
    "select": {
      "indicatorSize": { "$type": "dimension", "$value": "{dimension.16}" },
      "indicatorGap": { "$type": "dimension", "$value": "{dimension.8}" },
      "panelGap": { "$type": "dimension", "$value": "{dimension.8}" },
      "panelPadding": { "$type": "dimension", "$value": "{dimension.4}" },
      "panelBorderWidth": { "$type": "dimension", "$value": "{dimension.1}" },
      "panelMaxWidth": { "$type": "dimension", "$value": "360px" },
      "panelMaxHeight": { "$type": "dimension", "$value": "240px" },
      "optionPadding": {
        "x": { "$type": "dimension", "$value": "{component.input.padding.x}" },
        "y": { "$type": "dimension", "$value": "{component.input.padding.y}" }
      },
      "optionMinHeight": { "$type": "dimension", "$value": "{dimension.44}" },
      "optionSelectedWeight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" }
    }
  }
}
