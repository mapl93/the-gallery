{%- comment -%}
  Footer social row.
  Params:
    url – optional external profile URL
    label – visible service name
    icon_asset – theme asset filename
{%- endcomment -%}

<li>
  {%- if url != blank -%}
    <a class="footer__link storefront-footer__icon-link" href="{{ url }}" target="_blank" rel="noopener">
  {%- else -%}
    <span class="storefront-footer__icon-link">
  {%- endif -%}
    <img src="{{ icon_asset | asset_url }}" alt="" width="16" height="16">
    <span>{{ label }}</span>
  {%- if url != blank -%}</a>{%- else -%}</span>{%- endif -%}
</li>
