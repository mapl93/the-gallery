{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "coming-soon",
  "name": "Coming Soon / Password",
  "registryId": "X1",
  "category": "pages",
  "status": "pilot",
  "summary": "Split-screen editorial coming-soon page with optional background media, target-owned form composition, password-access hooks, and footer metadata.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/coming-soon",
    "css": {
      "file": "components/css/coming-soon.css",
      "selector": ".coming-soon"
    },
    "docs": "site/src/content/components/coming-soon.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".coming-soon", "className": ".coming-soon", "required": true, "description": "Coming-soon page root." },
    { "name": "background", "selector": ".coming-soon__bg", "className": ".coming-soon__bg", "required": false, "description": "Optional full-viewport background media." },
    { "name": "logoBar", "selector": ".coming-soon__logo-bar", "className": ".coming-soon__logo-bar", "required": false, "description": "Top-left brand container." },
    { "name": "logoInline", "selector": ".coming-soon__logo-inline", "className": ".coming-soon__logo-inline", "required": false, "description": "In-flow brand container." },
    { "name": "logo", "selector": ".coming-soon__logo", "className": ".coming-soon__logo", "required": false, "description": "Optional logo image." },
    { "name": "storeName", "selector": ".coming-soon__store-name", "className": ".coming-soon__store-name", "required": false, "description": "Optional store name." },
    { "name": "inner", "selector": ".coming-soon__inner", "className": ".coming-soon__inner", "required": true, "description": "Responsive split-layout wrapper." },
    { "name": "left", "selector": ".coming-soon__left", "className": ".coming-soon__left", "required": false, "description": "Editorial content region." },
    { "name": "right", "selector": ".coming-soon__right", "className": ".coming-soon__right", "required": false, "description": "Optional form-composition region." },
    { "name": "heading", "selector": ".coming-soon__heading", "className": ".coming-soon__heading", "required": true, "description": "Page-level heading." },
    { "name": "subtitle", "selector": ".coming-soon__subtitle", "className": ".coming-soon__subtitle", "required": false, "description": "Optional editorial subtitle." },
    { "name": "body", "selector": ".coming-soon__body", "className": ".coming-soon__body", "required": false, "description": "Optional supporting editorial content." },
    { "name": "social", "selector": ".coming-soon__social", "className": ".coming-soon__social", "required": false, "description": "Optional social-link group." },
    { "name": "socialLink", "selector": ".coming-soon__social-link", "className": ".coming-soon__social-link", "required": false, "description": "Target-owned social destination." },
    { "name": "formHeader", "selector": ".coming-soon__form-header", "className": ".coming-soon__form-header", "required": false, "description": "Optional form-region heading." },
    { "name": "formSubtext", "selector": ".coming-soon__form-subtext", "className": ".coming-soon__form-subtext", "required": false, "description": "Optional form guidance." },
    { "name": "newsletter", "selector": ".coming-soon__newsletter", "className": ".coming-soon__newsletter", "required": false, "description": "Optional signup-form wrapper." },
    { "name": "form", "selector": ".coming-soon__form", "className": ".coming-soon__form", "required": false, "description": "Native target-owned form composition." },
    { "name": "input", "selector": ".coming-soon__input", "className": ".coming-soon__input", "required": false, "description": "Sizing hook composed on the canonical Input field; Input owns its label, message, and validation state." },
    { "name": "submit", "selector": ".coming-soon__submit", "className": ".coming-soon__submit", "required": false, "description": "Submit action composed with canonical Button semantics." },
    { "name": "success", "selector": ".coming-soon__success", "className": ".coming-soon__success", "required": false, "description": "Optional target-owned success-feedback hook." },
    { "name": "error", "selector": ".coming-soon__error", "className": ".coming-soon__error", "required": false, "description": "Optional target-owned error-feedback hook." },
    { "name": "passwordLink", "selector": ".coming-soon__password-link", "className": ".coming-soon__password-link", "required": false, "description": "Optional password-access trigger styling hook." },
    { "name": "modal", "selector": ".coming-soon__modal", "className": ".coming-soon__modal", "required": false, "description": "Optional password-access overlay styling hook; authentication and dialog behavior are target-owned." },
    { "name": "modalBackdrop", "selector": ".coming-soon__modal-backdrop", "className": ".coming-soon__modal-backdrop", "required": false, "description": "Optional dialog backdrop styling hook." },
    { "name": "modalPanel", "selector": ".coming-soon__modal-panel", "className": ".coming-soon__modal-panel", "required": false, "description": "Optional dialog-panel styling hook." },
    { "name": "modalClose", "selector": ".coming-soon__modal-close", "className": ".coming-soon__modal-close", "required": false, "description": "Optional target-owned dialog dismiss action." },
    { "name": "modalTitle", "selector": ".coming-soon__modal-title", "className": ".coming-soon__modal-title", "required": false, "description": "Optional password-access surface title." },
    { "name": "footer", "selector": ".coming-soon__footer", "className": ".coming-soon__footer", "required": false, "description": "Optional footer metadata or legal content." }
  ],
  "variants": [
    { "name": "default", "className": null, "default": true, "description": "Default coming-soon page." }
  ],
  "sizes": [
    { "name": "default", "className": null, "default": true, "description": "Default full-viewport responsive layout." }
  ],
  "states": [
    { "name": "default", "selectors": [".coming-soon"], "description": "Default page presentation." },
    { "name": "withBackground", "selectors": [".coming-soon:has(.coming-soon__bg)::after"], "description": "Background-media contrast overlay." },
    { "name": "inputFocus", "selectors": [".coming-soon__input:focus"], "description": "Legacy local field-focus styling hook; canonical Input composition retains the complete field focus obligation." },
    { "name": "submitHover", "selectors": [".coming-soon__submit:hover"], "description": "Submit-action hover presentation." },
    { "name": "passwordHover", "selectors": [".coming-soon__password-link:hover"], "description": "Password-trigger hover presentation." },
    { "name": "modalOpen", "selectors": [".coming-soon__modal.is-open", ".coming-soon__modal.is-open .coming-soon__modal-panel"], "description": "Existing open-presentation hook; this state does not assign dialog or authentication ownership." },
    { "name": "modalCloseHover", "selectors": [".coming-soon__modal-close:hover"], "description": "Dialog-dismiss hover presentation." }
  ],
  "behavior": [
    {
      "name": "formComposition",
      "selectors": [".coming-soon__form", ".coming-soon__input", ".coming-soon__submit"],
      "events": ["submit"],
      "description": "Every value-entry form composes canonical Input and Button anatomy. Input wrappers preserve default, error, success, warning, hover, focus-visible, disabled, label, message, aria-invalid, and aria-describedby obligations; submission and response handling remain target-owned."
    },
    {
      "name": "passwordAccessBoundary",
      "selectors": [".coming-soon__password-link", ".coming-soon__modal", ".coming-soon__modal-close"],
      "attributes": ["aria-expanded", "aria-controls"],
      "events": ["click", "Escape"],
      "description": "The selectors provide presentation hooks only. A consuming target or dialog dependency owns authentication, visibility, focus trapping, dismissal, backdrop behavior, and focus restoration."
    },
    {
      "name": "backgroundMedia",
      "selectors": [".coming-soon__bg"],
      "attributes": ["alt"],
      "description": "Background media is decorative or has useful alternative text according to the target content."
    }
  ],
  "properties": [
    {
      "name": "backgroundMedia",
      "type": "slot",
      "required": false,
      "description": "Optional target-owned full-page media; essential information remains textual.",
      "targetMappings": { "web": [{ "kind": "slot", "selector": ".coming-soon__bg", "classNames": [".coming-soon__bg"] }] }
    },
    {
      "name": "brand",
      "type": "slot",
      "required": false,
      "description": "Optional logo or store-name composition.",
      "targetMappings": { "web": [{ "kind": "slot", "selector": ".coming-soon__logo-bar", "classNames": [".coming-soon__logo-bar", ".coming-soon__logo-inline", ".coming-soon__logo", ".coming-soon__store-name"] }] }
    },
    {
      "name": "heading",
      "type": "string",
      "required": true,
      "description": "Page-level coming-soon heading.",
      "targetMappings": { "web": [{ "kind": "content", "selector": ".coming-soon__heading" }] }
    },
    {
      "name": "subtitle",
      "type": "string",
      "required": false,
      "description": "Optional editorial subtitle.",
      "targetMappings": { "web": [{ "kind": "content", "selector": ".coming-soon__subtitle" }] }
    },
    {
      "name": "body",
      "type": "slot",
      "required": false,
      "description": "Optional supporting editorial content.",
      "targetMappings": { "web": [{ "kind": "slot", "selector": ".coming-soon__body", "classNames": [".coming-soon__body"] }] }
    },
    {
      "name": "socialLinks",
      "type": "slot",
      "required": false,
      "description": "Optional target-owned social destinations.",
      "targetMappings": { "web": [{ "kind": "slot", "selector": ".coming-soon__social", "classNames": [".coming-soon__social", ".coming-soon__social-link"] }] }
    },
    {
      "name": "formHeading",
      "type": "string",
      "required": false,
      "description": "Optional heading for the form region.",
      "targetMappings": { "web": [{ "kind": "content", "selector": ".coming-soon__form-header" }] }
    },
    {
      "name": "formDescription",
      "type": "string",
      "required": false,
      "description": "Optional guidance for the form region.",
      "targetMappings": { "web": [{ "kind": "content", "selector": ".coming-soon__form-subtext" }] }
    },
    {
      "name": "form",
      "type": "slot",
      "required": false,
      "description": "Target-owned native form composed from canonical Input and Button anatomy; this contract does not choose the backend or response lifecycle.",
      "targetMappings": { "web": [{ "kind": "slot", "selector": ".coming-soon__newsletter", "classNames": [".coming-soon__newsletter", ".coming-soon__form", ".coming-soon__input", ".coming-soon__submit", ".coming-soon__success", ".coming-soon__error"] }] }
    },
    {
      "name": "passwordTriggerLabel",
      "type": "string",
      "required": false,
      "description": "Optional visible label for a target-owned password-access trigger.",
      "targetMappings": { "web": [{ "kind": "content", "selector": ".coming-soon__password-link" }] }
    },
    {
      "name": "passwordEntry",
      "type": "slot",
      "required": false,
      "description": "Optional target-owned password-access content; this slot does not define authentication or dialog behavior.",
      "targetMappings": { "web": [{ "kind": "slot", "selector": ".coming-soon__modal", "classNames": [".coming-soon__modal", ".coming-soon__modal-backdrop", ".coming-soon__modal-panel", ".coming-soon__modal-close", ".coming-soon__modal-title"] }] }
    },
    {
      "name": "footer",
      "type": "slot",
      "required": false,
      "description": "Optional footer metadata or legal content.",
      "targetMappings": { "web": [{ "kind": "slot", "selector": ".coming-soon__footer", "classNames": [".coming-soon__footer"] }] }
    }
  ],
  "tokens": {
    "public": {
      "color": ["--color-surface-primary", "--color-text-primary", "--color-text-secondary", "--color-border-default", "--color-surface-secondary", "--color-button-primary-bg-default", "--color-button-primary-text-default", "--color-button-primary-bg-hover", "--color-feedback-error-default"],
      "spacing": ["--space-layout-touch-target"],
      "radius": ["--radius-sm", "--radius-md"],
      "transition": ["--transition-fast", "--transition-base"],
      "easing": ["--easing-default", "--easing-out"],
      "typography": ["--typo-display-size", "--typo-h3-size", "--typo-h4-size", "--typo-body-size", "--typo-body-sm-size", "--typo-caption-size"]
    }
  },
  "accessibility": [
    "Use a single page-level heading and preserve editorial reading order when the layout stacks.",
    "Compose every value-entry field from canonical Input anatomy with a visible label and associated message; preserve default, error, success, and warning validation, and reserve aria-invalid for error.",
    "Use native submit controls and leave submission, pending, success, error, and retry ownership to the consuming target.",
    "When password access is supplied, its target or dialog dependency provides a labelled surface, focus management, Escape dismissal, and focus restoration without this contract assuming authentication ownership.",
    "Do not rely on background imagery for essential text."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/coming-soon.css." },
    "shopify": { "status": "planned", "kind": "liquid-css-js", "notes": "Password-page content and target-owned form/authentication behavior require independent adapter mapping." },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
