{
  "sections": {
    "main": {
      "type": "main-journal-article",
      "settings": {
        "hero_variant": "split",
        "show_image": true,
        "show_date": true,
        "show_author_in_hero": false,
        "drop_cap": true,
        "show_author_card": false
      }
    },
    "related": {
      "type": "related-articles",
      "settings": {
        "heading_level": "2",
        "card_variant": "editorial",
        "card_surface": "flat",
        "show_image": true,
        "show_date": true,
        "show_excerpt": false,
        "excerpt_lines": "none",
        "show_author": false
      }
    },
    "comments": {
      "type": "comments",
      "settings": {
        "heading_level": "2",
        "comments_per_page": 10,
        "show_composer": true
      }
    }
  },
  "order": ["main", "related", "comments"]
}
