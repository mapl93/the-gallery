<section class="collection-grid section-spacing container">
  <div class="collection-grid__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="collection-grid__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <p class="collection-grid__description">{{ section.settings.description }}</p>
    {%- endif -%}
  </div>

  <div class="collection-grid__products">
    {%- assign target_collection = section.settings.collection -%}
    {%- assign product_limit = section.settings.products_to_show | default: 4 -%}

    {%- if target_collection != blank -%}
      {%- for product in target_collection.products limit: product_limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..product_limit) -%}
        <div class="product-card">
          <div class="product-card__image-wrapper">
            {{ 'product-1' | placeholder_svg_tag: 'product-card__image' }}
          </div>
          <div class="product-card__content">
            <span class="product-card__collection">Collection</span>
            <h3 class="product-card__title">Product title</h3>
            <span class="product-card__price">{{ 4999 | money }}</span>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.show_view_all and target_collection != blank -%}
    <div class="collection-grid__cta">
      {%- assign view_all_label = 'collections.view_all' | t -%}
      {% render 'button', label: view_all_label, variant: 'outline', url: target_collection.url %}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "class": "section-collection-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured pieces"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Collection Grid"
    }
  ]
}
{% endschema %}
