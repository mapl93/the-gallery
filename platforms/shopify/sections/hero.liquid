<section class="hero">
  <div class="hero__media">
    {%- if section.settings.video -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true,
         muted: true, playsinline: true }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1920 | image_tag:
         alt: section.settings.heading, loading: 'eager',
         widths: '768,1024,1440,1920', sizes: '100vw',
         fetchpriority: 'high' }}
    {%- endif -%}
  </div>
  <div class="hero__overlay"></div>
  <div class="hero__content">
    {%- if section.settings.label != blank -%}
      <p class="hero__label">{{ section.settings.label }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="hero__description">{{ section.settings.description }}</p>
    {%- endif -%}

    <div class="hero__actions">
      {%- if section.settings.cta_url != blank -%}
        <a href="{{ section.settings.cta_url }}" class="btn btn--primary btn--lg">
          {{ section.settings.cta_text | default: 'Shop Now' }}
        </a>
      {%- endif -%}
      {%- if section.settings.cta2_url != blank -%}
        <a href="{{ section.settings.cta2_url }}" class="btn btn--outline btn--lg"
           style="--_btn-text: var(--color-text-inverse); --_btn-border: var(--color-text-inverse);">
          {{ section.settings.cta2_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "video", "id": "video", "label": "Background video" },
    { "type": "text", "id": "label", "label": "Label" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Art in every detail"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Handcrafted ceramics that honor the dialogue between maker, material, and fire."
    },
    { "type": "text", "id": "cta_text", "label": "Primary CTA text", "default": "Shop Now" },
    { "type": "url", "id": "cta_url", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary CTA text" },
    { "type": "url", "id": "cta2_url", "label": "Secondary CTA link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
