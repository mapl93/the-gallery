{% doc %}
  Renders a passive certificate record from current product facts. A real
  signature or verification destination must be supplied explicitly by the
  calling target; this snippet never generates or guarantees either one.

  @param {product} product - Product whose title, vendor, and current certificate-detail metafields are presented.
  @param {string} [label] - Optional visible record-kind label; defaults to the localized certificate label.
  @param {string} [title] - Optional visible record title; defaults to the product title.
  @param {string} [artist] - Optional artist or maker attribution; defaults to the product vendor.
  @param {string} [heading_id] - Optional target-unique title id used to name the article.
  @param {string} [signature] - Optional real target-owned signature or artist-mark text.
  @param {string} [verification_url] - Optional real target-owned certificate-record destination.
  @param {image} [verification_image] - Optional target-owned QR or verification image shown inside the descriptive link.
  @param {string} [verification_label] - Optional descriptive verification link text.

  @example
  {% render 'certificate-of-authenticity', product: product, verification_url: certificate.url %}
{% enddoc %}

{%- liquid
  assign certificate_label = label
  if certificate_label == blank
    assign certificate_label = 'certificate.label' | t
  endif

  assign certificate_title = title | default: product.title
  assign certificate_artist = artist | default: product.vendor
  assign certificate_heading_id = heading_id
  if certificate_heading_id == blank
    capture certificate_heading_id
      echo 'certificate-title-' | append: product.id
    endcapture
  endif

  assign medium = product.metafields.custom.medium.value
  assign dimensions = product.metafields.custom.dimensions.value
  assign year = product.metafields.custom.year.value
  assign edition = product.metafields.custom.edition.value
  assign glaze = product.metafields.custom.glaze_type.value
  assign firing = product.metafields.custom.firing_temperature.value

  assign has_details = false
  if medium != blank or dimensions != blank or year != blank or edition != blank or glaze != blank or firing != blank
    assign has_details = true
  endif

  assign has_lower_content = false
  if has_details or signature != blank or verification_url != blank
    assign has_lower_content = true
  endif

  assign resolved_verification_label = verification_label
  if resolved_verification_label == blank
    assign resolved_verification_label = 'certificate.verify_record' | t
  endif
-%}

<article class="coa" aria-labelledby="{{ certificate_heading_id | escape }}">
  {% if certificate_label != blank %}
    <p class="coa__header">{{ certificate_label | escape }}</p>
  {% endif %}

  <h2 class="coa__title" id="{{ certificate_heading_id | escape }}">{{ certificate_title | escape }}</h2>

  {% if certificate_artist != blank %}
    <p class="coa__artist">{{ certificate_artist | escape }}</p>
  {% endif %}

  {% if has_lower_content %}
    <div class="coa__divider" aria-hidden="true"></div>
  {% endif %}

  {% if has_details %}
    <dl class="coa__details">
      {% if medium != blank %}
        <div class="coa__detail">
          <dt class="coa__detail-label">{{ 'certificate.details.medium' | t }}</dt>
          <dd class="coa__detail-value">{{ medium | escape }}</dd>
        </div>
      {% endif %}
      {% if dimensions != blank %}
        <div class="coa__detail">
          <dt class="coa__detail-label">{{ 'certificate.details.dimensions' | t }}</dt>
          <dd class="coa__detail-value">{{ dimensions | escape }}</dd>
        </div>
      {% endif %}
      {% if year != blank %}
        <div class="coa__detail">
          <dt class="coa__detail-label">{{ 'certificate.details.year' | t }}</dt>
          <dd class="coa__detail-value">{{ year | escape }}</dd>
        </div>
      {% endif %}
      {% if edition != blank %}
        <div class="coa__detail">
          <dt class="coa__detail-label">{{ 'certificate.details.edition' | t }}</dt>
          <dd class="coa__detail-value">{{ edition | escape }}</dd>
        </div>
      {% endif %}
      {% if glaze != blank %}
        <div class="coa__detail">
          <dt class="coa__detail-label">{{ 'certificate.details.glaze' | t }}</dt>
          <dd class="coa__detail-value">{{ glaze | escape }}</dd>
        </div>
      {% endif %}
      {% if firing != blank %}
        <div class="coa__detail">
          <dt class="coa__detail-label">{{ 'certificate.details.firing' | t }}</dt>
          <dd class="coa__detail-value">{{ firing | escape }}</dd>
        </div>
      {% endif %}
    </dl>
  {% endif %}

  {% if signature != blank %}
    <p class="coa__signature">{{ signature | escape }}</p>
  {% endif %}

  {% if verification_url != blank %}
    <a class="coa__verification" href="{{ verification_url | escape }}">
      {% if verification_image != blank %}
        <span class="coa__qr" aria-hidden="true">
          {{ verification_image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', widths: '80, 160', sizes: '80px' }}
        </span>
      {% endif %}
      <span class="coa__verify">{{ resolved_verification_label | escape }}</span>
    </a>
  {% endif %}
</article>
