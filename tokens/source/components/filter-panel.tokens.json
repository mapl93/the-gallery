{
  "$description": "Filter Panel visual roles around canonical Drawer and form controls. The adjacent width is independent of Drawer width; spacing factors retain the shared system base.",
  "component": {
    "filter-panel": {
      "panelWidth": {
        "$type": "dimension",
        "$value": "15rem"
      },
      "panelBorderWidth": {
        "$type": "dimension",
        "$value": "{dimension.1}"
      },
      "groupBorderWidth": {
        "$type": "dimension",
        "$value": "{dimension.1}"
      },
      "rootGapScale": {
        "$type": "number",
        "$value": 1
      },
      "paddingScale": {
        "$type": "number",
        "$value": 1
      },
      "activeGapScale": {
        "$type": "number",
        "$value": 0.5
      },
      "groupPaddingScale": {
        "$type": "number",
        "$value": 1
      },
      "titleGapScale": {
        "$type": "number",
        "$value": 0.75
      },
      "optionsGapScale": {
        "$type": "number",
        "$value": 0.5
      },
      "priceGapScale": {
        "$type": "number",
        "$value": 0.5
      },
      "titleWeight": {
        "$type": "fontWeight",
        "$value": "{font.weight.semibold}"
      },
      "footerGap": {
        "$type": "dimension",
        "$value": "{dimension.0}"
      }
    }
  }
}
