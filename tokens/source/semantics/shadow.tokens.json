{
  "$description": "Semantic elevation values. Theme modes may override shadow color.",
  "shadow": {
    "sm": {
      "x": { "$type": "dimension", "$value": "0px" },
      "y": { "$type": "dimension", "$value": "1px" },
      "blur": { "$type": "dimension", "$value": "2px" },
      "spread": { "$type": "dimension", "$value": "0px" },
      "color": { "$type": "color", "$value": "rgba(23, 23, 23, 0.05)" }
    },
    "md": {
      "x": { "$type": "dimension", "$value": "0px" },
      "y": { "$type": "dimension", "$value": "4px" },
      "blur": { "$type": "dimension", "$value": "6px" },
      "spread": { "$type": "dimension", "$value": "-1px" },
      "color": { "$type": "color", "$value": "rgba(23, 23, 23, 0.10)" }
    },
    "lg": {
      "x": { "$type": "dimension", "$value": "0px" },
      "y": { "$type": "dimension", "$value": "10px" },
      "blur": { "$type": "dimension", "$value": "15px" },
      "spread": { "$type": "dimension", "$value": "-3px" },
      "color": { "$type": "color", "$value": "rgba(23, 23, 23, 0.10)" }
    },
    "xl": {
      "x": { "$type": "dimension", "$value": "0px" },
      "y": { "$type": "dimension", "$value": "20px" },
      "blur": { "$type": "dimension", "$value": "25px" },
      "spread": { "$type": "dimension", "$value": "-5px" },
      "color": { "$type": "color", "$value": "rgba(23, 23, 23, 0.10)" }
    },
    "2xl": {
      "x": { "$type": "dimension", "$value": "0px" },
      "y": { "$type": "dimension", "$value": "25px" },
      "blur": { "$type": "dimension", "$value": "50px" },
      "spread": { "$type": "dimension", "$value": "-12px" },
      "color": { "$type": "color", "$value": "rgba(23, 23, 23, 0.25)" }
    }
  }
}
