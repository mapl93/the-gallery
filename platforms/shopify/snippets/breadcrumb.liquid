{%- comment -%}
  Snippet: breadcrumb
  Usage: {% render 'breadcrumb', product: product, collection: collection %}
{%- endcomment -%}

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol class="breadcrumb__list">
    <li class="breadcrumb__item">
      <a class="breadcrumb__link" href="{{ routes.root_url }}">Home</a>
      <span class="breadcrumb__separator" aria-hidden="true">/</span>
    </li>
    {%- if collection -%}
      <li class="breadcrumb__item">
        <a class="breadcrumb__link" href="{{ collection.url }}">{{ collection.title | escape }}</a>
        <span class="breadcrumb__separator" aria-hidden="true">/</span>
      </li>
    {%- endif -%}
    {%- if product -%}
      <li class="breadcrumb__item">
        <span class="breadcrumb__current" aria-current="page">{{ product.title | escape }}</span>
      </li>
    {%- endif -%}
  </ol>
</nav>
