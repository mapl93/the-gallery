{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.1.0",
  "slug": "artist-index",
  "name": "Artist Index Grid",
  "registryId": "F6",
  "category": "storytelling",
  "status": "pilot",
  "summary": "Artist index with optional target-owned filters and artist results.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/artist-index",
    "css": { "file": "components/css/storytelling.css", "selector": ".artist-index" },
    "docs": "site/src/content/components/artist-index.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".artist-index", "className": ".artist-index", "required": true, "description": "Artist index section." },
    { "name": "header", "selector": ".artist-index__header", "className": ".artist-index__header", "required": true, "description": "Index heading region." },
    { "name": "heading", "selector": ".artist-index__heading", "className": ".artist-index__heading", "required": true, "description": "Artist index heading." },
    { "name": "intro", "selector": ".artist-index__intro", "className": ".artist-index__intro", "required": false, "description": "Optional index introduction." },
    { "name": "filters", "selector": ".artist-index__filters", "className": ".artist-index__filters", "required": false, "description": "Optional target-owned filter composition." },
    { "name": "filterControl", "selector": ".artist-index__filter-btn", "className": ".artist-index__filter-btn", "required": false, "description": "Repeated filter control styling hook; the target owns its selection semantics." },
    { "name": "grid", "selector": ".artist-index__grid", "className": ".artist-index__grid", "required": true, "description": "Artist result composition grid." }
  ],
  "variants": [{ "name": "default", "className": null, "default": true, "description": "Default responsive artist index." }],
  "sizes": [{ "name": "default", "className": null, "default": true, "description": "Auto-filling contained artist grid." }],
  "states": [
    { "name": "default", "selectors": [".artist-index"], "description": "Default artist index state." },
    { "name": "filterHover", "selectors": [".artist-index__filter-btn:hover"], "description": "Filter control hover state." },
    { "name": "filterFocus", "selectors": [".artist-index__filter-btn:focus-visible"], "description": "Visible filter control keyboard focus." },
    { "name": "filterSelected", "selectors": [".artist-index__filter-btn[aria-pressed=\"true\"]", ".artist-index__filter-btn.is-active"], "description": "Neutral primary selected-control styling hook; the target selects the appropriate semantic state mechanism." }
  ],
  "behavior": [
    { "name": "filteringBoundary", "selectors": [".artist-index__filters", ".artist-index__grid"], "description": "The target owns single versus multiple selection, filter semantics, result synchronization, empty results, and announcements. This contract supplies composition and visual-state hooks only." }
  ],
  "properties": [
    { "name": "title", "type": "string", "required": true, "description": "Artist index heading.", "targetMappings": { "web": [{ "kind": "content", "selector": ".artist-index__heading" }] } },
    { "name": "introduction", "type": "string", "required": false, "description": "Optional index introduction.", "targetMappings": { "web": [{ "kind": "content", "selector": ".artist-index__intro" }] } },
    { "name": "filters", "type": "slot", "required": false, "description": "Target-owned filter controls and semantics.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".artist-index__filters", "classNames": [".artist-index__filters", ".artist-index__filter-btn"] }] } },
    { "name": "results", "type": "slot", "required": true, "description": "Target-owned artist result items.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".artist-index__grid", "classNames": [".artist-index__grid"] }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-border-default", "--color-border-focus", "--color-border-subtle", "--color-button-primary-bg-default", "--color-button-primary-border-default", "--color-button-primary-text-default", "--color-text-primary", "--color-text-secondary"],
      "motion": ["--motion-transition-micro"],
      "typography": ["--font-family-heading", "--typo-body-size", "--typo-body-sm-size", "--typo-h2-size"],
      "radius": ["--radius-full"],
      "spacing": ["--section-spacing-y", "--space-layout-container", "--space-layout-element-gap", "--space-layout-grid-gap", "--space-layout-section-gap", "--space-layout-touch-target"]
    }
  },
  "accessibility": [
    "Use a heading level appropriate to the surrounding page for the index title.",
    "Choose control roles and selected-state attributes that match the target's decided filter selection model.",
    "Keep filter controls keyboard operable with visible focus and touch-sized targets.",
    "When filtering changes results without navigation, announce meaningful result changes and manage empty results in the target adapter."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/storytelling.css." },
    "shopify": { "status": "planned", "kind": "liquid-css-js" },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
