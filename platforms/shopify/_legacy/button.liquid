{%- comment -%}
  Snippet: button
  Usage: {% render 'button', label: 'Add to cart', variant: 'primary', url: '#', type: 'link' %}
  Params:
    label    – button text (required)
    variant  – primary | secondary | outline | link | danger (default: primary)
    url      – if set, renders as <a>; otherwise <button>
    type     – 'link' or 'button' (default: button)
    disabled – true/false
    icon     – svg name (optional)
    class    – additional CSS classes
{%- endcomment -%}

{%- assign btn_variant = variant | default: 'primary' -%}
{%- assign btn_class = 'btn btn--' | append: btn_variant -%}
{%- if class != blank -%}
  {%- assign btn_class = btn_class | append: ' ' | append: class -%}
{%- endif -%}

{%- if url != blank -%}
  <a href="{{ url }}" class="{{ btn_class }}"
    {%- if disabled %} aria-disabled="true" tabindex="-1"{% endif -%}>
    {%- if icon != blank -%}
      {% render 'icon', name: icon %}
    {%- endif -%}
    {{ label }}
  </a>
{%- else -%}
  <button type="{{ type | default: 'button' }}" class="{{ btn_class }}"
    {%- if disabled %} disabled aria-disabled="true"{% endif -%}>
    {%- if icon != blank -%}
      {% render 'icon', name: icon %}
    {%- endif -%}
    {{ label }}
  </button>
{%- endif -%}
