{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "file-upload",
  "name": "File Upload / Dropzone",
  "registryId": "H6",
  "category": "forms",
  "status": "pilot",
  "summary": "Native file input dropzone with hover and dragover states, icon/text/hint anatomy, preview thumbnails, accepted-file guidance, and upload interaction behavior.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/file-upload",
    "css": {
      "file": "components/css/forms.css",
      "selector": ".file-upload"
    },
    "docs": "site/src/content/components/file-upload.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".file-upload",
      "className": ".file-upload",
      "required": true,
      "description": "Dropzone surface and file input positioning context."
    },
    {
      "name": "input",
      "selector": ".file-upload__input",
      "className": ".file-upload__input",
      "required": true,
      "description": "Native file input covering the dropzone."
    },
    {
      "name": "icon",
      "selector": ".file-upload__icon",
      "className": ".file-upload__icon",
      "required": false,
      "description": "Optional upload icon."
    },
    {
      "name": "text",
      "selector": ".file-upload__text",
      "className": ".file-upload__text",
      "required": true,
      "description": "Primary upload instruction."
    },
    {
      "name": "hint",
      "selector": ".file-upload__hint",
      "className": ".file-upload__hint",
      "required": false,
      "description": "Accepted format, size, or helper text."
    },
    {
      "name": "preview",
      "selector": ".file-upload__preview",
      "className": ".file-upload__preview",
      "required": false,
      "description": "Preview list for selected files."
    },
    {
      "name": "thumb",
      "selector": ".file-upload__thumb",
      "className": ".file-upload__thumb",
      "required": false,
      "description": "Preview thumbnail for an uploaded or selected file."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default upload dropzone."
    },
    { "name": "error", "className": ".file-upload--error", "default": false, "description": "Rejected or invalid file selection presentation." },
    { "name": "success", "className": ".file-upload--success", "default": false, "description": "Accepted file selection presentation." },
    { "name": "warning", "className": ".file-upload--warning", "default": false, "description": "File selection that needs attention before submission." }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default dropzone and preview size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [".file-upload"],
      "description": "Default upload dropzone state."
    },
    {
      "name": "hover",
      "selectors": [".file-upload:hover"],
      "description": "Pointer hover state."
    },
    {
      "name": "dragover",
      "selectors": [".file-upload--dragover"],
      "description": "Active drag-over state."
    }
  ],
  "behavior": [
    {
      "name": "nativeFileInput",
      "attributes": ["type=\"file\"", "accept", "multiple", "disabled", "capture"],
      "description": "The control should preserve native file input behavior and accepted file constraints."
    },
    {
      "name": "dropzone",
      "selectors": [".file-upload--dragover"],
      "events": ["dragenter", "dragover", "dragleave", "drop"],
      "description": "Targets that support drag and drop should synchronize drag-over state and process dropped files through the same validation path."
    },
    {
      "name": "preview",
      "selectors": [".file-upload__preview", ".file-upload__thumb"],
      "description": "Selected file previews should reflect the current file list and include useful names or alt text where media is shown."
    }
  ],
  "properties": [
    { "name": "variant", "type": "enum", "required": false, "valuesFrom": "variants", "description": "Validation presentation for the selected files.", "targetMappings": { "web": [{ "kind": "optionClass", "selector": ".file-upload", "source": "variants" }] } },
    { "name": "accept", "type": "string", "required": false, "description": "Native accepted file type expression.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".file-upload__input", "attribute": "accept", "valueFrom": "property", "elements": ["input"] }] } },
    { "name": "multiple", "type": "boolean", "required": false, "defaultValue": false, "description": "Allows more than one native file selection.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".file-upload__input", "attribute": "multiple", "values": { "true": "", "false": null }, "elements": ["input"] }] } },
    { "name": "disabled", "type": "boolean", "required": false, "defaultValue": false, "description": "Makes the native file input unavailable.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".file-upload__input", "attribute": "disabled", "values": { "true": "", "false": null }, "elements": ["input"] }] } },
    { "name": "describedBy", "type": "string", "required": false, "description": "Id reference for accepted-file guidance or validation feedback.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".file-upload__input", "attribute": "aria-describedby", "valueFrom": "property", "elements": ["input"] }] } }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-border-default",
        "--color-surface-primary",
        "--color-button-primary-bg-default",
        "--color-surface-secondary",
        "--color-text-disabled",
        "--color-text-primary",
        "--color-border-subtle",
        "--color-input-default-focused-outer-border",
        "--color-input-error-unfocused-inner-border",
        "--color-input-error-unfocused-label",
        "--color-input-error-unfocused-message",
        "--color-input-error-focused-outer-border",
        "--color-input-success-unfocused-inner-border",
        "--color-input-success-unfocused-label",
        "--color-input-success-unfocused-message",
        "--color-input-success-focused-outer-border",
        "--color-input-warning-unfocused-inner-border",
        "--color-input-warning-unfocused-label",
        "--color-input-warning-unfocused-message",
        "--color-input-warning-focused-outer-border"
      ],
      "radius": [
        "--radius-lg",
        "--radius-sm"
      ],
      "transition": [
        "--transition-fast"
      ],
      "easing": [
        "--easing-default"
      ],
      "typography": [
        "--typo-body-size"
      ]
    }
  },
  "accessibility": [
    "Use a native file input and visible upload instructions.",
    "Expose accepted file types and size limits in visible helper text.",
    "Ensure drag-and-drop is an enhancement, not the only upload path.",
    "Announce validation errors and selected file names to assistive technology.",
    "Provide useful alt text or file names for image previews."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented by class composition in components/css/forms.css; file validation, preview generation, and drag events must be provided by the consuming target."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "style"
    },
    "compose": {
      "status": "planned",
      "kind": "composable"
    }
  }
}
