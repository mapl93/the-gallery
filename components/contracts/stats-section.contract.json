{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "stats-section",
  "name": "Stats Counter",
  "registryId": "S11",
  "category": "sections",
  "status": "pilot",
  "summary": "Responsive metric-section shell with target-formatted repeated values and no assumed count-up runtime.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/stats-section",
    "css": {
      "file": "components/css/sections.css",
      "selector": ".stats-section"
    },
    "docs": "site/src/content/components/stats-section.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".stats-section",
      "className": ".stats-section",
      "required": true,
      "description": "Stats section root."
    },
    {
      "name": "title",
      "selector": ".stats-section__title",
      "className": ".stats-section__title",
      "required": false,
      "description": "Optional section heading."
    },
    {
      "name": "grid",
      "selector": ".stats-section__grid",
      "className": ".stats-section__grid",
      "required": true,
      "description": "Responsive repeated-metric composition region."
    },
    {
      "name": "item",
      "selector": ".stats-section__item",
      "className": ".stats-section__item",
      "required": false,
      "description": "Repeated target-owned metric item."
    },
    {
      "name": "number",
      "selector": ".stats-section__number",
      "className": ".stats-section__number",
      "required": false,
      "description": "Target-formatted metric value."
    },
    {
      "name": "label",
      "selector": ".stats-section__label",
      "className": ".stats-section__label",
      "required": false,
      "description": "Visible metric label."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default variant."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".stats-section"
      ],
      "description": "Resting stats presentation; the data-animate selector is a presentation hook rather than a complete state model."
    }
  ],
  "behavior": [
    {
      "name": "metricOwnership",
      "selectors": [
        ".stats-section__grid"
      ],
      "description": "The target supplies, formats, orders, and updates metric values and labels. Repeated metrics remain target-owned records."
    },
    {
      "name": "countUpBoundary",
      "selectors": [
        ".stats-section__number[data-animate]"
      ],
      "attributes": [
        "data-animate"
      ],
      "description": "Canonical CSS recognizes an existing transition hook, but this contract does not define count-up calculation, observation timing, announcements, or a public animation property."
    }
  ],
  "properties": [
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "Optional visible section heading.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".stats-section__title" }]
      }
    },
    {
      "name": "metrics",
      "type": "slot",
      "required": true,
      "description": "Ordered target-owned metric item compositions.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".stats-section__grid", "classNames": [".stats-section__grid"] }]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-text-primary",
        "--color-text-secondary"
      ],
      "easing": [
        "--easing-default"
      ],
      "typography": [
        "--font-family-heading",
        "--typo-body-size",
        "--typo-h1-size",
        "--typo-h2-size"
      ],
      "spacing": [
        "--space-layout-container",
        "--space-layout-section-gap"
      ]
    }
  },
  "accessibility": [
    "Pair every metric value with a visible label and preserve meaningful reading order across responsive columns.",
    "Use locale-appropriate target formatting and do not place important meaning only in punctuation, color, or generated animation.",
    "If values update after render, the target decides whether and how to announce the change without producing repetitive live-region output.",
    "Reduced motion removes the existing transition hook."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented in components/css/sections.css."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "native-component"
    },
    "compose": {
      "status": "planned",
      "kind": "native-component"
    }
  }
}
