{
  "$description": "Primitive motion, opacity, and elevation-order values.",
  "duration": {
    "instant": {
      "$type": "duration",
      "$value": "0ms",
      "$description": "No elapsed time. Used for disabled motion and transition delays."
    },
    "fast": {
      "$type": "duration",
      "$value": "100ms",
      "$description": "Short primitive duration for immediate UI feedback."
    },
    "base": {
      "$type": "duration",
      "$value": "200ms",
      "$description": "Default primitive duration for ordinary UI transitions."
    },
    "slow": {
      "$type": "duration",
      "$value": "300ms",
      "$description": "Longer primitive duration for overlays and larger movement."
    },
    "slower": {
      "$type": "duration",
      "$value": "500ms",
      "$description": "Longest primitive duration for deliberate or editorial motion."
    }
  },
  "curve": {
    "linear": { "$type": "cubicBezier", "$value": [0, 0, 1, 1] },
    "in": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] },
    "out": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] },
    "inOut": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] }
  },
  "opacity": {
    "0": { "$type": "number", "$value": 0 },
    "10": { "$type": "number", "$value": 0.1 },
    "20": { "$type": "number", "$value": 0.2 },
    "40": { "$type": "number", "$value": 0.4 },
    "50": { "$type": "number", "$value": 0.5 },
    "60": { "$type": "number", "$value": 0.6 },
    "80": { "$type": "number", "$value": 0.8 },
    "100": { "$type": "number", "$value": 1 }
  },
  "zIndex": {
    "base": { "$type": "number", "$value": 0 },
    "dropdown": { "$type": "number", "$value": 1000 },
    "sticky": { "$type": "number", "$value": 1050 },
    "overlay": { "$type": "number", "$value": 1100 },
    "modal": { "$type": "number", "$value": 1200 },
    "toast": { "$type": "number", "$value": 1300 }
  }
}
