{%- comment -%}
  Snippet: quantity-selector
  Usage: {% render 'quantity-selector' %}
  Usage with cart item: {% render 'quantity-selector', item: item %}
{%- endcomment -%}

<div class="qty" data-qty>
  <button class="qty__btn" type="button" aria-label="Decrease quantity" data-qty-minus>
    {% render 'icon', name: 'minus' %}
  </button>
  <input class="qty__input" type="number"
         name="{% if item %}updates[{{ item.key }}]{% else %}quantity{% endif %}"
         value="{% if item %}{{ item.quantity }}{% else %}1{% endif %}"
         min="{% if item %}0{% else %}1{% endif %}"
         aria-label="Quantity"
         data-qty-input>
  <button class="qty__btn" type="button" aria-label="Increase quantity" data-qty-plus>
    {% render 'icon', name: 'plus' %}
  </button>
</div>
