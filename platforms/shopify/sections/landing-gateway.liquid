{%- comment -%}
  Target-owned Shopify composition based on the approved Figma landing frame.
  The section remains merchant-editable without promoting its fixture content
  into the target-agnostic component contract.
{%- endcomment -%}

<div class="landing-gateway">
  <h1 class="visually-hidden">{{ shop.name }}</h1>

  <div class="landing-gateway__eyes">
    {% render 'brand-eyes', tone: 'dark' %}
  </div>

  <nav class="landing-gateway__navigation" aria-label="{{ section.settings.navigation_label | escape }}">
    <ul class="landing-gateway__portals">
      {%- for block in section.blocks -%}
        {%- if block.settings.label != blank -%}
          <li {{ block.shopify_attributes }}>
            <a class="landing-gateway__portal-link" href="{{ block.settings.url | default: routes.root_url }}">
              {{ block.settings.label }}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </nav>

  <div class="landing-gateway__media" aria-hidden="{% if section.settings.image_alt == blank %}true{% else %}false{% endif %}">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image
        | image_url: width: 900
        | image_tag:
          widths: '239, 478, 717, 900',
          sizes: '239px',
          loading: 'eager',
          alt: section.settings.image_alt
      }}
    {%- else -%}
      <img
        src="{{ 'gallery-studio-process.jpg' | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        width="1330"
        height="2364"
        loading="eager"
      >
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Editorial gateway",
  "tag": "section",
  "class": "shopify-section--landing-gateway",
  "settings": [
    {
      "type": "text",
      "id": "navigation_label",
      "label": "Navigation label",
      "default": "Explore"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Studio image",
      "info": "Uses the reference studio image until you choose one."
    },
    { "type": "text", "id": "image_alt", "label": "Image alternative text" }
  ],
  "blocks": [
    {
      "type": "portal",
      "name": "Portal link",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial gateway",
      "blocks": [
        { "type": "portal", "settings": { "label": "Work" } },
        { "type": "portal", "settings": { "label": "Shop" } },
        { "type": "portal", "settings": { "label": "Journal" } },
        { "type": "portal", "settings": { "label": "About me" } }
      ]
    }
  ]
}
{% endschema %}
