{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "mega-menu",
  "name": "Mega Menu",
  "registryId": "C7",
  "category": "global",
  "status": "pilot",
  "summary": "Multi-column navigation menu with link columns, promo blocks, and featured collection rows.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/mega-menu",
    "css": { "file": "components/css/global.css", "selector": ".mega-menu" },
    "docs": "site/src/content/components/mega-menu.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".mega-menu", "className": ".mega-menu", "required": true, "description": "Mega menu popover container." },
    { "name": "inner", "selector": ".mega-menu__inner", "className": ".mega-menu__inner", "required": true, "description": "Responsive menu grid." },
    { "name": "column", "selector": ".mega-menu__column", "className": ".mega-menu__column", "required": false, "description": "Link column." },
    { "name": "heading", "selector": ".mega-menu__heading", "className": ".mega-menu__heading", "required": false, "description": "Column heading." },
    { "name": "link", "selector": ".mega-menu__link", "className": ".mega-menu__link", "required": false, "description": "Menu link." },
    { "name": "promo", "selector": ".mega-menu__promo", "className": ".mega-menu__promo", "required": false, "description": "Promotional media link." },
    { "name": "promoContent", "selector": ".mega-menu__promo-content", "className": ".mega-menu__promo-content", "required": false, "description": "Promotional overlay content." },
    { "name": "promoTitle", "selector": ".mega-menu__promo-title", "className": ".mega-menu__promo-title", "required": false, "description": "Promo title." },
    { "name": "promoLink", "selector": ".mega-menu__promo-link", "className": ".mega-menu__promo-link", "required": false, "description": "Promo link text." },
    { "name": "featured", "selector": ".mega-menu__featured", "className": ".mega-menu__featured", "required": false, "description": "Featured collection grid." },
    { "name": "featuredItem", "selector": ".mega-menu__featured-item", "className": ".mega-menu__featured-item", "required": false, "description": "Featured item link." },
    { "name": "featuredImage", "selector": ".mega-menu__featured-img", "className": ".mega-menu__featured-img", "required": false, "description": "Featured item image." },
    { "name": "featuredName", "selector": ".mega-menu__featured-name", "className": ".mega-menu__featured-name", "required": false, "description": "Featured item name." }
  ],
  "variants": [
    { "name": "default", "className": null, "default": true, "description": "Column-only mega menu." },
    { "name": "promo", "className": null, "default": false, "description": "Mega menu composition that includes promotional media blocks." },
    { "name": "featured", "className": null, "default": false, "description": "Mega menu composition that includes a featured item grid." }
  ],
  "sizes": [
    { "name": "default", "className": null, "default": true, "description": "Default full-width desktop menu." }
  ],
  "states": [
    { "name": "closed", "selectors": [".mega-menu"], "description": "Default hidden mega menu state." },
    { "name": "openAria", "selectors": [".mega-menu[aria-hidden=\"false\"]"], "description": "Open state controlled through aria-hidden." },
    { "name": "openClass", "selectors": [".mega-menu.is-open"], "description": "Open state controlled through class." },
    { "name": "linkHover", "selectors": [".mega-menu__link:hover"], "description": "Menu link hover state." },
    { "name": "currentPage", "selectors": [".mega-menu__link[aria-current=\"page\"]"], "description": "Current menu destination state." },
    { "name": "featuredHover", "selectors": [".mega-menu__featured-item:hover .mega-menu__featured-img"], "description": "Featured item image hover motion." }
  ],
  "behavior": [
    { "name": "openState", "selectors": [".mega-menu", ".mega-menu.is-open", ".mega-menu[aria-hidden=\"false\"]"], "attributes": ["aria-hidden"], "description": "Open state should synchronize visual visibility and accessibility state." },
    { "name": "menuNavigation", "selectors": [".mega-menu__link"], "attributes": ["href", "aria-current"], "events": ["click"], "description": "Links should navigate and expose current-page state where applicable." },
    { "name": "promoNavigation", "selectors": [".mega-menu__promo"], "attributes": ["href"], "events": ["click"], "description": "Promo blocks should be links when they navigate." },
    { "name": "featuredNavigation", "selectors": [".mega-menu__featured-item"], "attributes": ["href"], "events": ["click"], "description": "Featured items should navigate to collection or product destinations." }
  ],
  "properties": [
    { "name": "label", "type": "string", "required": true, "description": "Accessible name for the mega-menu navigation region.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".mega-menu", "attribute": "aria-label", "valueFrom": "property", "elements": ["nav"] }] } },
    { "name": "open", "type": "boolean", "required": false, "defaultValue": false, "description": "Controls visual visibility and accessible hidden state. Consumer targets still own trigger relationships, keyboard entry, dismissal, and focus restoration.", "targetMappings": { "web": [{ "kind": "class", "selector": ".mega-menu", "classNames": [".is-open"] }, { "kind": "attribute", "selector": ".mega-menu", "attribute": "aria-hidden", "values": { "true": "false", "false": "true" } }] } },
    { "name": "columns", "type": "slot", "required": false, "description": "Optional target-owned labelled navigation columns and native links.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".mega-menu__column", "classNames": [".mega-menu__column"] }] } },
    { "name": "promo", "type": "slot", "required": false, "description": "Optional promotional media link with a useful accessible name.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".mega-menu__promo", "classNames": [".mega-menu__promo"] }] } },
    { "name": "featured", "type": "slot", "required": false, "description": "Optional target-owned featured destination links and media.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".mega-menu__featured", "classNames": [".mega-menu__featured"] }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-surface-primary", "--color-border-subtle", "--color-border-focus", "--color-text-primary", "--color-text-secondary"],
      "spacing": ["--layout-content-width", "--layout-gutter", "--space-layout-touch-target"],
      "radius": ["--radius-md", "--radius-sm"],
      "shadow": ["--shadow-lg"],
      "typography": ["--font-family-heading", "--typo-body-size", "--typo-body-sm-size", "--typo-h4-size"],
      "transition": ["--transition-default", "--transition-fast"],
      "easing": ["--easing-default"]
    }
  },
  "accessibility": [
    "Expose the menu as navigation with a clear label from the triggering context.",
    "Synchronize aria-hidden with visual open state.",
    "Support keyboard entry, Escape dismissal, and focus return in the target adapter.",
    "Ensure promo and featured media links have useful accessible names."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/global.css." },
    "shopify": { "status": "planned", "kind": "liquid-css-js", "notes": "Should map nested navigation, promo blocks, featured blocks, and trigger state from theme settings." },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
