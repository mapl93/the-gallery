{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.1.0",
  "slug": "empty-collection",
  "name": "Empty Collection State",
  "registryId": "E7",
  "category": "collection",
  "status": "pilot",
  "summary": "Empty collection result state with icon, heading, helper text, and CTA.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/empty-collection",
    "css": { "file": "components/css/collection.css", "selector": ".empty-collection" },
    "docs": "site/src/content/components/empty-collection.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".empty-collection", "className": ".empty-collection", "required": true, "description": "Empty collection state container." },
    { "name": "icon", "selector": ".empty-collection__icon", "className": ".empty-collection__icon", "required": false, "description": "Optional empty state icon." },
    { "name": "heading", "selector": ".empty-collection__heading", "className": ".empty-collection__heading", "required": true, "description": "Empty state heading." },
    { "name": "text", "selector": ".empty-collection__text", "className": ".empty-collection__text", "required": false, "description": "Guidance copy." },
    { "name": "cta", "selector": ".empty-collection__cta", "className": ".empty-collection__cta", "required": false, "description": "Recovery action." }
  ],
  "variants": [
    { "name": "default", "className": null, "default": true, "description": "Default empty collection state." }
  ],
  "sizes": [
    { "name": "default", "className": null, "default": true, "description": "Default centered empty state spacing." }
  ],
  "states": [
    { "name": "default", "selectors": [".empty-collection"], "description": "Default empty collection state." },
    { "name": "ctaHover", "selectors": [".empty-collection__cta:hover"], "description": "CTA hover state." },
    { "name": "ctaFocus", "selectors": [".empty-collection__cta:focus-visible"], "description": "Visible recovery-action focus state." }
  ],
  "behavior": [
    { "name": "emptyResults", "selectors": [".empty-collection__heading", ".empty-collection__text"], "description": "Empty state should explain why no products are shown and how to recover." },
    { "name": "recoveryAction", "selectors": [".empty-collection__cta"], "attributes": ["href"], "events": ["click"], "description": "CTA should clear filters or navigate to a broader catalog destination." }
  ],
  "properties": [
    { "name": "icon", "type": "slot", "required": false, "description": "Optional passive empty-state illustration or icon.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".empty-collection__icon", "classNames": [".empty-collection__icon"] }] } },
    { "name": "heading", "type": "string", "required": true, "description": "Empty-state heading.", "targetMappings": { "web": [{ "kind": "content", "selector": ".empty-collection__heading" }] } },
    { "name": "text", "type": "string", "required": false, "description": "Recovery guidance.", "targetMappings": { "web": [{ "kind": "content", "selector": ".empty-collection__text" }] } },
    { "name": "ctaLabel", "type": "string", "required": false, "description": "Visible recovery action label.", "targetMappings": { "web": [{ "kind": "content", "selector": ".empty-collection__cta" }] } },
    { "name": "href", "type": "string", "required": false, "description": "Recovery destination.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".empty-collection__cta", "attribute": "href", "valueFrom": "property", "elements": ["a"] }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-text-disabled", "--color-text-primary", "--color-text-secondary", "--color-border-focus", "--color-button-primary-bg-default", "--color-button-primary-bg-hover", "--color-button-primary-text-default", "--color-button-primary-text-hover", "--color-button-primary-border-default", "--color-button-primary-border-hover"],
      "radius": ["--radius-sm"],
      "transition": ["--transition-fast"],
      "easing": ["--easing-default"],
      "typography": ["--typo-h3-size", "--typo-body-size", "--font-family-heading"]
    }
  },
  "accessibility": [
    "Make the empty state message readable without relying on the icon.",
    "Provide a clear recovery action when one is available.",
    "Do not trap focus inside the empty state."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/collection.css." },
    "shopify": { "status": "planned", "kind": "liquid-css", "notes": "Should render when a collection has no products or filters return no results." },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
