{%- comment -%}
  Snippet: empty-state
  Usage: {% render 'empty-state', icon: 'shopping-bag', title: 'Your cart is empty', message: 'Discover our pieces.', cta_text: 'Shop Now', cta_url: '/collections/all' %}
{%- endcomment -%}

<div class="empty-state">
  {% if icon %}
    <div class="empty-state__icon" aria-hidden="true">
      {% render 'icon', name: icon %}
    </div>
  {% endif %}
  <h3 class="empty-state__title">{{ title }}</h3>
  {% if message %}
    <p class="empty-state__message">{{ message }}</p>
  {% endif %}
  {% if cta_text and cta_url %}
    <a href="{{ cta_url }}" class="btn btn--outline">{{ cta_text }}</a>
  {% endif %}
</div>
