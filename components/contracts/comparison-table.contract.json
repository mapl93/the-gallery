  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".comparison-table"
      ],
      "description": "Resting scrollable table presentation; highlighted cells and indicators are content options rather than states."
    },
    {
      "name": "overflowFocusVisible",
      "selectors": [
        ".comparison-table:focus-visible"
      ],
      "description": "Visible keyboard focus when the target makes an overflowing table region focusable."
    }
  ],
  "behavior": [
    {
      "name": "tableSemantics",
      "selectors": [
        ".comparison-table"
      ],
      "description": "Targets provide native table structure, a caption or equivalent accessible name, correctly scoped headers, and meaningful text for visual indicators."
