{
  "$description": "Pagination public visual values. Owner selected an 18px directional icon default for both Web and Shopify. Destination and page-window state remain target-owned.",
  "component": {
    "pagination": {
      "gap": {
        "$type": "dimension",
        "$value": "{dimension.4}"
      },
      "paddingInline": {
        "$type": "dimension",
        "$value": "{dimension.12}"
      },
      "ellipsisPadding": {
        "$type": "dimension",
        "$value": "{dimension.8}"
      },
      "iconSize": {
        "$type": "dimension",
        "$value": "{dimension.18}"
      },
      "currentWeight": {
        "$type": "fontWeight",
        "$value": "{font.weight.semibold}"
      }
    }
  }
}
