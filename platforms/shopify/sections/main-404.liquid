{%- liquid
  assign heading_id = 'Page404Heading-' | append: section.id
  assign search_id = 'Page404Search-' | append: section.id
  assign search_message_id = search_id | append: '-Message'
-%}

<section class="page-404" aria-labelledby="{{ heading_id }}">
  {%- if section.settings.show_code -%}
    <p class="page-404__code" aria-hidden="true">404</p>
  {%- endif -%}

  {% render 'empty-state',
    root_class: 'page-404__core',
    heading_tag: 'h1',
    title: 'general.404.heading' | t,
    title_id: heading_id,
    title_class: 'page-404__heading',
    message: 'general.404.title' | t,
    message_class: 'page-404__text',
    cta_text: 'general.404.link' | t,
    cta_url: routes.root_url,
    action_class: 'page-404__primary-action'
  %}

  {%- if section.settings.show_search -%}
    <form
      class="page-404__search"
      role="search"
      aria-label="{{ 'general.404.search_label' | t | escape }}"
      action="{{ routes.search_url }}"
      method="get"
    >
      <div class="input page-404__search-field">
        <label class="input__label" for="{{ search_id }}">
          {{- 'general.404.search_label' | t -}}
        </label>
        <div class="page-404__search-row">
          <div class="input__control">
            <input
              class="input__field"
              id="{{ search_id }}"
              name="q"
              type="search"
              placeholder="{{ 'general.404.search_placeholder' | t | escape }}"
              aria-describedby="{{ search_message_id }}"
              required
            >
          </div>
          <button class="btn page-404__search-action" type="submit">
            {{- 'general.404.search_submit' | t -}}
          </button>
        </div>
        <p class="input__message" id="{{ search_message_id }}">
          {{- 'general.404.search_message' | t -}}
        </p>
      </div>
    </form>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "tag": "div",
  "class": "section-404",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_code",
      "label": "t:sections.main_404.settings.show_code",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:sections.main_404.settings.show_search",
      "default": true
    }
  ]
}
{% endschema %}
