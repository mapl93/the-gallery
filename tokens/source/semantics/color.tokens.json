{
  "$description": "Default semantic color roles. Theme modes may override these paths.",
  "color": {
    "surface": {
      "primary": { "$type": "color", "$value": "{color.gray.0}" },
      "secondary": { "$type": "color", "$value": "{color.gray.100}" },
      "archival": { "$type": "color", "$value": "{color.brown.50}" },
      "statement": { "$type": "color", "$value": "{color.orange.50}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.gray.900}" },
      "secondary": { "$type": "color", "$value": "{color.gray.600}" },
      "archival": { "$type": "color", "$value": "{color.brown.600}" },
      "statement": { "$type": "color", "$value": "{color.orange.600}" },
      "inverse": { "$type": "color", "$value": "{color.gray.0}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.gray.200}" },
      "strong": { "$type": "color", "$value": "{color.gray.900}" },
      "archival": { "$type": "color", "$value": "{color.brown.300}" },
      "statement": { "$type": "color", "$value": "{color.orange.300}" }
    },
    "feedback": {
      "info": {
        "background": { "$type": "color", "$value": "{color.blue.100}" },
        "default": { "$type": "color", "$value": "{color.blue.500}" },
        "hover": { "$type": "color", "$value": "{color.blue.600}" }
      },
      "success": {
        "background": { "$type": "color", "$value": "{color.green.100}" },
        "default": { "$type": "color", "$value": "{color.green.500}" },
        "hover": { "$type": "color", "$value": "{color.green.600}" }
      },
      "warning": {
        "background": { "$type": "color", "$value": "{color.amber.100}" },
        "default": { "$type": "color", "$value": "{color.amber.500}" },
        "hover": { "$type": "color", "$value": "{color.amber.600}" }
      },
      "error": {
        "background": { "$type": "color", "$value": "{color.red.100}" },
        "default": { "$type": "color", "$value": "{color.red.500}" },
        "hover": { "$type": "color", "$value": "{color.red.600}" }
      }
    }
  }
}
