{% doc %}
  Renders one native cart-note disclosure inside a Shopify cart form.

  @param {boolean} [expanded] - Whether the disclosure is initially open.
  @param {string} [note_id] - Stable id for the native note field.
{% enddoc %}

{%- assign note_id = note_id | default: 'CartNote' -%}

<details class="cart-note"{% if expanded %} open{% endif %}>
  <summary class="cart-note__toggle">{{ 'cart.note_toggle' | t }}</summary>
  <div class="input cart-note__field">
    <label class="input__label" for="{{ note_id }}">
      {{ 'cart.note_label' | t }}
    </label>
    <div class="input__control">
      <textarea
        class="input__field textarea__field"
        id="{{ note_id }}"
        name="note"
        rows="4"
        autocomplete="off"
        placeholder="{{ 'cart.note_placeholder' | t | escape }}"
      >{{ cart.note | escape }}</textarea>
    </div>
  </div>
</details>
