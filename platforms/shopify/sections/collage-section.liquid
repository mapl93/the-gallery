{% liquid
  assign section_heading = section.settings.heading | strip
  assign heading_id = 'CollageSection-' | append: section.id | append: '-Heading'

  assign valid_item_count = 0
  for block in section.blocks
    assign image_alt = block.settings.image_alt | strip
    if image_alt == blank and block.settings.image != blank
      assign image_alt = block.settings.image.alt | strip
    endif

    assign has_image_semantics = false
    if block.settings.image_decorative or image_alt != blank
      assign has_image_semantics = true
    endif

    if block.type == 'media' and block.settings.image != blank and has_image_semantics
      assign valid_item_count = valid_item_count | plus: 1
    endif
  endfor

  assign feature_used = false
%}

{% if valid_item_count > 0 %}
  {% if section_heading != blank %}
    <section class="collage-section" aria-labelledby="{{ heading_id }}">
  {% else %}
    <div class="collage-section">
  {% endif %}
    {% if section_heading != blank %}
      <header class="collage-section__header">
        <h2 class="collage-section__heading" id="{{ heading_id }}">{{ section_heading | escape }}</h2>
      </header>
    {% endif %}

    <ul class="collage-section__grid">
      {% for block in section.blocks %}
        {% liquid
          assign image_alt = block.settings.image_alt | strip
          if image_alt == blank and block.settings.image != blank
            assign image_alt = block.settings.image.alt | strip
          endif
          if block.settings.image_decorative
            assign image_alt = ''
          endif

          assign has_image_semantics = false
          if block.settings.image_decorative or image_alt != blank
            assign has_image_semantics = true
          endif

          assign item_caption = block.settings.caption | strip
          assign item_destination = block.settings.destination
          assign item_class = 'collage-section__item'
          assign image_sizes = '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw'

          if block.type == 'media' and block.settings.image != blank and has_image_semantics and block.settings.featured and feature_used == false
            assign item_class = item_class | append: ' collage-section__item--feature'
            assign image_sizes = '(min-width: 1024px) 50vw, (min-width: 640px) 100vw, 100vw'
            assign feature_used = true
          endif
        %}

        {% if block.type == 'media' and block.settings.image != blank and has_image_semantics %}
          <li class="{{ item_class }}" {{ block.shopify_attributes }}>
            {% if item_destination != blank %}
              <a class="collage-section__link" href="{{ item_destination }}">
            {% endif %}
              <figure class="collage-section__figure">
                {{ block.settings.image | image_url: width: 2400 | image_tag:
                  alt: image_alt,
                  class: 'collage-section__media',
                  loading: 'lazy',
                  widths: '320, 480, 640, 800, 1080, 1440, 1800, 2400',
                  sizes: image_sizes
                }}

                {% if item_caption != blank %}
                  <figcaption class="collage-section__caption">{{ item_caption | escape }}</figcaption>
                {% endif %}
              </figure>
            {% if item_destination != blank %}
              </a>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  {% if section_heading != blank %}
    </section>
  {% else %}
    </div>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "t:sections.collage_section.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collage_section.settings.heading"
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "media",
      "name": "t:sections.collage_section.blocks.media.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collage_section.blocks.media.settings.image"
        },
        {
          "type": "checkbox",
          "id": "image_decorative",
          "label": "t:sections.collage_section.blocks.media.settings.image_decorative",
          "default": false
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "t:sections.collage_section.blocks.media.settings.image_alt"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.collage_section.blocks.media.settings.caption"
        },
        {
          "type": "url",
          "id": "destination",
          "label": "t:sections.collage_section.blocks.media.settings.destination"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "t:sections.collage_section.blocks.media.settings.featured",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collage_section.name",
      "blocks": [
        { "type": "media", "settings": { "featured": true } },
        { "type": "media" },
        { "type": "media" },
        { "type": "media" },
        { "type": "media" }
      ]
    }
  ]
}
{% endschema %}
