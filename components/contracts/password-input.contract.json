{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "password-input",
  "name": "Password Input",
  "registryId": "H13",
  "category": "forms",
  "status": "pilot",
  "summary": "Password input contract with an Input dependency, positioned show-hide toggle, optional strength meter, visibility behavior, and strength-state semantics.",
  "dependencies": ["input"],
  "source": {
    "registry": "registry.json#/components/password-input",
    "css": {
      "file": "components/css/forms.css",
      "selector": ".password-input"
    },
    "docs": "site/src/content/components/password-input.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".password-input",
      "className": ".password-input",
      "required": true,
      "description": "Positioning wrapper for the password field and visibility toggle."
    },
    {
      "name": "field",
      "selector": ".password-input__field",
      "className": ".password-input__field",
      "required": true,
      "description": "Native password input field styled by the Password Input root contract."
    },
    {
      "name": "toggle",
      "selector": ".password-input__toggle",
      "className": ".password-input__toggle",
      "required": true,
      "description": "Button that toggles password visibility."
    },
    {
      "name": "strength",
      "selector": ".password-strength",
      "className": ".password-strength",
      "required": false,
      "description": "Optional password strength meter wrapper."
    },
    {
      "name": "strengthBar",
      "selector": ".password-strength__bar",
      "className": ".password-strength__bar",
      "required": false,
      "description": "Single segment of the strength meter."
    },
    {
      "name": "strengthText",
      "selector": ".password-strength__text",
      "className": ".password-strength__text",
      "required": false,
      "description": "Optional text label for the current strength state."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default password input."
    },
    { "name": "error", "className": ".password-input--error", "default": false, "description": "Invalid password value presentation." },
    { "name": "success", "className": ".password-input--success", "default": false, "description": "Validated password value presentation." },
    { "name": "warning", "className": ".password-input--warning", "default": false, "description": "Password value that needs attention." }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default password input and toggle size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [".password-input"],
      "description": "Default password input state."
    },
    {
      "name": "fieldHover",
      "selectors": [".password-input__field:hover"],
      "description": "Pointer hover state that preserves the active validation family."
    },
    {
      "name": "fieldFocus",
      "selectors": [".password-input__field:focus-visible"],
      "description": "Four-pixel zero-offset focus hierarchy on the native field."
    },
    {
      "name": "fieldDisabled",
      "selectors": [".password-input__field:disabled"],
      "description": "Unavailable native field state."
    },
    {
      "name": "toggleHover",
      "selectors": [".password-input__toggle:hover"],
      "description": "Pointer hover state on the visibility toggle."
    },
    {
      "name": "strengthWeak",
      "selectors": [".password-strength--weak .password-strength__bar:nth-child(1)"],
      "description": "Weak password strength state."
    },
    {
      "name": "strengthFair",
      "selectors": [".password-strength--fair .password-strength__bar:nth-child(-n+2)"],
      "description": "Fair password strength state."
    },
    {
      "name": "strengthGood",
      "selectors": [".password-strength--good .password-strength__bar:nth-child(-n+3)"],
      "description": "Good password strength state."
    },
    {
      "name": "strengthStrong",
      "selectors": [".password-strength--strong .password-strength__bar"],
      "description": "Strong password strength state."
    }
  ],
  "behavior": [
    {
      "name": "inputDependency",
      "selectors": [".password-input__field"],
      "attributes": ["type=\"password\"", "autocomplete", "required", "disabled", "aria-describedby"],
      "description": "The field should preserve native password input behavior while consuming the Input dependency for base styling."
    },
    {
      "name": "visibilityToggle",
      "selectors": [".password-input__toggle"],
      "attributes": ["type=\"button\"", "aria-label", "aria-pressed"],
      "events": ["click", "Space", "Enter"],
      "description": "The toggle should switch between hidden and visible password text without submitting the form."
    },
    {
      "name": "strengthMeter",
      "selectors": [".password-strength", ".password-strength__bar", ".password-strength__text"],
      "attributes": ["aria-describedby", "aria-live=\"polite\""],
      "description": "Optional strength feedback should be text-backed and associated with the password field."
    }
  ],
  "properties": [
    { "name": "variant", "type": "enum", "required": false, "valuesFrom": "variants", "description": "Validation presentation for the password value.", "targetMappings": { "web": [{ "kind": "optionClass", "selector": ".password-input", "source": "variants" }] } },
    { "name": "value", "type": "string", "required": false, "defaultValue": "Gallery2026", "description": "Current native password value.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".password-input__field", "attribute": "value", "valueFrom": "property", "elements": ["input"] }] } },
    { "name": "placeholder", "type": "string", "required": false, "defaultValue": "Enter password", "description": "Hint displayed while the field is empty.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".password-input__field", "attribute": "placeholder", "valueFrom": "property", "elements": ["input"] }] } },
    { "name": "visible", "type": "boolean", "required": false, "defaultValue": false, "description": "Switches the field between concealed password text and visible plain text.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".password-input__field", "attribute": "type", "values": { "true": "text", "false": "password" }, "elements": ["input"] }, { "kind": "attribute", "selector": ".password-input__toggle", "attribute": "aria-pressed", "values": { "true": "true", "false": "false" }, "elements": ["button"] }] } },
    { "name": "strength", "type": "enum", "required": false, "values": ["weak", "fair", "good", "strong"], "defaultValue": "good", "description": "Text-backed password strength state for the optional meter.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".password-strength", "attribute": "data-strength", "values": { "weak": "weak", "fair": "fair", "good": "good", "strong": "strong" } }] } },
    { "name": "disabled", "type": "boolean", "required": false, "defaultValue": false, "description": "Makes the field and visibility toggle unavailable.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".password-input__field", "attribute": "disabled", "values": { "true": "", "false": null }, "elements": ["input"] }, { "kind": "attribute", "selector": ".password-input__toggle", "attribute": "disabled", "values": { "true": "", "false": null }, "elements": ["button"] }] } },
    { "name": "required", "type": "boolean", "required": false, "defaultValue": false, "description": "Marks the native password field as required.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".password-input__field", "attribute": "required", "values": { "true": "", "false": null }, "elements": ["input"] }] } },
    { "name": "autocomplete", "type": "string", "required": false, "defaultValue": "current-password", "description": "Native autocomplete purpose such as current-password or new-password.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".password-input__field", "attribute": "autocomplete", "valueFrom": "property", "elements": ["input"] }] } },
    { "name": "describedBy", "type": "string", "required": false, "description": "Id reference for password guidance, strength, or validation feedback.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".password-input__field", "attribute": "aria-describedby", "valueFrom": "property", "elements": ["input"] }] } }
  ],
