{% if section.settings.text != blank %}
<div class="announcement" role="region" aria-label="Announcement">
  {{ section.settings.text }}
</div>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    { "type": "richtext", "id": "text", "label": "Announcement text" }
  ]
}
{% endschema %}
