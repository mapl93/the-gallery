{% liquid
  assign process_title = section.settings.title
  if process_title == blank
    assign process_title = 'process_timeline.default_title' | t
  endif

  assign heading_id = 'ProcessTimeline-' | append: section.id | append: '-Title'
%}

<section class="process-timeline" aria-labelledby="{{ heading_id }}">
  <h2 class="process-timeline__title" id="{{ heading_id }}">{{ process_title | escape }}</h2>

  {% if section.blocks.size > 0 %}
    <ol class="process-timeline__track" role="list" tabindex="0" aria-labelledby="{{ heading_id }}">
      {% for block in section.blocks %}
        {% liquid
          assign step_title = block.settings.title
          if step_title == blank
            assign step_title = 'process_timeline.default_step_title' | t: number: forloop.index
          endif

          assign step_alt = block.settings.image.alt | default: step_title
          if block.settings.image_decorative
            assign step_alt = ''
          endif
        %}
        <li class="process-step" {{ block.shopify_attributes }}>
          <span class="process-step__number" aria-hidden="true">{{ forloop.index }}</span>

          {% if block.settings.image != blank %}
            <div class="process-step__image">
              {{ block.settings.image | image_url: width: 960 | image_tag:
                alt: step_alt,
                loading: 'lazy',
                widths: '240, 360, 480, 720, 960',
                sizes: '(min-width: 768px) 25vw, 70vw'
              }}
            </div>
          {% endif %}

          <h3 class="process-step__title">{{ step_title | escape }}</h3>

          {% if block.settings.description != blank %}
            <p class="process-step__description">{{ block.settings.description | escape }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  {% endif %}
</section>

{% schema %}
{
  "name": "t:sections.process_timeline.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.process_timeline.settings.heading"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.process_timeline.blocks.step.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.process_timeline.blocks.step.settings.image"
        },
        {
          "type": "checkbox",
          "id": "image_decorative",
          "label": "t:sections.process_timeline.blocks.step.settings.image_decorative",
          "default": false
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.process_timeline.blocks.step.settings.title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:sections.process_timeline.blocks.step.settings.description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.process_timeline.name",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
