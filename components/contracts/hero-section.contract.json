{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "hero-section",
  "name": "Hero Section",
  "registryId": "S1",
  "category": "sections",
  "status": "pilot",
  "summary": "Responsive editorial hero shell with source-backed layout variants and target-owned media, actions, and slideshow content.",
  "dependencies": [
    "button"
  ],
  "source": {
    "registry": "registry.json#/components/hero-section",
    "css": {
      "file": "components/css/sections.css",
      "selector": ".hero-section"
    },
    "docs": "site/src/content/components/hero-section.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".hero-section",
      "className": ".hero-section",
      "required": true,
      "description": "Hero section root and positioning context."
    },
    {
      "name": "media",
      "selector": ".hero-section__media",
      "className": ".hero-section__media",
      "required": false,
      "description": "Optional target-owned image, video, or slideshow media region."
    },
    {
      "name": "overlay",
      "selector": ".hero-section__overlay",
      "className": ".hero-section__overlay",
      "required": false,
      "description": "Optional visual contrast layer above media."
    },
    {
      "name": "content",
      "selector": ".hero-section__content",
      "className": ".hero-section__content",
      "required": true,
      "description": "Foreground content region."
    },
    {
      "name": "eyebrow",
      "selector": ".hero-section__eyebrow",
      "className": ".hero-section__eyebrow",
      "required": false,
      "description": "Optional short contextual label."
    },
    {
      "name": "title",
      "selector": ".hero-section__title",
      "className": ".hero-section__title",
      "required": true,
      "description": "Primary hero heading."
    },
    {
      "name": "subtitle",
      "selector": ".hero-section__subtitle",
      "className": ".hero-section__subtitle",
      "required": false,
      "description": "Optional supporting copy."
    },
    {
      "name": "actions",
      "selector": ".hero-section__actions",
      "className": ".hero-section__actions",
      "required": false,
      "description": "Optional group of Button-composed actions."
    },
    {
      "name": "slide",
      "selector": ".hero-section__slide",
      "className": ".hero-section__slide",
      "required": false,
      "description": "Optional repeated slide item used only by the slideshow presentation."
    }
  ],
  "variants": [
    {
      "name": "full",
      "className": null,
      "default": true,
      "description": "Default media-backed hero presentation."
    },
    {
      "name": "split",
      "className": ".hero-section--split",
      "default": false,
      "description": "Two-column media and content presentation that stacks on narrow viewports."
    },
    {
      "name": "text-only",
      "className": ".hero-section--text-only",
      "default": false,
      "description": "Text-only presentation without required media."
    },
    {
      "name": "parallax",
      "className": ".hero-section--parallax",
      "default": false,
      "description": "Presentation hook for target-owned parallax enhancement."
    },
    {
      "name": "slideshow",
      "className": ".hero-section--slideshow",
      "default": false,
      "description": "Horizontally snapped slide presentation without prescribed navigation behavior."
    },
    {
      "name": "fullscreen",
      "className": ".hero-section--fullscreen",
      "default": false,
      "description": "Viewport-height hero presentation."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".hero-section"
      ],
      "description": "Resting hero presentation; layout variants are options rather than interaction states."
    }
  ],
  "behavior": [
    {
      "name": "mediaSemantics",
      "selectors": [
        ".hero-section__media"
      ],
      "description": "Targets decide whether each image or video is informative or decorative and provide alternative text, native controls, captions, or hidden semantics accordingly."
    },
    {
      "name": "actionComposition",
      "selectors": [
        ".hero-section__actions"
      ],
      "description": "Actions compose Button instances and preserve Button-owned activation, focus, disabled, and busy behavior."
    },
    {
      "name": "targetOwnedMotionAndNavigation",
      "selectors": [
        ".hero-section--parallax .hero-section__media img",
        ".hero-section--slideshow .hero-section__media"
      ],
      "description": "Canonical CSS supplies parallax and scroll-snap presentation hooks only; targets own scroll synchronization, slide navigation, current-slide state, announcements, and media playback."
    }
  ],
  "properties": [
    {
      "name": "variant",
      "type": "enum",
      "required": false,
      "defaultValue": "full",
      "valuesFrom": "variants",
      "description": "Source-backed hero layout presentation.",
      "targetMappings": {
        "web": [{ "kind": "optionClass", "selector": ".hero-section", "source": "variants" }]
      }
    },
    {
      "name": "media",
      "type": "slot",
      "required": false,
      "description": "Target-owned image, video, or slideshow media content.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".hero-section__media", "classNames": [".hero-section__media"] }]
      }
    },
    {
      "name": "overlay",
      "type": "slot",
      "required": false,
      "description": "Optional contrast layer rendered when media needs foreground support.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".hero-section__overlay", "classNames": [".hero-section__overlay"] }]
      }
    },
    {
      "name": "eyebrow",
      "type": "string",
      "required": false,
      "description": "Optional short context above the heading.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".hero-section__eyebrow" }]
      }
    },
    {
      "name": "title",
      "type": "string",
      "required": true,
      "description": "Primary hero heading.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".hero-section__title" }]
      }
    },
    {
      "name": "subtitle",
      "type": "string",
      "required": false,
      "description": "Optional supporting hero copy.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".hero-section__subtitle" }]
      }
    },
    {
      "name": "actions",
      "type": "slot",
      "required": false,
      "description": "Optional group of Button-composed actions.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".hero-section__actions", "classNames": [".hero-section__actions"] }]
      }
    },
    {
      "name": "slides",
      "type": "slot",
      "required": false,
      "description": "Ordered target-owned slide content for the slideshow presentation.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".hero-section__slide", "classNames": [".hero-section__slide"] }]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-surface-primary",
        "--color-text-inverse",
        "--color-text-primary"
      ],
      "typography": [
        "--font-family-heading",
        "--typo-body-lg-size",
        "--typo-body-size",
        "--typo-h1-size"
      ],
      "spacing": [
        "--space-layout-container",
        "--space-layout-section-gap"
      ]
    }
  },
  "accessibility": [
    "Use a semantic section and a heading level appropriate to the surrounding page; do not assume every hero owns the page h1.",
    "Give informative media useful alternatives and hide decorative media; video content requires target-owned controls, captions, and transcripts as applicable.",
    "Button-composed actions retain visible focus, touch targets, accessible names, and native activation semantics.",
    "Slideshow and parallax targets must honor reduced motion and provide keyboard-operable navigation and current-slide announcements before claiming interactive behavior."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented in components/css/sections.css."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "native-component"
    },
    "compose": {
      "status": "planned",
      "kind": "native-component"
    }
  }
}
