{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "gallery-grid",
  "name": "Gallery Grid",
  "registryId": "S5",
  "category": "sections",
  "status": "pilot",
  "summary": "Responsive gallery shell with grid and masonry presentation while item activation remains target-owned.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/gallery-grid",
    "css": {
      "file": "components/css/sections.css",
      "selector": ".gallery-grid"
    },
    "docs": "site/src/content/components/gallery-grid.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".gallery-grid",
      "className": ".gallery-grid",
      "required": true,
      "description": "Gallery section root."
    },
    {
      "name": "header",
      "selector": ".gallery-grid__header",
      "className": ".gallery-grid__header",
      "required": false,
      "description": "Optional heading region."
    },
    {
      "name": "title",
      "selector": ".gallery-grid__title",
      "className": ".gallery-grid__title",
      "required": false,
      "description": "Optional gallery heading."
    },
    {
      "name": "items",
      "selector": ".gallery-grid__items",
      "className": ".gallery-grid__items",
      "required": true,
      "description": "Ordered gallery-item composition region."
    },
    {
      "name": "item",
      "selector": ".gallery-grid__item",
      "className": ".gallery-grid__item",
      "required": false,
      "description": "Repeated target-owned gallery item."
    }
  ],
  "variants": [
    {
      "name": "grid",
      "className": null,
      "default": true,
      "description": "Default responsive grid presentation."
    },
    {
      "name": "masonry",
      "className": ".gallery-grid--masonry",
      "default": false,
      "description": "Responsive CSS-column masonry presentation."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".gallery-grid"
      ],
      "description": "Resting gallery presentation."
    },
    {
      "name": "itemHover",
      "selectors": [
        ".gallery-grid__item:hover img"
      ],
      "description": "Pointer emphasis for a gallery item without implying activation."
    },
    {
      "name": "itemFocusWithin",
      "selectors": [
        ".gallery-grid__item:focus-visible",
        ".gallery-grid__item:focus-within img"
      ],
      "description": "Equivalent emphasis when target-owned interactive content receives keyboard focus."
    }
  ],
  "behavior": [
    {
      "name": "itemOwnership",
      "selectors": [
        ".gallery-grid__item"
      ],
      "description": "Gallery items may remain passive or contain target-owned native links or controls; this contract does not choose navigation, selection, or Lightbox behavior."
    }
  ],
  "properties": [
    {
      "name": "variant",
      "type": "enum",
      "required": false,
      "defaultValue": "grid",
      "valuesFrom": "variants",
      "description": "Standard grid or masonry presentation.",
      "targetMappings": {
        "web": [{ "kind": "optionClass", "selector": ".gallery-grid", "source": "variants" }]
      }
    },
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "Optional visible gallery heading.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".gallery-grid__title" }]
      }
    },
    {
      "name": "items",
      "type": "slot",
      "required": true,
      "description": "Ordered target-owned media items with target-selected semantics.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".gallery-grid__items", "classNames": [".gallery-grid__items"] }]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-border-focus",
        "--color-text-primary"
      ],
      "easing": [
        "--easing-default"
      ],
      "typography": [
        "--font-family-heading",
        "--typo-h2-size"
      ],
      "radius": [
        "--radius-sm"
      ],
      "spacing": [
        "--space-layout-container",
        "--space-layout-section-gap"
      ],
      "transition": [
        "--transition-default"
      ]
    }
  },
  "accessibility": [
    "Provide useful image alternatives or hide decorative images, and preserve source order across grid and masonry presentation.",
    "Do not add button or link semantics to passive items; interactive items use native target-owned controls with visible focus and descriptive names.",
    "Hover-only image emphasis is supplemental and has an equivalent focus-within treatment when a target adds interaction.",
    "Reduced motion removes image scaling transitions."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented in components/css/sections.css."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "native-component"
    },
    "compose": {
      "status": "planned",
      "kind": "native-component"
    }
  }
}
