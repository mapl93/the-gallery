{
  "$description": "Navigation composition tokens preserve existing native field, link and summary values. Shared overlays, providers, search results, cart operations and lifecycle remain owned by their current component or target.",
  "component": {
    "search-overlay": {
      "panelMax": {
        "$type": "dimension",
        "$value": "40rem"
      },
      "resultMedia": {
        "$type": "dimension",
        "$value": "3rem"
      },
      "scrimColor": {
        "$type": "color",
        "$value": "{color.overlay}"
      },
      "topShare": {
        "$type": "number",
        "$value": 0.08
      },
      "topMax": {
        "$type": "dimension",
        "$value": "5rem"
      },
      "panelPadding": {
        "$type": "number",
        "$value": 1
      },
      "headerGap": {
        "$type": "number",
        "$value": 1
      },
      "headerMargin": {
        "$type": "dimension",
        "$value": "{dimension.12}"
      },
      "inputPaddingBlock": {
        "$type": "dimension",
        "$value": "{dimension.12}"
      },
      "inputPaddingInline": {
        "$type": "dimension",
        "$value": "{dimension.16}"
      },
      "inputBorder": {
        "$type": "dimension",
        "$value": "{dimension.2}"
      },
      "inputFocusWidth": {
        "$type": "dimension",
        "$value": "{dimension.2}"
      },
      "inputFocusOffset": {
        "$type": "dimension",
        "$value": "{dimension.2}"
      },
      "resultsMargin": {
        "$type": "dimension",
        "$value": "{dimension.16}"
      },
      "resultGap": {
        "$type": "dimension",
        "$value": "{dimension.12}"
      },
      "resultPadding": {
        "$type": "dimension",
        "$value": "{dimension.12}"
      },
      "resultFocusWidth": {
        "$type": "dimension",
        "$value": "{dimension.2}"
      },
      "resultFocusInset": {
        "$type": "dimension",
        "$value": "{dimension.2}"
      },
      "resultTitleWeight": {
        "$type": "fontWeight",
        "$value": "{font.weight.medium}"
      }
    }
  }
}
