{% liquid
  assign section_title = section.settings.title | strip
  assign section_subtitle = section.settings.subtitle | strip
  assign heading_id = 'FaqSection-' | append: section.id | append: '-Title'
  assign valid_item_count = 0

  for block in section.blocks
    assign question = block.settings.question | strip
    assign answer_text = block.settings.answer | strip_html | strip
    if block.type == 'question' and question != blank and answer_text != blank
      assign valid_item_count = valid_item_count | plus: 1
    endif
  endfor
%}

{% if valid_item_count > 0 %}
  {% if section_title != blank %}
    <section class="faq-section" aria-labelledby="{{ heading_id }}">
  {% else %}
    <div class="faq-section">
  {% endif %}
    {% if section_title != blank or section_subtitle != blank %}
      <header class="faq-section__header">
        {% if section_title != blank %}
          <h2 class="faq-section__title" id="{{ heading_id }}">{{ section_title | escape }}</h2>
        {% endif %}
        {% if section_subtitle != blank %}
          <p class="faq-section__subtitle">{{ section_subtitle | escape }}</p>
        {% endif %}
      </header>
    {% endif %}

    <div class="accordion faq-section__list">
      {% for block in section.blocks %}
        {% liquid
          assign question = block.settings.question | strip
          assign answer_text = block.settings.answer | strip_html | strip
        %}

        {% if block.type == 'question' and question != blank and answer_text != blank %}
          <details
            class="accordion__item faq-section__item"
            {% if block.settings.open_by_default %}open{% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="accordion__trigger">
              <span>{{ question | escape }}</span>
              <svg class="accordion__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" />
              </svg>
            </summary>
            <div class="accordion__panel">
              <div class="accordion__panel-inner">
                <div class="accordion__content rte">{{ block.settings.answer }}</div>
              </div>
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  {% if section_title != blank %}
    </section>
  {% else %}
    </div>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "t:sections.faq_section.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.faq_section.settings.title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:sections.faq_section.settings.subtitle"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq_section.blocks.question.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.faq_section.blocks.question.settings.question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.faq_section.blocks.question.settings.answer"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "t:sections.faq_section.blocks.question.settings.open_by_default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq_section.name",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
