  "accessibility": [
    "Label the embedded article from the exhibition title; a full target page owns its outer main landmark and contextual page-heading level.",
    "Use visible-heading sections for works and artists. Keep untitled information as a neutral container unless the target supplies a localized accessible name.",
    "Give informative hero, work, and artist media useful alternative text; use empty alt for decorative or nearby-redundant images.",
    "Use native description-list and repeated-list markup plus machine-readable start/end dates where the target can provide structured values.",
    "Passive records add no focus stops. Target-owned links and controls retain their own keyboard, focus, accessible-name, and activation requirements.",
    "Preserve hero, information, works, and artists source order at every component width and writing direction."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Container-responsive passive composition implemented in components/css/storytelling.css; targets supply semantic records and media."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css",
      "notes": "Generated CSS is available; exhibition template, sections/blocks, schema, data, editor behavior, responsive media and record ownership remain planned."
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "native-component"
    },
    "compose": {
      "status": "planned",
      "kind": "native-component"
    }
  }
