{%- paginate collection.products by section.settings.products_per_page -%}
  {%- liquid
    assign collection_heading = collection.title
    if collection.handle == 'all'
      assign collection_heading = 'collections.shop_title' | t
    endif

    assign empty_collection_title = 'collections.empty_title' | t
    assign empty_collection_message = 'collections.empty_message' | t
  -%}

  <section
    class="storefront-collection"
    aria-labelledby="StorefrontCollectionTitle-{{ section.id }}"
    data-storefront-shop
  >
    <header class="storefront-collection__header">
      <h1 class="storefront-collection__title" id="StorefrontCollectionTitle-{{ section.id }}">{{ collection_heading }}</h1>
      {%- if collection.description != blank -%}
        <div class="storefront-collection__description rte">{{ collection.description }}</div>
      {%- endif -%}
      <p class="visually-hidden">{{ 'collections.product_count' | t: count: collection.products_count }}</p>
    </header>

    {%- if section.settings.show_categories and section.settings.category_menu != blank -%}
      <nav class="storefront-collection__category-navigation" aria-label="{{ section.settings.category_label | escape }}">
        <ul class="storefront-collection__categories">
          {%- for link in section.settings.category_menu.links -%}
            <li>
              <a class="storefront-collection__category-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if section.settings.enable_sorting and collection.products.size > 0 -%}
      <form class="storefront-shop__controls" data-shop-controls hidden>
        <details class="storefront-work-selector" data-shop-selector>
          <summary class="storefront-work-selector__trigger">
            <svg class="storefront-work-selector__icon" aria-hidden="true" viewBox="0 0 24 20" focusable="false">
              <path d="M3 6h18M7 14h10" />
            </svg>
            <span class="storefront-work-selector__label">{{ 'collections.sorting.criterion_label' | t }}</span>
            <span class="storefront-work-selector__value" data-shop-selector-value>{{ 'collections.sorting.collection' | t }}</span>
          </summary>
          <div class="storefront-work-selector__menu" role="radiogroup" aria-label="{{ 'collections.sorting.criterion_label' | t | escape }}">
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="shop-criterion-{{ section.id }}" value="collection" data-shop-criterion data-shop-option-label="{{ 'collections.sorting.collection' | t | escape }}" checked>
              <span>{{ 'collections.sorting.collection' | t }}</span>
            </label>
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="shop-criterion-{{ section.id }}" value="price" data-shop-criterion data-shop-option-label="{{ 'collections.sorting.price' | t | escape }}">
              <span>{{ 'collections.sorting.price' | t }}</span>
            </label>
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="shop-criterion-{{ section.id }}" value="availability" data-shop-criterion data-shop-option-label="{{ 'collections.sorting.availability' | t | escape }}">
              <span>{{ 'collections.sorting.availability' | t }}</span>
            </label>
          </div>
        </details>

        <details class="storefront-work-selector storefront-work-selector--sort" data-shop-selector>
          <summary class="storefront-work-selector__trigger">
            <svg class="storefront-work-selector__icon" aria-hidden="true" viewBox="0 0 24 20" focusable="false">
              <path d="m4 7 8 6 8-6" />
            </svg>
            <span class="storefront-work-selector__label">{{ 'collections.sorting.direction_label' | t }}</span>
            <span class="storefront-work-selector__value" data-shop-selector-value>{{ 'collections.sorting.ascending' | t }}</span>
          </summary>
          <div class="storefront-work-selector__menu" role="radiogroup" aria-label="{{ 'collections.sorting.direction_label' | t | escape }}">
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="shop-direction-{{ section.id }}" value="ascending" data-shop-direction data-shop-option-label="{{ 'collections.sorting.ascending' | t | escape }}" checked>
              <span>{{ 'collections.sorting.ascending' | t }}</span>
            </label>
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="shop-direction-{{ section.id }}" value="descending" data-shop-direction data-shop-option-label="{{ 'collections.sorting.descending' | t | escape }}">
              <span>{{ 'collections.sorting.descending' | t }}</span>
            </label>
          </div>
        </details>
      </form>
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      <ul class="storefront-collection__grid" style="--storefront-grid-columns: {{ section.settings.columns }}" data-shop-grid>
        {%- for product in collection.products -%}
          {%- liquid
            assign product_collection_title = product.collections.first.title | default: product.type
            assign availability_rank = 1
            if product.available
              assign availability_rank = 0
            endif
          -%}
          <li
            class="storefront-collection__item"
            data-shop-item
            data-shop-collection="{{ product_collection_title | downcase | escape }}"
            data-shop-price="{{ product.price }}"
            data-shop-availability="{{ availability_rank }}"
            data-shop-title="{{ product.title | downcase | escape }}"
          >
            {% render 'storefront-product-tile',
              product: product,
              media_ratio: section.settings.media_ratio,
              show_vendor: section.settings.show_vendor,
              show_description: section.settings.show_description,
              show_badges: section.settings.show_badges,
              show_second_image: section.settings.show_second_image,
              heading_tag: 'h2'
            %}
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      {% render 'empty-state',
        heading_tag: 'h2',
        title: empty_collection_title,
        message: empty_collection_message
      %}
    {%- endif -%}
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Storefront collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 24, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    { "type": "checkbox", "id": "show_categories", "label": "Show category navigation", "default": false },
    { "type": "text", "id": "category_label", "label": "Category navigation label", "default": "Shop categories" },
    { "type": "link_list", "id": "category_menu", "label": "Category menu" },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Show maker or vendor", "default": false },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": false },
    { "type": "checkbox", "id": "show_badges", "label": "Show status badges", "default": true },
    { "type": "checkbox", "id": "show_second_image", "label": "Show second image on hover", "default": true }
  ]
}
{% endschema %}
