/* ============================================================
   The Gallery — Theme Styles
   All values reference design tokens (CSS custom properties).
   No hardcoded values allowed.
   ============================================================ */

/* ---- CUSTOM PROPERTIES (Semantic Layer) ---- */
:root {
  /* Colors — Light mode defaults */
  --color-surface-primary: #FFFFFF;
  --color-surface-secondary: #F5F5F5;
  --color-surface-archival: #F6F2F0;
  --color-surface-statement: #FFF7ED;

  --color-text-primary: #171717;
  --color-text-secondary: #525252;
  --color-text-archival: #8B6553;
  --color-text-statement: #EA580C;

  --color-border-default: #E5E5E5;
  --color-border-archival: #BFA193;
  --color-border-statement: #FDBA74;

  /* Feedback */
  --color-feedback-info: #3B82F6;
  --color-feedback-info-bg: #DBEAFE;
  --color-feedback-success: #10B981;
  --color-feedback-success-bg: #D1FAE5;
  --color-feedback-warning: #F59E0B;
  --color-feedback-warning-bg: #FEF3C7;
  --color-feedback-error: #EF4444;
  --color-feedback-error-bg: #FEE2E2;

  /* Button Colors — Primary */
  --btn-primary-bg: #404040;
  --btn-primary-bg-hover: #262626;
  --btn-primary-bg-active: #0A0A0A;
  --btn-primary-text: #FFFFFF;
  --btn-primary-border: transparent;

  /* Button Colors — Secondary */
  --btn-secondary-bg: #F5F5F5;
  --btn-secondary-bg-hover: #E5E5E5;
  --btn-secondary-bg-active: #D4D4D4;
  --btn-secondary-text: #171717;

  /* Button Colors — Outline */
  --btn-outline-bg: transparent;
  --btn-outline-bg-hover: #FAFAFA;
  --btn-outline-bg-active: #F5F5F5;
  --btn-outline-text: #171717;
  --btn-outline-border: #171717;

  /* Button Colors — Link */
  --btn-link-bg: transparent;
  --btn-link-bg-hover: #F5F5F5;
  --btn-link-text: #171717;
  --btn-link-border: #171717;

  /* Button Colors — Danger */
  --btn-danger-bg: #EF4444;
  --btn-danger-bg-hover: #DC2626;
  --btn-danger-text: #FEE2E2;

  /* Typography — values injected by Liquid in theme.liquid, these are CSS fallbacks */
  --font-family-main: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-family-display: 'Lora', Georgia, 'Times New Roman', serif;

  --font-weight-regular: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;

  /* Typography Scale — Fluid (375px → 1440px viewport) */
  --font-size-display: clamp(2.25rem, 1.63rem + 2.63vw, 4rem);
  --line-height-display: clamp(2.5rem, 1.8rem + 3vw, 4.5rem);
  --font-size-h1: clamp(1.75rem, 1.22rem + 2.25vw, 3.25rem);
  --line-height-h1: clamp(2.125rem, 1.55rem + 2.44vw, 3.75rem);
  --font-size-h2: clamp(1.5rem, 1.19rem + 1.31vw, 2.375rem);
  --line-height-h2: clamp(1.875rem, 1.52rem + 1.5vw, 2.875rem);
  --font-size-h3: clamp(1.25rem, 1.07rem + 0.75vw, 1.75rem);
  --line-height-h3: clamp(1.625rem, 1.45rem + 0.75vw, 2.125rem);
  --font-size-body-lg: clamp(1.125rem, 1.08rem + 0.19vw, 1.25rem);
  --line-height-body-lg: clamp(1.813rem, 1.75rem + 0.28vw, 2rem);
  --font-size-body: clamp(1rem, 0.96rem + 0.19vw, 1.125rem);
  --line-height-body: clamp(1.5rem, 1.43rem + 0.28vw, 1.688rem);
  --font-size-body-sm: 0.875rem;
  --line-height-body-sm: 1.25rem;
  --font-size-caption: 0.75rem;
  --line-height-caption: 1rem;
  --font-size-button: clamp(1rem, 0.96rem + 0.19vw, 1.125rem);
  --font-size-article-title: clamp(1.5rem, 1.24rem + 1.13vw, 2.25rem);
  --line-height-article-title: clamp(1.875rem, 1.57rem + 1.31vw, 2.75rem);
  --font-size-article-body: clamp(1rem, 0.96rem + 0.19vw, 1.125rem);
  --line-height-article-body: clamp(1.625rem, 1.56rem + 0.28vw, 1.813rem);

  /* Spacing — Fluid scale (375px → 1440px viewport) */
  --space-0: 0;
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-5: clamp(1.25rem, 1.16rem + 0.38vw, 1.5rem);
  --space-6: clamp(1.5rem, 1.32rem + 0.75vw, 2rem);
  --space-7: clamp(2rem, 1.65rem + 1.5vw, 3rem);
  --space-8: clamp(2.5rem, 1.97rem + 2.25vw, 4rem);
  --space-9: clamp(3.5rem, 2.62rem + 3.76vw, 6rem);
  --space-10: clamp(4.5rem, 3.27rem + 5.26vw, 8rem);
  --space-11: clamp(6rem, 3.89rem + 9.01vw, 12rem);
  --space-12: clamp(8rem, 5.18rem + 12.02vw, 16rem);

  /* Semantic Spacing Aliases — fixed (same across breakpoints) */
  --stack-none: var(--space-0);
  --stack-xs: var(--space-2);
  --stack-sm: var(--space-3);
  --stack-md: var(--space-4);

  /* Semantic Spacing Aliases — fluid (mapping changes across breakpoints) */
  --stack-lg: clamp(1.25rem, 0.99rem + 1.13vw, 2rem);
  --stack-xl: clamp(2rem, 1.3rem + 3vw, 4rem);
  --stack-2xl: clamp(3.5rem, 1.92rem + 6.76vw, 8rem);
  --stack-3xl: clamp(4.5rem, 0.45rem + 17.28vw, 16rem);

  --inline-xs: var(--space-1);
  --inline-sm: var(--space-2);
  --inline-md: var(--space-3);
  --inline-lg: var(--space-4);
  --inline-xl: clamp(1.25rem, 0.99rem + 1.13vw, 2rem);
  --inline-2xl: clamp(2rem, 1.3rem + 3vw, 4rem);

  --section-xs: var(--space-7);
  --section-sm: var(--space-8);
  --section-md: var(--space-9);
  --section-lg: var(--space-10);
  --section-xl: var(--space-11);

  --component-xs: var(--space-4);
  --component-sm: var(--space-5);
  --component-md: var(--space-6);
  --component-lg: var(--space-7);
  --component-xl: var(--space-9);

  /* Borders */
  --radius-none: 0px;
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 16px;
  --radius-2xl: 24px;
  --radius-full: 999px;

  /* Shadows — Light */
  --shadow-sm: 0 1px 2px rgba(23, 23, 23, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(23, 23, 23, 0.10);
  --shadow-lg: 0 10px 15px -3px rgba(23, 23, 23, 0.10);
  --shadow-xl: 0 20px 25px -5px rgba(23, 23, 23, 0.10);
  --shadow-2xl: 0 25px 50px -12px rgba(23, 23, 23, 0.25);

  /* Transitions */
  --transition-fast: 100ms;
  --transition-base: 200ms;
  --transition-slow: 300ms;
  --transition-slower: 500ms;
  --ease-linear: linear;
  --ease-in: ease-in;
  --ease-out: ease-out;
  --ease-in-out: ease-in-out;
  --ease-spring: cubic-bezier(0.4, 0, 0.2, 1);

  /* Z-Index */
  --z-base: 0;
  --z-dropdown: 1000;
  --z-sticky: 1050;
  --z-overlay: 1100;
  --z-modal: 1200;
  --z-toast: 1300;

  /* Layout */
  --container-max-width: 75rem;
  --container-margin: 7.5rem;
  --grid-columns: 12;
  --grid-gutter: 2rem;
  --touch-min: 2.75rem;
}

/* ---- DARK MODE ---- */
[data-theme="dark"] {
  --color-surface-primary: #171717;
  --color-surface-secondary: #262626;
  --color-surface-archival: #553A2C;
  --color-surface-statement: #9A3412;

  --color-text-primary: #FAFAFA;
  --color-text-secondary: #D4D4D4;
  --color-text-archival: #AD8674;
  --color-text-statement: #FB923C;

  --color-border-default: #404040;
  --color-border-archival: #8B6553;
  --color-border-statement: #EA580C;

  --color-feedback-info: #60A5FA;
  --color-feedback-info-bg: #1D4ED8;
  --color-feedback-success: #34D399;
  --color-feedback-success-bg: #047857;
  --color-feedback-warning: #FBBF24;
  --color-feedback-warning-bg: #B45309;
  --color-feedback-error: #F87171;
  --color-feedback-error-bg: #B91C1C;

  --btn-primary-bg: #FFFFFF;
  --btn-primary-bg-hover: #FAFAFA;
  --btn-primary-bg-active: #F5F5F5;
  --btn-primary-text: #171717;

  --btn-secondary-bg: #262626;
  --btn-secondary-bg-hover: #404040;
  --btn-secondary-bg-active: #525252;
  --btn-secondary-text: #FAFAFA;

  --btn-outline-bg: transparent;
  --btn-outline-bg-hover: #262626;
  --btn-outline-bg-active: #404040;
  --btn-outline-text: #FFFFFF;
  --btn-outline-border: #FFFFFF;

  --btn-link-bg: transparent;
  --btn-link-bg-hover: #262626;
  --btn-link-text: #FAFAFA;
  --btn-link-border: #FAFAFA;

  --shadow-sm: 0 1px 2px rgba(245, 245, 245, 0.10);
  --shadow-md: 0 4px 6px -1px rgba(245, 245, 245, 0.15);
  --shadow-lg: 0 10px 15px -3px rgba(245, 245, 245, 0.20);
  --shadow-xl: 0 20px 25px -5px rgba(245, 245, 245, 0.25);
  --shadow-2xl: 0 25px 50px -12px rgba(245, 245, 245, 0.30);
}

/* ---- LAYOUT BREAKPOINTS (container & grid only — typography/spacing handled by clamp) ---- */
@media (max-width: 767px) {
  :root {
    --container-max-width: 100%;
    --container-margin: 1.5rem;
    --grid-columns: 4;
    --grid-gutter: 1rem;
  }
}

@media (min-width: 768px) and (max-width: 1023px) {
  :root {
    --container-max-width: 768px;
    --container-margin: 3rem;
    --grid-columns: 8;
    --grid-gutter: 1.5rem;
  }
}

@media (min-width: 1440px) {
  :root {
    --container-max-width: 1440px;
    --container-margin: 10rem;
  }
}

/* ============================================================
   RESET & BASE
   ============================================================ */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

body {
  font-family: var(--font-family-main);
  font-size: var(--font-size-body);
  line-height: var(--line-height-body);
  font-weight: var(--font-weight-regular);
  color: var(--color-text-primary);
  background-color: var(--color-surface-primary);
  -webkit-text-size-adjust: 100%;
}

img,
video,
svg {
  display: block;
  max-width: 100%;
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
  color: inherit;
  background: none;
  border: none;
  cursor: pointer;
}

ul, ol {
  list-style: none;
}

input, textarea, select {
  font: inherit;
  color: inherit;
}

/* ---- SKIP LINK ---- */
.skip-to-content {
  position: absolute;
  top: -100%;
  left: var(--space-4);
  z-index: var(--z-toast);
  padding: var(--space-2) var(--space-4);
  background: var(--color-surface-primary);
  color: var(--color-text-primary);
  border: 1px solid var(--color-border-default);
  font-size: var(--font-size-body-sm);
}

.skip-to-content:focus {
  top: var(--space-2);
}

/* ============================================================
   LAYOUT UTILITIES
   ============================================================ */
.container {
  width: 100%;
  max-width: var(--container-max-width);
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--container-margin);
  padding-right: var(--container-margin);
}

.grid {
  display: grid;
  grid-template-columns: repeat(var(--grid-columns), 1fr);
  gap: var(--grid-gutter);
}

.section-spacing {
  padding-top: var(--section-md);
  padding-bottom: var(--section-md);
}

.section-spacing--lg {
  padding-top: var(--section-lg);
  padding-bottom: var(--section-lg);
}

/* ============================================================
   TYPOGRAPHY
   ============================================================ */
.display {
  font-family: var(--font-family-main);
  font-size: var(--font-size-display);
  line-height: var(--line-height-display);
  font-weight: var(--font-weight-bold);
  letter-spacing: -0.02em;
  color: var(--color-text-primary);
}

.h1 {
  font-family: var(--font-family-main);
  font-size: var(--font-size-h1);
  line-height: var(--line-height-h1);
  font-weight: var(--font-weight-semibold);
  letter-spacing: -0.02em;
  color: var(--color-text-primary);
}

.h2 {
  font-family: var(--font-family-main);
  font-size: var(--font-size-h2);
  line-height: var(--line-height-h2);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.h3 {
  font-family: var(--font-family-main);
  font-size: var(--font-size-h3);
  line-height: var(--line-height-h3);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.body-lg {
  font-size: var(--font-size-body-lg);
  line-height: var(--line-height-body-lg);
}

.body-sm {
  font-size: var(--font-size-body-sm);
  line-height: var(--line-height-body-sm);
}

.caption {
  font-size: var(--font-size-caption);
  line-height: var(--line-height-caption);
  letter-spacing: 0.01em;
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-archival {
  color: var(--color-text-archival);
}

/* Editorial typography (Lora) */
.editorial {
  font-family: var(--font-family-display);
}

.article-title {
  font-family: var(--font-family-display);
  font-size: var(--font-size-article-title);
  line-height: var(--line-height-article-title);
  font-weight: var(--font-weight-semibold);
}

.article-body {
  font-family: var(--font-family-display);
  font-size: var(--font-size-article-body);
  line-height: var(--line-height-article-body);
}

/* ============================================================
   BUTTONS
   ============================================================ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--inline-md);
  min-height: var(--touch-min);
  padding: var(--component-xs) var(--component-md);
  font-family: var(--font-family-main);
  font-size: var(--font-size-button);
  font-weight: var(--font-weight-medium);
  line-height: 1;
  text-align: center;
  text-decoration: none;
  border: 1px solid transparent;
  cursor: pointer;
  transition: background-color var(--transition-base) var(--ease-out),
              color var(--transition-base) var(--ease-out),
              border-color var(--transition-base) var(--ease-out);
}

.btn:disabled,
.btn[aria-disabled="true"] {
  opacity: 0.4;
  pointer-events: none;
}

/* Primary */
.btn--primary {
  background-color: var(--btn-primary-bg);
  color: var(--btn-primary-text);
  border-color: var(--btn-primary-border);
  border-radius: var(--radius-sm);
}

.btn--primary:hover {
  background-color: var(--btn-primary-bg-hover);
}

.btn--primary:active {
  background-color: var(--btn-primary-bg-active);
}

/* Secondary */
.btn--secondary {
  background-color: var(--btn-secondary-bg);
  color: var(--btn-secondary-text);
  border-radius: var(--radius-sm);
}

.btn--secondary:hover {
  background-color: var(--btn-secondary-bg-hover);
}

.btn--secondary:active {
  background-color: var(--btn-secondary-bg-active);
}

/* Outline — sharp corners for gallery aesthetic */
.btn--outline {
  background-color: var(--btn-outline-bg);
  color: var(--btn-outline-text);
  border-color: var(--btn-outline-border);
  border-radius: var(--radius-none);
}

.btn--outline:hover {
  background-color: var(--btn-outline-bg-hover);
}

.btn--outline:active {
  background-color: var(--btn-outline-bg-active);
}

/* Link */
.btn--link {
  background-color: var(--btn-link-bg);
  color: var(--btn-link-text);
  border-radius: var(--radius-none);
  padding-left: 0;
  padding-right: 0;
  border-bottom: 1px solid var(--btn-link-border);
}

.btn--link:hover {
  background-color: var(--btn-link-bg-hover);
}

/* Danger */
.btn--danger {
  background-color: var(--btn-danger-bg);
  color: var(--btn-danger-text);
  border-radius: var(--radius-sm);
}

.btn--danger:hover {
  background-color: var(--btn-danger-bg-hover);
}

/* ============================================================
   FORMS
   ============================================================ */
.form-field {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  margin-top: var(--space-4);
  margin-bottom: var(--space-1);
}

.form-field__label {
  font-size: var(--font-size-body-sm);
  line-height: var(--line-height-body-sm);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
}

.form-field__input {
  padding: var(--space-3);
  background-color: var(--color-surface-primary);
  border: 1px solid var(--color-border-default);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-body);
  line-height: var(--line-height-body);
  color: var(--color-text-primary);
  transition: border-color var(--transition-base) var(--ease-out);
  min-height: var(--touch-min);
}

.form-field__input::placeholder {
  color: #A3A3A3;
}

.form-field__input:focus {
  outline: none;
  border-color: var(--color-text-primary);
}

.form-field__input--error {
  border-color: var(--color-feedback-error);
}

.form-field__input--success {
  border-color: var(--color-feedback-success);
}

.form-field__message {
  font-size: var(--font-size-caption);
  line-height: var(--line-height-caption);
}

.form-field__message--error {
  color: var(--color-feedback-error);
}

.form-field__message--success {
  color: var(--color-feedback-success);
}

/* ============================================================
   PRODUCT CARD
   ============================================================ */
.product-card {
  display: flex;
  flex-direction: column;
  background-color: var(--color-surface-primary);
  border-radius: var(--radius-none);
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition: box-shadow var(--transition-base) var(--ease-out);
}

.product-card:hover {
  box-shadow: var(--shadow-sm);
}

.product-card__image-wrapper {
  position: relative;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background-color: var(--color-surface-secondary);
}

.product-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity var(--transition-slow) var(--ease-out);
}

.product-card__image--hover {
  position: absolute;
  inset: 0;
  opacity: 0;
}

.product-card:hover .product-card__image--hover {
  opacity: 1;
}

.product-card:hover .product-card__image--primary {
  opacity: 0;
}

.product-card__content {
  padding: var(--component-sm);
  display: flex;
  flex-direction: column;
  gap: var(--stack-xs);
}

.product-card__title {
  font-size: var(--font-size-h3);
  line-height: var(--line-height-h3);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.product-card__collection {
  font-size: var(--font-size-caption);
  line-height: var(--line-height-caption);
  color: var(--color-text-secondary);
  letter-spacing: 0.01em;
  text-transform: uppercase;
}

.product-card__price {
  font-size: var(--font-size-body);
  line-height: var(--line-height-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.product-card__price--compare {
  font-size: var(--font-size-body-sm);
  color: var(--color-text-secondary);
  text-decoration: line-through;
}

/* ============================================================
   HEADER
   ============================================================ */
.site-header {
  position: sticky;
  top: 0;
  z-index: var(--z-sticky);
  background-color: var(--color-surface-primary);
  border-bottom: 1px solid var(--color-border-default);
  transition: background-color var(--transition-base) var(--ease-out);
}

.site-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64px;
  padding-left: var(--container-margin);
  padding-right: var(--container-margin);
}

@media (min-width: 1024px) {
  .site-header__inner {
    height: 80px;
  }
}

.site-header__logo {
  font-family: var(--font-family-main);
  font-size: var(--font-size-h3);
  font-weight: var(--font-weight-semibold);
  letter-spacing: -0.02em;
  color: var(--color-text-primary);
  text-decoration: none;
}

.site-header__nav {
  display: none;
  align-items: center;
  gap: var(--space-6);
}

@media (min-width: 1024px) {
  .site-header__nav {
    display: flex;
  }
}

.site-header__nav-link {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  text-decoration: none;
  transition: color var(--transition-base) var(--ease-out);
}

.site-header__nav-link:hover {
  color: var(--color-text-secondary);
}

.site-header__actions {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.site-header__action-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--touch-min);
  height: var(--touch-min);
  padding: 0;
  background: none;
  border: none;
  color: var(--color-text-primary);
  cursor: pointer;
}

.site-header__action-btn svg {
  width: 24px;
  height: 24px;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.5;
}

.site-header__cart-count {
  position: absolute;
  top: 4px;
  right: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  background-color: var(--color-text-primary);
  color: var(--color-surface-primary);
  font-size: 11px;
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-full);
  line-height: 1;
}

/* Mobile Menu */
.site-header__menu-toggle {
  display: flex;
}

@media (min-width: 1024px) {
  .site-header__menu-toggle {
    display: none;
  }
}

.mobile-nav {
  position: fixed;
  inset: 0;
  z-index: var(--z-overlay);
  background-color: var(--color-surface-primary);
  display: flex;
  flex-direction: column;
  padding: var(--space-7) var(--container-margin);
  transform: translateX(-100%);
  transition: transform var(--transition-slow) var(--ease-spring);
}

.mobile-nav.is-open {
  transform: translateX(0);
}

.mobile-nav__close {
  align-self: flex-end;
  margin-bottom: var(--space-7);
}

.mobile-nav__link {
  display: block;
  padding: var(--space-4) 0;
  font-size: var(--font-size-h2);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  border-bottom: 1px solid var(--color-border-default);
  text-decoration: none;
}

/* ============================================================
   FOOTER
   ============================================================ */
.site-footer {
  background-color: var(--color-surface-secondary);
  border-top: 1px solid var(--color-border-default);
  padding-top: var(--section-md);
  padding-bottom: var(--section-sm);
}

.site-footer__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-7);
  max-width: var(--container-max-width);
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--container-margin);
  padding-right: var(--container-margin);
}

@media (min-width: 768px) {
  .site-footer__inner {
    grid-template-columns: 2fr 1fr 1fr 1fr;
  }
}

.site-footer__brand {
  display: flex;
  flex-direction: column;
  gap: var(--stack-md);
}

.site-footer__brand-name {
  font-size: var(--font-size-h3);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.site-footer__brand-desc {
  font-size: var(--font-size-body-sm);
  color: var(--color-text-secondary);
  max-width: 300px;
}

.site-footer__heading {
  font-size: var(--font-size-body-sm);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: var(--stack-md);
}

.site-footer__link {
  display: block;
  font-size: var(--font-size-body-sm);
  color: var(--color-text-secondary);
  text-decoration: none;
  padding: var(--space-1) 0;
  transition: color var(--transition-base) var(--ease-out);
}

.site-footer__link:hover {
  color: var(--color-text-primary);
}

.site-footer__newsletter {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--stack-sm);
}

.site-footer__newsletter-input {
  flex: 1;
  padding: var(--space-2) var(--space-3);
  border: 1px solid var(--color-border-default);
  border-radius: var(--radius-sm);
  background-color: var(--color-surface-primary);
  font-size: var(--font-size-body-sm);
  min-height: var(--touch-min);
}

.site-footer__bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--section-sm);
  padding-top: var(--space-6);
  border-top: 1px solid var(--color-border-default);
  max-width: var(--container-max-width);
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--container-margin);
  padding-right: var(--container-margin);
}

.site-footer__copyright {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
}

.site-footer__social {
  display: flex;
  gap: var(--space-4);
}

.site-footer__social-link {
  color: var(--color-text-secondary);
  transition: color var(--transition-base) var(--ease-out);
}

.site-footer__social-link:hover {
  color: var(--color-text-primary);
}

.site-footer__social-link svg {
  width: 20px;
  height: 20px;
}

/* ============================================================
   HERO SECTION
   ============================================================ */
.hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  overflow: hidden;
  background-color: var(--color-surface-secondary);
}

.hero--full {
  min-height: 100vh;
}

.hero__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 60%);
}

.hero__content {
  position: relative;
  z-index: 1;
  text-align: center;
  max-width: 800px;
  padding: var(--space-7);
  color: #FFFFFF;
}

.hero__subtitle {
  font-size: var(--font-size-body-lg);
  line-height: var(--line-height-body-lg);
  margin-top: var(--stack-md);
  opacity: 0.9;
}

.hero__cta {
  margin-top: var(--stack-xl);
}

.hero .btn--outline {
  color: #fff;
  border-color: #fff;
}

.hero .btn--outline:hover {
  background-color: rgba(255, 255, 255, 0.1);
}

/* ============================================================
   ARTIST STORY SECTION
   ============================================================ */
.artist-story {
  background-color: var(--color-surface-archival);
}

.artist-story__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-7);
  align-items: center;
}

@media (min-width: 768px) {
  .artist-story__inner {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-9);
  }
}

.artist-story__image-wrapper {
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background-color: var(--color-surface-secondary);
}

.artist-story__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.artist-story__content {
  display: flex;
  flex-direction: column;
  gap: var(--stack-lg);
}

.artist-story__headline {
  font-family: var(--font-family-display);
  font-size: var(--font-size-h2);
  line-height: var(--line-height-h2);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.artist-story__text {
  font-family: var(--font-family-display);
  font-size: var(--font-size-body-lg);
  line-height: var(--line-height-body-lg);
  color: var(--color-text-secondary);
}

.artist-story__quote {
  font-family: var(--font-family-display);
  font-size: var(--font-size-h3);
  line-height: var(--line-height-h3);
  font-style: italic;
  color: var(--color-text-archival);
  border-left: 3px solid var(--color-border-archival);
  padding-left: var(--space-5);
}

/* ============================================================
   COLLECTION GRID
   ============================================================ */
.collection-grid__header {
  text-align: center;
  margin-bottom: var(--stack-xl);
}

.collection-grid__title {
  font-size: var(--font-size-h2);
  line-height: var(--line-height-h2);
  font-weight: var(--font-weight-semibold);
}

.collection-grid__description {
  font-size: var(--font-size-body-lg);
  color: var(--color-text-secondary);
  margin-top: var(--stack-sm);
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.collection-grid__products {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--grid-gutter);
}

@media (min-width: 768px) {
  .collection-grid__products {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (min-width: 1024px) {
  .collection-grid__products {
    grid-template-columns: repeat(4, 1fr);
  }
}

.collection-grid__cta {
  text-align: center;
  margin-top: var(--stack-xl);
}

/* ============================================================
   PRODUCT GALLERY (Stacked)
   ============================================================ */
.product-gallery-stacked {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.product-gallery-stacked__image {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  background-color: var(--color-surface-secondary);
}

/* ============================================================
   PRODUCT INFO
   ============================================================ */
.product-info {
  display: flex;
  flex-direction: column;
  gap: var(--stack-lg);
}

.product-info__title {
  font-size: var(--font-size-h1);
  line-height: var(--line-height-h1);
  font-weight: var(--font-weight-semibold);
}

.product-info__price-wrapper {
  display: flex;
  align-items: baseline;
  gap: var(--inline-md);
}

.product-info__price {
  font-size: var(--font-size-h3);
  font-weight: var(--font-weight-medium);
}

.product-info__price--compare {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  text-decoration: line-through;
}

.product-info__description {
  font-size: var(--font-size-body);
  line-height: var(--line-height-body);
  color: var(--color-text-secondary);
}

/* Ceramics Metafields */
.product-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--stack-sm) var(--inline-xl);
  padding-top: var(--stack-lg);
  border-top: 1px solid var(--color-border-default);
}

.product-meta__item {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.product-meta__label {
  font-size: var(--font-size-caption);
  line-height: var(--line-height-caption);
  color: var(--color-text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.product-meta__value {
  font-size: var(--font-size-body-sm);
  line-height: var(--line-height-body-sm);
  color: var(--color-text-primary);
}

/* ============================================================
   CART DRAWER
   ============================================================ */
.cart-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-width: 420px;
  z-index: var(--z-modal);
  background-color: var(--color-surface-primary);
  box-shadow: var(--shadow-xl);
  transform: translateX(100%);
  transition: transform var(--transition-slow) var(--ease-spring);
  display: flex;
  flex-direction: column;
}

.cart-drawer.is-open {
  transform: translateX(0);
}

.cart-drawer__overlay {
  position: fixed;
  inset: 0;
  z-index: calc(var(--z-modal) - 1);
  background-color: rgba(0, 0, 0, 0.4);
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--transition-slow) var(--ease-out),
              visibility var(--transition-slow) var(--ease-out);
}

.cart-drawer__overlay.is-visible {
  opacity: 1;
  visibility: visible;
}

.cart-drawer__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-5) var(--space-6);
  border-bottom: 1px solid var(--color-border-default);
}

.cart-drawer__title {
  font-size: var(--font-size-h3);
  font-weight: var(--font-weight-semibold);
}

.cart-drawer__items {
  flex: 1;
  overflow-y: auto;
  padding: var(--space-5) var(--space-6);
}

.cart-drawer__footer {
  padding: var(--space-5) var(--space-6);
  border-top: 1px solid var(--color-border-default);
  display: flex;
  flex-direction: column;
  gap: var(--stack-md);
}

.cart-drawer__total {
  display: flex;
  justify-content: space-between;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
}

/* Cart Line Item */
.cart-item {
  display: flex;
  gap: var(--inline-lg);
  padding: var(--space-4) 0;
  border-bottom: 1px solid var(--color-border-default);
}

.cart-item__image {
  width: 80px;
  height: 80px;
  object-fit: cover;
  background-color: var(--color-surface-secondary);
  flex-shrink: 0;
}

.cart-item__details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.cart-item__title {
  font-size: var(--font-size-body-sm);
  font-weight: var(--font-weight-medium);
}

.cart-item__variant {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
}

.cart-item__price {
  font-size: var(--font-size-body-sm);
  font-weight: var(--font-weight-medium);
}

/* ============================================================
   EDITORIAL MEDIA SECTION
   ============================================================ */
.editorial-media--full {
  width: 100%;
}

.editorial-media--split {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
  align-items: stretch;
}

@media (min-width: 768px) {
  .editorial-media--split {
    grid-template-columns: 1fr 1fr;
  }
}

.editorial-media__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.editorial-media__content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: var(--section-sm);
}

/* ============================================================
   VISIBILITY UTILITIES
   ============================================================ */
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

@media (max-width: 767px) {
  .hide-mobile { display: none !important; }
}

@media (min-width: 768px) and (max-width: 1023px) {
  .hide-tablet { display: none !important; }
}

@media (min-width: 1024px) {
  .hide-desktop { display: none !important; }
}

/* ============================================================
   COMING SOON
   Full-screen editorial landing page.
   ============================================================ */
.coming-soon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  min-height: 100dvh;
  background-color: var(--color-surface-primary);
  overflow: hidden;
}

.coming-soon__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}

/* Dark gradient overlay when background image is present */
.coming-soon__bg + .coming-soon__content {
  --_cs-text: #FAFAFA;
  --_cs-text-muted: rgba(250, 250, 250, 0.7);
  --_cs-border: rgba(250, 250, 250, 0.25);
  --_cs-input-bg: rgba(0, 0, 0, 0.3);
  --_cs-btn-bg: #FFFFFF;
  --_cs-btn-text: #171717;
  --_cs-btn-hover: #F5F5F5;
}

.coming-soon:has(.coming-soon__bg)::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.3) 0%,
    rgba(0, 0, 0, 0.55) 100%
  );
  z-index: 1;
}

/* No-image defaults */
.coming-soon__content {
  --_cs-text: var(--color-text-primary);
  --_cs-text-muted: var(--color-text-secondary);
  --_cs-border: var(--color-border-default);
  --_cs-input-bg: var(--color-surface-secondary);
  --_cs-btn-bg: var(--btn-primary-bg);
  --_cs-btn-text: var(--btn-primary-text);
  --_cs-btn-hover: var(--btn-primary-bg-hover);

  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  max-width: 34rem;
  padding: var(--space-6);
  gap: var(--stack-lg);
  color: var(--_cs-text);
}

.coming-soon__brand {
  margin-bottom: var(--space-2);
}

.coming-soon__logo {
  max-height: 3.5rem;
  width: auto;
}

.coming-soon__store-name {
  font-family: var(--font-family-main);
  font-size: var(--font-size-h3);
  font-weight: var(--font-weight-semibold);
  letter-spacing: -0.02em;
  text-transform: none;
}

.coming-soon__heading {
  font-family: var(--font-family-display);
  font-size: var(--font-size-display);
  line-height: var(--line-height-display);
  font-weight: var(--font-weight-bold);
  letter-spacing: -0.03em;
  font-style: italic;
}

.coming-soon__subtext {
  font-size: var(--font-size-body-lg);
  line-height: var(--line-height-body-lg);
  color: var(--_cs-text-muted);
  max-width: 28rem;
}

.coming-soon__newsletter {
  width: 100%;
  max-width: 26rem;
}

.coming-soon__form {
  display: flex;
  gap: 0;
  border: 1px solid var(--_cs-border);
}

.coming-soon__input {
  flex: 1;
  min-width: 0;
  padding: var(--space-3) var(--space-4);
  background: var(--_cs-input-bg);
  border: none;
  color: var(--_cs-text);
  font-family: var(--font-family-main);
  font-size: var(--font-size-body);
  line-height: var(--line-height-body);
  min-height: var(--touch-min);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.coming-soon__input::placeholder {
  color: var(--_cs-text-muted);
}

.coming-soon__input:focus {
  outline: none;
  background: var(--_cs-input-bg);
}

.coming-soon__submit {
  padding: var(--space-3) var(--space-5);
  background: var(--_cs-btn-bg);
  color: var(--_cs-btn-text);
  font-family: var(--font-family-main);
  font-size: var(--font-size-body-sm);
  font-weight: var(--font-weight-medium);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border: none;
  cursor: pointer;
  white-space: nowrap;
  min-height: var(--touch-min);
  transition: background-color var(--transition-base) var(--ease-out);
}

.coming-soon__submit:hover {
  background: var(--_cs-btn-hover);
}

.coming-soon__success {
  font-family: var(--font-family-display);
  font-style: italic;
  font-size: var(--font-size-body-lg);
  color: var(--_cs-text);
}

.coming-soon__error {
  margin-top: var(--space-2);
  font-size: var(--font-size-body-sm);
  color: var(--color-feedback-error);
}

.coming-soon__social {
  display: flex;
  gap: var(--space-5);
  align-items: center;
}

.coming-soon__social-link {
  color: var(--_cs-text-muted);
  transition: color var(--transition-base) var(--ease-out);
}

.coming-soon__social-link:hover {
  color: var(--_cs-text);
}

.coming-soon__footer {
  font-size: var(--font-size-caption);
  color: var(--_cs-text-muted);
  letter-spacing: 0.02em;
}
