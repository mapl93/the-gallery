        "$value": "{dimension.4}"
      },
      "linkWeight": {
        "$type": "fontWeight",
        "$value": "{font.weight.medium}"
      },
      "underlineOffset": {
        "$type": "dimension",
        "$value": "{dimension.4}"
      },
      "focusWidth": {
        "$type": "dimension",
        "$value": "{dimension.2}"
      },
      "focusInset": {
        "$type": "dimension",
        "$value": "{dimension.2}"
      }
    }
  }
}
