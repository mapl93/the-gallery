{%- comment -%}
  Target-owned Shopify composition based on the approved Figma landing frame.
  The section remains merchant-editable without promoting its fixture content
  into the target-agnostic component contract.
{%- endcomment -%}

<div class="landing-gateway">
  <h1 class="visually-hidden">{{ shop.name }}</h1>

  <div class="landing-gateway__eyes">
    {% render 'brand-eyes', tone: 'light', track_pointer: true %}
  </div>

  {%- liquid
    assign navigation_label = section.settings.navigation_label
    if navigation_label == blank or navigation_label == 'Explore'
      assign navigation_label = 'gateway.navigation_label' | t
    endif
  -%}

  <nav class="landing-gateway__navigation" aria-label="{{ navigation_label | escape }}">
    <ul class="landing-gateway__portals">
      {%- for block in section.blocks -%}
        {%- liquid
          assign portal_label = block.settings.label

          if block.settings.label_key != blank and block.settings.label_key != 'custom'
            assign portal_translation_key = 'gateway.links.' | append: block.settings.label_key
            assign portal_label = portal_translation_key | t
          endif
        -%}
        {%- if portal_label != blank -%}
          {%- liquid
            assign preview_image = block.settings.image
            assign preview_asset = blank

            if preview_image == blank
              case block.settings.fallback_source
                when 'studio_reference'
                  assign preview_asset = 'gallery-studio-process.jpg'
                when 'first_product'
                  assign preview_image = collections.all.products.first.featured_image
                when 'latest_article'
                  assign preview_image = blogs.journal.articles.first.image
              endcase

              if preview_image == blank and block.settings.fallback_source != 'none'
                assign preview_asset = 'gallery-studio-process.jpg'
              endif
            endif
          -%}
          <li class="landing-gateway__portal" {{ block.shopify_attributes }}>
            <a class="landing-gateway__portal-link" href="{{ block.settings.url | default: routes.root_url }}">
              {{ portal_label }}
            </a>

            {%- if preview_image != blank or preview_asset != blank -%}
              <div class="landing-gateway__media" aria-hidden="true">
                {%- if preview_image != blank -%}
                  {{ preview_image
                    | image_url: width: 1800
                    | image_tag:
                      widths: '320, 480, 720, 960, 1200, 1800',
                      sizes: '(max-width: 47.99rem) 160px, 44dvh',
                      loading: 'lazy',
                      alt: ''
                  }}
                {%- else -%}
                  <img
                    src="{{ preview_asset | asset_url }}"
                    alt=""
                    width="1330"
                    height="2364"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </nav>
</div>

{% schema %}
{
  "name": "Editorial gateway",
  "tag": "section",
  "class": "shopify-section--landing-gateway",
  "settings": [
    {
      "type": "text",
      "id": "navigation_label",
      "label": "Navigation label",
      "default": "Explore"
    }
  ],
  "blocks": [
    {
      "type": "portal",
      "name": "Portal link",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop" },
        {
          "type": "select",
          "id": "label_key",
          "label": "Localized label",
          "options": [
            { "value": "custom", "label": "Use custom label" },
            { "value": "works", "label": "Works" },
            { "value": "shop", "label": "Shop" },
            { "value": "firings", "label": "Firings" },
            { "value": "journal", "label": "Journal" },
            { "value": "about", "label": "About me" }
          ],
          "default": "custom"
        },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Hover image" },
        {
          "type": "select",
          "id": "fallback_source",
          "label": "Fallback image",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "studio_reference", "label": "Studio reference" },
            { "value": "first_product", "label": "First product" },
            { "value": "latest_article", "label": "Latest Journal article" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial gateway",
      "blocks": [
        { "type": "portal", "settings": { "label": "Works", "label_key": "works", "fallback_source": "studio_reference" } },
        { "type": "portal", "settings": { "label": "Shop", "label_key": "shop", "fallback_source": "first_product" } },
        { "type": "portal", "settings": { "label": "Firings", "label_key": "firings", "fallback_source": "studio_reference" } },
        { "type": "portal", "settings": { "label": "Journal", "label_key": "journal", "fallback_source": "latest_article" } },
        { "type": "portal", "settings": { "label": "About me", "label_key": "about", "fallback_source": "studio_reference" } }
      ]
    }
  ]
}
{% endschema %}
