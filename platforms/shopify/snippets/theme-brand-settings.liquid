{% style %}
  {{ settings.font_body | font_face: font_display: 'swap' }}
  {{ settings.font_body | font_modify: 'weight', '500' | font_face: font_display: 'swap' }}
  {{ settings.font_body | font_modify: 'weight', '600' | font_face: font_display: 'swap' }}
  {{ settings.font_body | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.font_heading | font_face: font_display: 'swap' }}
  {{ settings.font_heading | font_modify: 'weight', '500' | font_face: font_display: 'swap' }}
  {{ settings.font_heading | font_modify: 'weight', '600' | font_face: font_display: 'swap' }}
  {{ settings.font_heading | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.font_heading | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root,
  [data-theme] {
    {% if settings.font_body != blank %}
      --tg-font-family-sans: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      --font-family-body: var(--tg-font-family-sans);
      --font-family-heading: var(--tg-font-family-sans);
      --font-family-accent: var(--tg-font-family-sans);
    {% endif %}
    {% if settings.font_heading != blank %}
      --tg-font-family-serif: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
      --font-family-article: var(--tg-font-family-serif);
    {% endif %}
  }

  :root:not([data-theme="dark"]),
  [data-theme="light"] {
    {% if settings.color_surface_primary != blank %}
      --tg-color-surface-primary: {{ settings.color_surface_primary }};
    {% endif %}
    {% if settings.color_surface_secondary != blank %}
      --tg-color-surface-secondary: {{ settings.color_surface_secondary }};
    {% endif %}
    {% if settings.color_surface_archival != blank %}
      --tg-color-surface-archival: {{ settings.color_surface_archival }};
    {% endif %}
    {% if settings.color_text_primary != blank %}
      --tg-color-text-primary: {{ settings.color_text_primary }};
    {% endif %}
    {% if settings.color_text_secondary != blank %}
      --tg-color-text-secondary: {{ settings.color_text_secondary }};
    {% endif %}
    {% if settings.color_border_default != blank %}
      --tg-color-border-default: {{ settings.color_border_default }};
    {% endif %}
    {% if settings.color_button_primary != blank %}
      --tg-component-button-primary-background-default: {{ settings.color_button_primary }};
    {% endif %}
    {% if settings.color_button_primary_hover != blank %}
      --tg-component-button-primary-background-hover: {{ settings.color_button_primary_hover }};
    {% endif %}
    {% if settings.color_button_primary_active != blank %}
      --tg-component-button-primary-background-active: {{ settings.color_button_primary_active }};
    {% endif %}
    {% if settings.color_button_primary_text != blank %}
      --tg-component-button-primary-text: {{ settings.color_button_primary_text }};
    {% endif %}
  }
{% endstyle %}
