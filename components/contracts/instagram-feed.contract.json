{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "instagram-feed",
  "name": "Instagram Feed",
  "registryId": "S16",
  "category": "sections",
  "status": "pilot",
  "summary": "Responsive social-media gallery shell with target-owned records, destinations, metadata, and feed integration.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/instagram-feed",
    "css": {
      "file": "components/css/sections.css",
      "selector": ".instagram-feed"
    },
    "docs": "site/src/content/components/instagram-feed.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".instagram-feed",
      "className": ".instagram-feed",
      "required": true,
      "description": "Social gallery section root."
    },
    {
      "name": "header",
      "selector": ".instagram-feed__header",
      "className": ".instagram-feed__header",
      "required": false,
      "description": "Optional centered heading and account region."
    },
    {
      "name": "heading",
      "selector": ".instagram-feed__heading",
      "className": ".instagram-feed__heading",
      "required": false,
      "description": "Optional visible section heading."
    },
    {
      "name": "handle",
      "selector": ".instagram-feed__handle",
      "className": ".instagram-feed__handle",
      "required": false,
      "description": "Optional native account-profile link."
    },
    {
      "name": "grid",
      "selector": ".instagram-feed__grid",
      "className": ".instagram-feed__grid",
      "required": true,
      "description": "Responsive target-owned social-item composition."
    },
    {
      "name": "item",
      "selector": ".instagram-feed__item",
      "className": ".instagram-feed__item",
      "required": false,
      "description": "Repeated target-owned social-media item."
    },
    {
      "name": "overlay",
      "selector": ".instagram-feed__overlay",
      "className": ".instagram-feed__overlay",
      "required": false,
      "description": "Optional metadata overlay disclosed without requiring hover."
    },
    {
      "name": "stat",
      "selector": ".instagram-feed__stat",
      "className": ".instagram-feed__stat",
      "required": false,
      "description": "Optional target-formatted social metric."
    },
    {
      "name": "cta",
      "selector": ".instagram-feed__cta",
      "className": ".instagram-feed__cta",
      "required": false,
      "description": "Optional target-owned action region."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default variant."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".instagram-feed"
      ],
      "description": "Resting social-gallery presentation."
    },
    {
      "name": "handleHover",
      "selectors": [
        ".instagram-feed__handle:hover"
      ],
      "description": "Pointer emphasis for the optional account link."
    },
    {
      "name": "handleFocusVisible",
      "selectors": [
        ".instagram-feed__handle:focus-visible"
      ],
      "description": "Visible keyboard focus on the optional account link."
    },
    {
      "name": "itemHover",
      "selectors": [
        ".instagram-feed__item:hover img",
        ".instagram-feed__item:hover::after",
        ".instagram-feed__item:hover .instagram-feed__overlay"
      ],
      "description": "Pointer image emphasis and metadata disclosure for one supplied item."
    },
    {
      "name": "itemFocusWithin",
      "selectors": [
        ".instagram-feed__item:focus-visible",
        ".instagram-feed__item:focus-within img",
        ".instagram-feed__item:focus-within::after",
        ".instagram-feed__item:focus-within .instagram-feed__overlay"
      ],
      "description": "Equivalent disclosure when target-owned interactive content receives keyboard focus."
    }
  ],
  "behavior": [
    {
      "name": "feedOwnership",
      "selectors": [
        ".instagram-feed"
      ],
      "description": "Targets own provider authorization, fetching, caching, consent, freshness, failure and empty states, record ordering, and metric formatting. Canonical CSS accepts already-rendered content only."
    },
    {
      "name": "itemNavigationBoundary",
      "selectors": [
        ".instagram-feed__item",
        ".instagram-feed__cta"
      ],
      "description": "This contract does not make every item navigational. Targets use native links or buttons only when real destinations or actions exist and preserve visible focus and accessible names."
    }
  ],
  "properties": [
    {
      "name": "heading",
      "type": "string",
      "required": false,
      "description": "Optional visible section heading.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".instagram-feed__heading" }]
      }
    },
    {
      "name": "handle",
      "type": "string",
      "required": false,
      "description": "Optional visible account handle.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".instagram-feed__handle" }]
      }
    },
    {
      "name": "handleDestination",
      "type": "string",
      "required": false,
      "description": "Target-owned profile destination for the optional handle link.",
      "targetMappings": {
        "web": [{ "kind": "attribute", "selector": ".instagram-feed__handle", "attribute": "href", "valueFrom": "property", "elements": ["a"] }]
      }
    },
    {
      "name": "items",
      "type": "slot",
      "required": true,
      "description": "Ordered target-owned social-media items and any supplied overlay metadata.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".instagram-feed__grid", "classNames": [".instagram-feed__grid"] }]
      }
    },
    {
      "name": "action",
      "type": "slot",
      "required": false,
      "description": "Optional target-owned account or gallery action.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".instagram-feed__cta", "classNames": [".instagram-feed__cta"] }]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-border-focus",
        "--color-text-accent",
        "--color-text-primary"
      ],
      "easing": [
        "--easing-default"
      ],
      "typography": [
        "--font-family-heading",
        "--typo-body-sm-size",
        "--typo-h3-size"
      ],
      "other": [
        "--section-spacing-y"
      ],
      "transition": [
        "--transition-default",
        "--transition-fast"
      ]
    }
  },
  "accessibility": [
    "Provide useful alternatives for informative social imagery and avoid repeating provider captions verbatim when adjacent text already names the item.",
    "Metadata overlays remain available on focus within and non-hover input rather than relying on pointer hover alone.",
    "Only real destinations or actions receive native link or button semantics, visible focus, and descriptive accessible names.",
    "Target-owned loading, empty, failure, consent, and stale-data states require accessible text rather than a permanently blank grid."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented in components/css/sections.css."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "native-component"
    },
    "compose": {
      "status": "planned",
      "kind": "native-component"
    }
  }
}
