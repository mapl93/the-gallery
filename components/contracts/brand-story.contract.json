{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "brand-story",
  "name": "Brand Story",
  "registryId": "S8",
  "category": "sections",
  "status": "pilot",
  "summary": "Responsive brand narrative section with target-owned media, rich story content, and optional signature.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/brand-story",
    "css": {
      "file": "components/css/sections.css",
      "selector": ".brand-story"
    },
    "docs": "site/src/content/components/brand-story.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".brand-story",
      "className": ".brand-story",
      "required": true,
      "description": "Brand story section root."
    },
    {
      "name": "grid",
      "selector": ".brand-story__grid",
      "className": ".brand-story__grid",
      "required": true,
      "description": "Responsive media and narrative layout."
    },
    {
      "name": "media",
      "selector": ".brand-story__media",
      "className": ".brand-story__media",
      "required": true,
      "description": "Target-owned brand media."
    },
    {
      "name": "content",
      "selector": ".brand-story__content",
      "className": ".brand-story__content",
      "required": true,
      "description": "Narrative content region."
    },
    {
      "name": "eyebrow",
      "selector": ".brand-story__eyebrow",
      "className": ".brand-story__eyebrow",
      "required": false,
      "description": "Optional short contextual label."
    },
    {
      "name": "title",
      "selector": ".brand-story__title",
      "className": ".brand-story__title",
      "required": true,
      "description": "Brand story heading."
    },
    {
      "name": "text",
      "selector": ".brand-story__text",
      "className": ".brand-story__text",
      "required": true,
      "description": "Target-owned narrative rich content."
    },
    {
      "name": "signature",
      "selector": ".brand-story__signature",
      "className": ".brand-story__signature",
      "required": false,
      "description": "Optional target-owned signature or maker mark."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default variant."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".brand-story"
      ],
      "description": "Resting brand story presentation."
    }
  ],
  "behavior": [
    {
      "name": "mediaSemantics",
      "selectors": [
        ".brand-story__media"
      ],
      "description": "Targets determine informative or decorative media semantics and supply appropriate alternative text."
    },
    {
      "name": "narrativeOrder",
      "selectors": [
        ".brand-story__grid"
      ],
      "description": "Adapters preserve a meaningful source order for media and narrative content when the layout stacks."
    }
  ],
  "properties": [
    {
      "name": "media",
      "type": "slot",
      "required": true,
      "description": "Target-owned brand media.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".brand-story__media", "classNames": [".brand-story__media"] }]
      }
    },
    {
      "name": "eyebrow",
      "type": "string",
      "required": false,
      "description": "Optional short context above the heading.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".brand-story__eyebrow" }]
      }
    },
    {
      "name": "title",
      "type": "string",
      "required": true,
      "description": "Visible brand story heading.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".brand-story__title" }]
      }
    },
    {
      "name": "body",
      "type": "slot",
      "required": true,
      "description": "Target-owned narrative rich content.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".brand-story__text", "classNames": [".brand-story__text"] }]
      }
    },
    {
      "name": "signature",
      "type": "slot",
      "required": false,
      "description": "Optional signature or maker-mark content.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".brand-story__signature", "classNames": [".brand-story__signature"] }]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-text-primary",
        "--color-text-secondary"
      ],
      "typography": [
        "--font-family-heading",
        "--typo-body-size",
        "--typo-h2-size"
      ],
      "radius": [
        "--radius-lg"
      ],
      "spacing": [
        "--space-layout-container",
        "--space-layout-section-gap"
      ]
    }
  },
  "accessibility": [
    "Use a contextual heading level and semantic paragraphs or rich-content elements for the narrative.",
    "Give informative media useful alternative text and hide decorative imagery or signatures when adjacent text already conveys the same identity.",
    "Preserve meaningful source order when the two-column layout stacks."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented in components/css/sections.css."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "native-component"
    },
    "compose": {
      "status": "planned",
      "kind": "native-component"
    }
  }
}
