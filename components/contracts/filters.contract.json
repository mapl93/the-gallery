{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.1.0",
  "slug": "filters",
  "name": "Collection Filters",
  "registryId": "E3",
  "category": "collection",
  "status": "pilot",
  "summary": "Collection filter layout with active filter tags, sidebar groups, option lists, and swatches.",
  "dependencies": ["checkbox", "radio", "tag"],
  "source": {
    "registry": "registry.json#/components/filters",
    "css": { "file": "components/css/collection.css", "selector": ".filters" },
    "docs": "site/src/content/components/filters.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".filters", "className": ".filters", "required": true, "description": "Filter container." },
    { "name": "bar", "selector": ".filters__bar", "className": ".filters__bar", "required": true, "description": "Top filter and sort bar." },
    { "name": "active", "selector": ".filters__active", "className": ".filters__active", "required": false, "description": "Active filter tag list." },
    { "name": "layout", "selector": ".filters__layout", "className": ".filters__layout", "required": false, "description": "Desktop filter/content layout." },
    { "name": "sidebar", "selector": ".filters__sidebar", "className": ".filters__sidebar", "required": false, "description": "Desktop filter sidebar." },
    { "name": "group", "selector": ".filter-group", "className": ".filter-group", "required": false, "description": "Single filter group." },
    { "name": "title", "selector": ".filter-group__title", "className": ".filter-group__title", "required": false, "description": "Filter group title or disclosure trigger." },
    { "name": "options", "selector": ".filter-group__options", "className": ".filter-group__options", "required": false, "description": "Filter option list." },
    { "name": "swatches", "selector": ".filter-swatches", "className": ".filter-swatches", "required": false, "description": "Swatch option list." },
    { "name": "swatch", "selector": ".filter-swatch", "className": ".filter-swatch", "required": false, "description": "Single swatch option." }
  ],
  "variants": [
    { "name": "default", "className": null, "default": true, "description": "Default responsive collection filters." }
  ],
  "sizes": [
    { "name": "default", "className": null, "default": true, "description": "Default filter spacing." }
  ],
  "states": [
    { "name": "default", "selectors": [".filters"], "description": "Default filter state." },
    { "name": "activeFilters", "selectors": [".filters__active"], "description": "Active filter tag list state." },
    { "name": "desktopSidebar", "selectors": [".filters__layout", ".filters__sidebar"], "description": "Desktop sidebar layout state." },
    { "name": "titleFocus", "selectors": ["button.filter-group__title:focus-visible"], "description": "Visible focus for interactive filter-group titles." }
  ],
  "behavior": [
    { "name": "filterSelection", "selectors": [".filter-group__options", ".filter-swatches"], "attributes": ["name", "value", "checked"], "events": ["change"], "description": "Filter selections should update collection query state and active filter tags." },
    { "name": "activeFilterRemoval", "selectors": [".filters__active"], "events": ["click"], "description": "Active filter tags should allow removing a filter without losing other selected filters." },
    { "name": "dependencyComposition", "selectors": [".filter-group__options"], "description": "Filters compose Checkbox, Radio, and Tag dependencies without replacing their semantics." }
  ],
  "properties": [
    { "name": "bar", "type": "slot", "required": true, "description": "Top-level filter and sort controls.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".filters__bar", "classNames": [".filters__bar"] }] } },
    { "name": "activeFilters", "type": "slot", "required": false, "description": "Removable active-filter Tag dependencies.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".filters__active", "classNames": [".filters__active"] }] } },
    { "name": "filterGroups", "type": "slot", "required": false, "description": "Filter groups composed from labelled Checkbox, Radio, or swatch controls.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".filter-group", "classNames": [".filter-group"] }] } },
    { "name": "sidebar", "type": "slot", "required": false, "description": "Optional desktop sidebar composition.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".filters__sidebar", "classNames": [".filters__sidebar"] }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-border-subtle", "--color-border-focus", "--color-text-primary"],
      "spacing": ["--space-layout-grid-gap", "--space-layout-element-gap"],
      "typography": ["--typo-body-size"]
    }
  },
  "accessibility": [
    "Group related filter controls with visible labels or fieldset/legend semantics.",
    "Keep filter changes announced when results update asynchronously.",
    "Do not remove keyboard focus when active filters are applied or removed."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/collection.css." },
    "shopify": { "status": "planned", "kind": "liquid-css-js", "notes": "Should map collection filters and URL params to selected controls and active tags." },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
