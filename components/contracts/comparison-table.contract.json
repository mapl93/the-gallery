      }
    },
    {
      "name": "table",
      "type": "slot",
      "required": true,
      "description": "Target-owned native table, including caption, headers, body rows, and any highlighted cells.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".comparison-table", "classNames": [".comparison-table"] }]
      }
    }
  ],
  "tokens": {
