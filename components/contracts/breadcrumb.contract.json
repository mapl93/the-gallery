{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "breadcrumb",
  "name": "Breadcrumb",
  "registryId": "B8",
  "category": "layout",
  "status": "pilot",
  "summary": "Navigation trail layout component with item, link, separator, current-page anatomy, hover state, and nav landmark requirements.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/breadcrumb",
    "css": {
      "file": "components/css/layout.css",
      "selector": ".breadcrumb"
    },
    "docs": "site/src/content/components/breadcrumb.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".breadcrumb",
      "className": ".breadcrumb",
      "required": true,
      "description": "Navigation trail wrapper."
    },
    {
      "name": "item",
      "selector": ".breadcrumb__item",
      "className": ".breadcrumb__item",
      "required": false,
      "description": "Optional wrapper for a breadcrumb segment."
    },
    {
      "name": "link",
      "selector": ".breadcrumb__link",
      "className": ".breadcrumb__link",
      "required": false,
      "description": "Navigable breadcrumb link."
    },
    {
      "name": "separator",
      "selector": ".breadcrumb__separator",
      "className": ".breadcrumb__separator",
      "required": false,
      "description": "Visual separator between items."
    },
    {
      "name": "current",
      "selector": ".breadcrumb__current",
      "className": ".breadcrumb__current",
      "required": true,
      "description": "Current page segment."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default breadcrumb trail."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default breadcrumb spacing and text size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [".breadcrumb"],
      "description": "Default breadcrumb state."
    },
    {
      "name": "linkHover",
      "selectors": [".breadcrumb__link:hover"],
      "description": "Pointer hover state on a breadcrumb link."
    },
    {
      "name": "current",
      "selectors": [".breadcrumb__current"],
      "description": "Current-page segment state."
    }
  ],
  "behavior": [
    {
      "name": "navigationLandmark",
      "selectors": [".breadcrumb"],
      "attributes": ["<nav>", "aria-label=\"Breadcrumb\""],
      "description": "Breadcrumbs should render as a named navigation landmark."
    },
    {
      "name": "currentPage",
      "selectors": [".breadcrumb__current"],
      "attributes": ["aria-current=\"page\""],
      "description": "The current page segment should be marked with aria-current=\"page\"."
    },
    {
      "name": "separatorSemantics",
      "selectors": [".breadcrumb__separator"],
      "attributes": ["aria-hidden=\"true\""],
      "description": "Visual separators should not be announced as extra breadcrumb items."
    }
  ],
  "properties": [
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "Breadcrumb",
      "description": "Accessible name for the breadcrumb navigation landmark.",
      "targetMappings": {
        "web": [
          {
            "kind": "attribute",
            "selector": ".breadcrumb",
            "attribute": "aria-label",
            "valueFrom": "property"
          }
        ]
      }
    },
    {
      "name": "currentLabel",
      "type": "string",
      "required": true,
      "description": "Visible label for the current page segment marked with aria-current.",
      "targetMappings": {
        "web": [
          {
            "kind": "content",
            "selector": ".breadcrumb__current"
          }
        ]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-text-secondary",
        "--color-text-accent",
        "--color-text-disabled",
        "--color-text-primary"
      ],
      "transition": [
        "--transition-fast"
      ],
      "easing": [
        "--easing-default"
      ],
      "typography": [
        "--typo-body-size"
      ],
      "spacing": [
        "--space-layout-element-gap"
      ]
    }
  },
  "accessibility": [
    "Use nav with aria-label=\"Breadcrumb\" for the breadcrumb region.",
    "Mark the current page with aria-current=\"page\".",
    "Hide purely visual separators from assistive technology.",
    "Keep breadcrumb labels concise and ordered from broadest to current page."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented by class composition in components/css/layout.css."
    },
    "shopify": {
      "status": "implemented",
      "kind": "liquid-css-class",
      "notes": "Shopify Liquid can render breadcrumb links and current item with the same class contract."
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "style"
    },
    "compose": {
      "status": "planned",
      "kind": "composable"
    }
  }
}
