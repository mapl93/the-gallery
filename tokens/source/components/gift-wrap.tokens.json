{
  "$description": "Cart note and wrapping visual roles preserve existing system gap factors and alias border/focus dimensions and weights. Native disclosure, Checkbox/Textarea and commercial truth retain their owners.",
  "component": {
    "gift-wrap": {
      "blockPaddingScale": {
        "$type": "number",
        "$value": 0.75
      },
      "inlinePaddingScale": {
        "$type": "number",
        "$value": 1
      },
      "infoGapScale": {
        "$type": "number",
        "$value": 0.125
      },
      "borderWidth": {
        "$type": "dimension",
        "$value": "{dimension.1}"
      },
      "labelWeight": {
        "$type": "fontWeight",
        "$value": "{font.weight.medium}"
      },
      "priceWeight": {
        "$type": "fontWeight",
        "$value": "{font.weight.regular}"
      }
    }
  }
}
