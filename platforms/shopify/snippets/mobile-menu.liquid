{%- comment -%}
  Snippet: mobile-menu
  Usage: {% render 'mobile-menu', menu: linklists['main-menu'] %}
{%- endcomment -%}

{%- assign mobile_menu = menu | default: linklists['main-menu'] -%}
<div class="drawer-overlay" data-mobile-menu-overlay aria-hidden="true"></div>
<aside class="drawer drawer--left"
       id="mobile-menu"
       role="dialog"
       aria-modal="true"
       aria-hidden="true"
       aria-labelledby="mobile-menu-title"
       data-mobile-menu>
  <div class="drawer__header">
    <h2 class="drawer__title" id="mobile-menu-title">{{ 'accessibility.menu' | t }}</h2>
    <button class="close-btn drawer__close"
            type="button"
            aria-label="{{ 'accessibility.close' | t }} {{ 'accessibility.menu' | t | downcase }}"
            data-mobile-menu-close>
      {% render 'icon', name: 'x' %}
    </button>
  </div>
  <nav class="drawer__body" aria-label="{{ 'accessibility.navigation' | t }}">
    <ul class="mobile-nav">
      {% for link in mobile_menu.links %}
        <li class="mobile-nav__item">
          <a class="mobile-nav__link" href="{{ link.url }}"
             {% if link.active %}aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        </li>
      {% endfor %}
    </ul>
  </nav>
</aside>
