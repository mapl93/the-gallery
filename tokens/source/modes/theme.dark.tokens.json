{
  "$description": "Dark theme overrides. Compile this with primitives, semantics, components, and one viewport mode.",
  "color": {
    "surface": {
      "primary": { "$type": "color", "$value": "{color.gray.900}" },
      "secondary": { "$type": "color", "$value": "{color.gray.800}" },
      "archival": { "$type": "color", "$value": "{color.brown.800}" },
      "statement": { "$type": "color", "$value": "{color.orange.800}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.gray.50}" },
      "secondary": { "$type": "color", "$value": "{color.gray.300}" },
      "archival": { "$type": "color", "$value": "{color.brown.400}" },
      "statement": { "$type": "color", "$value": "{color.orange.400}" },
      "inverse": { "$type": "color", "$value": "{color.gray.900}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.gray.700}" },
      "strong": { "$type": "color", "$value": "{color.gray.0}" },
      "archival": { "$type": "color", "$value": "{color.brown.600}" },
      "statement": { "$type": "color", "$value": "{color.orange.600}" }
    },
    "feedback": {
      "info": {
        "background": { "$type": "color", "$value": "{color.blue.700}" },
        "default": { "$type": "color", "$value": "{color.blue.400}" },
        "hover": { "$type": "color", "$value": "{color.blue.300}" }
      },
      "success": {
        "background": { "$type": "color", "$value": "{color.green.700}" },
        "default": { "$type": "color", "$value": "{color.green.400}" }
      },
      "warning": {
        "background": { "$type": "color", "$value": "{color.amber.700}" },
        "default": { "$type": "color", "$value": "{color.amber.400}" }
      },
      "error": {
        "background": { "$type": "color", "$value": "{color.red.700}" },
        "default": { "$type": "color", "$value": "{color.red.400}" }
      }
    }
  },
  "shadow": {
    "sm": {
      "color": { "$type": "color", "$value": "rgba(245, 245, 245, 0.10)" }
    },
    "md": {
      "color": { "$type": "color", "$value": "rgba(245, 245, 245, 0.15)" }
    },
    "lg": {
      "color": { "$type": "color", "$value": "rgba(245, 245, 245, 0.20)" }
    },
    "xl": {
      "color": { "$type": "color", "$value": "rgba(245, 245, 245, 0.25)" }
    },
    "2xl": {
      "color": { "$type": "color", "$value": "rgba(245, 245, 245, 0.30)" }
    }
  },
  "component": {
    "button": {
      "primary": {
        "background": {
          "default": { "$type": "color", "$value": "{color.gray.0}" },
          "hover": { "$type": "color", "$value": "{color.gray.50}" },
          "active": { "$type": "color", "$value": "{color.gray.100}" }
        },
        "text": { "$type": "color", "$value": "{color.gray.900}" },
        "border": { "$type": "color", "$value": "{color.transparent}" }
      },
      "secondary": {
        "background": {
          "default": { "$type": "color", "$value": "{color.gray.800}" },
          "hover": { "$type": "color", "$value": "{color.gray.700}" },
          "active": { "$type": "color", "$value": "{color.gray.600}" }
        },
        "text": { "$type": "color", "$value": "{color.gray.50}" },
        "border": { "$type": "color", "$value": "{color.transparent}" }
      },
      "outline": {
        "background": {
          "default": { "$type": "color", "$value": "{color.transparent}" },
          "hover": { "$type": "color", "$value": "{color.gray.800}" },
          "active": { "$type": "color", "$value": "{color.gray.700}" }
        },
        "text": { "$type": "color", "$value": "{color.gray.0}" },
        "border": { "$type": "color", "$value": "{color.gray.0}" }
      },
      "link": {
        "background": {
          "default": { "$type": "color", "$value": "{color.transparent}" },
          "hover": { "$type": "color", "$value": "{color.transparent}" }
        },
        "text": { "$type": "color", "$value": "{color.gray.50}" },
        "border": { "$type": "color", "$value": "{color.transparent}" }
      }
    }
  }
}
