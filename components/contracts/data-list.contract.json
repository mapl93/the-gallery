{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "data-list",
  "name": "Data List / Description List",
  "registryId": "A26",
  "category": "primitives",
  "status": "pilot",
  "summary": "Description-list primitive for key-value data with vertical default and horizontal variants.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/data-list",
    "css": { "file": "components/css/primitives.css", "selector": ".data-list" },
    "docs": "site/src/content/components/data-list.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".data-list", "className": ".data-list", "required": true, "description": "Description list wrapper." },
    { "name": "item", "selector": ".data-list__item", "className": ".data-list__item", "required": true, "description": "Single key-value row." },
    { "name": "key", "selector": ".data-list__key", "className": ".data-list__key", "required": true, "description": "Term or key." },
    { "name": "value", "selector": ".data-list__value", "className": ".data-list__value", "required": true, "description": "Description or value." }
  ],
  "variants": [
    { "name": "vertical", "className": null, "default": true, "description": "Default vertical key-value list." },
    { "name": "horizontal", "className": ".data-list--horizontal", "default": false, "description": "Horizontal wrapping key-value list." }
  ],
  "sizes": [
    { "name": "default", "className": null, "default": true, "description": "Default data-list spacing." }
  ],
  "states": [
    { "name": "default", "selectors": [".data-list"], "description": "Default data-list state." },
    { "name": "horizontal", "selectors": [".data-list--horizontal"], "description": "Horizontal layout state." }
  ],
  "behavior": [
    { "name": "descriptionListSemantics", "selectors": [".data-list", ".data-list__key", ".data-list__value"], "attributes": ["<dl>", "<dt>", "<dd>"], "description": "Targets preserve description-list semantics and keep each term adjacent to its description in source order." },
    { "name": "repeatedContent", "selectors": [".data-list__item"], "description": "The consumer owns the repeated key-value pairs; the component contract styles their shared anatomy without defining fixture content as defaults." }
  ],
  "properties": [
    {
      "name": "variant",
      "type": "enum",
      "required": false,
      "valuesFrom": "variants",
      "description": "Selects the vertical row layout or horizontal wrapping layout.",
      "targetMappings": {
        "web": [{ "kind": "optionClass", "selector": ".data-list", "source": "variants" }]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": ["--color-border-subtle", "--color-text-secondary", "--color-text-primary"],
      "typography": ["--typo-body-size"]
    }
  },
  "accessibility": [
    "Use dl, dt, and dd semantics for key-value data.",
    "Keep each key adjacent to its value in reading order.",
    "Avoid using Data List for unrelated navigation or layout-only content."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented by class composition in components/css/primitives.css." },
    "shopify": { "status": "implemented", "kind": "liquid-css-class" },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "style" },
    "compose": { "status": "planned", "kind": "composable" }
  }
}
