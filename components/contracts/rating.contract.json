{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "rating",
  "name": "Rating Stars",
  "registryId": "A11",
  "category": "primitives",
  "status": "pilot",
  "summary": "Read-only star rating primitive with filled and half-star anatomy, review count text, and accessible rating-label requirements.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/rating",
    "css": {
      "file": "components/css/primitives.css",
      "selector": ".rating"
    },
    "docs": "site/src/content/components/rating.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".rating",
      "className": ".rating",
      "required": true,
      "description": "Inline read-only rating wrapper."
    },
    {
      "name": "stars",
      "selector": ".rating__stars",
      "className": ".rating__stars",
      "required": true,
      "description": "Star icon group."
    },
    {
      "name": "star",
      "selector": ".rating__star",
      "className": ".rating__star",
      "required": true,
      "description": "Single star glyph or icon."
    },
    {
      "name": "count",
      "selector": ".rating__count",
      "className": ".rating__count",
      "required": false,
      "description": "Optional review count text."
    },
    {
      "name": "halfFill",
      "selector": ".rating__star--half::before",
      "required": false,
      "generated": true,
      "description": "Generated half-fill layer for a half-star."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default read-only rating."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default star size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [".rating"],
      "description": "Default rating state."
    },
    {
      "name": "filled",
      "selectors": [".rating__star--filled"],
      "description": "Filled star state."
    },
    {
      "name": "half",
      "selectors": [".rating__star--half", ".rating__star--half::before"],
      "description": "Half-star state."
    }
  ],
  "behavior": [
    {
      "name": "readOnlyRating",
      "selectors": [".rating", ".rating__stars"],
      "attributes": ["aria-label", "role=\"img\""],
      "description": "Read-only ratings should expose a text alternative such as \"4.5 out of 5 stars\"."
    },
    {
      "name": "reviewCount",
      "selectors": [".rating__count"],
      "description": "Review count text should be visible and included in the surrounding product or review context."
    }
  ],
  "properties": [
    {
      "name": "accessibleLabel",
      "type": "string",
      "required": true,
      "description": "Localized text alternative that communicates the displayed rating value and scale.",
      "targetMappings": {
        "web": [
          {
            "kind": "attribute",
            "selector": ".rating",
            "attribute": "aria-label",
            "valueFrom": "property"
          }
        ]
      }
    },
    {
      "name": "reviewCount",
      "type": "string",
      "required": false,
      "unsetBehavior": "Omit the count element when no localized review-count text is supplied.",
      "description": "Optional localized review-count text displayed beside the stars.",
      "targetMappings": {
        "web": [
          {
            "kind": "content",
            "selector": ".rating__count"
          }
        ]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-text-accent",
        "--color-border-subtle",
        "--color-text-secondary"
      ],
      "typography": [
        "--typo-body-size"
      ]
    }
  },
  "accessibility": [
    "Provide a text alternative for the numeric rating value.",
    "Do not expose every decorative star as separate assistive technology content.",
    "Use Star Input for interactive rating input; Rating Stars is display-only.",
    "Do not rely on color alone to communicate rating value."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented by class composition in components/css/primitives.css."
    },
    "shopify": {
      "status": "implemented",
      "kind": "liquid-css-class",
      "notes": "Shopify Liquid can render product rating metadata and count text with the same class contract."
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "style"
    },
    "compose": {
      "status": "planned",
      "kind": "composable"
    }
  }
}
