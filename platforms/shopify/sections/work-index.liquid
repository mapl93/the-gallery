{%- liquid
  assign work_heading = section.settings.heading
  if work_heading == blank
    if section.settings.heading_context == 'individual-pieces'
      assign work_heading = 'work.individual_pieces_title' | t
    else
      assign work_heading = 'work.title' | t
    endif
  endif
-%}

<section
  class="storefront-work"
  aria-labelledby="StorefrontWorkTitle-{{ section.id }}"
  data-storefront-work
  data-result-singular="{{ 'work.results.singular' | t | escape }}"
  data-result-plural="{{ 'work.results.plural' | t | escape }}"
>
  <h1 class="visually-hidden" id="StorefrontWorkTitle-{{ section.id }}">{{ work_heading }}</h1>

  {%- if section.settings.enable_search or section.settings.enable_filters or section.settings.enable_sorting -%}
    <form class="storefront-work__controls" data-work-controls hidden>
      {%- if section.settings.enable_search -%}
        <div class="input storefront-work__search">
          <label class="input__label" for="StorefrontWorkSearch-{{ section.id }}">{{ 'work.search.label' | t }}</label>
          <div class="input__control">
            <input
              class="input__field"
              id="StorefrontWorkSearch-{{ section.id }}"
              type="search"
              autocomplete="off"
              placeholder="{{ 'work.search.placeholder' | t | escape }}"
              data-work-search
            >
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.enable_filters -%}
        <div class="select">
          <label class="select__label" for="StorefrontWorkType-{{ section.id }}">{{ 'work.filters.type' | t }}</label>
          <select class="select__field" id="StorefrontWorkType-{{ section.id }}" data-work-filter="kind">
            <option value="">{{ 'work.filters.all_types' | t }}</option>
            <option value="collection">{{ 'work.types.collection' | t }}</option>
            <option value="piece">{{ 'work.types.individual_pieces' | t }}</option>
            <option value="service">{{ 'work.types.service' | t }}</option>
          </select>
        </div>

        <div class="select">
          <label class="select__label" for="StorefrontWorkEdition-{{ section.id }}">{{ 'work.filters.edition' | t }}</label>
          <select class="select__field" id="StorefrontWorkEdition-{{ section.id }}" data-work-filter="edition">
            <option value="">{{ 'work.filters.all_editions' | t }}</option>
            <option value="limited">{{ 'work.editions.limited' | t }}</option>
            <option value="permanent">{{ 'work.editions.permanent' | t }}</option>
          </select>
        </div>

        <div class="select">
          <label class="select__label" for="StorefrontWorkAvailability-{{ section.id }}">{{ 'work.filters.availability' | t }}</label>
          <select class="select__field" id="StorefrontWorkAvailability-{{ section.id }}" data-work-filter="availability">
            <option value="">{{ 'work.filters.all_availability' | t }}</option>
            <option value="available">{{ 'work.availability.available' | t }}</option>
            <option value="coming-soon">{{ 'work.availability.coming_soon' | t }}</option>
            <option value="unavailable">{{ 'work.availability.unavailable' | t }}</option>
          </select>
        </div>

        <div class="select">
          <label class="select__label" for="StorefrontWorkOffer-{{ section.id }}">{{ 'work.filters.offer' | t }}</label>
          <select class="select__field" id="StorefrontWorkOffer-{{ section.id }}" data-work-filter="offer">
            <option value="">{{ 'work.filters.all_offers' | t }}</option>
            <option value="product">{{ 'work.offers.product' | t }}</option>
            <option value="service">{{ 'work.offers.service' | t }}</option>
          </select>
        </div>
      {%- endif -%}

      {%- if section.settings.enable_sorting -%}
        <div class="select">
          <label class="select__label" for="StorefrontWorkSort-{{ section.id }}">{{ 'work.sort.label' | t }}</label>
          <select class="select__field" id="StorefrontWorkSort-{{ section.id }}" data-work-sort>
            <option value="default">{{ 'work.sort.default' | t }}</option>
            <option value="date-desc">{{ 'work.sort.newest' | t }}</option>
            <option value="date-asc">{{ 'work.sort.oldest' | t }}</option>
            <option value="availability">{{ 'work.sort.availability' | t }}</option>
            <option value="kind">{{ 'work.sort.type' | t }}</option>
            <option value="offer">{{ 'work.sort.offer' | t }}</option>
            <option value="title">{{ 'work.sort.title' | t }}</option>
          </select>
        </div>
      {%- endif -%}

      <div class="storefront-work__control-meta">
        <button class="btn btn--outline btn--sm" type="reset">{{ 'work.filters.clear' | t }}</button>
        <p class="storefront-work__result-count" aria-live="polite" data-work-result-count></p>
      </div>
    </form>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="storefront-work__grid" data-work-grid>
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_image = block.settings.image
          assign card_hover_image = block.settings.hover_image
          assign card_hover_video = block.settings.hover_video
          assign card_title = block.settings.title
          assign card_description = block.settings.description
          assign card_url = block.settings.url
          assign selected_collection = block.settings.collection
          assign card_kind = block.settings.kind
          assign card_filter_kind = card_kind
          assign card_type_label = 'work.types.collection' | t
          assign image_loading = 'lazy'

          if forloop.index <= 3
            assign image_loading = 'eager'
          endif

          if card_kind == 'piece-index'
            assign card_filter_kind = 'piece'
            assign card_type_label = 'work.types.individual_pieces' | t
          elsif card_kind == 'piece'
            assign card_filter_kind = 'piece'
            assign card_type_label = 'work.types.individual_piece' | t
          elsif card_kind == 'service'
            assign card_type_label = 'work.types.service' | t
          endif

          if selected_collection != blank
            if card_image == blank
              assign card_image = selected_collection.featured_image
            endif
            if card_title == blank
              assign card_title = selected_collection.title
            endif
            if card_description == blank
              assign card_description = selected_collection.description | strip_html | truncatewords: 30
            endif
            if card_url == blank
              assign card_url = selected_collection.url
            endif
          endif

          if card_title == blank
            if card_kind == 'piece-index'
              assign card_title = 'work.types.individual_pieces' | t
            else
              assign card_title = 'work.untitled' | t
            endif
          endif

          capture card_search_text
            echo card_title
            echo ' '
            echo card_description
            echo ' '
            echo block.settings.search_terms
          endcapture
        -%}

        <li
          class="storefront-work__item"
          data-work-item
          data-work-kind="{{ card_filter_kind }}"
          data-work-edition="{% if block.settings.limited %}limited{% else %}permanent{% endif %}"
          data-work-availability="{{ block.settings.availability }}"
          data-work-offer="{{ block.settings.offer_kind }}"
          data-work-featured="{{ block.settings.featured }}"
          data-work-date="{{ block.settings.publication_date | escape }}"
          data-work-search="{{ card_search_text | strip_html | strip_newlines | downcase | escape }}"
          data-work-title="{{ card_title | downcase | escape }}"
          {{ block.shopify_attributes }}
        >
          {%- if card_url != blank -%}
            <a class="storefront-work-card" href="{{ card_url }}">
          {%- else -%}
            <article class="storefront-work-card">
          {%- endif -%}
              <div class="storefront-work-card__media">
                {%- if card_image != blank -%}
                  {{ card_image
                    | image_url: width: 1800
                    | image_tag:
                      widths: '480, 720, 960, 1200, 1500, 1800',
                      sizes: '(min-width: 768px) 33vw, 100vw',
                      loading: image_loading,
                      class: 'storefront-work-card__image storefront-work-card__image--primary',
                      alt: card_image.alt | default: card_title
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'storefront-work-card__image storefront-work-card__image--primary storefront-work-card__placeholder placeholder-svg' }}
                {%- endif -%}

                {%- if card_hover_video != blank -%}
                  {{ card_hover_video
                    | video_tag:
                      autoplay: false,
                      loop: true,
                      muted: true,
                      controls: false,
                      playsinline: true,
                      preload: 'metadata',
                      class: 'storefront-work-card__image storefront-work-card__image--hover storefront-work-card__video',
                      data-work-hover-video: ''
                  }}
                {%- elsif card_hover_image != blank -%}
                  {{ card_hover_image
                    | image_url: width: 1800
                    | image_tag:
                      widths: '480, 720, 960, 1200, 1500, 1800',
                      sizes: '(min-width: 768px) 33vw, 100vw',
                      loading: 'lazy',
                      class: 'storefront-work-card__image storefront-work-card__image--hover',
                      alt: ''
                  }}
                {%- endif -%}
              </div>

              <div class="storefront-work-card__content">
                <ul class="storefront-work-card__tags" aria-label="{{ 'work.tags.label' | t | escape }}">
                  <li class="storefront-work-card__tag">{{ card_type_label }}</li>
                  {%- if block.settings.limited and card_kind == 'collection' -%}
                    <li class="storefront-work-card__tag">{{ 'work.editions.limited' | t }}</li>
                  {%- endif -%}
                </ul>
                <h2 class="storefront-work-card__title">{{ card_title }}</h2>
              </div>
          {%- if card_url != blank -%}
            </a>
          {%- else -%}
            </article>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    <div class="storefront-work__empty" data-work-empty hidden>
      <p>{{ 'work.no_results' | t }}</p>
      <button class="btn btn--outline" type="button" data-work-clear>{{ 'work.filters.clear' | t }}</button>
    </div>
  {%- elsif request.design_mode -%}
    <p>{{ 'work.editor_hint' | t }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Work index",
  "settings": [
    {
      "type": "select",
      "id": "heading_context",
      "label": "Translated heading",
      "default": "work",
      "options": [
        { "value": "work", "label": "Work" },
        { "value": "individual-pieces", "label": "Individual pieces" }
      ]
    },
    { "type": "text", "id": "heading", "label": "Custom accessible heading" },
    { "type": "checkbox", "id": "enable_search", "label": "Enable search", "default": true },
    { "type": "checkbox", "id": "enable_filters", "label": "Enable filters", "default": true },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "Work entry",
      "settings": [
        {
          "type": "select",
          "id": "kind",
          "label": "Type",
          "default": "collection",
          "options": [
            { "value": "collection", "label": "Collection" },
            { "value": "piece-index", "label": "Individual pieces index" },
            { "value": "piece", "label": "Individual piece" },
            { "value": "service", "label": "Service" }
          ]
        },
        { "type": "collection", "id": "collection", "label": "Shopify collection source" },
        { "type": "image_picker", "id": "image", "label": "Primary image" },
        { "type": "video", "id": "hover_video", "label": "Hover video" },
        { "type": "image_picker", "id": "hover_image", "label": "Hover image fallback" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "textarea", "id": "description", "label": "Search description" },
        { "type": "text", "id": "search_terms", "label": "Additional search terms" },
        { "type": "url", "id": "url", "label": "Dedicated page" },
        { "type": "checkbox", "id": "limited", "label": "Limited edition", "default": false },
        {
          "type": "select",
          "id": "availability",
          "label": "Availability",
          "default": "unspecified",
          "options": [
            { "value": "unspecified", "label": "Not specified" },
            { "value": "available", "label": "Available" },
            { "value": "coming-soon", "label": "Coming soon" },
            { "value": "unavailable", "label": "Unavailable" }
          ]
        },
        {
          "type": "select",
          "id": "offer_kind",
          "label": "Offer type",
          "default": "product",
          "options": [
            { "value": "product", "label": "Product" },
            { "value": "service", "label": "Service" }
          ]
        },
        { "type": "text", "id": "publication_date", "label": "Publication date (YYYY-MM-DD)" },
        { "type": "checkbox", "id": "featured", "label": "Pin in default order", "default": false }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [{ "name": "Work index" }]
}
{% endschema %}
