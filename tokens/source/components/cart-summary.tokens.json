{
  "$description": "Public cart summary/discount visual values preserve existing defaults and semantic composition. Factors use system element gap; weights and borders alias system values. No cart or promotion engine.",
  "component": {
    "cart-summary": {
      "gapScale": {
        "$type": "number",
        "$value": 1
      },
      "paddingScale": {
        "$type": "number",
        "$value": 1
      },
      "rowsGapScale": {
        "$type": "number",
        "$value": 0.375
      },
      "rowGapScale": {
        "$type": "number",
        "$value": 0.5
      },
      "totalMarginScale": {
        "$type": "number",
        "$value": 0.125
      },
      "totalPaddingScale": {
        "$type": "number",
        "$value": 0.5
      },
      "expressGapScale": {
        "$type": "number",
        "$value": 0.5
      },
      "totalBorderWidth": {
        "$type": "dimension",
        "$value": "{dimension.1}"
      },
      "titleWeight": {
        "$type": "fontWeight",
        "$value": "{font.weight.semibold}"
      },
      "totalWeight": {
        "$type": "fontWeight",
        "$value": "{font.weight.bold}"
      }
    }
  }
}
