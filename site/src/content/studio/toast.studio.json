      ]
    },
    {
      "id": "presentation",
      "label": "Presentation",
      "controls": [
        { "id": "variant", "label": "Variant", "kind": "segmented", "properties": ["variant"] },
        { "id": "announcement", "label": "Announcement", "kind": "segmented", "properties": ["announcement"] }
      ]
    },
    {
      "id": "behavior",
      "label": "Behavior",
      "controls": [
        { "id": "visible", "label": "Visible", "kind": "toggle", "properties": ["visible"] }
      ]
    },
    {
      "id": "appearance",
      "label": "Appearance",
      "controls": [
        { "id": "surface", "label": "Surface", "kind": "token-swatch", "tokens": { "category": "color", "names": ["--color-surface-primary"] } },
        { "id": "default-border", "label": "Default border", "kind": "token-swatch", "tokens": { "category": "color", "names": ["--color-border-default"] } },
        { "id": "title-color", "label": "Title", "kind": "token-swatch", "tokens": { "category": "color", "names": ["--color-text-primary"] } },
