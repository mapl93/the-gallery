{%- if section.settings.heading != blank -%}
  {%- liquid
    assign hero_layout = section.settings.layout | default: 'full'
    assign hero_height = section.settings.height | default: 'default'
    assign media_behavior = section.settings.media_behavior | default: 'none'
    assign navigation = section.settings.navigation | default: 'both'
    assign interval_ms = section.settings.autoplay_interval | times: 1000
    assign has_media = false
    assign has_slides = false
    assign autoplay = false
    assign loading = 'lazy'
    assign fetchpriority = 'auto'

    if section.index <= 1
      assign loading = 'eager'
      assign fetchpriority = 'high'
    endif

    if hero_layout == 'text-only'
      assign media_behavior = 'none'
    elsif media_behavior == 'slideshow' and section.blocks.size > 1
      assign has_media = true
      assign has_slides = true
    elsif section.settings.video != blank or section.settings.image != blank
      assign has_media = true
      unless media_behavior == 'parallax'
        assign media_behavior = 'none'
      endunless
    else
      assign media_behavior = 'none'
    endif

    if has_slides and section.settings.autoplay
      assign autoplay = true
    endif

    assign status_template = 'hero.slide_status' | t: current: '{current}', total: '{total}'
  -%}

  <section
    class="hero{% if has_slides %} carousel{% endif %}{% if hero_layout == 'split' %} hero--split{% elsif hero_layout == 'text-only' %} hero--text-only{% endif %}{% if hero_height == 'fullscreen' %} hero--fullscreen{% endif %}"
    aria-labelledby="HeroTitle-{{ section.id }}"
    {% if has_slides %}aria-roledescription="carousel"{% endif %}
    data-hero
    data-media-behavior="{{ media_behavior }}"
    data-autoplay="{{ autoplay }}"
    data-loop="{{ section.settings.loop }}"
    data-navigation="{{ navigation }}"
    data-autoplay-interval="{{ interval_ms }}"
    style="--_hero-interval: {{ interval_ms }}ms;"
  >
    <div class="hero__inner">
      {%- if has_media -%}
        <div class="hero__media">
          {%- if has_slides -%}
            <div
              class="hero__track carousel__track"
              id="HeroTrack-{{ section.id }}"
              tabindex="0"
              aria-label="{{ 'hero.slides' | t }}"
            >
              {%- for block in section.blocks -%}
                <div
                  class="hero__slide carousel__slide"
                  role="group"
                  aria-roledescription="slide"
                  aria-label="{{ 'hero.slide_status' | t: current: forloop.index, total: forloop.length }}"
                  {% if forloop.first %}aria-current="true"{% endif %}
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 2400 | image_tag:
                      alt: block.settings.image_alt,
                      loading: loading,
                      widths: '480,768,1024,1440,1920,2400',
                      sizes: '100vw',
                      fetchpriority: fetchpriority
                    }}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- elsif section.settings.video != blank -%}
            {{ section.settings.video | video_tag:
              class: 'hero__media-item',
              autoplay: false,
              loop: false,
              muted: false,
              controls: true,
              playsinline: true,
              preload: 'metadata'
            }}
          {%- elsif section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 2400 | image_tag:
              class: 'hero__media-item',
              alt: section.settings.image_alt,
              loading: loading,
              widths: '480,768,1024,1440,1920,2400',
              sizes: '100vw',
              fetchpriority: fetchpriority
            }}
          {%- endif -%}

          {%- if section.settings.overlay -%}
            <div class="hero__overlay" aria-hidden="true"></div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="hero__content">
        {%- if section.settings.label != blank -%}
          <p class="hero__label">{{ section.settings.label }}</p>
        {%- endif -%}
        <h1 class="hero__title" id="HeroTitle-{{ section.id }}">{{ section.settings.heading }}</h1>
        {%- if section.settings.description != blank -%}
          <div class="hero__description">{{ section.settings.description }}</div>
        {%- endif -%}
        {%- if section.settings.cta_url != blank or section.settings.cta2_url != blank -%}
          <div class="hero__actions">
            {%- if section.settings.cta_url != blank -%}
              <a href="{{ section.settings.cta_url }}" class="btn btn--primary">
                {{ section.settings.cta_text | default: 'Shop now' }}
              </a>
            {%- endif -%}
            {%- if section.settings.cta2_url != blank -%}
              <a href="{{ section.settings.cta2_url }}" class="btn btn--secondary">
                {{ section.settings.cta2_text }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if has_slides -%}
      <div class="hero__controls" aria-label="{{ 'hero.controls' | t }}">
        {%- if navigation == 'both' or navigation == 'arrows' -%}
          <button class="icon-btn icon-btn--round carousel__nav-btn hero__previous" type="button" aria-label="{{ 'hero.previous' | t }}" aria-controls="HeroTrack-{{ section.id }}">
            <svg class="icon-btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
          </button>
          <button class="icon-btn icon-btn--round carousel__nav-btn hero__next" type="button" aria-label="{{ 'hero.next' | t }}" aria-controls="HeroTrack-{{ section.id }}">
            <svg class="icon-btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
          </button>
        {%- endif -%}

        {%- if navigation == 'both' or navigation == 'indicators' -%}
          <div class="hero__indicators carousel__dots" aria-label="{{ 'hero.choose_slide' | t }}">
            {%- for block in section.blocks -%}
              <button
                class="hero__indicator carousel__dot{% if forloop.first %} carousel__dot--active{% endif %}"
                type="button"
                aria-label="{{ 'hero.go_to_slide' | t: current: forloop.index, total: forloop.length }}"
                aria-controls="HeroTrack-{{ section.id }}"
                {% if forloop.first %}aria-current="true"{% endif %}
              ></button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if autoplay -%}
          <button
            class="icon-btn icon-btn--round carousel__nav-btn hero__rotation-control"
            type="button"
            aria-label="{{ 'hero.pause' | t }}"
            aria-pressed="false"
            data-pause-label="{{ 'hero.pause' | t | escape }}"
            data-play-label="{{ 'hero.play' | t | escape }}"
          >
            <span class="hero__pause-icon"><svg class="icon-btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5v14M15 5v14" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"/></svg></span>
            <span class="hero__play-icon" hidden><svg class="icon-btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="2"/></svg></span>
          </button>
        {%- endif -%}
      </div>

      {%- if autoplay -%}
        <div class="hero__progress" aria-hidden="true"><span class="hero__progress-value"></span></div>
      {%- endif -%}
      <p class="hero__status carousel__status visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-status-template="{{ status_template | escape }}">
        {{ 'hero.slide_status' | t: current: 1, total: section.blocks.size }}
      </p>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Hero",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "full",
      "options": [
        { "value": "full", "label": "Full" },
        { "value": "split", "label": "Split" },
        { "value": "text-only", "label": "Text only" }
      ]
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "fullscreen", "label": "Fullscreen" }
      ]
    },
    {
      "type": "select",
      "id": "media_behavior",
      "label": "Media behavior",
      "default": "none",
      "options": [
        { "value": "none", "label": "Single media" },
        { "value": "parallax", "label": "Parallax" },
        { "value": "slideshow", "label": "Slideshow" }
      ]
    },
    { "type": "image_picker", "id": "image", "label": "Single image" },
    { "type": "text", "id": "image_alt", "label": "Single image alternative text" },
    { "type": "video", "id": "video", "label": "Single video" },
    { "type": "checkbox", "id": "overlay", "label": "Show media scrim", "default": true },
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Art in every detail" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Handcrafted ceramics shaped for considered daily rituals.</p>" },
    { "type": "text", "id": "cta_text", "label": "Primary action text", "default": "Shop now" },
    { "type": "url", "id": "cta_url", "label": "Primary action link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary action text" },
    { "type": "url", "id": "cta2_url", "label": "Secondary action link" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay slideshow", "default": false },
    { "type": "checkbox", "id": "loop", "label": "Loop slideshow", "default": true },
    {
      "type": "select",
      "id": "navigation",
      "label": "Slideshow navigation",
      "default": "both",
      "options": [
        { "value": "both", "label": "Arrows and indicators" },
        { "value": "arrows", "label": "Arrows" },
        { "value": "indicators", "label": "Indicators" }
      ]
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Autoplay interval",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Image slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Alternative text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
