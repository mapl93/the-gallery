{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.1.0",
  "slug": "store-pickup",
  "name": "Store Pickup Availability",
  "registryId": "D9",
  "category": "product",
  "status": "pilot",
  "summary": "Expandable store pickup availability list with locations, status icons, details, and hours.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/store-pickup",
    "css": { "file": "components/css/product.css", "selector": ".store-pickup" },
    "docs": "site/src/content/components/store-pickup.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".store-pickup", "className": ".store-pickup", "required": true, "description": "Store pickup disclosure container." },
    { "name": "toggle", "selector": ".store-pickup__toggle", "className": ".store-pickup__toggle", "required": true, "description": "Disclosure toggle." },
    { "name": "toggleIcon", "selector": ".store-pickup__toggle-icon", "className": ".store-pickup__toggle-icon", "required": false, "description": "Disclosure indicator icon." },
    { "name": "content", "selector": ".store-pickup__content", "className": ".store-pickup__content", "required": true, "description": "Expanded pickup content." },
    { "name": "location", "selector": ".store-pickup__location", "className": ".store-pickup__location", "required": true, "description": "Single pickup location." },
    { "name": "statusIcon", "selector": ".store-pickup__status-icon", "className": ".store-pickup__status-icon", "required": false, "description": "Availability status icon." },
    { "name": "locationName", "selector": ".store-pickup__location-name", "className": ".store-pickup__location-name", "required": true, "description": "Location name." },
    { "name": "locationDetail", "selector": ".store-pickup__location-detail", "className": ".store-pickup__location-detail", "required": false, "description": "Pickup detail such as readiness time." },
    { "name": "locationHours", "selector": ".store-pickup__location-hours", "className": ".store-pickup__location-hours", "required": false, "description": "Location hours." }
  ],
  "variants": [
    { "name": "default", "className": null, "default": true, "description": "Default pickup availability disclosure." }
  ],
  "sizes": [
    { "name": "default", "className": null, "default": true, "description": "Default pickup availability size." }
  ],
  "states": [
    { "name": "collapsed", "selectors": [".store-pickup__content"], "description": "Collapsed disclosure content state." },
    { "name": "expanded", "selectors": [".store-pickup[aria-expanded=\"true\"] .store-pickup__content", ".store-pickup[aria-expanded=\"true\"] .store-pickup__toggle-icon"], "description": "Expanded disclosure state." },
    { "name": "available", "selectors": [".store-pickup__status-icon--available"], "description": "Available pickup status." },
    { "name": "unavailable", "selectors": [".store-pickup__status-icon--unavailable"], "description": "Unavailable pickup status." }
  ],
  "behavior": [
    { "name": "disclosure", "selectors": [".store-pickup[aria-expanded=\"true\"] .store-pickup__content", ".store-pickup__toggle"], "attributes": ["aria-expanded", "aria-controls"], "events": ["click", "Space", "Enter"], "description": "Toggle should keep expanded state and content visibility synchronized." },
    { "name": "availabilityStatus", "selectors": [".store-pickup__status-icon--available", ".store-pickup__status-icon--unavailable"], "description": "Availability should be represented in readable text, not by icon color alone." }
  ],
  "properties": [
    { "name": "toggleLabel", "type": "string", "required": true, "description": "Visible disclosure trigger label.", "targetMappings": { "web": [{ "kind": "content", "selector": ".store-pickup__toggle" }] } },
    { "name": "expanded", "type": "boolean", "required": false, "defaultValue": false, "description": "Controls pickup-content visibility and synchronized disclosure state.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".store-pickup", "attribute": "aria-expanded", "values": { "true": "true", "false": "false" } }, { "kind": "attribute", "selector": ".store-pickup__toggle", "attribute": "aria-expanded", "values": { "true": "true", "false": "false" }, "elements": ["button"] }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-border-subtle", "--color-border-focus", "--color-text-primary", "--color-feedback-success-default", "--color-text-disabled", "--color-text-secondary"],
      "transition": ["--transition-fast"],
      "easing": ["--easing-default"],
      "typography": ["--typo-body-size", "--typo-body-sm-size", "--typo-caption-size"]
    }
  },
  "accessibility": [
    "Expose pickup details through a disclosure or target-native expansion control.",
    "Keep aria-expanded synchronized with content visibility in web targets.",
    "Pair status icons with readable availability text."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/product.css." },
    "shopify": { "status": "planned", "kind": "liquid-css-js", "notes": "Should map store availability data or app-provided pickup locations to the disclosure list." },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
