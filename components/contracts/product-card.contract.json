{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.1.0",
  "slug": "product-card",
  "name": "Product Card",
  "registryId": "D1",
  "category": "product",
  "status": "pilot",
  "summary": "Product listing card with media, title, vendor, badges, price area, and optional quick-add composition.",
  "dependencies": ["badge", "button", "price"],
  "source": {
    "registry": "registry.json#/components/product-card",
    "css": { "file": "components/css/product.css", "selector": ".product-card" },
    "docs": "site/src/content/components/product-card.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".product-card", "className": ".product-card", "required": true, "description": "Product card container." },
    { "name": "media", "selector": ".product-card__media", "className": ".product-card__media", "required": true, "description": "Media wrapper for product imagery." },
    { "name": "image", "selector": ".product-card__image", "className": ".product-card__image", "required": true, "description": "Primary product image." },
    { "name": "primaryImage", "selector": ".product-card__image--primary", "className": ".product-card__image--primary", "required": false, "description": "Primary image when a hover image is also present." },
    { "name": "hoverImage", "selector": ".product-card__image--hover", "className": ".product-card__image--hover", "required": false, "description": "Optional hover image layer." },
    { "name": "badges", "selector": ".product-card__badges", "className": ".product-card__badges", "required": false, "description": "Badge stack for sale, new, or availability labels." },
    { "name": "quickAdd", "selector": ".product-card__quick-add", "className": ".product-card__quick-add", "required": false, "description": "Optional quick-add action area." },
    { "name": "body", "selector": ".product-card__body", "className": ".product-card__body", "required": true, "description": "Text content wrapper." },
    { "name": "vendor", "selector": ".product-card__vendor", "className": ".product-card__vendor", "required": false, "description": "Vendor or brand text." },
    { "name": "title", "selector": ".product-card__title", "className": ".product-card__title", "required": true, "description": "Product title heading." },
    { "name": "subtitle", "selector": ".product-card__subtitle", "className": ".product-card__subtitle", "required": false, "description": "Optional subtitle or short descriptor." },
    { "name": "footer", "selector": ".product-card__footer", "className": ".product-card__footer", "required": false, "description": "Footer area for price and secondary actions." }
  ],
  "variants": [
    { "name": "default", "className": null, "default": true, "description": "Default product card." }
  ],
  "sizes": [
    { "name": "default", "className": null, "default": true, "description": "Fluid card size controlled by the parent grid." }
  ],
  "states": [
    { "name": "default", "selectors": [".product-card"], "description": "Default card state." },
    { "name": "hoverImage", "selectors": [".product-card:hover .product-card__image--hover", ".product-card:hover .product-card__image--primary"], "description": "Hover image reveal and primary image scale." },
    { "name": "quickAddVisible", "selectors": [".product-card:hover .product-card__quick-add"], "description": "Quick-add area becomes visible on hover-capable targets." }
  ],
  "behavior": [
    { "name": "navigation", "selectors": [".product-card__title a::after"], "attributes": ["href"], "description": "Title and media links should navigate to the product detail without wrapping the entire card as one link." },
    { "name": "quickAdd", "selectors": [".product-card__quick-add"], "events": ["click"], "description": "Optional quick-add action should preserve Button behavior and product-form validation rules." },
    { "name": "pricing", "selectors": [".product-card__footer"], "description": "Price formatting should be delegated to the Price dependency." }
  ],
  "properties": [
    { "name": "title", "type": "string", "required": true, "description": "Visible product title.", "targetMappings": { "web": [{ "kind": "content", "selector": ".product-card__title" }] } },
    { "name": "href", "type": "string", "required": true, "description": "Product-detail destination used by the title link.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".product-card__title a", "attribute": "href", "valueFrom": "property", "elements": ["a"] }] } },
    { "name": "vendor", "type": "string", "required": false, "description": "Optional vendor or brand line.", "targetMappings": { "web": [{ "kind": "content", "selector": ".product-card__vendor" }] } },
    { "name": "subtitle", "type": "string", "required": false, "description": "Optional short product descriptor.", "targetMappings": { "web": [{ "kind": "content", "selector": ".product-card__subtitle" }] } },
    { "name": "imageAlt", "type": "string", "required": true, "description": "Alternative text for the primary product image.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".product-card__image--primary", "attribute": "alt", "valueFrom": "property", "elements": ["img"] }] } },
    { "name": "hoverImage", "type": "slot", "required": false, "description": "Optional alternate media revealed by hover or focus-within.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".product-card__image--hover", "classNames": [".product-card__image", ".product-card__image--hover"] }] } },
    { "name": "badges", "type": "slot", "required": false, "description": "Optional Badge composition.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".product-card__badges", "classNames": [".product-card__badges"] }] } },
    { "name": "quickAddAction", "type": "slot", "required": false, "description": "Optional Button composition for quick add.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".product-card__quick-add", "classNames": [".product-card__quick-add"] }] } },
    { "name": "footer", "type": "slot", "required": false, "description": "Optional Price and secondary-action composition.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".product-card__footer", "classNames": [".product-card__footer"] }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-surface-primary", "--color-border-subtle", "--color-text-primary", "--color-text-secondary"],
      "radius": ["--radius-md"],
      "shadow": ["--shadow-sm"],
      "spacing": ["--space-layout-element-gap"],
      "typography": ["--typo-body-size", "--font-family-heading"],
      "transition": ["--transition-slow", "--transition-base"],
      "easing": ["--easing-out", "--easing-default"]
    }
  },
  "accessibility": [
    "Product images need descriptive alternative text unless they are decorative duplicates of adjacent text.",
    "Keep product title and image links separate rather than wrapping the full card in one long accessible name.",
    "Badges and sale information should be exposed as text, not only color."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/product.css." },
    "shopify": { "status": "planned", "kind": "liquid-css", "notes": "Should map product, variant, image, and price data to the contract anatomy." },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
