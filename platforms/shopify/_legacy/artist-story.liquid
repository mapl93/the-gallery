<section class="artist-story section-spacing">
  <div class="artist-story__inner container">
    {%- if section.settings.artist_image != blank -%}
      <div class="artist-story__image-wrapper">
        <img
          class="artist-story__image"
          src="{{ section.settings.artist_image | image_url: width: 800 }}"
          alt="{{ section.settings.artist_image.alt | escape }}"
          width="800"
          height="1067"
          loading="lazy"
        >
      </div>
    {%- else -%}
      <div class="artist-story__image-wrapper">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {%- endif -%}

    <div class="artist-story__content">
      {%- if section.settings.headline != blank -%}
        <h2 class="artist-story__headline">{{ section.settings.headline }}</h2>
      {%- endif -%}

      {%- if section.settings.story_text != blank -%}
        <div class="artist-story__text">{{ section.settings.story_text }}</div>
      {%- endif -%}

      {%- if section.settings.pull_quote != blank -%}
        <blockquote class="artist-story__quote">
          {{ section.settings.pull_quote }}
        </blockquote>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        <div>
          {% render 'button', label: section.settings.button_text, variant: 'outline', url: section.settings.button_link %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Artist Story",
  "tag": "section",
  "class": "section-artist-story",
  "settings": [
    {
      "type": "image_picker",
      "id": "artist_image",
      "label": "Artist portrait"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "The maker behind the work"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story",
      "default": "<p>Every piece begins with a conversation between hand and clay. Working from a small studio, each creation honors the ancient dialogue between maker, material, and fire.</p>"
    },
    {
      "type": "text",
      "id": "pull_quote",
      "label": "Pull quote"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Read the full story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Artist Story"
    }
  ]
}
{% endschema %}
