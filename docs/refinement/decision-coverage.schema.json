{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-gallery.local/schemas/component-refinement-decision-coverage.json",
  "type": "object",
  "required": ["manifestVersion", "snapshot", "resolutionPath", "packets"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "manifestVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "resolutionPath": {
      "type": "string",
      "pattern": "^docs/refinement/.+\\.md$"
    },
    "packets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["path", "status", "componentDecisions"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^docs/reports/.+\\.md$" },
          "status": {
            "enum": ["owner-input-required", "owner-decisions-recorded"]
          },
          "sharedDecisionCodes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/decisionCode" }
          },
          "componentDecisions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "$ref": "#/$defs/decisionCode" }
          }
        }
      }
    }
  },
  "$defs": {
    "decisionCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[A-Z]$"
    }
  }
}
