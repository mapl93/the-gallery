{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.1.0",
  "slug": "size-chart",
  "name": "Size Chart",
  "registryId": "D7",
  "category": "product",
  "status": "pilot",
  "summary": "Size chart trigger and modal/drawer surface with unit toggle, measurement table, and fit notes.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/size-chart",
