{
  "$description": "Composition visual roles preserving existing defaults. Gaps use shared system bases; borders, typography and initial image measure alias system values. Modal/product/visibility safety remains owned by dependencies and targets.",
  "component": {
    "sticky-atc": {
      "innerGapScale": {
        "$type": "number",
        "$value": 0.75
      },
      "infoGapScale": {
        "$type": "number",
        "$value": 0.75
      },
      "blockPaddingScale": {
        "$type": "number",
        "$value": 0.5
      },
      "inlinePaddingScale": {
        "$type": "number",
        "$value": 1
      },
      "mediaSize": {
        "$type": "dimension",
        "$value": "{size.touch.minHeight}"
      },
      "borderWidth": {
        "$type": "dimension",
        "$value": "{dimension.1}"
      },
      "titleWeight": {
        "$type": "fontWeight",
        "$value": "{font.weight.semibold}"
      }
    }
  }
}
