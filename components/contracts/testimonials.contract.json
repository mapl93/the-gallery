{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "testimonials",
  "name": "Testimonials",
  "registryId": "G3",
  "category": "marketing",
  "status": "pilot",
  "summary": "Responsive testimonial collection with repeated quote cards and optional Avatar-composed authors.",
  "dependencies": [
    "avatar"
  ],
  "source": {
    "registry": "registry.json#/components/testimonials",
    "css": {
      "file": "components/css/marketing.css",
      "selector": ".testimonials"
    },
    "docs": "site/src/content/components/testimonials.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".testimonials",
      "className": ".testimonials",
      "required": true,
      "description": "Testimonials section root."
    },
    {
      "name": "title",
      "selector": ".testimonials__title",
      "className": ".testimonials__title",
      "required": false,
      "description": "Optional section heading."
    },
    {
      "name": "grid",
      "selector": ".testimonials__grid",
      "className": ".testimonials__grid",
      "required": true,
      "description": "Responsive repeated-card container."
    },
    {
      "name": "testimonial",
      "selector": ".testimonial",
      "className": ".testimonial",
      "required": true,
      "description": "Repeated testimonial card."
    },
    {
      "name": "quote",
      "selector": ".testimonial__quote",
      "className": ".testimonial__quote",
      "required": true,
      "description": "Quoted testimonial text."
    },
    {
      "name": "quoteMark",
      "selector": ".testimonial__quote::before",
      "required": false,
      "generated": true,
      "description": "Decorative generated opening quotation mark."
    },
    {
      "name": "author",
      "selector": ".testimonial__author",
      "className": ".testimonial__author",
      "required": true,
      "description": "Author identity row that may compose Avatar."
    },
    {
      "name": "name",
      "selector": ".testimonial__name",
      "className": ".testimonial__name",
      "required": true,
      "description": "Visible author name."
    },
    {
      "name": "detail",
      "selector": ".testimonial__detail",
      "className": ".testimonial__detail",
      "required": false,
      "description": "Optional author role or supporting detail."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Single responsive testimonial-grid presentation."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "One, two, or three columns according to available viewport width."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".testimonials"
      ],
      "description": "Passive testimonial collection."
    }
  ],
  "behavior": [
    {
      "name": "authorComposition",
      "selectors": [
        ".testimonial__author"
      ],
      "description": "Author rows may compose Avatar; the visible name remains text even when an avatar is present."
    },
    {
      "name": "quoteSemantics",
      "selectors": [
        ".testimonial__quote"
      ],
      "description": "Targets should use quotation semantics appropriate to the document and keep the generated quote mark decorative."
    }
  ],
  "properties": [
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "Optional section heading.",
      "targetMappings": {
        "web": [
          {
            "kind": "content",
            "selector": ".testimonials__title"
          }
        ]
      }
    },
    {
      "name": "items",
      "type": "slot",
      "required": true,
      "description": "Repeated testimonial cards supplied by the target or CMS.",
      "targetMappings": {
        "web": [
          {
            "kind": "slot",
            "selector": ".testimonials__grid",
            "classNames": [
              ".testimonials__grid"
            ]
          }
        ]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-surface-secondary",
        "--color-text-accent",
        "--color-text-primary",
        "--color-text-secondary"
      ],
      "typography": [
        "--font-family-heading",
        "--typo-article-line-height",
        "--typo-article-size",
        "--typo-body-size",
        "--typo-h2-size"
      ],
      "radius": [
        "--radius-lg"
      ],
      "spacing": [
        "--space-layout-container",
        "--space-layout-grid-gap",
        "--space-layout-section-gap"
      ]
    }
  },
  "accessibility": [
    "Use semantic quotation markup and do not include the generated decorative quote mark in the accessible name.",
    "Keep every author name visible when an Avatar dependency is present.",
    "Treat testimonials as passive content unless a separately contracted control is composed.",
    "Do not present fabricated, unattributed, or misleading endorsements."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented in components/css/marketing.css."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "native-component"
    },
    "compose": {
      "status": "planned",
      "kind": "native-component"
    }
  }
}
