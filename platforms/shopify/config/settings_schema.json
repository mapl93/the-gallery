[
  {
    "name": "theme_info",
    "theme_name": "The Gallery",
    "theme_version": "0.1.0",
    "theme_author": "Manú Studio",
    "theme_documentation_url": "https://github.com/manustudio/the-gallery",
    "theme_support_email": "support@manustudio.com"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "paragraph",
        "content": "Upload up to four logo variants. Any section that shows a logo can pick which variant to display. If a variant is not uploaded, the store name is shown as text."
      },
      {
        "type": "image_picker",
        "id": "logo_short",
        "label": "Short",
        "info": "Compact mark — ideal for header, mobile, favicon."
      },
      {
        "type": "image_picker",
        "id": "logo_long",
        "label": "Long",
        "info": "Horizontal lockup — ideal for landing pages."
      },
      {
        "type": "image_picker",
        "id": "logo_wordmark",
        "label": "Wordmark",
        "info": "Type-only logo — ideal for footer, email."
      },
      {
        "type": "image_picker",
        "id": "logo_easter_egg",
        "label": "Easter egg",
        "info": "A surprise variant — use it however you like."
      }
    ]
  },
  {
    "name": "Coming Soon",
    "settings": [
      {
        "type": "checkbox",
        "id": "coming_soon_enabled",
        "label": "Enable Coming Soon mode",
        "info": "When active, all pages show the Coming Soon landing instead of the full site. No password required — the page is public.",
        "default": false
      }
    ]
  },
  {
    "name": "Gift wrap",
    "settings": [
      {
        "type": "checkbox",
        "id": "gift_wrap_enabled",
        "label": "Enable gift wrapping",
        "info": "Adds one order-level sellable gift-wrap line from the dedicated product selected below.",
        "default": false
      },
      {
        "type": "product",
        "id": "gift_wrap_product",
        "label": "Dedicated gift-wrap product",
        "info": "Use a product with exactly one variant. Its real price, tax, inventory, fulfillment, refund, and discount rules apply."
      }
    ]
  },
