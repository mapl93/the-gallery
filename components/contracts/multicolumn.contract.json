{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "multicolumn",
  "name": "Multicolumn",
  "registryId": "S4",
  "category": "sections",
  "status": "pilot",
  "summary": "Responsive section shell for an optional heading and target-owned repeated feature items.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/multicolumn",
    "css": {
      "file": "components/css/sections.css",
      "selector": ".multicolumn"
    },
    "docs": "site/src/content/components/multicolumn.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".multicolumn",
      "className": ".multicolumn",
      "required": true,
      "description": "Multicolumn section root."
    },
    {
      "name": "header",
      "selector": ".multicolumn__header",
      "className": ".multicolumn__header",
      "required": false,
      "description": "Optional centered heading region."
    },
    {
      "name": "title",
      "selector": ".multicolumn__title",
      "className": ".multicolumn__title",
      "required": false,
      "description": "Optional section heading."
    },
    {
      "name": "grid",
      "selector": ".multicolumn__grid",
      "className": ".multicolumn__grid",
      "required": true,
      "description": "Responsive repeated-item composition region."
    },
    {
      "name": "item",
      "selector": ".multicolumn__item",
      "className": ".multicolumn__item",
      "required": false,
      "description": "Repeated target-owned feature item."
    },
    {
      "name": "icon",
      "selector": ".multicolumn__icon",
      "className": ".multicolumn__icon",
      "required": false,
      "description": "Optional item visual supplied by the target."
    },
    {
      "name": "itemTitle",
      "selector": ".multicolumn__item-title",
      "className": ".multicolumn__item-title",
      "required": false,
      "description": "Optional item heading."
    },
    {
      "name": "itemText",
      "selector": ".multicolumn__item-text",
      "className": ".multicolumn__item-text",
      "required": false,
      "description": "Optional item supporting copy."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default variant."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".multicolumn"
      ],
      "description": "Resting multicolumn presentation."
    }
  ],
  "behavior": [
    {
      "name": "itemComposition",
      "selectors": [
        ".multicolumn__grid"
      ],
      "description": "The target supplies ordered item records and appropriate semantics; the parent section owns only their responsive composition."
    }
  ],
  "properties": [
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "Optional visible section heading.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".multicolumn__title" }]
      }
    },
    {
      "name": "items",
      "type": "slot",
      "required": true,
      "description": "Ordered target-owned feature item compositions.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".multicolumn__grid", "classNames": [".multicolumn__grid"] }]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-text-accent",
        "--color-text-primary",
        "--color-text-secondary"
      ],
      "typography": [
        "--font-family-heading",
        "--typo-body-size",
        "--typo-h2-size",
        "--typo-h4-size"
      ],
      "spacing": [
        "--space-layout-container",
        "--space-layout-grid-gap",
        "--space-layout-section-gap"
      ]
    }
  },
  "accessibility": [
    "Use a list when item order or grouping is meaningful and preserve a logical heading hierarchy.",
    "Hide decorative icons from assistive technology; provide adjacent or alternative text when an icon carries meaning.",
    "Responsive column changes must not alter item reading order."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented in components/css/sections.css."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "native-component"
    },
    "compose": {
      "status": "planned",
      "kind": "native-component"
    }
  }
}
