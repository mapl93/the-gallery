{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_card.page_title' | t }} &ndash; {{ shop.name }}</title>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
    {%- endif -%}



    {{ 'tokens.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'primitives.css' | asset_url | stylesheet_tag }}
    {{ 'forms.css' | asset_url | stylesheet_tag }}
    {{ 'pages.css' | asset_url | stylesheet_tag }}

    {% render 'theme-brand-settings' %}

    {{ content_for_header }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script src="{{ 'gift-card.js' | asset_url }}" defer></script>
  </head>
  <body class="template-gift-card">
    <a href="#main-content" class="skip-link">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    <main id="main-content" tabindex="-1">
      <section class="gift-card" aria-labelledby="gift-card-title">
        <div class="gift-card__layout">
          <div class="gift-card__card">
            <div class="gift-card__card-content">
              <div class="gift-card__issuer">
                {% render 'logo', variant: 'long', width: 180, loading: 'eager' %}
              </div>
              <p class="gift-card__balance">{{ gift_card.balance | money_with_currency }}</p>
            </div>
          </div>

          <div class="gift-card__content">
            <div>
              <h1 class="gift-card__heading" id="gift-card-title">{{ 'gift_card.heading' | t }}</h1>
              <p class="gift-card__instructions">{{ 'gift_card.instructions' | t }}</p>
            </div>

            <div class="gift-card__code-group" aria-labelledby="gift-card-code-label">
              <p class="gift-card__code-label" id="gift-card-code-label">{{ 'gift_card.code_label' | t }}</p>
              <div class="gift-card__code-row">
                <code class="gift-card__code" data-gift-card-code>{{ gift_card.code | format_code }}</code>
                <button
                  class="btn btn--secondary gift-card__copy-action"
                  type="button"
                  aria-describedby="gift-card-copy-status"
                  data-gift-card-copy
                  data-success-message="{{ 'gift_card.copy_success' | t | escape }}"
                  data-fallback-message="{{ 'gift_card.copy_fallback' | t | escape }}"
                >
                  <span class="gift-card__copy-label">{{ 'gift_card.copy' | t }}</span>
                </button>
              </div>
              <p class="gift-card__copy-status" id="gift-card-copy-status" role="status" aria-live="polite"></p>
            </div>

            <dl class="gift-card__details">
              <div class="gift-card__detail">
                <dt>{{ 'gift_card.status_label' | t }}</dt>
                <dd>
                  {%- if gift_card.enabled -%}
                    {%- if gift_card.expired -%}
                      {{ 'gift_card.status_expired' | t }}
                    {%- else -%}
                      {{ 'gift_card.status_active' | t }}
                    {%- endif -%}
                  {%- else -%}
                    {{ 'gift_card.status_disabled' | t }}
                  {%- endif -%}
                </dd>
              </div>
              {%- if gift_card.expires_on -%}
                <div class="gift-card__detail">
                  <dt>{{ 'gift_card.expiration_label' | t }}</dt>
                  <dd>{{ gift_card.expires_on | date: format: 'date' }}</dd>
                </div>
              {%- endif -%}
            </dl>

            <figure class="gift-card__qr">
              <div
                class="gift-card__qr-graphic"
                data-gift-card-qr="{{ gift_card.qr_identifier | escape }}"
                aria-hidden="true"
              ></div>
              <figcaption class="gift-card__qr-caption">{{ 'gift_card.qr_caption' | t }}</figcaption>
            </figure>

            <div class="gift-card__actions" aria-label="{{ 'gift_card.actions_label' | t | escape }}">
              <a class="btn gift-card__action" href="{{ shop.url }}">{{ 'gift_card.shop_link' | t }}</a>
              {%- if gift_card.pass_url -%}
                <a class="btn btn--secondary gift-card__action" href="{{ gift_card.pass_url }}">
                  <img
                    src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                    width="120"
                    height="40"
                    alt="{{ 'gift_card.add_to_wallet' | t | escape }}"
                  >
                </a>
              {%- endif -%}
              <button class="btn btn--secondary gift-card__action" type="button" data-gift-card-print>
                {{ 'gift_card.print' | t }}
              </button>
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
