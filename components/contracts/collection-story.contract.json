{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.1.0",
  "slug": "collection-story",
  "name": "Collection Story",
  "registryId": "F4",
  "category": "storytelling",
  "status": "pilot",
  "summary": "Editorial block with image, title, text, and inspiration quote.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/collection-story",
    "css": { "file": "components/css/storytelling.css", "selector": ".collection-story" },
    "docs": "site/src/content/components/collection-story.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".collection-story", "className": ".collection-story", "required": true, "description": "Collection story section." },
    { "name": "media", "selector": ".collection-story__media", "className": ".collection-story__media", "required": false, "description": "Optional collection media region." },
    { "name": "mediaImage", "selector": ".collection-story__media img", "className": null, "required": false, "description": "Collection image supplied by the target." },
    { "name": "content", "selector": ".collection-story__content", "className": ".collection-story__content", "required": true, "description": "Ordered collection narrative content." },
    { "name": "label", "selector": ".collection-story__label", "className": ".collection-story__label", "required": false, "description": "Optional editorial label." },
    { "name": "title", "selector": ".collection-story__title", "className": ".collection-story__title", "required": true, "description": "Collection story heading." },
    { "name": "text", "selector": ".collection-story__text", "className": ".collection-story__text", "required": true, "description": "Collection narrative rich content." },
    { "name": "inspiration", "selector": ".collection-story__inspiration", "className": ".collection-story__inspiration", "required": false, "description": "Optional inspiration quotation." },
    { "name": "actions", "selector": ".collection-story__actions", "className": ".collection-story__actions", "required": false, "description": "Optional target-owned action composition." }
  ],
  "variants": [
    { "name": "default", "className": null, "default": true, "description": "Default collection story presentation." }
  ],
  "sizes": [{ "name": "default", "className": null, "default": true, "description": "Single-column layout that becomes two columns at wider viewports." }],
  "states": [{ "name": "default", "selectors": [".collection-story"], "description": "Default collection story state." }],
  "behavior": [
    { "name": "narrativeOrder", "selectors": [".collection-story", ".collection-story__content"], "description": "Adapters should preserve meaningful media and narrative source order even when reversed visual placement is used." }
  ],
  "properties": [
    { "name": "reversed", "type": "boolean", "required": false, "defaultValue": false, "description": "Places media after narrative content at wider viewports without changing source order.", "targetMappings": { "web": [{ "kind": "class", "selector": ".collection-story", "classNames": [".collection-story--reversed"], "removeWhen": [false] }] } },
    { "name": "media", "type": "slot", "required": false, "description": "Target-owned collection media with appropriate alternative text.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".collection-story__media", "classNames": [".collection-story__media"] }] } },
    { "name": "label", "type": "string", "required": false, "description": "Optional editorial label.", "targetMappings": { "web": [{ "kind": "content", "selector": ".collection-story__label" }] } },
    { "name": "title", "type": "string", "required": true, "description": "Collection story heading.", "targetMappings": { "web": [{ "kind": "content", "selector": ".collection-story__title" }] } },
    { "name": "body", "type": "slot", "required": true, "description": "Target-owned collection narrative rich content.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".collection-story__text", "classNames": [".collection-story__text"] }] } },
    { "name": "inspiration", "type": "string", "required": false, "description": "Optional inspiration quotation.", "targetMappings": { "web": [{ "kind": "content", "selector": ".collection-story__inspiration" }] } },
    { "name": "actions", "type": "slot", "required": false, "description": "Optional target-owned calls to action.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".collection-story__actions", "classNames": [".collection-story__actions"] }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-border-decorative", "--color-surface-primary", "--color-text-accent", "--color-text-primary", "--color-text-secondary"],
      "typography": ["--font-family-accent", "--font-family-heading", "--typo-article-line-height", "--typo-article-size", "--typo-body-size", "--typo-h2-size", "--typo-h4-size"],
      "radius": ["--radius-lg"],
      "spacing": ["--space-layout-container", "--space-layout-element-gap", "--space-layout-grid-gap", "--space-layout-section-gap"]
    }
  },
  "accessibility": [
    "Use a heading level appropriate to the surrounding page for the title.",
    "Give meaningful media useful alternative text and mark decorative media accordingly.",
    "Preserve logical reading order when the reversed property changes only visual placement.",
    "Keep composed actions keyboard accessible with visible focus indicators."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/storytelling.css." },
    "shopify": { "status": "planned", "kind": "liquid-css-js" },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
