{
  "$description": "Public button customization tokens. These represent component API, not every private CSS variable.",
  "component": {
    "button": {
      "primary": {
        "background": {
          "default": { "$type": "color", "$value": "{color.gray.700}" },
          "hover": { "$type": "color", "$value": "{color.gray.800}" },
          "active": { "$type": "color", "$value": "{color.gray.950}" }
        },
        "text": { "$type": "color", "$value": "{color.gray.0}" },
        "border": { "$type": "color", "$value": "{color.transparent}" }
      },
      "secondary": {
        "background": {
          "default": { "$type": "color", "$value": "{color.gray.100}" },
          "hover": { "$type": "color", "$value": "{color.gray.200}" },
          "active": { "$type": "color", "$value": "{color.gray.300}" }
        },
        "text": { "$type": "color", "$value": "{color.gray.900}" },
        "border": { "$type": "color", "$value": "{color.transparent}" }
      },
      "outline": {
        "background": {
          "default": { "$type": "color", "$value": "{color.transparent}" },
          "hover": { "$type": "color", "$value": "{color.gray.50}" },
          "active": { "$type": "color", "$value": "{color.gray.100}" }
        },
        "text": { "$type": "color", "$value": "{color.gray.900}" },
        "border": { "$type": "color", "$value": "{color.gray.900}" }
      },
      "link": {
        "background": {
          "default": { "$type": "color", "$value": "{color.transparent}" },
          "hover": { "$type": "color", "$value": "{color.transparent}" }
        },
        "text": { "$type": "color", "$value": "{color.gray.900}" },
        "border": { "$type": "color", "$value": "{color.transparent}" }
      },
      "danger": {
        "background": {
          "default": { "$type": "color", "$value": "{color.red.600}" },
          "hover": { "$type": "color", "$value": "{color.red.700}" }
        },
        "text": { "$type": "color", "$value": "{color.gray.0}" },
        "border": { "$type": "color", "$value": "{color.transparent}" }
      },
      "padding": {
        "x": { "$type": "dimension", "$value": "{dimension.20}" },
        "y": { "$type": "dimension", "$value": "{dimension.10}" }
      },
      "gap": { "$type": "dimension", "$value": "{dimension.8}" },
      "minHeight": { "$type": "dimension", "$value": "{dimension.46}" },
      "iconSize": { "$type": "dimension", "$value": "{dimension.20}" },
      "radius": { "$type": "dimension", "$value": "{radius.md}" },
      "fontSize": { "$type": "dimension", "$value": "{typography.component.button.size}" },
      "fontWeight": { "$type": "fontWeight", "$value": "{typography.component.button.weight}" },
      "transitionDuration": { "$type": "duration", "$value": "{motion.duration.micro}" },
      "transitionCurve": { "$type": "cubicBezier", "$value": "{motion.curve.standard}" }
    }
  }
}
