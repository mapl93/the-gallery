{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.1.0",
  "slug": "artist-statement",
  "name": "Artist Statement Section",
  "registryId": "F8",
  "category": "storytelling",
  "status": "pilot",
  "summary": "Artist statement with portrait, quotation, body, and signature regions.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/artist-statement",
    "css": { "file": "components/css/storytelling.css", "selector": ".artist-statement" },
    "docs": "site/src/content/components/artist-statement.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".artist-statement", "className": ".artist-statement", "required": true, "description": "Artist statement section." },
    { "name": "layout", "selector": ".artist-statement__layout", "className": ".artist-statement__layout", "required": true, "description": "Responsive portrait and content layout." },
    { "name": "portrait", "selector": ".artist-statement__portrait", "className": ".artist-statement__portrait", "required": false, "description": "Optional sticky portrait region." },
    { "name": "portraitImage", "selector": ".artist-statement__portrait img", "className": null, "required": false, "description": "Portrait image supplied by the target." },
    { "name": "content", "selector": ".artist-statement__content", "className": ".artist-statement__content", "required": true, "description": "Ordered artist statement content." },
    { "name": "eyebrow", "selector": ".artist-statement__eyebrow", "className": ".artist-statement__eyebrow", "required": false, "description": "Optional editorial label." },
    { "name": "name", "selector": ".artist-statement__name", "className": ".artist-statement__name", "required": true, "description": "Artist name heading." },
    { "name": "quote", "selector": ".artist-statement__quote", "className": ".artist-statement__quote", "required": false, "description": "Optional highlighted quotation." },
    { "name": "body", "selector": ".artist-statement__body", "className": ".artist-statement__body", "required": true, "description": "Artist statement rich content." },
    { "name": "signature", "selector": ".artist-statement__signature", "className": ".artist-statement__signature", "required": false, "description": "Optional signature or artist mark." },
    { "name": "signatureImage", "selector": ".artist-statement__signature img", "className": null, "required": false, "description": "Signature image supplied by the target." }
  ],
  "variants": [{ "name": "default", "className": null, "default": true, "description": "Default artist statement composition." }],
  "sizes": [{ "name": "default", "className": null, "default": true, "description": "Two-column layout with a sticky portrait that stacks on narrow viewports." }],
  "states": [{ "name": "default", "selectors": [".artist-statement"], "description": "Default artist statement state." }],
  "behavior": [
    { "name": "narrativeOrder", "selectors": [".artist-statement__layout", ".artist-statement__content"], "description": "Adapters should preserve portrait and statement reading order while sticky positioning remains visual-only." }
  ],
  "properties": [
    { "name": "portrait", "type": "slot", "required": false, "description": "Target-owned portrait media with appropriate alternative text.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".artist-statement__portrait", "classNames": [".artist-statement__portrait"] }] } },
    { "name": "eyebrow", "type": "string", "required": false, "description": "Optional editorial label.", "targetMappings": { "web": [{ "kind": "content", "selector": ".artist-statement__eyebrow" }] } },
    { "name": "name", "type": "string", "required": true, "description": "Artist display name.", "targetMappings": { "web": [{ "kind": "content", "selector": ".artist-statement__name" }] } },
    { "name": "quote", "type": "string", "required": false, "description": "Optional highlighted artist quotation.", "targetMappings": { "web": [{ "kind": "content", "selector": ".artist-statement__quote" }] } },
    { "name": "body", "type": "slot", "required": true, "description": "Target-owned artist statement rich content.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".artist-statement__body", "classNames": [".artist-statement__body"] }] } },
    { "name": "signature", "type": "slot", "required": false, "description": "Optional target-owned signature or artist mark.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".artist-statement__signature", "classNames": [".artist-statement__signature"] }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-border-decorative", "--color-text-primary", "--color-text-secondary"],
      "typography": ["--font-family-accent", "--font-family-heading", "--typo-article-line-height", "--typo-article-size", "--typo-body-size", "--typo-h2-size", "--typo-h4-size"],
      "spacing": ["--layout-content-width", "--layout-gutter", "--section-spacing-y", "--space-layout-element-gap", "--space-layout-section-gap"],
      "radius": ["--radius-md"]
    }
  },
  "accessibility": [
    "Use a heading level appropriate to the surrounding page for the artist name.",
    "Use quotation markup for the highlighted quote when it is a quotation.",
    "Give meaningful portrait media useful alternative text and mark decorative media accordingly.",
    "Treat a decorative signature image as decorative; provide text attribution when the signature conveys identity not otherwise present."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/storytelling.css." },
    "shopify": { "status": "planned", "kind": "liquid-css-js" },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
