{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "newsletter",
  "name": "Newsletter Signup",
  "registryId": "G2",
  "category": "marketing",
  "status": "pilot",
  "summary": "Email-capture section that composes Input and Button while leaving submission response ownership to the consuming target.",
  "dependencies": [
    "input",
    "button"
  ],
  "source": {
    "registry": "registry.json#/components/newsletter",
    "css": {
      "file": "components/css/marketing.css",
      "selector": ".newsletter"
    },
    "docs": "site/src/content/components/newsletter.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".newsletter",
      "className": ".newsletter",
      "required": true,
      "description": "Newsletter section root."
    },
    {
      "name": "content",
      "selector": ".newsletter__content",
      "className": ".newsletter__content",
      "required": true,
      "description": "Centered content wrapper."
    },
    {
      "name": "title",
      "selector": ".newsletter__title",
      "className": ".newsletter__title",
      "required": true,
      "description": "Signup heading."
    },
    {
      "name": "description",
      "selector": ".newsletter__description",
      "className": ".newsletter__description",
      "required": false,
      "description": "Optional signup context."
    },
    {
      "name": "form",
      "selector": ".newsletter__form",
      "className": ".newsletter__form",
      "required": true,
      "description": "Native form composition containing Input and Button dependencies."
    },
    {
      "name": "input",
      "selector": ".newsletter__input",
      "className": ".newsletter__input",
      "required": true,
      "description": "Newsletter sizing class composed onto the Input dependency's native field."
    },
    {
      "name": "note",
      "selector": ".newsletter__note",
      "className": ".newsletter__note",
      "required": false,
      "description": "Optional privacy or frequency note."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Single centered signup presentation."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Responsive form width supplied by canonical CSS."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".newsletter"
      ],
      "description": "Resting newsletter presentation; field states belong to the Input dependency."
    }
  ],
  "behavior": [
    {
      "name": "inputComposition",
      "selectors": [
        ".newsletter__form",
        ".newsletter__input"
      ],
      "description": "The email field composes Input anatomy and must preserve Input's default, error, success, warning, hover, focus-visible, disabled, label, and message obligations."
    },
    {
      "name": "formSubmission",
      "selectors": [
        ".newsletter__form"
      ],
      "events": [
        "submit"
      ],
      "description": "The native form emits submission to the consuming target; this contract does not choose inline, replacement, redirect, or other response ownership."
    }
  ],
  "properties": [
    {
      "name": "title",
      "type": "string",
      "required": true,
      "description": "Newsletter signup heading.",
      "targetMappings": {
        "web": [
          {
            "kind": "content",
            "selector": ".newsletter__title"
          }
        ]
      }
    },
    {
      "name": "description",
      "type": "string",
      "required": false,
      "description": "Optional signup context.",
      "targetMappings": {
        "web": [
          {
            "kind": "content",
            "selector": ".newsletter__description"
          }
        ]
      }
    },
    {
      "name": "form",
      "type": "slot",
      "required": true,
      "description": "Native form content composed from Input and Button dependencies.",
      "targetMappings": {
        "web": [
          {
            "kind": "slot",
            "selector": ".newsletter__form",
            "classNames": [
              ".newsletter__form"
            ]
          }
        ]
      }
    },
    {
      "name": "note",
      "type": "string",
      "required": false,
      "description": "Optional privacy, consent, or message-frequency note.",
      "targetMappings": {
        "web": [
          {
            "kind": "content",
            "selector": ".newsletter__note"
          }
        ]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-surface-secondary",
        "--color-text-disabled",
        "--color-text-primary",
        "--color-text-secondary"
      ],
      "typography": [
        "--font-family-heading",
        "--typo-body-size",
        "--typo-h3-size"
      ],
      "spacing": [
        "--space-layout-container",
        "--space-layout-section-gap"
      ]
    }
  },
  "accessibility": [
    "Render the signup as a native form and use a submit-capable Button dependency.",
    "Compose the email control from Input with a visible label, associated message, native email semantics, and required state when the target requires it.",
    "Preserve Input's default, error, success, and warning validation families; use aria-invalid only for error.",
    "Do not use placeholder text as the email field's only accessible name.",
    "The consuming target must announce or navigate to a clear submission result without this contract assuming where that response lives."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented in components/css/marketing.css."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "native-component"
    },
    "compose": {
      "status": "planned",
      "kind": "native-component"
    }
  }
}
