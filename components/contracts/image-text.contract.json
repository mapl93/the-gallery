{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "image-text",
  "name": "Image with Text",
  "registryId": "S3",
  "category": "sections",
  "status": "pilot",
  "summary": "Responsive media-and-narrative section with source-backed layout variants and Button-composed actions.",
  "dependencies": [
    "button"
  ],
  "source": {
    "registry": "registry.json#/components/image-text",
    "css": {
      "file": "components/css/sections.css",
      "selector": ".image-text"
    },
    "docs": "site/src/content/components/image-text.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".image-text",
      "className": ".image-text",
      "required": true,
      "description": "Media-and-text section root."
    },
    {
      "name": "media",
      "selector": ".image-text__media",
      "className": ".image-text__media",
      "required": true,
      "description": "Target-owned image or media region."
    },
    {
      "name": "content",
      "selector": ".image-text__content",
      "className": ".image-text__content",
      "required": true,
      "description": "Narrative content region."
    },
    {
      "name": "eyebrow",
      "selector": ".image-text__eyebrow",
      "className": ".image-text__eyebrow",
      "required": false,
      "description": "Optional short contextual label."
    },
    {
      "name": "title",
      "selector": ".image-text__title",
      "className": ".image-text__title",
      "required": true,
      "description": "Section heading."
    },
    {
      "name": "body",
      "selector": ".image-text__body",
      "className": ".image-text__body",
      "required": true,
      "description": "Target-owned narrative rich content."
    },
    {
      "name": "cta",
      "selector": ".image-text__cta",
      "className": ".image-text__cta",
      "required": false,
      "description": "Optional Button-composed action."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default side-by-side media and content presentation."
    },
    {
      "name": "reversed",
      "className": ".image-text--reversed",
      "default": false,
      "description": "Places media after content visually without requiring DOM reordering."
    },
    {
      "name": "stacked",
      "className": ".image-text--stacked",
      "default": false,
      "description": "Single-column presentation at all viewport widths."
    },
    {
      "name": "overlay",
      "className": ".image-text--overlay",
      "default": false,
      "description": "Content overlays the media with a contrast layer."
    },
    {
      "name": "offset",
      "className": ".image-text--offset",
      "default": false,
      "description": "Contained presentation with spacing and rounded media."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".image-text"
      ],
      "description": "Resting section presentation; layout modifiers are variants rather than states."
    }
  ],
  "behavior": [
    {
      "name": "mediaSemantics",
      "selectors": [
        ".image-text__media"
      ],
      "description": "Targets decide whether media is informative or decorative and provide appropriate alternative text or hidden semantics."
    },
    {
      "name": "actionComposition",
      "selectors": [
        ".image-text__cta"
      ],
      "description": "The optional action composes Button and preserves Button-owned activation, focus, disabled, and busy behavior."
    },
    {
      "name": "meaningfulSourceOrder",
      "selectors": [
        ".image-text__media",
        ".image-text__content"
      ],
      "description": "Adapters preserve a meaningful media and narrative source order even when a variant changes visual placement."
    }
  ],
  "properties": [
    {
      "name": "variant",
      "type": "enum",
      "required": false,
      "defaultValue": "default",
      "valuesFrom": "variants",
      "description": "Source-backed media-and-content layout presentation.",
      "targetMappings": {
        "web": [{ "kind": "optionClass", "selector": ".image-text", "source": "variants" }]
      }
    },
    {
      "name": "media",
      "type": "slot",
      "required": true,
      "description": "Target-owned media content.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".image-text__media", "classNames": [".image-text__media"] }]
      }
    },
    {
      "name": "eyebrow",
      "type": "string",
      "required": false,
      "description": "Optional short context above the heading.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".image-text__eyebrow" }]
      }
    },
    {
      "name": "title",
      "type": "string",
      "required": true,
      "description": "Visible section heading.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".image-text__title" }]
      }
    },
    {
      "name": "body",
      "type": "slot",
      "required": true,
      "description": "Target-owned narrative rich content.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".image-text__body", "classNames": [".image-text__body"] }]
      }
    },
    {
      "name": "action",
      "type": "slot",
      "required": false,
      "description": "Optional Button-composed call to action.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".image-text__cta", "classNames": [".image-text__cta"] }]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-text-inverse",
        "--color-text-primary",
        "--color-text-secondary"
      ],
      "typography": [
        "--font-family-heading",
        "--typo-body-size",
        "--typo-h2-size"
      ],
      "radius": [
        "--radius-lg"
      ],
      "spacing": [
        "--space-layout-container",
        "--space-layout-section-gap"
      ]
    }
  },
  "accessibility": [
    "Use a contextual heading level and preserve meaningful media and narrative source order when layouts reverse or stack.",
    "Give informative media useful alternative text and hide decorative media from assistive technology.",
    "Ensure overlay presentation maintains text contrast over every supplied media frame.",
    "The optional action preserves Button-owned focus, touch, activation, disabled, and busy behavior."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented in components/css/sections.css."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "native-component"
    },
    "compose": {
      "status": "planned",
      "kind": "native-component"
    }
  }
}
