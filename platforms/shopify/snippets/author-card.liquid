{% doc %}
Renders one passive canonical Author Card from a Shopify article author.

The owning article composition controls placement semantics, localization,
privacy, schema, multiple-author grouping, SEO, tracking, and whether public
contact destinations are appropriate. Email and homepage links are opt-in and
require explicit visible labels.

@param {article} article - Article resource rendered by the owning composition.
@param {user} [author_user] - Explicit Shopify user override; defaults to article.user.
@param {string} [variant] - full or compact.
@param {string} [role] - Optional localized role or affiliation.
@param {boolean} [show_image] - Whether an available author image is rendered.
@param {boolean} [show_bio] - Whether an available biography is rendered in full.
@param {boolean} [show_homepage] - Explicit opt-in for the available homepage Link.
@param {boolean} [show_email] - Explicit opt-in for the available email Link.
@param {string} [homepage_label] - Required visible localized homepage Link label.
@param {string} [email_label] - Required visible localized email Link label.
@param {string} [image_alt] - Contextual image alternative; empty by default beside the visible name.
@param {string} [image_loading] - lazy by default; eager for an explicitly prioritized placement.
@param {string} [class] - Optional target-owned additional class.

@example
{% render 'author-card', article: article, show_homepage: true, homepage_label: 'Author website' %}
{% enddoc %}

{%- liquid
  assign author_card_user = author_user
  if author_card_user == blank and article != blank
    assign author_card_user = article.user
  endif

  assign author_card_name = author_card_user.name
  if author_card_name == blank and article != blank
    assign author_card_name = article.author
  endif

  assign author_card_variant = 'full'
  if variant == 'compact'
    assign author_card_variant = 'compact'
  endif

  assign author_card_show_image = true
  assign author_card_show_bio = true
  if show_image == false
    assign author_card_show_image = false
  endif
  if show_bio == false
    assign author_card_show_bio = false
  endif

  assign author_card_loading = 'lazy'
  if image_loading == 'eager'
    assign author_card_loading = 'eager'
  endif

  assign author_card_has_image = false
  if author_card_show_image and author_card_user.image != blank
    assign author_card_has_image = true
  endif

  assign author_card_has_bio = false
  if author_card_variant == 'full' and author_card_show_bio and author_card_user.bio != blank
    assign author_card_has_bio = true
  endif

  assign author_card_has_homepage = false
  if author_card_variant == 'full' and show_homepage == true and author_card_user.homepage != blank and homepage_label != blank
    assign author_card_has_homepage = true
  endif

  assign author_card_has_email = false
  if author_card_variant == 'full' and show_email == true and author_card_user.email != blank and email_label != blank
    assign author_card_has_email = true
  endif

  assign author_card_class = 'card author-card'
  if author_card_variant == 'compact'
    assign author_card_class = author_card_class | append: ' card--flat author-card--compact'
  endif
  if class != blank
    assign author_card_class = author_card_class | append: ' ' | append: class
  endif
-%}

{%- if author_card_name != blank -%}
  <div class="{{ author_card_class | escape }}">
    {%- if author_card_has_image -%}
      <span class="avatar{% if author_card_variant == 'full' %} avatar--lg{% endif %} author-card__avatar">
        {{ author_card_user.image | image_url: width: 160 | image_tag:
          alt: image_alt,
          loading: author_card_loading,
          widths: '40, 56, 80, 112, 160' }}
      </span>
    {%- endif -%}

    <div class="author-card__info">
      <p class="author-card__name">{{ author_card_name | escape }}</p>

      {%- if role != blank -%}
        <p class="author-card__role">{{ role | escape }}</p>
      {%- endif -%}

      {%- if author_card_has_bio -%}
        <p class="author-card__bio">{{ author_card_user.bio | strip_html | escape }}</p>
      {%- endif -%}

      {%- if author_card_has_homepage or author_card_has_email -%}
        <div class="author-card__links">
          {%- if author_card_has_homepage -%}
            <a class="link link--nav author-card__link" href="{{ author_card_user.homepage | escape }}" rel="author">
              {{ homepage_label | escape }}
            </a>
          {%- endif -%}
          {%- if author_card_has_email -%}
            <a class="link link--nav author-card__link" href="mailto:{{ author_card_user.email | escape }}" rel="author">
              {{ email_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
