<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {%- endif -%}



  {{ 'tokens.css' | asset_url | stylesheet_tag }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'primitives.css' | asset_url | stylesheet_tag }}
  {{ 'layout-primitives.css' | asset_url | stylesheet_tag }}
  {{ 'forms.css' | asset_url | stylesheet_tag }}
  {{ 'coming-soon.css' | asset_url | stylesheet_tag }}

  {% render 'theme-brand-settings' %}

  {{ content_for_header }}
</head>
<body class="template-password">
  {{ content_for_layout }}
  <script type="module" src="{{ 'runtime-loader.js' | asset_url }}"></script>
</body>
</html>
