    "inspectorNodeId": "1020:480"
  },
  "groups": [
    {
      "id": "content",
      "label": "Content",
      "controls": [
        { "id": "title", "label": "Title", "kind": "text", "properties": ["title"] },
        { "id": "table", "label": "Comparison matrix", "kind": "slot-composition", "properties": ["table"] }
      ]
    },
    {
      "id": "selection",
      "label": "Selection",
      "controls": [
        {
          "id": "interaction",
          "label": "Interaction",
          "kind": "segmented",
          "properties": ["interaction"],
          "optionLabels": { "passive": "Passive", "selectable": "Selectable" }
        },
        {
          "id": "selection-mode",
          "label": "Selection mode",
          "kind": "segmented",
          "properties": ["selectionMode"],
          "optionLabels": { "single": "Single", "multiple": "Multiple" },
          "visibleWhen": { "property": "interaction", "equals": "selectable" }
        },
        {
          "id": "selected-id",
          "label": "Selected alternative",
          "kind": "text",
          "properties": ["selectedId"],
          "visibleWhen": { "property": "selectionMode", "equals": "single" }
        },
        {
          "id": "selected-ids",
          "label": "Selected alternatives",
          "kind": "collection",
          "properties": ["selectedIds"],
          "visibleWhen": { "property": "selectionMode", "equals": "multiple" }
        }
      ]
    },
    {
      "id": "appearance",
      "label": "Appearance",
      "controls": [
        { "id": "title-color", "label": "Title color", "kind": "token-swatch", "tokens": { "category": "color", "names": ["--color-text-primary"] } },
        { "id": "status-color", "label": "Status colors", "kind": "token-pair", "tokens": { "category": "color", "names": ["--color-feedback-success-default", "--color-text-secondary"] } },
        { "id": "highlight-color", "label": "Highlight", "kind": "token-swatch", "tokens": { "category": "color", "names": ["--color-button-primary-bg-default"] } },
        { "id": "title-type", "label": "Title type", "kind": "token", "tokens": { "category": "typography", "names": ["--typo-h2-size"] } },
        { "id": "claim-type", "label": "Claim type", "kind": "token-pair", "tokens": { "category": "typography", "names": ["--typo-caption-size", "--typo-caption-line-height"] } },
        { "id": "layout-space", "label": "Layout space", "kind": "token-pair", "tokens": { "category": "spacing", "names": ["--space-layout-section-gap", "--space-layout-grid-gap"] } }
      ]
    }
  ]
