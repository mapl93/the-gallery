<footer class="footer" role="contentinfo">
  <div class="footer__grid">
    {%- comment -%} Brand Column {%- endcomment -%}
    <div>
      <span class="footer__heading">{{ shop.name }}</span>
      {%- if section.settings.footer_text != blank -%}
        <p style="font-size: calc(var(--typo-body-size) * 0.875); color: var(--color-text-secondary); margin-top: 8px;">
          {{ section.settings.footer_text }}
        </p>
      {%- endif -%}
    </div>

    {%- comment -%} Navigation Columns {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <p class="footer__heading">{{ block.settings.heading }}</p>
            {%- if block.settings.menu != blank -%}
              <ul class="footer__links">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    <div style="display: flex; gap: 16px;">
      {%- if section.settings.social_instagram != blank -%}
        <a href="{{ section.settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
          {% render 'icon', name: 'instagram' %}
        </a>
      {%- endif -%}
      {%- if section.settings.social_pinterest != blank -%}
        <a href="{{ section.settings.social_pinterest }}" aria-label="Pinterest" target="_blank" rel="noopener">
          {% render 'icon', name: 'pinterest' %}
        </a>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "footer_text",
      "label": "Brand description",
      "default": "Handcrafted art ceramics. Each piece tells a story of fire, earth, and intention."
    },
    { "type": "url", "id": "social_instagram", "label": "Instagram URL" },
    { "type": "url", "id": "social_pinterest", "label": "Pinterest URL" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "max_blocks": 3
}
{% endschema %}
