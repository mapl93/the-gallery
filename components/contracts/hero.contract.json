{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "hero",
  "name": "Hero Banner",
  "registryId": "G1",
  "category": "marketing",
  "status": "pilot",
  "summary": "Full-width editorial hero with optional media and overlay, required named content, and Button-composed actions.",
  "dependencies": [
    "button"
  ],
  "source": {
    "registry": "registry.json#/components/hero",
    "css": {
      "file": "components/css/marketing.css",
      "selector": ".hero"
    },
    "docs": "site/src/content/components/hero.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".hero",
      "className": ".hero",
      "required": true,
      "description": "Hero section root that owns containment, vertical alignment, and responsive minimum height."
    },
    {
      "name": "media",
      "selector": ".hero__media",
      "className": ".hero__media",
      "required": false,
      "description": "Optional background image or video layer."
    },
    {
      "name": "overlay",
      "selector": ".hero__overlay",
      "className": ".hero__overlay",
      "required": false,
      "description": "Optional contrast layer between media and content."
    },
    {
      "name": "content",
      "selector": ".hero__content",
      "className": ".hero__content",
      "required": true,
      "description": "Foreground content wrapper."
    },
    {
      "name": "label",
      "selector": ".hero__label",
      "className": ".hero__label",
      "required": false,
      "description": "Optional short context label."
    },
    {
      "name": "title",
      "selector": ".hero__title",
      "className": ".hero__title",
      "required": true,
      "description": "Primary hero heading."
    },
    {
      "name": "description",
      "selector": ".hero__description",
      "className": ".hero__description",
      "required": false,
      "description": "Optional supporting copy."
    },
    {
      "name": "actions",
      "selector": ".hero__actions",
      "className": ".hero__actions",
      "required": false,
      "description": "Optional Button-composed action group."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Single editorial hero presentation."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Responsive minimum height supplied by canonical CSS."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".hero"
      ],
      "description": "Resting hero presentation."
    }
  ],
  "behavior": [
    {
      "name": "mediaSemantics",
      "selectors": [
        ".hero__media"
      ],
      "description": "Targets decide whether media is informative or decorative and supply image alternative text, video controls, captions, or hidden semantics accordingly."
    },
    {
      "name": "actionComposition",
      "selectors": [
        ".hero__actions"
      ],
      "description": "Actions compose Button instances and preserve each Button's native action or navigation semantics."
    }
  ],
  "properties": [
    {
      "name": "label",
      "type": "string",
      "required": false,
      "description": "Optional short context above the title.",
      "targetMappings": {
        "web": [
          {
            "kind": "content",
            "selector": ".hero__label"
          }
        ]
      }
    },
    {
      "name": "title",
      "type": "string",
      "required": true,
      "description": "Primary hero heading.",
      "targetMappings": {
        "web": [
          {
            "kind": "content",
            "selector": ".hero__title"
          }
        ]
      }
    },
    {
      "name": "description",
      "type": "string",
      "required": false,
      "description": "Optional supporting hero copy.",
      "targetMappings": {
        "web": [
          {
            "kind": "content",
            "selector": ".hero__description"
          }
        ]
      }
    },
    {
      "name": "media",
      "type": "slot",
      "required": false,
      "description": "Optional target-owned image or video layer.",
      "targetMappings": {
        "web": [
          {
            "kind": "slot",
            "selector": ".hero__media",
            "classNames": [
              ".hero__media"
            ]
          }
        ]
      }
    },
    {
      "name": "overlay",
      "type": "slot",
      "required": false,
      "description": "Optional contrast layer rendered only when media needs it.",
      "targetMappings": {
        "web": [
          {
            "kind": "slot",
            "selector": ".hero__overlay",
            "classNames": [
              ".hero__overlay"
            ]
          }
        ]
      }
    },
    {
      "name": "actions",
      "type": "slot",
      "required": false,
      "description": "Optional group of Button-composed actions.",
      "targetMappings": {
        "web": [
          {
            "kind": "slot",
            "selector": ".hero__actions",
            "classNames": [
              ".hero__actions"
            ]
          }
        ]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-text-inverse"
      ],
      "typography": [
        "--font-family-heading",
        "--typo-article-line-height",
        "--typo-article-size",
        "--typo-body-size",
        "--typo-display-line-height",
        "--typo-display-size"
      ],
      "spacing": [
        "--space-layout-container",
        "--space-layout-section-gap"
      ]
    }
  },
  "accessibility": [
    "Use a heading level appropriate to the surrounding page hierarchy.",
    "Do not rely on background media for essential meaning; provide alternative text or equivalent visible copy when media is informative.",
    "Ensure the optional overlay preserves readable text contrast across the selected media.",
    "Render calls to action with the Button dependency and preserve native button or link semantics."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented in components/css/marketing.css."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "native-component"
    },
    "compose": {
      "status": "planned",
      "kind": "native-component"
    }
  }
}
