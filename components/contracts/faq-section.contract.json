{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "faq-section",
  "name": "FAQ Section",
  "registryId": "S9",
  "category": "sections",
  "status": "pilot",
  "summary": "Centered FAQ section shell that composes Accordion-owned question and answer items.",
  "dependencies": [
    "accordion"
  ],
  "source": {
    "registry": "registry.json#/components/faq-section",
    "css": {
      "file": "components/css/sections.css",
      "selector": ".faq-section"
    },
    "docs": "site/src/content/components/faq-section.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".faq-section",
      "className": ".faq-section",
      "required": true,
      "description": "FAQ section root and Accordion composition surface."
    },
    {
      "name": "header",
      "selector": ".faq-section__header",
      "className": ".faq-section__header",
      "required": false,
      "description": "Optional centered heading region."
    },
    {
      "name": "title",
      "selector": ".faq-section__title",
      "className": ".faq-section__title",
      "required": false,
      "description": "Optional FAQ section heading."
    },
    {
      "name": "subtitle",
      "selector": ".faq-section__subtitle",
      "className": ".faq-section__subtitle",
      "required": false,
      "description": "Optional supporting context."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default variant."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".faq-section"
      ],
      "description": "Resting FAQ section presentation; item expansion states belong to Accordion."
    }
  ],
  "behavior": [
    {
      "name": "accordionComposition",
      "selectors": [
        ".faq-section"
      ],
      "description": "Question items compose Accordion and preserve Accordion-owned trigger semantics, expanded state, keyboard behavior, panel relationships, and focus treatment."
    }
  ],
  "properties": [
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "Optional visible FAQ section heading.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".faq-section__title" }]
      }
    },
    {
      "name": "subtitle",
      "type": "string",
      "required": false,
      "description": "Optional supporting FAQ context.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".faq-section__subtitle" }]
      }
    },
    {
      "name": "items",
      "type": "slot",
      "required": true,
      "description": "Ordered Accordion composition rendered after the optional header.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".faq-section", "classNames": [".faq-section"] }]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-text-primary",
        "--color-text-secondary"
      ],
      "typography": [
        "--font-family-heading",
        "--typo-body-size",
        "--typo-h2-size"
      ],
      "spacing": [
        "--space-layout-container",
        "--space-layout-section-gap"
      ]
    }
  },
  "accessibility": [
    "Use a contextual heading level and associate the section with its visible title when present.",
    "Compose Accordion without duplicating its button, aria-expanded, aria-controls, panel relationship, keyboard, and focus obligations.",
    "Question and answer source order remains meaningful when scripting is absent."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented in components/css/sections.css."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "native-component"
    },
    "compose": {
      "status": "planned",
      "kind": "native-component"
    }
  }
}
