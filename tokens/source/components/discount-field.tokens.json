{
  "$description": "Public cart summary/discount visual values preserve existing defaults and semantic composition. Factors use system element gap; weights and borders alias system values. No cart or promotion engine.",
  "component": {
    "discount-field": {
      "panelGapScale": {
        "$type": "number",
        "$value": 0.5
      },
      "panelPaddingScale": {
        "$type": "number",
        "$value": 0.5
      },
      "formGapScale": {
        "$type": "number",
        "$value": 0.5
      },
      "codesGapScale": {
        "$type": "number",
        "$value": 0.25
      },
      "codeGapScale": {
        "$type": "number",
        "$value": 0.5
      },
      "codePaddingScale": {
        "$type": "number",
        "$value": 0.5
      },
      "accentShare": {
        "$type": "number",
        "$value": 0.7
      },
      "toggleWeight": {
        "$type": "fontWeight",
        "$value": "{font.weight.semibold}"
      },
      "underlineOffset": {
        "$type": "dimension",
        "$value": "0.2em"
      },
      "focusWidth": {
        "$type": "dimension",
        "$value": "{dimension.4}"
      },
      "focusOffset": {
        "$type": "dimension",
        "$value": "{dimension.2}"
      },
      "codeBorderWidth": {
        "$type": "dimension",
        "$value": "{dimension.1}"
      }
    }
  }
}
