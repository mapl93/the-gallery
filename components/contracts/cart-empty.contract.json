{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.1.0",
  "slug": "cart-empty",
  "name": "Cart Empty",
  "registryId": "K7",
  "category": "cart",
  "status": "pilot",
  "summary": "Empty cart state with icon, title, message, and recovery CTA composition.",
  "dependencies": ["empty-state", "button"],
  "source": {
    "registry": "registry.json#/components/cart-empty",
    "css": { "file": "components/css/cart.css", "selector": ".cart-empty" },
    "docs": "site/src/content/components/cart-empty.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".cart-empty", "className": ".cart-empty", "required": true, "description": "Empty cart container." },
    { "name": "icon", "selector": ".cart-empty__icon", "className": ".cart-empty__icon", "required": false, "description": "Optional empty-cart icon." },
    { "name": "title", "selector": ".cart-empty__title", "className": ".cart-empty__title", "required": true, "description": "Empty cart title." },
    { "name": "message", "selector": ".cart-empty__message", "className": ".cart-empty__message", "required": false, "description": "Empty cart guidance text." },
    { "name": "action", "selector": ".cart-empty__action", "className": ".cart-empty__action", "required": false, "description": "Primary recovery action." }
  ],
  "variants": [
    { "name": "default", "className": null, "default": true, "description": "Default empty cart state." }
  ],
  "sizes": [
    { "name": "default", "className": null, "default": true, "description": "Default centered empty cart spacing." }
  ],
  "states": [
    { "name": "default", "selectors": [".cart-empty"], "description": "Default empty cart state." }
  ],
  "behavior": [
    { "name": "emptyCart", "selectors": [".cart-empty__title", ".cart-empty__message"], "description": "Empty cart state should explain that no items are present." },
    { "name": "recoveryAction", "selectors": [".cart-empty"], "description": "CTA should send users back to shopping or recommendations." }
  ],
  "properties": [
    { "name": "icon", "type": "slot", "required": false, "description": "Optional passive empty-cart icon.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".cart-empty__icon", "classNames": [".cart-empty__icon"] }] } },
    { "name": "title", "type": "string", "required": true, "description": "Empty-cart heading.", "targetMappings": { "web": [{ "kind": "content", "selector": ".cart-empty__title" }] } },
    { "name": "message", "type": "string", "required": false, "description": "Empty-cart guidance.", "targetMappings": { "web": [{ "kind": "content", "selector": ".cart-empty__message" }] } },
    { "name": "actionLabel", "type": "string", "required": false, "description": "Primary recovery action label.", "targetMappings": { "web": [{ "kind": "content", "selector": ".cart-empty__action" }] } },
    { "name": "href", "type": "string", "required": false, "description": "Recovery destination.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".cart-empty__action", "attribute": "href", "valueFrom": "property", "elements": ["a"] }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-text-disabled", "--color-text-primary", "--color-text-secondary"],
      "spacing": ["--space-layout-section-gap"],
      "typography": ["--font-family-heading", "--typo-h3-size", "--typo-body-size"]
    }
  },
  "accessibility": [
    "Make the empty cart message understandable without the icon.",
    "Provide a clear recovery action when possible.",
    "Do not trap focus in an empty cart state."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/cart.css." },
    "shopify": { "status": "planned", "kind": "liquid-css", "notes": "Should render when Shopify cart item count is zero." },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
