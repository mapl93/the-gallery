{% doc %}
Renders the storefront editorial product-media sequence. On wide viewports the
media stack scrolls vertically beside sticky purchase information. On small
viewports it becomes a native horizontal scroll-snap gallery.

@param {product} product - Product whose media is rendered.

@example
{% render 'storefront-product-media', product: product %}
{% enddoc %}

{%- if product != blank and product.media.size > 0 -%}
  {%- liquid
    assign lightbox_images = product.media | where: 'media_type', 'image'
    assign lightbox_initial = lightbox_images.first
    assign lightbox_id = 'storefront-product-lightbox-' | append: section.id
    assign lightbox_title_id = lightbox_id | append: '-title'
    assign lightbox_caption_id = lightbox_id | append: '-caption'
  -%}
  <div
    class="storefront-product-media"
    data-editorial-media
    aria-label="{{ 'products.media.views' | t | escape }}"
  >
    <div class="storefront-product-media__track" data-editorial-media-track>
      {%- for media in product.media -%}
        {%- liquid
          assign media_alt = media.alt | default: product.title
          assign media_loading = 'lazy'
          assign media_fetch_priority = 'auto'
          if forloop.first
            assign media_loading = 'eager'
            assign media_fetch_priority = 'high'
          endif
        -%}
        <figure
          class="storefront-product-media__item storefront-product-media__item--{{ media.media_type | replace: '_', '-' }}"
          id="product-media-{{ section.id }}-{{ forloop.index }}"
          data-editorial-media-item
          data-media-index="{{ forloop.index0 }}"
          {% if media.preview_image != blank %}style="--_storefront-media-aspect-ratio: {{ media.preview_image.aspect_ratio }};"{% endif %}
        >
          {%- case media.media_type -%}
            {%- when 'image' -%}
              <button
                class="storefront-product-media__open"
                type="button"
                aria-label="{{ 'products.media.open_detail' | t: title: media_alt | escape }}"
                data-editorial-lightbox-open
                data-editorial-lightbox-caption="{{ media_alt | escape }}"
              >
                {{ media.preview_image
                  | image_url: width: 2400
                  | image_tag:
                    class: 'storefront-product-media__image',
                    alt: media_alt,
                    loading: media_loading,
                    fetchpriority: media_fetch_priority,
                    widths: '480,720,960,1200,1600,2000,2400',
                    sizes: '(min-width: 768px) 66vw, 100vw'
                }}
              </button>

            {%- when 'video' -%}
              {{ media | video_tag:
                class: 'storefront-product-media__interactive',
                controls: true,
                preload: 'metadata',
                image_size: '2000x'
              }}

            {%- when 'external_video' -%}
              {{ media | external_video_tag:
                class: 'storefront-product-media__interactive'
              }}

            {%- when 'model' -%}
              {{ media | model_viewer_tag:
                class: 'storefront-product-media__interactive',
                image_size: '2000x',
                toggleable: true
              }}
          {%- endcase -%}
        </figure>
      {%- endfor -%}
    </div>

    {%- if product.media.size > 1 -%}
      <div class="storefront-product-media__pagination" role="group" aria-label="{{ 'products.media.pages' | t | escape }}">
        {%- for media in product.media -%}
          {%- assign media_alt = media.alt | default: product.title -%}
          <button
            class="storefront-product-media__dot"
            type="button"
            aria-label="{{ 'products.media.view' | t: index: forloop.index, total: product.media.size, title: media_alt | escape }}"
            {% if forloop.first %}aria-current="true"{% endif %}
            data-editorial-media-dot="{{ forloop.index0 }}"
          >
            <span></span>
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if lightbox_initial != blank -%}
      <div class="modal-overlay lightbox storefront-product-lightbox" aria-hidden="true" data-editorial-lightbox hidden>
        <div
          class="modal lightbox__dialog"
          id="{{ lightbox_id }}"
          role="dialog"
          aria-modal="true"
          aria-labelledby="{{ lightbox_title_id }}"
          aria-describedby="{{ lightbox_caption_id }}"
          tabindex="-1"
        >
          <div class="modal__header lightbox__header">
            <h2 class="modal__title lightbox__title visually-hidden" id="{{ lightbox_title_id }}">{{ 'products.media.detail_title' | t }}</h2>
            <button
              class="close-btn modal__close lightbox__close"
              type="button"
              aria-label="{{ 'products.media.close_detail' | t }}"
              data-editorial-lightbox-close
            >
              {% render 'icon', name: 'close', size: 20 %}
            </button>
          </div>

          <div class="modal__body lightbox__body">
            <figure class="lightbox__content">
              <div class="lightbox__viewport">
                {{ lightbox_initial.preview_image
                  | image_url: width: 2400
                  | image_tag:
                    class: 'lightbox__image',
                    alt: lightbox_initial.alt,
                    loading: 'eager',
                    widths: '720,960,1200,1600,2000,2400',
                    sizes: '100vw',
                    data-editorial-lightbox-image: ''
                }}
              </div>
              <div class="lightbox__counter" dir="ltr" aria-hidden="true" data-editorial-lightbox-counter>1 / {{ lightbox_images.size }}</div>
              <figcaption class="lightbox__caption" id="{{ lightbox_caption_id }}" data-editorial-lightbox-caption>{{ lightbox_initial.alt | default: product.title | escape }}</figcaption>
            </figure>

            {%- if lightbox_images.size > 1 -%}
              <button class="lightbox__nav lightbox__nav--prev icon-btn icon-btn--round" type="button" aria-label="{{ 'products.media.previous_image' | t }}" data-editorial-lightbox-action="previous">{% render 'icon', name: 'chevron-left' %}</button>
              <button class="lightbox__nav lightbox__nav--next icon-btn icon-btn--round" type="button" aria-label="{{ 'products.media.next_image' | t }}" data-editorial-lightbox-action="next">{% render 'icon', name: 'chevron-right' %}</button>
            {%- endif -%}

            <p class="lightbox__status visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-editorial-lightbox-status></p>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
