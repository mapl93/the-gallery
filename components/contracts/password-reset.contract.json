{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.1.0",
  "slug": "password-reset",
  "name": "Password Reset",
  "registryId": "U2",
  "category": "account",
  "status": "pilot",
  "summary": "Password reset request state with icon, title, helper text, form composition, and success message.",
  "dependencies": ["input", "button"],
  "source": {
    "registry": "registry.json#/components/password-reset",
    "css": { "file": "components/css/account.css", "selector": ".password-reset" },
    "docs": "site/src/content/components/password-reset.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".password-reset", "className": ".password-reset", "required": true, "description": "Password reset container." },
    { "name": "icon", "selector": ".password-reset__icon", "className": ".password-reset__icon", "required": false, "description": "Optional reset icon." },
    { "name": "title", "selector": ".password-reset__title", "className": ".password-reset__title", "required": true, "description": "Reset form title." },
    { "name": "text", "selector": ".password-reset__text", "className": ".password-reset__text", "required": true, "description": "Reset helper text." },
    { "name": "form", "selector": ".password-reset__form", "className": ".password-reset__form", "required": true, "description": "Reset-request form composition." },
    { "name": "success", "selector": ".password-reset__success", "className": ".password-reset__success", "required": false, "description": "Reset email sent success message." }
  ],
  "variants": [
    { "name": "default", "className": null, "default": true, "description": "Default password reset state." }
  ],
  "sizes": [
    { "name": "default", "className": null, "default": true, "description": "Default narrow reset form width." }
  ],
  "states": [
    { "name": "default", "selectors": [".password-reset"], "description": "Default reset form state." },
    { "name": "success", "selectors": [".password-reset__success"], "description": "Reset email sent state." }
  ],
  "behavior": [
    { "name": "resetRequest", "selectors": [".password-reset"], "events": ["submit"], "description": "Reset request should submit an email to the target account system." },
    { "name": "successFeedback", "selectors": [".password-reset__success"], "attributes": ["role=\"status\""], "description": "Success message should be announced after reset request." }
  ],
  "properties": [
    { "name": "icon", "type": "slot", "required": false, "description": "Optional passive reset illustration.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".password-reset__icon", "classNames": [".password-reset__icon"] }] } },
    { "name": "title", "type": "string", "required": true, "description": "Password-reset title.", "targetMappings": { "web": [{ "kind": "content", "selector": ".password-reset__title" }] } },
    { "name": "text", "type": "string", "required": true, "description": "Reset-request guidance.", "targetMappings": { "web": [{ "kind": "content", "selector": ".password-reset__text" }] } },
    { "name": "form", "type": "slot", "required": true, "description": "Input and Button composition for the reset request.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".password-reset__form", "classNames": [".password-reset__form"] }] } },
    { "name": "successMessage", "type": "string", "required": false, "description": "Confirmation announced after a successful request.", "targetMappings": { "web": [{ "kind": "content", "selector": ".password-reset__success" }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-text-disabled", "--color-text-primary", "--color-text-secondary", "--color-feedback-success-default"],
      "spacing": ["--space-layout-section-gap", "--space-layout-container"],
      "radius": ["--radius-md"],
      "typography": ["--font-family-heading", "--typo-h3-size", "--typo-body-size"]
    }
  },
  "accessibility": [
    "Label the email input and connect errors to the field.",
    "The composed email field preserves Input validation presentation and uses aria-invalid only for error.",
    "Use a status region for reset email success feedback.",
    "Avoid revealing whether an email belongs to an account unless the target auth system explicitly allows that messaging."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/account.css." },
    "shopify": { "status": "planned", "kind": "liquid-css", "notes": "Should map Shopify customer password recovery form and feedback." },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
