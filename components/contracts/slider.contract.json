{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.4.0",
  "slug": "slider",
  "name": "Slider / Range",
  "registryId": "H2",
  "category": "forms",
  "status": "pilot",
  "summary": "Native horizontal range contract for one value or an ordered lower/upper pair, with synchronized visible values, active fill, native form ownership, validation presentation, and cross-engine thumb behavior.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/slider",
    "css": {
      "file": "components/css/forms.css",
      "selector": ".slider"
    },
    "docs": "site/src/content/components/slider.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".slider",
      "className": ".slider",
      "required": true,
      "description": "Horizontal slider wrapper that owns label, value summary, validation presentation, and synchronized fill progress."
    },
    {
      "name": "label",
      "selector": ".slider__label",
      "className": ".slider__label",
      "required": false,
      "description": "Visible slider label and value row."
    },
    {
      "name": "value",
      "selector": ".slider__value",
      "className": ".slider__value",
      "required": false,
      "description": "Visible current value or lower–upper value summary synchronized from the native input owner or owners."
    },
    {
      "name": "track",
      "selector": ".slider__track",
      "className": ".slider__track",
      "required": false,
      "description": "Optional positioning wrapper for the native range input."
    },
    {
      "name": "input",
      "selector": ".slider__input",
      "className": ".slider__input",
      "required": true,
      "description": "Native range input."
    },
    {
      "name": "webkitThumb",
      "selector": ".slider__input::-webkit-slider-thumb",
      "required": false,
      "generated": true,
      "description": "Generated WebKit range thumb."
    },
    {
      "name": "mozThumb",
      "selector": ".slider__input::-moz-range-thumb",
      "required": false,
      "generated": true,
      "description": "Generated Firefox range thumb."
    },
    {
      "name": "rangeRoot",
      "selector": ".range-slider",
      "className": ".range-slider",
      "required": false,
      "description": "Dual-handle range wrapper with private logical start/end progress variables."
    },
    {
      "name": "rangeTrack",
      "selector": ".range-slider__track",
      "className": ".range-slider__track",
      "required": false,
      "description": "Dual-handle range track."
    },
    {
      "name": "rangeFill",
      "selector": ".range-slider__fill",
      "className": ".range-slider__fill",
      "required": false,
      "description": "Selected range fill between handles."
    },
    {
      "name": "rangeInput",
      "selector": ".range-slider__input",
      "className": ".range-slider__input",
      "required": false,
      "description": "Native lower or upper range input; data-range-lower and data-range-upper identify stable semantic owners."
    }
  ],
  "variants": [
    {
      "name": "single",
      "className": null,
      "default": true,
      "description": "Default single-value slider."
    },
    {
      "name": "range",
      "className": ".range-slider",
      "default": false,
      "description": "Dual-handle range slider structure."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default slider track and thumb size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".slider"
      ],
      "description": "Default single-value slider state."
    },
    {
      "name": "focusVisible",
      "selectors": [
        ".slider__input:focus-visible::-webkit-slider-thumb",
        ".range-slider__input:focus-visible::-webkit-slider-thumb",
        ".range-slider__input:focus-visible::-moz-range-thumb"
      ],
      "description": "Keyboard focus state on the WebKit thumb. Variant-specific selectors are implementation coverage of this same state."
    },
    {
      "name": "disabled",
      "selectors": [
        ".slider__input:disabled"
      ],
      "description": "Unavailable slider state."
    },
    {
      "name": "range",
      "selectors": [
        ".range-slider"
      ],
      "description": "Dual-handle range structure."
    },
    {
      "name": "rangeFill",
      "selectors": [
        ".range-slider__fill"
      ],
      "description": "Selected range fill state."
    },
    {
      "name": "error",
      "selectors": [
        ".slider[data-validation=\"error\"]",
        ".range-slider[data-validation=\"error\"]"
      ],
      "description": "Error validation family applied independently from geometry and value."
    },
    {
      "name": "success",
      "selectors": [
        ".slider[data-validation=\"success\"]",
        ".range-slider[data-validation=\"success\"]"
      ],
      "description": "Success validation family applied independently from geometry and value."
    },
    {
      "name": "warning",
      "selectors": [
        ".slider[data-validation=\"warning\"]",
        ".range-slider[data-validation=\"warning\"]"
      ],
      "description": "Warning validation family applied independently from geometry and value."
    }
  ],
  "behavior": [
    {
      "name": "nativeRange",
      "attributes": ["type=\"range\"", "min", "max", "step", "value", "disabled"],
      "description": "Every handle preserves native range value, form, reset, pointer, touch, and keyboard behavior."
    },
    {
      "name": "valueSynchronization",
      "events": ["input", "change", "reset"],
      "description": "Visible value text and active fill are derived from the current native value after initialization, input, change, attribute updates, and form reset."
    },
    {
      "name": "rangePair",
      "selectors": [".range-slider", ".range-slider__input", ".range-slider__fill"],
      "attributes": ["data-range-lower", "data-range-upper", "min", "max", "step", "value"],
      "description": "Dual-handle sliders keep explicit lower and upper native values ordered without swapping semantic owners and synchronize the logical fill between them."
    },
    {
      "name": "trackPointer",
      "events": ["pointerdown"],
      "description": "Pointer activation on the shared range track moves the nearest available native handle and focuses that owner; no continuous layout work runs while idle."
    },
    {
      "name": "keyboardNavigation",
      "events": ["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "Home", "End", "PageUp", "PageDown"],
      "description": "Keyboard users should be able to adjust slider values using native range keyboard behavior."
    },
    {
      "name": "controlledUncontrolled",
      "events": ["input", "change", "reset"],
      "description": "Static HTML values are uncontrolled defaults; framework adapters control the same native values and consume native events instead of adding mirrored hidden state."
    }
  ],
  "properties": [
    { "name": "label", "type": "string", "required": true, "description": "Visible label for the slider.", "targetMappings": { "web": [{ "kind": "content", "selector": ".slider__label" }] } },
    { "name": "mode", "type": "enum", "required": false, "valuesFrom": "variants", "description": "Single-value or dual-handle range structure.", "targetMappings": { "web": [{ "kind": "optionClass", "selector": ".slider", "source": "variants" }] } },
    { "name": "variant", "type": "enum", "required": false, "values": ["default", "error", "success", "warning"], "description": "Validation presentation composed independently from slider mode.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".slider", "attribute": "data-validation", "values": { "default": null, "error": "error", "success": "success", "warning": "warning" } }, { "kind": "attribute", "selector": ".range-slider", "attribute": "data-validation", "values": { "default": null, "error": "error", "success": "success", "warning": "warning" } }] } },
    { "name": "value", "type": "number", "required": false, "defaultValue": 50, "description": "Current single value or lower native value in range mode.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".slider__input", "attribute": "value", "valueFrom": "property", "elements": ["input"] }, { "kind": "attribute", "selector": ".range-slider__input[data-range-lower]", "attribute": "value", "valueFrom": "property", "elements": ["input"] }] } },
    { "name": "upperValue", "type": "number", "required": false, "defaultValue": 75, "description": "Upper native value used only in range mode; it cannot be lower than value.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".range-slider__input[data-range-upper]", "attribute": "value", "valueFrom": "property", "elements": ["input"] }] } },
    { "name": "name", "type": "string", "required": false, "description": "Form field name for the single or lower native range owner.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".slider__input", "attribute": "name", "valueFrom": "property", "elements": ["input"] }, { "kind": "attribute", "selector": ".range-slider__input[data-range-lower]", "attribute": "name", "valueFrom": "property", "elements": ["input"] }] } },
    { "name": "upperName", "type": "string", "required": false, "description": "Form field name for the upper native owner in range mode.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".range-slider__input[data-range-upper]", "attribute": "name", "valueFrom": "property", "elements": ["input"] }] } },
    { "name": "min", "type": "number", "required": false, "defaultValue": 0, "description": "Minimum native range value.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".slider__input", "attribute": "min", "valueFrom": "property", "elements": ["input"] }, { "kind": "attribute", "selector": ".range-slider__input", "attribute": "min", "valueFrom": "property", "elements": ["input"] }] } },
    { "name": "max", "type": "number", "required": false, "defaultValue": 100, "description": "Maximum native range value.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".slider__input", "attribute": "max", "valueFrom": "property", "elements": ["input"] }, { "kind": "attribute", "selector": ".range-slider__input", "attribute": "max", "valueFrom": "property", "elements": ["input"] }] } },
    { "name": "step", "type": "number", "required": false, "defaultValue": 1, "minimum": 0.01, "description": "Native value increment.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".slider__input", "attribute": "step", "valueFrom": "property", "elements": ["input"] }, { "kind": "attribute", "selector": ".range-slider__input", "attribute": "step", "valueFrom": "property", "elements": ["input"] }] } },
    { "name": "disabled", "type": "boolean", "required": false, "defaultValue": false, "description": "Makes slider handles unavailable.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".slider__input", "attribute": "disabled", "values": { "true": "", "false": null }, "elements": ["input"] }, { "kind": "attribute", "selector": ".range-slider__input", "attribute": "disabled", "values": { "true": "", "false": null }, "elements": ["input"] }] } },
    { "name": "describedBy", "type": "string", "required": false, "description": "Id reference for supporting or validation feedback.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".slider__input", "attribute": "aria-describedby", "valueFrom": "property", "elements": ["input"] }, { "kind": "attribute", "selector": ".range-slider__input", "attribute": "aria-describedby", "valueFrom": "property", "elements": ["input"] }] } }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-surface-secondary",
        "--color-button-primary-bg-default",
        "--color-surface-primary",
        "--color-text-primary",
        "--color-text-secondary",
        "--color-input-default-focused-outer-border",
        "--color-input-error-unfocused-inner-border",
        "--color-input-error-unfocused-label",
        "--color-input-error-focused-outer-border",
        "--color-input-success-unfocused-inner-border",
        "--color-input-success-unfocused-label",
        "--color-input-success-focused-outer-border",
        "--color-input-warning-unfocused-inner-border",
        "--color-input-warning-unfocused-label",
        "--color-input-warning-focused-outer-border"
      ],
      "radius": [
        "--radius-full"
      ],
      "shadow": [
        "--shadow-sm"
      ],
      "opacity": [
        "--opacity-disabled"
      ],
      "transition": [
        "--transition-fast"
      ],
      "easing": [
        "--easing-default"
      ],
      "typography": [
        "--font-family-body",
        "--typo-body-size",
        "--typo-body-line-height"
      ]
    }
  },
  "accessibility": [
    "Use native input type=\"range\" where possible.",
    "Provide a visible label or equivalent accessible name.",
    "Expose min, max, step, and current value.",
    "Keep displayed value text synchronized with the native input value.",
    "For dual-handle ranges, prevent lower and upper handles from crossing unless the target documents that behavior."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css-js",
      "notes": "Native range owners are styled in components/css/forms.css and progressively synchronized by components/js/theme.js for visible values, single/range fill, ordered handles, track pointer activation, mutations, and reset."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "style"
    },
    "compose": {
      "status": "planned",
      "kind": "composable"
    }
  }
}
