{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.2",
  "slug": "exhibition-page",
  "name": "Exhibition Landing Page",
  "registryId": "F7",
  "category": "storytelling",
  "status": "pilot",
  "summary": "Passive exhibition composition with a media-optional hero, semantic information, target-owned works and participating-artist regions, and container-responsive source order.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/exhibition-page",
    "css": {
      "file": "components/css/storytelling.css",
      "selector": ".exhibition-page"
    },
    "docs": "site/src/content/components/exhibition-page.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".exhibition-page",
      "className": ".exhibition-page",
      "required": true,
      "description": "Exhibition page composition."
    },
    {
      "name": "hero",
      "selector": ".exhibition-hero",
      "className": ".exhibition-hero",
      "required": true,
      "description": "Exhibition hero region with a valid no-media surface."
    },
    {
      "name": "heroMedia",
      "selector": ".exhibition-hero__media",
      "className": ".exhibition-hero__media",
      "required": false,
      "description": "Optional hero media region."
    },
    {
      "name": "heroImage",
      "selector": ".exhibition-hero__media img",
      "className": null,
      "required": false,
      "description": "Hero image supplied by the target."
    },
    {
      "name": "heroOverlay",
      "selector": ".exhibition-hero__overlay",
      "className": ".exhibition-hero__overlay",
      "required": false,
      "description": "Decorative contrast overlay rendered only with hero media."
    },
    {
      "name": "heroContent",
      "selector": ".exhibition-hero__content",
      "className": ".exhibition-hero__content",
      "required": true,
      "description": "Ordered hero text content."
    },
    {
      "name": "heroLabel",
      "selector": ".exhibition-hero__label",
      "className": ".exhibition-hero__label",
      "required": false,
      "description": "Optional exhibition label."
    },
    {
      "name": "heroTitle",
      "selector": ".exhibition-hero__title",
      "className": ".exhibition-hero__title",
      "required": true,
      "description": "Exhibition title."
    },
    {
      "name": "heroDates",
      "selector": ".exhibition-hero__dates",
      "className": ".exhibition-hero__dates",
      "required": false,
      "description": "Optional exhibition date text."
    },
    {
      "name": "heroLocation",
      "selector": ".exhibition-hero__location",
      "className": ".exhibition-hero__location",
      "required": false,
      "description": "Optional exhibition location."
    },
    {
      "name": "info",
      "selector": ".exhibition-info",
      "className": ".exhibition-info",
      "required": false,
      "description": "Neutral exhibition description and metadata layout; it is not an unnamed or hardcoded-language landmark."
    },
    {
      "name": "description",
      "selector": ".exhibition-info__description",
      "className": ".exhibition-info__description",
      "required": false,
      "description": "Exhibition narrative rich content."
    },
    {
      "name": "sidebar",
      "selector": ".exhibition-info__sidebar",
      "className": ".exhibition-info__sidebar",
      "required": false,
      "description": "Repeated exhibition metadata region."
    },
    {
      "name": "detail",
      "selector": ".exhibition-info__detail",
      "className": ".exhibition-info__detail",
      "required": false,
      "description": "Repeated exhibition metadata item."
    },
    {
      "name": "detailLabel",
      "selector": ".exhibition-info__detail-label",
      "className": ".exhibition-info__detail-label",
      "required": false,
      "description": "Metadata label."
    },
    {
      "name": "detailValue",
      "selector": ".exhibition-info__detail-value",
      "className": ".exhibition-info__detail-value",
      "required": false,
      "description": "Metadata value."
    },
    {
      "name": "works",
      "selector": ".exhibition-works",
      "className": ".exhibition-works",
      "required": false,
      "description": "Optional featured-works composition."
    },
    {
      "name": "worksHeading",
      "selector": ".exhibition-works__heading",
      "className": ".exhibition-works__heading",
      "required": false,
      "description": "Featured-works heading."
    },
    {
      "name": "worksGrid",
      "selector": ".exhibition-works__grid",
      "className": ".exhibition-works__grid",
      "required": false,
      "description": "Target-owned featured-work records, preferably grouped by a native list when repeated."
    },
    {
      "name": "artists",
      "selector": ".exhibition-artists",
      "className": ".exhibition-artists",
      "required": false,
      "description": "Optional participating-artists composition."
    },
    {
      "name": "artistsHeading",
      "selector": ".exhibition-artists__heading",
      "className": ".exhibition-artists__heading",
      "required": false,
      "description": "Participating-artists heading."
    },
    {
      "name": "artistsList",
      "selector": ".exhibition-artists__list",
      "className": ".exhibition-artists__list",
      "required": false,
      "description": "Target-owned artist items."
    },
    {
      "name": "artistItem",
      "selector": ".exhibition-artists__item",
      "className": ".exhibition-artists__item",
      "required": false,
      "description": "Passive participating-artist list item; target interaction remains outside this contract."
    },
    {
      "name": "artistAvatar",
      "selector": ".exhibition-artists__avatar",
      "className": ".exhibition-artists__avatar",
      "required": false,
      "description": "Participating artist image."
    },
    {
      "name": "artistContent",
      "selector": ".exhibition-artists__content",
      "className": ".exhibition-artists__content",
      "required": false,
      "description": "Participating artist name and optional role group."
    },
    {
      "name": "artistName",
      "selector": ".exhibition-artists__name",
      "className": ".exhibition-artists__name",
      "required": false,
      "description": "Participating artist name."
    },
    {
      "name": "artistRole",
      "selector": ".exhibition-artists__role",
      "className": ".exhibition-artists__role",
      "required": false,
      "description": "Optional artist role."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default exhibition page composition."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Contained page regions whose information and record layouts respond to the component width."
    }
  ],
  "states": [
    {
      "name": "withoutHeroMedia",
      "selectors": [
        ".exhibition-hero"
      ],
      "description": "Default semantic statement surface and primary text when hero media is absent."
    },
    {
      "name": "withHeroMedia",
      "selectors": [
        ".exhibition-hero--with-media",
        ".exhibition-hero__media",
        ".exhibition-hero__overlay"
      ],
      "description": "Target media, decorative scrim and inverse hero text."
    }
  ],
  "behavior": [
    {
      "name": "compositionBoundary",
      "selectors": [
        ".exhibition-works__grid",
        ".exhibition-artists__list"
      ],
      "description": "Featured works and participating artists remain target-owned composition slots. This contract does not decide whether Product Card, Artist Card, links, or other dependencies own those records."
    },
    {
      "name": "narrativeOrder",
      "selectors": [
        ".exhibition-page"
      ],
      "description": "Adapters preserve hero, exhibition information, works, and artist source order independently of responsive layout."
    },
    {
      "name": "containerResponsive",
      "selectors": [
        ".exhibition-page",
        ".exhibition-info",
        ".exhibition-works__grid",
        ".exhibition-artists__list"
      ],
      "description": "Information and record layout respond to the component container or intrinsic track space rather than the page viewport."
    },
    {
      "name": "passiveCore",
      "selectors": [
        ".exhibition-page"
      ],
      "description": "The neutral composition adds no focus stops, controlled state, event lifecycle, navigation, filtering, commerce behavior, request, observer, timer, or JavaScript."
    },
    {
      "name": "semanticGrouping",
      "selectors": [
        ".exhibition-info__sidebar",
        ".exhibition-works__grid",
        ".exhibition-artists__list"
      ],
      "description": "Adapters use native name-value and repeated-list semantics where the target content structure warrants them; target-owned interactive records retain their own semantics and focus."
    }
  ],
  "properties": [
    {
      "name": "heroMedia",
      "type": "slot",
      "required": false,
      "description": "Target-owned hero media with appropriate alternative text; applies the media modifier and decorative scrim.",
      "targetMappings": {
        "web": [
          {
            "kind": "slot",
            "selector": ".exhibition-hero__media",
            "classNames": [
              ".exhibition-hero--with-media",
              ".exhibition-hero__media",
              ".exhibition-hero__overlay"
            ]
          }
        ]
      }
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "description": "Optional exhibition label.",
      "targetMappings": {
        "web": [
          {
            "kind": "content",
            "selector": ".exhibition-hero__label"
          }
        ]
      }
    },
    {
      "name": "title",
      "type": "string",
      "required": true,
      "description": "Exhibition title.",
      "targetMappings": {
        "web": [
          {
            "kind": "content",
            "selector": ".exhibition-hero__title"
          }
        ]
      }
    },
    {
      "name": "dates",
      "type": "string",
      "required": false,
      "description": "Optional target-formatted exhibition dates.",
      "targetMappings": {
        "web": [
          {
            "kind": "content",
            "selector": ".exhibition-hero__dates"
          }
        ]
      }
    },
    {
      "name": "location",
      "type": "string",
      "required": false,
      "description": "Optional exhibition location.",
      "targetMappings": {
        "web": [
          {
            "kind": "content",
            "selector": ".exhibition-hero__location"
          }
        ]
      }
    },
    {
      "name": "description",
      "type": "slot",
      "required": false,
      "description": "Target-owned exhibition narrative rich content.",
      "targetMappings": {
        "web": [
          {
            "kind": "slot",
            "selector": ".exhibition-info__description",
            "classNames": [
              ".exhibition-info__description"
            ]
          }
        ]
      }
    },
    {
      "name": "details",
      "type": "slot",
      "required": false,
      "description": "Target-owned exhibition metadata.",
      "targetMappings": {
        "web": [
          {
            "kind": "slot",
            "selector": ".exhibition-info__sidebar",
            "classNames": [
              ".exhibition-info__sidebar",
              ".exhibition-info__detail",
              ".exhibition-info__detail-label",
              ".exhibition-info__detail-value"
            ]
          }
        ]
      }
    },
    {
      "name": "works",
      "type": "slot",
      "required": false,
      "description": "Target-owned featured-works heading and item composition.",
      "targetMappings": {
        "web": [
          {
            "kind": "slot",
            "selector": ".exhibition-works",
            "classNames": [
              ".exhibition-works",
              ".exhibition-works__heading",
              ".exhibition-works__grid"
            ]
          }
        ]
      }
    },
    {
      "name": "artists",
      "type": "slot",
      "required": false,
      "description": "Target-owned participating-artists heading and item composition.",
      "targetMappings": {
        "web": [
          {
            "kind": "slot",
            "selector": ".exhibition-artists",
            "classNames": [
              ".exhibition-artists",
              ".exhibition-artists__heading",
              ".exhibition-artists__list",
              ".exhibition-artists__item",
              ".exhibition-artists__avatar",
              ".exhibition-artists__name",
              ".exhibition-artists__role"
            ]
          }
        ]
      }
    }
  ],
