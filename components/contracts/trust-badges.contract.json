{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "trust-badges",
  "name": "Trust Badges",
  "registryId": "G5",
  "category": "marketing",
  "status": "pilot",
  "summary": "Passive wrapping collection of factual trust or guarantee statements with optional decorative icons.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/trust-badges",
    "css": {
      "file": "components/css/marketing.css",
      "selector": ".trust-badges"
    },
    "docs": "site/src/content/components/trust-badges.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".trust-badges",
      "className": ".trust-badges",
      "required": true,
      "description": "Wrapping trust-statement collection."
    },
    {
      "name": "badge",
      "selector": ".trust-badge",
      "className": ".trust-badge",
      "required": true,
      "description": "Repeated passive trust statement."
    },
    {
      "name": "icon",
      "selector": ".trust-badge svg",
      "required": false,
      "description": "Optional icon supporting a trust statement."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default wrapping spacing and text size."
    },
    {
      "name": "compact",
      "className": ".trust-badges--compact",
      "default": false,
      "description": "Reduced gaps and statement text size for dense product or cart contexts."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Content-sized wrapping collection."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".trust-badges"
      ],
      "description": "Passive resting presentation."
    }
  ],
  "behavior": [
    {
      "name": "passiveStatements",
      "selectors": [
        ".trust-badge"
      ],
      "description": "Trust badges are passive claims, not controls; targets must provide truthful text and must not imply interaction through focus or click behavior."
    },
    {
      "name": "iconSemantics",
      "selectors": [
        ".trust-badge svg"
      ],
      "attributes": [
        "aria-hidden=\"true\" for decorative icons"
      ],
      "description": "Icons that repeat the visible statement are hidden from assistive technology."
    }
  ],
  "properties": [
    {
      "name": "variant",
      "type": "enum",
      "required": false,
      "valuesFrom": "variants",
      "description": "Default or compact collection presentation.",
      "targetMappings": {
        "web": [
          {
            "kind": "optionClass",
            "selector": ".trust-badges",
            "source": "variants"
          }
        ]
      }
    },
    {
      "name": "items",
      "type": "slot",
      "required": true,
      "description": "Repeated factual trust statements supplied by the target.",
      "targetMappings": {
        "web": [
          {
            "kind": "slot",
            "selector": ".trust-badges",
            "classNames": [
              ".trust-badges"
            ]
          }
        ]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-feedback-success-default",
        "--color-text-secondary"
      ],
      "typography": [
        "--typo-body-size"
      ]
    }
  },
  "accessibility": [
    "Keep every guarantee or trust claim available as text rather than icon alone.",
    "Hide decorative icons from assistive technology and name informative icons only when they add meaning beyond the text.",
    "Do not make passive trust statements keyboard-focusable.",
    "Use list semantics when the collection is meaningfully a list of independent statements."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented in components/css/marketing.css."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "native-component"
    },
    "compose": {
      "status": "planned",
      "kind": "native-component"
    }
  }
}
