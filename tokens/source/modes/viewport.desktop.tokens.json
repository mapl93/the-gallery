{
  "$description": "Desktop viewport overrides. Compile this with one theme mode.",
  "typography": {
    "display": {
      "size": { "$type": "dimension", "$value": "{dimension.56}" },
      "lineHeight": { "$type": "dimension", "$value": "{dimension.62}" }
    },
    "h1": {
      "size": { "$type": "dimension", "$value": "{dimension.44}" },
      "lineHeight": { "$type": "dimension", "$value": "{dimension.53}" }
    },
    "h2": {
      "size": { "$type": "dimension", "$value": "{dimension.32}" },
      "lineHeight": { "$type": "dimension", "$value": "{dimension.40}" }
    },
    "h3": {
      "size": { "$type": "dimension", "$value": "{dimension.24}" },
      "lineHeight": { "$type": "dimension", "$value": "{dimension.30}" }
    },
    "body": {
      "large": {
        "size": { "$type": "dimension", "$value": "{dimension.20}" },
        "lineHeight": { "$type": "dimension", "$value": "{dimension.32}" }
      },
      "default": {
        "size": { "$type": "dimension", "$value": "{dimension.16}" },
        "lineHeight": { "$type": "dimension", "$value": "{dimension.24}" }
      }
    },
    "component": {
      "button": {
        "size": { "$type": "dimension", "$value": "{dimension.16}" }
      }
    }
  },
  "space": {
    "container": {
      "margin": { "$type": "dimension", "$value": "{dimension.120}" }
    }
  },
  "size": {
    "container": {
      "maxWidth": { "$type": "dimension", "$value": "{dimension.1200}" }
    }
  },
  "grid": {
    "columns": { "$type": "number", "$value": 12 },
    "gutter": { "$type": "dimension", "$value": "{dimension.32}" },
    "margin": { "$type": "dimension", "$value": "{dimension.120}" }
  }
}
