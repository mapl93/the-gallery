{%- comment -%}
  Section: Main Page
  Generic page content section (About, Contact, etc.)
{%- endcomment -%}

<div class="section storefront-page">
  <div class="container storefront-page__container">
    <h1 class="storefront-page__title">{{ page.title }}</h1>

    <div class="page-content rte">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page Content",
  "tag": "section",
  "class": "section-main-page",
  "settings": []
}
{% endschema %}
