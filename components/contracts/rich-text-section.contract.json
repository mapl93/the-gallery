{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "rich-text-section",
  "name": "Rich Text Section",
  "registryId": "S15",
  "category": "sections",
  "status": "pilot",
  "summary": "Contained semantic rich-content section with an optional heading and target-owned document body.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/rich-text-section",
    "css": {
      "file": "components/css/sections.css",
      "selector": ".rich-text-section"
    },
    "docs": "site/src/content/components/rich-text-section.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".rich-text-section",
      "className": ".rich-text-section",
      "required": true,
      "description": "Contained rich-text section root."
    },
    {
      "name": "title",
      "selector": ".rich-text-section__title",
      "className": ".rich-text-section__title",
      "required": false,
      "description": "Optional visible section heading."
    },
    {
      "name": "body",
      "selector": ".rich-text-section__body",
      "className": ".rich-text-section__body",
      "required": true,
      "description": "Target-owned semantic rich content."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default variant."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".rich-text-section"
      ],
      "description": "Resting rich-content presentation."
    },
    {
      "name": "linkFocusVisible",
      "selectors": [
        ".rich-text-section__body a:focus-visible"
      ],
      "description": "Visible keyboard focus on target-supplied rich-content links."
    }
  ],
  "behavior": [
    {
      "name": "semanticContent",
      "selectors": [
        ".rich-text-section__body"
      ],
      "description": "Targets preserve meaningful heading order, list, quotation, link, image, and document semantics rather than flattening supplied rich content into decorative containers."
    },
    {
      "name": "linkNavigation",
      "selectors": [
        ".rich-text-section__body a"
      ],
      "attributes": [
        "href"
      ],
      "description": "Links use native anchors with target-owned destinations and descriptive accessible names."
    }
  ],
  "properties": [
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "Optional visible section heading.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".rich-text-section__title" }]
      }
    },
    {
      "name": "body",
      "type": "slot",
      "required": true,
      "description": "Target-owned semantic rich document content.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".rich-text-section__body", "classNames": [".rich-text-section__body"] }]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-border-default",
        "--color-border-focus",
        "--color-text-accent",
        "--color-text-primary",
        "--color-text-secondary"
      ],
      "typography": [
        "--font-family-heading",
        "--typo-body-size",
        "--typo-h2-size"
      ],
      "radius": [
        "--radius-md"
      ],
      "spacing": [
        "--space-layout-container",
        "--space-layout-section-gap"
      ]
    }
  },
  "accessibility": [
    "Preserve semantic headings, paragraphs, lists, quotations, links, and image alternatives in target-supplied rich content.",
    "Use a contextual heading hierarchy and do not select heading levels from visual size alone.",
    "Links are descriptive native anchors with visible keyboard focus, and long content remains contained at narrow widths.",
    "Do not rely on blockquote styling alone when a citation or source is available."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented in components/css/sections.css."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "native-component"
    },
    "compose": {
      "status": "planned",
      "kind": "native-component"
    }
  }
}
