{
  "$description": "Semantic motion roles consumed by components and target adapters.",
  "motion": {
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": "{duration.instant}",
        "$description": "No visible motion. Use for reduced-motion fallbacks and immediate state changes."
      },
      "micro": {
        "$type": "duration",
        "$value": "{duration.fast}",
        "$description": "Small control feedback such as hover, focus, checked, and pressed states."
      },
      "standard": {
        "$type": "duration",
        "$value": "{duration.base}",
        "$description": "Default UI state transition duration."
      },
      "moderate": {
        "$type": "duration",
        "$value": "{duration.slow}",
        "$description": "Overlay, disclosure, and larger element transition duration."
      },
      "emphasis": {
        "$type": "duration",
        "$value": "{duration.slower}",
        "$description": "Deliberate or editorial motion duration."
      }
    },
    "curve": {
      "linear": {
        "$type": "cubicBezier",
        "$value": "{curve.linear}",
        "$description": "Linear timing for continuous movement."
      },
      "standard": {
        "$type": "cubicBezier",
        "$value": "{curve.inOut}",
        "$description": "Default curve for reversible UI transitions."
      },
      "enter": {
        "$type": "cubicBezier",
        "$value": "{curve.out}",
        "$description": "Decelerating curve for content entering or becoming visible."
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": "{curve.in}",
        "$description": "Accelerating curve for content exiting or becoming hidden."
      },
      "emphasis": {
        "$type": "cubicBezier",
        "$value": "{curve.out}",
        "$description": "Expressive curve for emphasized reveal motion."
      }
    },
    "transition": {
      "instant": {
        "$type": "transition",
        "$value": {
          "duration": "{motion.duration.instant}",
          "delay": "{motion.duration.instant}",
          "timingFunction": "{motion.curve.linear}"
        },
        "$description": "No visible transition."
      },
      "micro": {
        "$type": "transition",
        "$value": {
          "duration": "{motion.duration.micro}",
          "delay": "{motion.duration.instant}",
          "timingFunction": "{motion.curve.standard}"
        },
        "$description": "Small control feedback transition."
      },
      "standard": {
        "$type": "transition",
        "$value": {
          "duration": "{motion.duration.standard}",
          "delay": "{motion.duration.instant}",
          "timingFunction": "{motion.curve.standard}"
        },
        "$description": "Default reversible UI transition."
      },
      "disclosure": {
        "$type": "transition",
        "$value": {
          "duration": "{motion.duration.standard}",
          "delay": "{motion.duration.instant}",
          "timingFunction": "{motion.curve.standard}"
        },
        "$description": "Expand, collapse, tab, accordion, menu, and disclosure transition."
      },
      "overlay-enter": {
        "$type": "transition",
        "$value": {
          "duration": "{motion.duration.moderate}",
          "delay": "{motion.duration.instant}",
          "timingFunction": "{motion.curve.enter}"
        },
        "$description": "Modal, drawer, popover, lightbox, and overlay entrance transition."
      },
      "overlay-exit": {
        "$type": "transition",
        "$value": {
          "duration": "{motion.duration.standard}",
          "delay": "{motion.duration.instant}",
          "timingFunction": "{motion.curve.exit}"
        },
        "$description": "Modal, drawer, popover, lightbox, and overlay exit transition."
      },
      "feedback": {
        "$type": "transition",
        "$value": {
          "duration": "{motion.duration.standard}",
          "delay": "{motion.duration.instant}",
          "timingFunction": "{motion.curve.enter}"
        },
        "$description": "Toast, alert, validation, and transient feedback transition."
      },
      "media": {
        "$type": "transition",
        "$value": {
          "duration": "{motion.duration.moderate}",
          "delay": "{motion.duration.instant}",
          "timingFunction": "{motion.curve.enter}"
        },
        "$description": "Image, video, gallery, and editorial media reveal transition."
      },
      "emphasis": {
        "$type": "transition",
        "$value": {
          "duration": "{motion.duration.emphasis}",
          "delay": "{motion.duration.instant}",
          "timingFunction": "{motion.curve.emphasis}"
        },
        "$description": "Intentional editorial motion for brand moments."
      },
      "continuous": {
        "$type": "transition",
        "$value": {
          "duration": "{motion.duration.emphasis}",
          "delay": "{motion.duration.instant}",
          "timingFunction": "{motion.curve.linear}"
        },
        "$description": "Continuous motion timing for marquee-like movement."
      }
    },
    "opacity": {
      "hidden": {
        "$type": "number",
        "$value": "{opacity.0}",
        "$description": "Fully transparent state."
      },
      "subtle": {
        "$type": "number",
        "$value": "{opacity.40}",
        "$description": "Subtle visible state."
      },
      "disabled": {
        "$type": "number",
        "$value": "{opacity.50}",
        "$description": "Disabled or unavailable UI opacity."
      },
      "scrim": {
        "$type": "number",
        "$value": "{opacity.60}",
        "$description": "Overlay scrim opacity."
      },
      "visible": {
        "$type": "number",
        "$value": "{opacity.100}",
        "$description": "Fully visible state."
      }
    }
  }
}
