        { "id": "message", "label": "Message", "kind": "text", "properties": ["message"] },
        { "id": "icon", "label": "Icon", "kind": "icon", "properties": ["icon"], "iconCatalogue": { "source": "lucide", "defaultLeading": "check", "defaultTrailing": "check" } },
        { "id": "action", "label": "Action", "kind": "slot-composition", "properties": ["action"] },
