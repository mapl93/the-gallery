{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.1.0",
  "slug": "collection-hero",
  "name": "Collection Hero",
  "registryId": "E1",
  "category": "collection",
  "status": "pilot",
  "summary": "Collection header with title, description, product count, and optional background image variant.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/collection-hero",
    "css": { "file": "components/css/collection.css", "selector": ".collection-hero" },
    "docs": "site/src/content/components/collection-hero.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".collection-hero", "className": ".collection-hero", "required": true, "description": "Collection hero container." },
    { "name": "image", "selector": ".collection-hero__image", "className": ".collection-hero__image", "required": false, "description": "Optional background image." },
    { "name": "overlay", "selector": ".collection-hero--with-image::before", "generated": true, "required": false, "description": "Generated image overlay." },
    { "name": "content", "selector": ".collection-hero__content", "className": ".collection-hero__content", "required": true, "description": "Centered content wrapper." },
    { "name": "title", "selector": ".collection-hero__title", "className": ".collection-hero__title", "required": true, "description": "Collection title." },
    { "name": "description", "selector": ".collection-hero__description", "className": ".collection-hero__description", "required": false, "description": "Collection description." },
    { "name": "count", "selector": ".collection-hero__count", "className": ".collection-hero__count", "required": false, "description": "Product count text." }
  ],
  "variants": [
    { "name": "default", "className": null, "default": true, "description": "Text-only collection hero." },
    { "name": "with-image", "className": ".collection-hero--with-image", "default": false, "description": "Hero with background image and overlay." }
  ],
  "sizes": [
    { "name": "default", "className": null, "default": true, "description": "Default full-width hero spacing." }
  ],
  "states": [
    { "name": "default", "selectors": [".collection-hero"], "description": "Default text-only hero state." },
    { "name": "withImage", "selectors": [".collection-hero--with-image", ".collection-hero--with-image .collection-hero__content", ".collection-hero--with-image::before"], "description": "Image-backed hero state." }
  ],
  "behavior": [
    { "name": "collectionData", "selectors": [".collection-hero__title", ".collection-hero__description", ".collection-hero__count"], "description": "Adapters should map collection title, description, and product count from target data." },
    { "name": "imageSemantics", "selectors": [".collection-hero__image"], "attributes": ["alt"], "description": "Background imagery should be decorative or have useful alt text depending on target markup." }
  ],
  "properties": [
    { "name": "variant", "type": "enum", "required": false, "valuesFrom": "variants", "description": "Text-only or image-backed presentation.", "targetMappings": { "web": [{ "kind": "optionClass", "selector": ".collection-hero", "source": "variants" }] } },
    { "name": "title", "type": "string", "required": true, "description": "Visible collection title.", "targetMappings": { "web": [{ "kind": "content", "selector": ".collection-hero__title" }] } },
    { "name": "description", "type": "string", "required": false, "description": "Optional collection description.", "targetMappings": { "web": [{ "kind": "content", "selector": ".collection-hero__description" }] } },
    { "name": "count", "type": "string", "required": false, "description": "Target-formatted product count text.", "targetMappings": { "web": [{ "kind": "content", "selector": ".collection-hero__count" }] } },
    { "name": "image", "type": "slot", "required": false, "description": "Optional collection media for the image-backed variant.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".collection-hero__image", "classNames": [".collection-hero__image"] }] } },
    { "name": "imageAlt", "type": "string", "required": false, "description": "Alternative text when collection media conveys content.", "targetMappings": { "web": [{ "kind": "attribute", "selector": ".collection-hero__image", "attribute": "alt", "valueFrom": "property", "elements": ["img"] }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-surface-archival", "--color-text-primary", "--color-text-inverse"],
      "spacing": ["--space-layout-section-gap", "--space-layout-container"],
      "typography": ["--typo-display-size", "--typo-display-line-height", "--typo-article-size", "--typo-body-size", "--font-family-heading"]
    }
  },
  "accessibility": [
    "Use a page-appropriate heading level for the collection title.",
    "Ensure text over images meets contrast requirements.",
    "Expose product count as readable text when shown."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/collection.css." },
    "shopify": { "status": "planned", "kind": "liquid-css", "notes": "Should map collection title, description, image, and product count." },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
