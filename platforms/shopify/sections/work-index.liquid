{%- liquid
  assign work_heading = section.settings.heading
  if work_heading == blank
    if section.settings.heading_context == 'individual-pieces'
      assign work_heading = 'work.individual_pieces_title' | t
    else
      assign work_heading = 'work.title' | t
    endif
  endif
-%}

<section
  class="storefront-work"
  aria-labelledby="StorefrontWorkTitle-{{ section.id }}"
  data-storefront-work
  data-result-singular="{{ 'work.results.singular' | t | escape }}"
  data-result-plural="{{ 'work.results.plural' | t | escape }}"
>
  <h1 class="storefront-work__title" id="StorefrontWorkTitle-{{ section.id }}">{{ work_heading }}</h1>

  {%- if section.settings.enable_filters or section.settings.enable_sorting -%}
    <form class="storefront-work__controls" data-work-controls hidden>
      {%- if section.settings.enable_filters -%}
        <details class="storefront-work-selector" data-work-selector>
          <summary class="storefront-work-selector__trigger">
            <svg class="storefront-work-selector__icon" aria-hidden="true" viewBox="0 0 24 20" focusable="false">
              <path d="M3 6h18M7 14h10" />
            </svg>
            <span class="storefront-work-selector__label">{{ 'work.filters.type' | t }}</span>
            <span class="storefront-work-selector__value" data-work-selector-value>{{ 'work.filters.all_types' | t }}</span>
          </summary>
          <div class="storefront-work-selector__menu" role="radiogroup" aria-label="{{ 'work.filters.type' | t | escape }}">
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="work-kind-{{ section.id }}" value="" data-work-filter="kind" data-work-option-label="{{ 'work.filters.all_types' | t | escape }}" checked>
              <span>{{ 'work.filters.all_types' | t }}</span>
            </label>
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="work-kind-{{ section.id }}" value="collection" data-work-filter="kind" data-work-option-label="{{ 'work.types.collection' | t | escape }}">
              <span>{{ 'work.types.collection' | t }}</span>
            </label>
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="work-kind-{{ section.id }}" value="piece" data-work-filter="kind" data-work-option-label="{{ 'work.types.individual_pieces' | t | escape }}">
              <span>{{ 'work.types.individual_pieces' | t }}</span>
            </label>
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="work-kind-{{ section.id }}" value="service" data-work-filter="kind" data-work-option-label="{{ 'work.types.service' | t | escape }}">
              <span>{{ 'work.types.service' | t }}</span>
            </label>
          </div>
        </details>

        <details class="storefront-work-selector" data-work-selector>
          <summary class="storefront-work-selector__trigger">
            <svg class="storefront-work-selector__icon" aria-hidden="true" viewBox="0 0 24 20" focusable="false">
              <path d="M3 6h18M7 14h10" />
            </svg>
            <span class="storefront-work-selector__label">{{ 'work.filters.edition' | t }}</span>
            <span class="storefront-work-selector__value" data-work-selector-value>{{ 'work.filters.all_editions' | t }}</span>
          </summary>
          <div class="storefront-work-selector__menu" role="radiogroup" aria-label="{{ 'work.filters.edition' | t | escape }}">
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="work-edition-{{ section.id }}" value="" data-work-filter="edition" data-work-option-label="{{ 'work.filters.all_editions' | t | escape }}" checked>
              <span>{{ 'work.filters.all_editions' | t }}</span>
            </label>
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="work-edition-{{ section.id }}" value="limited" data-work-filter="edition" data-work-option-label="{{ 'work.editions.limited' | t | escape }}">
              <span>{{ 'work.editions.limited' | t }}</span>
            </label>
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="work-edition-{{ section.id }}" value="permanent" data-work-filter="edition" data-work-option-label="{{ 'work.editions.permanent' | t | escape }}">
              <span>{{ 'work.editions.permanent' | t }}</span>
            </label>
          </div>
        </details>
      {%- endif -%}

      {%- if section.settings.enable_sorting -%}
        <details class="storefront-work-selector storefront-work-selector--sort" data-work-selector>
          <summary class="storefront-work-selector__trigger">
            <svg class="storefront-work-selector__icon" aria-hidden="true" viewBox="0 0 24 20" focusable="false">
              <path d="m4 7 8 6 8-6" />
            </svg>
            <span class="storefront-work-selector__label">{{ 'work.sort.label' | t }}</span>
            <span class="storefront-work-selector__value" data-work-selector-value>{{ 'work.sort.default' | t }}</span>
          </summary>
          <div class="storefront-work-selector__menu" role="radiogroup" aria-label="{{ 'work.sort.label' | t | escape }}">
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="work-sort-{{ section.id }}" value="default" data-work-sort data-work-option-label="{{ 'work.sort.default' | t | escape }}" checked>
              <span>{{ 'work.sort.default' | t }}</span>
            </label>
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="work-sort-{{ section.id }}" value="date-desc" data-work-sort data-work-option-label="{{ 'work.sort.newest' | t | escape }}">
              <span>{{ 'work.sort.newest' | t }}</span>
            </label>
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="work-sort-{{ section.id }}" value="date-asc" data-work-sort data-work-option-label="{{ 'work.sort.oldest' | t | escape }}">
              <span>{{ 'work.sort.oldest' | t }}</span>
            </label>
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="work-sort-{{ section.id }}" value="kind" data-work-sort data-work-option-label="{{ 'work.sort.type' | t | escape }}">
              <span>{{ 'work.sort.type' | t }}</span>
            </label>
            <label class="storefront-work-selector__option">
              <input class="storefront-work-selector__input visually-hidden" type="radio" name="work-sort-{{ section.id }}" value="title" data-work-sort data-work-option-label="{{ 'work.sort.title' | t | escape }}">
              <span>{{ 'work.sort.title' | t }}</span>
            </label>
          </div>
        </details>
      {%- endif -%}

      <p class="storefront-work__result-count visually-hidden" aria-live="polite" data-work-result-count></p>
    </form>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="storefront-work__grid" data-work-grid>
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_image = block.settings.image
          assign card_hover_image = block.settings.hover_image
          assign card_hover_video = block.settings.hover_video
          assign card_title = block.settings.title
          assign card_url = block.settings.url
          assign selected_collection = block.settings.collection
          assign card_kind = block.settings.kind
          assign card_filter_kind = card_kind
          assign card_type_label = 'work.types.collection' | t
          assign card_width = block.settings.card_width | default: 'one-third'
          assign card_sizes = '(min-width: 768px) 33vw, 100vw'
          assign image_loading = 'lazy'

          if card_width == 'two-thirds'
            assign card_sizes = '(min-width: 768px) 66vw, 100vw'
          endif

          if forloop.index <= 3
            assign image_loading = 'eager'
          endif

          if card_kind == 'piece-index'
            assign card_filter_kind = 'piece'
            assign card_type_label = 'work.types.individual_pieces' | t
          elsif card_kind == 'piece'
            assign card_filter_kind = 'piece'
            assign card_type_label = 'work.types.individual_piece' | t
          elsif card_kind == 'service' or card_kind == 'service-firings' or card_kind == 'service-custom-production'
            assign card_filter_kind = 'service'
            assign card_type_label = 'work.types.service' | t
            if card_title == blank
              if card_kind == 'service-firings'
                assign card_title = 'work.services.firings' | t
              elsif card_kind == 'service-custom-production'
                assign card_title = 'work.services.custom_production' | t
              endif
            endif
          endif

          if selected_collection != blank
            if card_image == blank
              assign card_image = selected_collection.featured_image
            endif
            if card_title == blank
              assign card_title = selected_collection.title
            endif
            if card_url == blank
              assign card_url = selected_collection.url
            endif
          endif

          if card_title == blank
            if card_kind == 'piece-index'
              assign card_title = 'work.types.individual_pieces' | t
            else
              assign card_title = 'work.untitled' | t
            endif
          endif

        -%}

        <li
          class="storefront-work__item"
          data-work-item
          data-work-width="{{ card_width }}"
          data-work-kind="{{ card_filter_kind }}"
          data-work-edition="{% if block.settings.limited %}limited{% else %}permanent{% endif %}"
          data-work-featured="{{ block.settings.featured }}"
          data-work-date="{{ block.settings.publication_date | escape }}"
          data-work-title="{{ card_title | downcase | escape }}"
          {{ block.shopify_attributes }}
        >
          {%- if card_url != blank -%}
            <a class="storefront-work-card" href="{{ card_url }}">
          {%- else -%}
            <article class="storefront-work-card">
          {%- endif -%}
              <div class="storefront-work-card__media">
                {%- if card_image != blank -%}
                  {{ card_image
                    | image_url: width: 1800
                    | image_tag:
                      widths: '480, 720, 960, 1200, 1500, 1800',
                      sizes: card_sizes,
                      loading: image_loading,
                      class: 'storefront-work-card__image storefront-work-card__image--primary',
                      alt: card_image.alt | default: card_title
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'storefront-work-card__image storefront-work-card__image--primary storefront-work-card__placeholder placeholder-svg' }}
                {%- endif -%}

                {%- if card_hover_video != blank -%}
                  {{ card_hover_video
                    | video_tag:
                      autoplay: false,
                      loop: true,
                      muted: true,
                      controls: false,
                      playsinline: true,
                      preload: 'metadata',
                      class: 'storefront-work-card__image storefront-work-card__image--hover storefront-work-card__video',
                      data-work-hover-video: ''
                  }}
                {%- elsif card_hover_image != blank -%}
                  {{ card_hover_image
                    | image_url: width: 1800
                    | image_tag:
                      widths: '480, 720, 960, 1200, 1500, 1800',
                      sizes: card_sizes,
                      loading: 'lazy',
                      class: 'storefront-work-card__image storefront-work-card__image--hover',
                      alt: ''
                  }}
                {%- endif -%}
              </div>

              <div class="storefront-work-card__content">
                <ul class="storefront-work-card__tags" aria-label="{{ 'work.tags.label' | t | escape }}">
                  <li class="storefront-work-card__tag">{{ card_type_label }}</li>
                  {%- if block.settings.limited and card_kind == 'collection' -%}
                    <li class="storefront-work-card__tag">{{ 'work.editions.limited' | t }}</li>
                  {%- endif -%}
                </ul>
                <h2 class="storefront-work-card__title">{{ card_title }}</h2>
              </div>
          {%- if card_url != blank -%}
            </a>
          {%- else -%}
            </article>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    <div class="storefront-work__empty" data-work-empty hidden>
      <p>{{ 'work.no_results' | t }}</p>
    </div>
  {%- elsif request.design_mode -%}
    <p>{{ 'work.editor_hint' | t }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Work index",
  "settings": [
    {
      "type": "select",
      "id": "heading_context",
      "label": "Translated heading",
      "default": "work",
      "options": [
        { "value": "work", "label": "Work" },
        { "value": "individual-pieces", "label": "Individual pieces" }
      ]
    },
    { "type": "text", "id": "heading", "label": "Custom accessible heading" },
    { "type": "checkbox", "id": "enable_filters", "label": "Enable filters", "default": true },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "Work entry",
      "settings": [
        {
          "type": "select",
          "id": "kind",
          "label": "Type",
          "default": "collection",
          "options": [
            { "value": "collection", "label": "Collection" },
            { "value": "piece-index", "label": "Individual pieces index" },
            { "value": "piece", "label": "Individual piece" },
            { "value": "service", "label": "Service with custom title" },
            { "value": "service-firings", "label": "Firings service" },
            { "value": "service-custom-production", "label": "Custom production service" }
          ]
        },
        {
          "type": "select",
          "id": "card_width",
          "label": "Card width",
          "default": "one-third",
          "options": [
            { "value": "one-third", "label": "One third" },
            { "value": "two-thirds", "label": "Two thirds" }
          ]
        },
        { "type": "collection", "id": "collection", "label": "Shopify collection source" },
        { "type": "image_picker", "id": "image", "label": "Primary image" },
        { "type": "video", "id": "hover_video", "label": "Hover video" },
        { "type": "image_picker", "id": "hover_image", "label": "Hover image fallback" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "url", "id": "url", "label": "Dedicated page" },
        { "type": "checkbox", "id": "limited", "label": "Limited edition", "default": false },
        { "type": "text", "id": "publication_date", "label": "Publication date (YYYY-MM-DD)" },
        { "type": "checkbox", "id": "featured", "label": "Pin in default order", "default": false }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [{ "name": "Work index" }]
}
{% endschema %}
