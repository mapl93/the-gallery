{%- comment -%}
  Section: Password Content
  Split-screen layout for password-protected store.
  Left: title, subtitle, body, social/contact.
  Right: newsletter signup + password link (opens modal).
  Logo pinned top-left. Background image configurable.
{%- endcomment -%}

<div class="coming-soon">
  {%- if section.settings.background_image != blank -%}
    <img
      class="coming-soon__bg"
      src="{{ section.settings.background_image | image_url: width: 1920 }}"
      alt=""
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
    >
  {%- endif -%}

  {%- comment -%} Main content wrapper (max-width centered) {%- endcomment -%}
  <div class="coming-soon__inner">

    {%- comment -%} Left column: editorial content {%- endcomment -%}
    <div class="coming-soon__left">
      {%- comment -%} Logo — inline above heading {%- endcomment -%}
      <div class="coming-soon__logo-inline">
        {%- render 'logo', variant: section.settings.logo_variant, width: 280, class: 'coming-soon__logo', loading: 'eager' -%}
      </div>

      <h1 class="coming-soon__heading">{{ 'password.heading' | t }}</h1>

      {%- assign subtitle_key = 'password.subtitle' | t -%}
      {%- if subtitle_key != 'password.subtitle' -%}
        <p class="coming-soon__subtitle">{{ subtitle_key }}</p>
      {%- endif -%}

      <div class="coming-soon__body">
        <p>{{ 'password.subtext' | t }}</p>
      </div>

      {%- comment -%} Social / contact {%- endcomment -%}
      <div class="coming-soon__social">
        {%- if section.settings.instagram_url != blank -%}
          <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram" class="coming-soon__social-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <a href="mailto:{{ section.settings.email }}" aria-label="Email" class="coming-soon__social-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Right column: newsletter {%- endcomment -%}
    <div class="coming-soon__right">
      <div class="coming-soon__newsletter">
        {% form 'customer', id: 'password-newsletter' %}
          <input type="hidden" name="contact[tags]" value="password-page,newsletter">
          {%- if form.posted_successfully? -%}
            <p class="coming-soon__success">{{ 'password.newsletter_success' | t }}</p>
          {%- else -%}
            <div class="coming-soon__form">
              <input
                type="email"
                name="contact[email]"
                placeholder="{{ 'password.newsletter_placeholder' | t }}"
                required
                autocomplete="email"
                aria-label="{{ 'password.newsletter_placeholder' | t }}"
                class="coming-soon__input"
              >
              <button type="submit" class="coming-soon__submit">
                {{ 'password.newsletter_submit' | t }}
              </button>
            </div>
            {%- if form.errors -%}
              <p class="coming-soon__error">{{ form.errors.messages['email'] }}</p>
            {%- endif -%}
          {%- endif -%}
        {% endform %}
      </div>

      {%- comment -%} Password link — opens modal {%- endcomment -%}
      <button type="button" class="coming-soon__password-link" data-password-toggle>
        {{ 'password.password_label' | t }}
      </button>
    </div>

  </div>

  {%- comment -%} Footer {%- endcomment -%}
  <p class="coming-soon__footer">
    &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
  </p>

  {%- comment -%} Password modal {%- endcomment -%}
  <div class="coming-soon__modal" data-password-modal>
    <div class="coming-soon__modal-backdrop" data-password-close></div>
    <div class="coming-soon__modal-panel">
      <button type="button" class="coming-soon__modal-close" data-password-close aria-label="{{ 'accessibility.close' | t }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
      <p class="coming-soon__modal-title">{{ 'password.modal_title' | t }}</p>
      {% form 'storefront_password' %}
        <div class="coming-soon__form">
          <input
            type="password"
            name="password"
            placeholder="{{ 'password.placeholder' | t }}"
            required
            autocomplete="current-password"
            aria-label="{{ 'password.placeholder' | t }}"
            class="coming-soon__input"
          >
          <button type="submit" class="coming-soon__submit">
            {{ 'password.submit' | t }}
          </button>
        </div>
        {%- if form.errors -%}
          <p class="coming-soon__error">{{ 'password.error' | t }}</p>
          <script>document.querySelector('[data-password-modal]').classList.add('is-open');</script>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</div>

<script>
  (function() {
    var modal = document.querySelector('[data-password-modal]');
    if (!modal) return;
    document.querySelectorAll('[data-password-toggle]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        modal.classList.add('is-open');
        modal.querySelector('input[type="password"]').focus();
      });
    });
    document.querySelectorAll('[data-password-close]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        modal.classList.remove('is-open');
      });
    });
    modal.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') modal.classList.remove('is-open');
    });
  })();
</script>

{% schema %}
{
  "name": "Password Page",
  "tag": "section",
  "class": "section-password",
  "settings": [
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "select",
      "id": "logo_variant",
      "label": "Logo variant",
      "info": "Logos are configured in Theme settings → Logo.",
      "options": [
        { "value": "short", "label": "Short" },
        { "value": "long", "label": "Long" },
        { "value": "wordmark", "label": "Wordmark" },
        { "value": "easter_egg", "label": "Easter egg" }
      ],
      "default": "short"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Full-screen background. A dark overlay is applied automatically."
    },
    {
      "type": "header",
      "content": "Social & Contact"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact email",
      "info": "Shown as a mail icon link."
    }
  ]
}
{% endschema %}
