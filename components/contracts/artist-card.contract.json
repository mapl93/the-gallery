{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.1.0",
  "slug": "artist-card",
  "name": "Artist Card",
  "registryId": "F6a",
  "category": "storytelling",
  "status": "pilot",
  "summary": "Artist card with portrait, identity, medium, location, and piece count.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/artist-card",
    "css": { "file": "components/css/storytelling.css", "selector": ".artist-card" },
    "docs": "site/src/content/components/artist-card.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".artist-card", "className": ".artist-card", "required": true, "description": "Artist card container; the target may keep it passive or provide native interactive markup." },
    { "name": "portrait", "selector": ".artist-card__portrait", "className": ".artist-card__portrait", "required": false, "description": "Optional artist portrait region." },
    { "name": "portraitImage", "selector": ".artist-card__portrait img", "className": null, "required": false, "description": "Portrait image supplied by the target." },
    { "name": "badge", "selector": ".artist-card__badge", "className": ".artist-card__badge", "required": false, "description": "Optional artist badge over the portrait." },
    { "name": "name", "selector": ".artist-card__name", "className": ".artist-card__name", "required": true, "description": "Artist display name." },
    { "name": "medium", "selector": ".artist-card__medium", "className": ".artist-card__medium", "required": false, "description": "Optional artist medium." },
    { "name": "location", "selector": ".artist-card__location", "className": ".artist-card__location", "required": false, "description": "Optional artist location." },
    { "name": "pieceCount", "selector": ".artist-card__piece-count", "className": ".artist-card__piece-count", "required": false, "description": "Optional target-formatted piece count." }
  ],
  "variants": [{ "name": "default", "className": null, "default": true, "description": "Default artist card." }],
  "sizes": [{ "name": "default", "className": null, "default": true, "description": "Card width follows its containing layout." }],
  "states": [
    { "name": "default", "selectors": [".artist-card"], "description": "Default artist card state." },
    { "name": "hover", "selectors": [".artist-card:hover .artist-card__portrait img"], "description": "Fine-pointer portrait emphasis." },
    { "name": "focus", "selectors": [".artist-card:is(a, button):focus-visible", ".artist-card:focus-within"], "description": "Visible keyboard focus when the target makes the card or its content interactive." }
  ],
  "behavior": [
    { "name": "interactionBoundary", "selectors": [".artist-card"], "description": "This contract does not decide whether every Artist Card is a link or passive. Targets that add activation must use native interactive semantics, an accessible name, and visible focus." }
  ],
  "properties": [
    { "name": "portrait", "type": "slot", "required": false, "description": "Target-owned portrait media with appropriate alternative text.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".artist-card__portrait", "classNames": [".artist-card__portrait"] }] } },
    { "name": "badge", "type": "string", "required": false, "description": "Optional short artist badge.", "targetMappings": { "web": [{ "kind": "content", "selector": ".artist-card__badge" }] } },
    { "name": "name", "type": "string", "required": true, "description": "Artist display name.", "targetMappings": { "web": [{ "kind": "content", "selector": ".artist-card__name" }] } },
    { "name": "medium", "type": "string", "required": false, "description": "Optional artist medium.", "targetMappings": { "web": [{ "kind": "content", "selector": ".artist-card__medium" }] } },
    { "name": "location", "type": "string", "required": false, "description": "Optional human-readable location.", "targetMappings": { "web": [{ "kind": "content", "selector": ".artist-card__location" }] } },
    { "name": "pieceCount", "type": "string", "required": false, "description": "Optional target-formatted piece count.", "targetMappings": { "web": [{ "kind": "content", "selector": ".artist-card__piece-count" }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-border-focus", "--color-button-primary-bg-default", "--color-button-primary-text-default", "--color-text-primary", "--color-text-secondary"],
      "motion": ["--motion-transition-media"],
      "typography": ["--font-family-heading", "--typo-body-sm-size", "--typo-caption-size", "--typo-h4-size"],
      "radius": ["--radius-md", "--radius-sm"],
      "spacing": ["--space-layout-element-gap"]
    }
  },
  "accessibility": [
    "Give meaningful portraits useful alternative text and mark decorative portraits accordingly.",
    "When the target makes the card interactive, use native link or button markup instead of click handling on a passive container.",
    "Ensure an interactive card has a descriptive accessible name, visible focus, and no nested interactive controls.",
    "Do not rely on portrait hover motion to communicate identity or availability."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/storytelling.css." },
    "shopify": { "status": "planned", "kind": "liquid-css-js" },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
