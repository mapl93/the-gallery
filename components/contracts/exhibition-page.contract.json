{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.1.0",
  "slug": "exhibition-page",
  "name": "Exhibition Landing Page",
  "registryId": "F7",
  "category": "storytelling",
  "status": "pilot",
  "summary": "Exhibition layout with hero, information, works, and participating-artist regions.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/exhibition-page",
    "css": { "file": "components/css/storytelling.css", "selector": ".exhibition-page" },
    "docs": "site/src/content/components/exhibition-page.mdx"
  },
  "anatomy": [
    { "name": "root", "selector": ".exhibition-page", "className": ".exhibition-page", "required": true, "description": "Exhibition page composition." },
    { "name": "hero", "selector": ".exhibition-hero", "className": ".exhibition-hero", "required": true, "description": "Exhibition hero region." },
    { "name": "heroMedia", "selector": ".exhibition-hero__media", "className": ".exhibition-hero__media", "required": false, "description": "Optional hero media region." },
    { "name": "heroImage", "selector": ".exhibition-hero__media img", "className": null, "required": false, "description": "Hero image supplied by the target." },
    { "name": "heroOverlay", "selector": ".exhibition-hero__overlay", "className": ".exhibition-hero__overlay", "required": false, "description": "Decorative contrast overlay." },
    { "name": "heroContent", "selector": ".exhibition-hero__content", "className": ".exhibition-hero__content", "required": true, "description": "Ordered hero text content." },
    { "name": "heroLabel", "selector": ".exhibition-hero__label", "className": ".exhibition-hero__label", "required": false, "description": "Optional exhibition label." },
    { "name": "heroTitle", "selector": ".exhibition-hero__title", "className": ".exhibition-hero__title", "required": true, "description": "Exhibition title." },
    { "name": "heroDates", "selector": ".exhibition-hero__dates", "className": ".exhibition-hero__dates", "required": false, "description": "Optional exhibition date text." },
    { "name": "heroLocation", "selector": ".exhibition-hero__location", "className": ".exhibition-hero__location", "required": false, "description": "Optional exhibition location." },
    { "name": "info", "selector": ".exhibition-info", "className": ".exhibition-info", "required": false, "description": "Exhibition description and metadata region." },
    { "name": "description", "selector": ".exhibition-info__description", "className": ".exhibition-info__description", "required": false, "description": "Exhibition narrative rich content." },
    { "name": "sidebar", "selector": ".exhibition-info__sidebar", "className": ".exhibition-info__sidebar", "required": false, "description": "Repeated exhibition metadata region." },
    { "name": "detail", "selector": ".exhibition-info__detail", "className": ".exhibition-info__detail", "required": false, "description": "Repeated exhibition metadata item." },
    { "name": "detailLabel", "selector": ".exhibition-info__detail-label", "className": ".exhibition-info__detail-label", "required": false, "description": "Metadata label." },
    { "name": "detailValue", "selector": ".exhibition-info__detail-value", "className": ".exhibition-info__detail-value", "required": false, "description": "Metadata value." },
    { "name": "works", "selector": ".exhibition-works", "className": ".exhibition-works", "required": false, "description": "Optional featured-works composition." },
    { "name": "worksHeading", "selector": ".exhibition-works__heading", "className": ".exhibition-works__heading", "required": false, "description": "Featured-works heading." },
    { "name": "worksGrid", "selector": ".exhibition-works__grid", "className": ".exhibition-works__grid", "required": false, "description": "Target-owned featured-work items." },
    { "name": "artists", "selector": ".exhibition-artists", "className": ".exhibition-artists", "required": false, "description": "Optional participating-artists composition." },
    { "name": "artistsHeading", "selector": ".exhibition-artists__heading", "className": ".exhibition-artists__heading", "required": false, "description": "Participating-artists heading." },
    { "name": "artistsList", "selector": ".exhibition-artists__list", "className": ".exhibition-artists__list", "required": false, "description": "Target-owned artist items." },
    { "name": "artistItem", "selector": ".exhibition-artists__item", "className": ".exhibition-artists__item", "required": false, "description": "Participating artist item." },
    { "name": "artistAvatar", "selector": ".exhibition-artists__avatar", "className": ".exhibition-artists__avatar", "required": false, "description": "Participating artist image." },
    { "name": "artistName", "selector": ".exhibition-artists__name", "className": ".exhibition-artists__name", "required": false, "description": "Participating artist name." },
    { "name": "artistRole", "selector": ".exhibition-artists__role", "className": ".exhibition-artists__role", "required": false, "description": "Optional artist role." }
  ],
  "variants": [{ "name": "default", "className": null, "default": true, "description": "Default exhibition page composition." }],
  "sizes": [{ "name": "default", "className": null, "default": true, "description": "Contained responsive page regions with a stacked information layout on narrow viewports." }],
  "states": [
    { "name": "default", "selectors": [".exhibition-page"], "description": "Default exhibition page state." },
    { "name": "artistFocus", "selectors": [".exhibition-artists__item:is(a, button):focus-visible"], "description": "Visible keyboard focus for target-interactive artist items." }
  ],
  "behavior": [
    { "name": "compositionBoundary", "selectors": [".exhibition-works__grid", ".exhibition-artists__list"], "description": "Featured works and participating artists remain target-owned composition slots. This contract does not decide whether Product Card, Artist Card, links, or other dependencies own those records." },
    { "name": "narrativeOrder", "selectors": [".exhibition-page"], "description": "Adapters should preserve hero, exhibition information, works, and artist reading order independently of responsive layout." }
  ],
  "properties": [
    { "name": "heroMedia", "type": "slot", "required": false, "description": "Target-owned hero media with appropriate alternative text.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".exhibition-hero__media", "classNames": [".exhibition-hero__media"] }] } },
    { "name": "label", "type": "string", "required": false, "description": "Optional exhibition label.", "targetMappings": { "web": [{ "kind": "content", "selector": ".exhibition-hero__label" }] } },
    { "name": "title", "type": "string", "required": true, "description": "Exhibition title.", "targetMappings": { "web": [{ "kind": "content", "selector": ".exhibition-hero__title" }] } },
    { "name": "dates", "type": "string", "required": false, "description": "Optional target-formatted exhibition dates.", "targetMappings": { "web": [{ "kind": "content", "selector": ".exhibition-hero__dates" }] } },
    { "name": "location", "type": "string", "required": false, "description": "Optional exhibition location.", "targetMappings": { "web": [{ "kind": "content", "selector": ".exhibition-hero__location" }] } },
    { "name": "description", "type": "slot", "required": false, "description": "Target-owned exhibition narrative rich content.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".exhibition-info__description", "classNames": [".exhibition-info__description"] }] } },
    { "name": "details", "type": "slot", "required": false, "description": "Target-owned exhibition metadata.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".exhibition-info__sidebar", "classNames": [".exhibition-info__sidebar", ".exhibition-info__detail", ".exhibition-info__detail-label", ".exhibition-info__detail-value"] }] } },
    { "name": "works", "type": "slot", "required": false, "description": "Target-owned featured-works heading and item composition.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".exhibition-works", "classNames": [".exhibition-works", ".exhibition-works__heading", ".exhibition-works__grid"] }] } },
    { "name": "artists", "type": "slot", "required": false, "description": "Target-owned participating-artists heading and item composition.", "targetMappings": { "web": [{ "kind": "slot", "selector": ".exhibition-artists", "classNames": [".exhibition-artists", ".exhibition-artists__heading", ".exhibition-artists__list", ".exhibition-artists__item", ".exhibition-artists__avatar", ".exhibition-artists__name", ".exhibition-artists__role"] }] } }
  ],
  "tokens": {
    "public": {
      "color": ["--color-border-focus", "--color-border-subtle", "--color-button-primary-bg-default", "--color-button-primary-text-default", "--color-surface-statement", "--color-text-primary", "--color-text-secondary"],
      "typography": ["--font-family-heading", "--typo-article-line-height", "--typo-article-size", "--typo-body-size", "--typo-body-sm-size", "--typo-caption-size", "--typo-h1-line-height", "--typo-h1-size", "--typo-h3-size"],
      "radius": ["--radius-full"],
      "spacing": ["--layout-content-width", "--layout-gutter", "--space-layout-element-gap", "--space-layout-grid-gap", "--space-layout-section-gap"]
    }
  },
  "accessibility": [
    "Use one page-level heading for the exhibition title and logical headings for optional works and artist regions.",
    "Give meaningful hero and artist media useful alternative text and mark decorative media accordingly.",
    "Use semantic name-value markup for exhibition details and machine-readable date markup where the target can provide it.",
    "Composed works and artist items retain their own link, control, focus, and accessible-name requirements."
  ],
  "adapters": {
    "web": { "status": "implemented", "kind": "css", "notes": "Implemented in components/css/storytelling.css." },
    "shopify": { "status": "planned", "kind": "liquid-css-js" },
    "react": { "status": "planned", "kind": "component" },
    "figma": { "status": "planned", "kind": "component" },
    "swiftui": { "status": "planned", "kind": "native-component" },
    "compose": { "status": "planned", "kind": "native-component" }
  }
}
