{%- liquid
  assign cart_label = 'accessibility.cart_count' | t: count: cart.item_count
  assign account_url = routes.account_login_url
  if customer
    assign account_url = routes.account_url
  endif
-%}

<header
  class="header storefront-header{% unless request.page_type == 'index' %} storefront-header--internal{% endunless %}{% unless section.settings.sticky %} storefront-header--static{% endunless %}"
  {% unless request.page_type == 'index' %}data-storefront-header{% endunless %}
>
  <a class="header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
    <img
      class="header__wordmark"
      src="{{ 'gallery-wordmark.svg' | asset_url }}"
      alt="{{ shop.name | escape }}"
      width="110"
      height="16"
      loading="eager"
    >
    {%- if request.page_type == 'index' -%}
      <span class="header__mobile-eyes">
        {% render 'brand-eyes', tone: 'dark', blink: true %}
      </span>
    {%- endif -%}
  </a>

  {%- unless request.page_type == 'index' -%}
    <a class="header__internal-eyes" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% render 'brand-eyes', tone: 'dark', blink: true %}
    </a>
  {%- endunless -%}

  <div class="header__actions">
    {%- if section.settings.show_search -%}
      <a
        class="header__action"
        href="{{ routes.search_url }}"
        aria-label="{{ 'accessibility.search' | t }}"
        aria-controls="StorefrontSearch"
        aria-expanded="false"
        data-storefront-open="search"
      >
        <img src="{{ 'gallery-search.svg' | asset_url }}" alt="" width="24" height="24">
      </a>
    {%- endif -%}

    {%- if section.settings.show_account -%}
      <a class="header__action" href="{{ account_url }}" aria-label="{{ 'accessibility.account' | t }}">
        <img src="{{ 'gallery-account.svg' | asset_url }}" alt="" width="24" height="24">
      </a>
    {%- endif -%}

    <a
      href="{{ routes.cart_url }}"
      class="header__action"
      aria-label="{{ cart_label | escape }}"
      {% if section.settings.cart_behavior == 'drawer' %}
        aria-controls="StorefrontCartDrawer"
        aria-expanded="false"
        data-storefront-open="cart"
      {% endif %}
    >
      <img src="{{ 'gallery-bag.svg' | asset_url }}" alt="" width="24" height="24">
      {%- if cart.item_count > 0 -%}
        <span class="header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
      {%- endif -%}
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": false },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": false },
    { "type": "checkbox", "id": "show_account", "label": "Show customer account", "default": true },
    {
      "type": "select",
      "id": "cart_behavior",
      "label": "Cart action",
      "options": [
        { "value": "drawer", "label": "Open cart drawer" },
        { "value": "page", "label": "Go to cart page" }
      ],
      "default": "drawer"
    }
  ]
}
{% endschema %}
