{%- comment -%}
  Target-owned editorial gateway inspired by the approved Figma layout. All
  typography, color, spacing, and motion values remain owned by The Gallery.
{%- endcomment -%}

<div class="landing-gateway">
  <h1 class="visually-hidden">{{ shop.name }}</h1>

  <div class="landing-gateway__identity" aria-hidden="true">
    <div class="landing-gateway__wordmark">
      {% render 'logo', variant: section.settings.logo_variant, width: 1280, loading: 'eager' %}
    </div>
  </div>

  <nav class="landing-gateway__navigation" aria-label="{{ section.settings.navigation_label | escape }}">
    <ul class="landing-gateway__portals">
      {%- for block in section.blocks -%}
        {%- if block.settings.label != blank -%}
          <li {{ block.shopify_attributes }}>
            <a class="landing-gateway__portal-link" href="{{ block.settings.url | default: routes.root_url }}">
              {{ block.settings.label }}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </nav>

  {%- if section.settings.image != blank -%}
    <div class="landing-gateway__media">
      {{ section.settings.image
        | image_url: width: 900
        | image_tag:
          widths: '240, 360, 540, 720, 900',
          sizes: '(min-width: 990px) 12rem, 22vw',
          loading: 'eager',
          alt: section.settings.image_alt
      }}
    </div>
  {%- endif -%}

  {%- if section.settings.note != blank -%}
    <div class="landing-gateway__note rte">{{ section.settings.note }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Editorial gateway",
  "tag": "section",
  "class": "shopify-section--landing-gateway",
  "settings": [
    {
      "type": "select",
      "id": "logo_variant",
      "label": "Logo variant",
      "options": [
        { "value": "short", "label": "Short" },
        { "value": "long", "label": "Long" },
        { "value": "wordmark", "label": "Wordmark" },
        { "value": "easter_egg", "label": "Easter egg" }
      ],
      "default": "wordmark"
    },
    {
      "type": "text",
      "id": "navigation_label",
      "label": "Navigation label",
      "default": "Explore"
    },
    { "type": "image_picker", "id": "image", "label": "Reference image" },
    { "type": "text", "id": "image_alt", "label": "Image alternative text" },
    { "type": "richtext", "id": "note", "label": "Editorial note" }
  ],
  "blocks": [
    {
      "type": "portal",
      "name": "Portal link",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial gateway",
      "blocks": [
        { "type": "portal", "settings": { "label": "Work" } },
        { "type": "portal", "settings": { "label": "Shop" } },
        { "type": "portal", "settings": { "label": "Journal" } },
        { "type": "portal", "settings": { "label": "About" } }
      ]
    }
  ]
}
{% endschema %}
