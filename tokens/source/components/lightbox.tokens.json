{
  "$description": "Lightbox public visual roles. Colors alias shared system values; zoom and pan remain runtime state.",
  "component": {
    "lightbox": {
      "viewportPaddingScale": {
        "$type": "number",
        "$value": 1
      },
      "contentMaxWidth": {
        "$type": "dimension",
        "$value": "960px"
      },
      "contentViewportHeightScale": {
        "$type": "number",
        "$value": 0.85
      },
      "imageViewportHeightScale": {
        "$type": "number",
        "$value": 0.72
      },
      "contentGapScale": {
        "$type": "number",
        "$value": 0.5
      },
      "closeInsetScale": {
        "$type": "number",
        "$value": 0.5
      },
      "navInsetScale": {
        "$type": "number",
        "$value": 0.5
      },
      "zoomInsetScale": {
        "$type": "number",
        "$value": 0.5
      },
      "zoomGapScale": {
        "$type": "number",
        "$value": 0.25
      },
      "captionMaxWidth": {
        "$type": "dimension",
        "$value": "60ch"
      },
      "fallbackViewportWidthScale": {
        "$type": "number",
        "$value": 0.8
      },
      "fallbackMaxWidth": {
        "$type": "dimension",
        "$value": "640px"
      },
      "fallbackViewportHeightScale": {
        "$type": "number",
        "$value": 0.6
      },
      "fallbackMaxHeight": {
        "$type": "dimension",
        "$value": "480px"
      },
      "fallbackBorderWidth": {
        "$type": "dimension",
        "$value": "{dimension.1}"
      },
      "scrimColor": {
        "$type": "color",
        "$value": "{color.overlay}",
        "$description": "Media viewer backdrop tint; aliases the shared overlay role."
      },
      "scrimOpacity": {
        "$type": "number",
        "$value": 0.92,
        "$description": "Existing media-viewer density. Independent of shared Modal scrim opacity."
      },
      "foregroundColor": {
        "$type": "color",
        "$value": "{color.gray.0}",
        "$description": "Caption, counter, fallback border/text and focus on the media backdrop; stable across themes."
      },
      "controlSurfaceColor": {
        "$type": "color",
        "$value": "{color.gray.0}",
        "$description": "Close, navigation and zoom surfaces; stable across themes."
      },
      "controlTextColor": {
        "$type": "color",
        "$value": "{color.gray.900}",
        "$description": "Foreground on the Lightbox control surface, including hover; stable across themes."
      }
    }
  }
}
