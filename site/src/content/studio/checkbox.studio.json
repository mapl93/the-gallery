            "names": [
              "--color-input-default-unfocused-bg"
            ]
          }
        },
        {
          "id": "control-color",
          "label": "Control",
          "kind": "token-swatch",
          "tokens": {
            "category": "color",
            "match": "^(--color-input-default-(unfocused|hover)-inner-border|--color-input-(error|success|warning)-unfocused-inner-border|--color-button-primary-bg-default)$"
          }
        },
        {
          "id": "label-color",
          "label": "Label",
          "kind": "token-swatch",
          "tokens": {
            "category": "color",
            "match": "^(--color-text-primary|--color-input-(error|success|warning)-unfocused-label)$"
          }
        },
        {
          "id": "focus-ring",
          "label": "Focus ring",
          "kind": "token-swatch",
          "tokens": {
            "category": "color",
            "match": "^--color-input-(default|error|success|warning)-focused-outer-border$"
          }
        },
        {
          "id": "transition",
          "label": "Transition",
          "kind": "token",
          "tokens": {
