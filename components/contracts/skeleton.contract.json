{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "skeleton",
  "name": "Loading Skeleton",
  "registryId": "A12",
  "category": "primitives",
  "status": "pilot",
  "summary": "Loading placeholder primitive with shimmer animation and shape variants for text, title, image, button, and circle placeholders.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/skeleton",
    "css": {
      "file": "components/css/primitives.css",
      "selector": ".skeleton"
    },
    "docs": "site/src/content/components/skeleton.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".skeleton",
      "className": ".skeleton",
      "required": true,
      "description": "Placeholder surface with shimmer animation."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default skeleton block."
    },
    {
      "name": "text",
      "className": ".skeleton--text",
      "default": false,
      "description": "Single-line text placeholder."
    },
    {
      "name": "title",
      "className": ".skeleton--title",
      "default": false,
      "description": "Heading placeholder."
    },
    {
      "name": "image",
      "className": ".skeleton--image",
      "default": false,
      "description": "Square media placeholder."
    },
    {
      "name": "button",
      "className": ".skeleton--button",
      "default": false,
      "description": "Button placeholder."
    },
    {
      "name": "circle",
      "className": ".skeleton--circle",
      "default": false,
      "description": "Circular placeholder."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default placeholder size defined by content or variant."
    }
  ],
  "states": [
    {
      "name": "loading",
      "selectors": [".skeleton"],
      "description": "Loading placeholder state."
    },
    {
      "name": "shimmer",
      "selectors": ["@keyframes skeleton-shimmer"],
      "description": "Indeterminate shimmer animation."
    }
  ],
  "behavior": [
    {
      "name": "decorativePlaceholder",
      "selectors": [".skeleton"],
      "attributes": ["aria-hidden=\"true\""],
      "description": "Skeleton shapes are decorative and should not duplicate the loading announcement."
    },
    {
      "name": "loadingAnnouncement",
      "attributes": ["aria-busy=\"true\"", "role=\"status\""],
      "description": "Loading announcement semantics belong to the containing region when users need feedback."
    },
    {
      "name": "reducedMotion",
      "selectors": [".skeleton"],
      "description": "Targets should consider reduced-motion policy for shimmer animation."
    }
  ],
  "properties": [
    {
      "name": "variant",
      "type": "enum",
      "required": false,
      "valuesFrom": "variants",
      "description": "Placeholder geometry selected from the canonical shape variants.",
      "targetMappings": {
        "web": [
          {
            "kind": "optionClass",
            "selector": ".skeleton",
            "source": "variants"
          }
        ]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-surface-secondary",
        "--color-surface-primary"
      ],
      "radius": [
        "--radius-sm",
        "--radius-md",
        "--radius-full"
      ],
      "spacing": [
        "--space-button-min-height"
      ]
    }
  },
  "accessibility": [
    "Mark decorative skeleton shapes as aria-hidden when the containing region announces loading state.",
    "Use aria-busy or role=\"status\" on the loading region when users need loading feedback.",
    "Replace skeletons with real content as soon as the target data is available.",
    "Respect reduced-motion preferences for shimmer animation in targets that support it."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented by class composition and keyframes in components/css/primitives.css."
    },
    "shopify": {
      "status": "implemented",
      "kind": "liquid-css-class"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "style"
    },
    "compose": {
      "status": "planned",
      "kind": "composable"
    }
  }
}
