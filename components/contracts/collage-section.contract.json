{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "collage-section",
  "name": "Collage Section",
  "registryId": "S19",
  "category": "sections",
  "status": "pilot",
  "summary": "Responsive art-directed media collage with item-level feature spans and target-owned activation.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/collage-section",
    "css": {
      "file": "components/css/sections.css",
      "selector": ".collage-section"
    },
    "docs": "site/src/content/components/collage-section.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".collage-section",
      "className": ".collage-section",
      "required": true,
      "description": "Collage section root."
    },
    {
      "name": "header",
      "selector": ".collage-section__header",
      "className": ".collage-section__header",
      "required": false,
      "description": "Optional centered heading region."
    },
    {
      "name": "heading",
      "selector": ".collage-section__heading",
      "className": ".collage-section__heading",
      "required": false,
      "description": "Optional visible collage heading."
    },
    {
      "name": "grid",
      "selector": ".collage-section__grid",
      "className": ".collage-section__grid",
      "required": true,
      "description": "Responsive art-directed item composition."
    },
    {
      "name": "item",
      "selector": ".collage-section__item",
      "className": ".collage-section__item",
      "required": false,
      "description": "Repeated target-owned media item."
    },
    {
      "name": "featureItem",
      "selector": ".collage-section__item--feature",
      "className": ".collage-section__item--feature",
      "required": false,
      "description": "Item-level modifier that spans two columns and rows when space allows."
    },
    {
      "name": "caption",
      "selector": ".collage-section__caption",
      "className": ".collage-section__caption",
      "required": false,
      "description": "Optional caption disclosed on hover, focus within, and non-hover input."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default variant."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [
        ".collage-section"
      ],
      "description": "Resting collage presentation; feature is an item layout modifier rather than a state."
    },
    {
      "name": "itemHover",
      "selectors": [
        ".collage-section__item:hover img",
        ".collage-section__item:hover .collage-section__caption"
      ],
      "description": "Pointer emphasis and caption disclosure for one item."
    },
    {
      "name": "itemFocusWithin",
      "selectors": [
        ".collage-section__item:focus-visible",
        ".collage-section__item:focus-within img",
        ".collage-section__item:focus-within .collage-section__caption"
      ],
      "description": "Equivalent emphasis and caption disclosure when target-owned interactive content receives focus."
    }
  ],
  "behavior": [
    {
      "name": "itemOwnership",
      "selectors": [
        ".collage-section__item"
      ],
      "description": "Targets supply ordered media, captions, and item-level feature spans and decide whether each item is passive or contains native navigation or another control."
    }
  ],
  "properties": [
    {
      "name": "heading",
      "type": "string",
      "required": false,
      "description": "Optional visible collage heading.",
      "targetMappings": {
        "web": [{ "kind": "content", "selector": ".collage-section__heading" }]
      }
    },
    {
      "name": "items",
      "type": "slot",
      "required": true,
      "description": "Ordered target-owned collage items, including any feature span and caption composition.",
      "targetMappings": {
        "web": [{ "kind": "slot", "selector": ".collage-section__grid", "classNames": [".collage-section__grid"] }]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-border-focus",
        "--color-text-primary"
      ],
      "easing": [
        "--easing-default"
      ],
      "typography": [
        "--font-family-heading",
        "--typo-body-sm-size",
        "--typo-h3-size"
      ],
      "radius": [
        "--radius-sm"
      ],
      "other": [
        "--section-spacing-y"
      ],
      "transition": [
        "--transition-default",
        "--transition-fast"
      ]
    }
  },
  "accessibility": [
    "Provide useful alternatives for informative imagery and preserve source order when feature items span the visual grid.",
    "Captions remain available on focus within and non-hover input rather than relying on pointer hover alone.",
    "Passive items do not receive button or link semantics; target-owned interactive content uses native controls with visible focus and descriptive names.",
    "Reduced motion removes image and caption transitions."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented in components/css/sections.css."
    },
    "shopify": {
      "status": "planned",
      "kind": "liquid-css-js"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "native-component"
    },
    "compose": {
      "status": "planned",
      "kind": "native-component"
    }
  }
}
