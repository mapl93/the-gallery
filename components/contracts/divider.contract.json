{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "divider",
  "name": "Divider",
  "registryId": "A14",
  "category": "primitives",
  "status": "pilot",
  "summary": "Horizontal or vertical divider primitive with default, decorative, and section spacing variants for visual or semantic separation.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/divider",
    "css": {
      "file": "components/css/primitives.css",
      "selector": ".divider"
    },
    "docs": "site/src/content/components/divider.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".divider",
      "className": ".divider",
      "required": true,
      "description": "Horizontal separation rule."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default subtle divider."
    },
    {
      "name": "decorative",
      "className": ".divider--decorative",
      "default": false,
      "description": "More visible decorative divider."
    },
    {
      "name": "section",
      "className": ".divider--section",
      "default": false,
      "description": "Section divider with larger vertical spacing."
    }
  ],
  "sizes": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default divider thickness and spacing."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [".divider"],
      "description": "Default divider state."
    }
  ],
  "behavior": [
    {
      "name": "separatorSemantics",
      "selectors": [".divider"],
      "attributes": ["<hr>", "role=\"separator\"", "aria-hidden=\"true\""],
      "description": "Use semantic separator markup for meaningful separation and hide purely decorative dividers from assistive technology."
    }
  ],
  "properties": [
    {
      "name": "variant",
      "type": "enum",
      "required": false,
      "valuesFrom": "variants",
      "description": "Visual emphasis and spacing presentation for the horizontal rule.",
      "targetMappings": {
        "web": [{ "kind": "optionClass", "selector": ".divider", "source": "variants" }]
      }
    },
    {
      "name": "orientation",
      "type": "enum",
      "required": false,
      "defaultValue": "horizontal",
      "values": ["horizontal", "vertical"],
      "description": "Axis along which the divider separates adjacent content.",
      "targetMappings": {
        "web": [{ "kind": "attribute", "selector": ".divider", "attribute": "data-orientation", "values": { "horizontal": null, "vertical": "vertical" } }]
      }
    },
    {
      "name": "semantics",
      "type": "enum",
      "required": false,
      "defaultValue": "decorative",
      "values": ["decorative", "structural"],
      "description": "Whether the divider is hidden from assistive technology or communicates structure between regions.",
      "targetMappings": {
        "web": [{ "kind": "attribute", "selector": ".divider", "attribute": "aria-hidden", "values": { "decorative": "true", "structural": null }, "elements": ["hr"] }]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-border-subtle",
        "--color-border-decorative"
      ],
      "spacing": [
        "--space-layout-element-gap",
        "--space-layout-section-gap"
      ]
    }
  },
  "accessibility": [
    "Use hr or role=\"separator\" when the divider conveys structure.",
    "Mark decorative dividers as aria-hidden when they add no semantic value.",
    "Do not use divider spacing as the only cue for grouped content."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented by class composition in components/css/primitives.css."
    },
    "shopify": {
      "status": "implemented",
      "kind": "liquid-css-class"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "style"
    },
    "compose": {
      "status": "planned",
      "kind": "composable"
    }
  }
}
