{%- comment -%}
  Public Coming Soon page.
  Password protection belongs to the independent password template.
{%- endcomment -%}

{%- liquid
  assign coming_soon_heading = section.settings.heading | strip
  assign coming_soon_form_heading = section.settings.form_heading | strip
  if coming_soon_form_heading == blank
    assign coming_soon_form_heading = 'coming_soon.newsletter_label' | t
  endif
  assign heading_id = 'coming-soon-heading-' | append: section.id
  assign form_heading_id = 'coming-soon-form-heading-' | append: section.id
  assign form_description_id = 'coming-soon-form-description-' | append: section.id
  assign email_id = 'coming-soon-email-' | append: section.id
  assign email_error_id = 'coming-soon-email-error-' | append: section.id
-%}

{%- if coming_soon_heading != blank -%}
  <section class="coming-soon" aria-labelledby="{{ heading_id }}">
    {%- if section.settings.background_image != blank -%}
      <img
        class="coming-soon__bg"
        src="{{ section.settings.background_image | image_url: width: 1920 }}"
        alt=""
        width="1920"
        height="1080"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}

    <div class="coming-soon__logo-bar">
      {%- render 'logo', variant: section.settings.logo_variant, width: 280, class: 'coming-soon__logo', loading: 'eager' -%}
    </div>

    <div class="coming-soon__inner">
      <div class="coming-soon__left">
        <h1 class="coming-soon__heading" id="{{ heading_id }}">
          {{- coming_soon_heading -}}
        </h1>

        {%- if section.settings.subtitle != blank -%}
          <p class="coming-soon__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="coming-soon__body">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.instagram_url != blank or section.settings.email != blank -%}
          <nav class="coming-soon__social" aria-label="{{ 'coming_soon.social_label' | t }}">
            {%- if section.settings.instagram_url != blank -%}
              <a class="link" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">
                Instagram
              </a>
            {%- endif -%}
            {%- if section.settings.email != blank -%}
              <a class="link" href="mailto:{{ section.settings.email }}">
                {{- section.settings.email -}}
              </a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      </div>

      {%- if section.settings.show_newsletter -%}
        <div class="coming-soon__right">
          <h2 class="coming-soon__form-header" id="{{ form_heading_id }}">
            {{- coming_soon_form_heading -}}
          </h2>
          {%- if section.settings.form_subtext != blank -%}
            <p class="coming-soon__form-subtext" id="{{ form_description_id }}">
              {{- section.settings.form_subtext -}}
            </p>
          {%- endif -%}

          {% form 'customer', id: 'coming-soon-newsletter', class: 'coming-soon__form', aria-labelledby: form_heading_id %}
            <input type="hidden" name="contact[tags]" value="coming-soon,newsletter">

            {%- if form.posted_successfully? -%}
              <p class="input__message" role="status">
                {{- 'coming_soon.newsletter_success' | t -}}
              </p>
            {%- else -%}
              <div class="input{% if form.errors %} input--error{% endif %}">
                <label class="input__label input__label--required" for="{{ email_id }}">
                  {{- 'coming_soon.newsletter_label' | t -}}
                </label>
                <div class="input__control">
                  <input
                    class="input__field"
                    id="{{ email_id }}"
                    type="email"
                    name="contact[email]"
                    placeholder="{{ 'coming_soon.newsletter_placeholder' | t }}"
                    required
                    autocomplete="email"
                    {%- if section.settings.form_subtext != blank or form.errors %}
                      aria-describedby="{% if section.settings.form_subtext != blank %}{{ form_description_id }}{% endif %}{% if form.errors %}{% if section.settings.form_subtext != blank %} {% endif %}{{ email_error_id }}{% endif %}"
                    {%- endif %}
                    {%- if form.errors %} aria-invalid="true"{% endif %}
                  >
                </div>
                {%- if form.errors -%}
                  <p class="input__message" id="{{ email_error_id }}" role="alert">
                    {{- form.errors.messages['email'] -}}
                  </p>
                {%- endif -%}
              </div>
              <button type="submit" class="btn">
                {{- 'coming_soon.newsletter_submit' | t -}}
              </button>
            {%- endif -%}
          {% endform %}
        </div>
      {%- endif -%}
    </div>

    <footer class="coming-soon__footer">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
    </footer>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Coming Soon",
  "tag": "section",
  "class": "section-coming-soon",
  "settings": [
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "select",
      "id": "logo_variant",
      "label": "Logo variant",
      "info": "Logos are configured in Theme settings → Logo.",
      "options": [
        { "value": "short", "label": "Short" },
        { "value": "long", "label": "Long" },
        { "value": "wordmark", "label": "Wordmark" },
        { "value": "easter_egg", "label": "Easter egg" }
      ],
      "default": "long"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Decorative full-screen background. A contrast overlay is applied automatically."
    },
    {
      "type": "header",
      "content": "Content (left column)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Now Closed."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Spring Collection - Sold Out!"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Thank you for your support & visiting this page. The shop will remain closed while I focus on making new work.</p><p>Subscribers to my newsletter will receive a preview link a few days before the shop goes live, along with <strong>30 minutes of early access</strong>.</p>"
    },
    {
      "type": "header",
      "content": "Social & Contact"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact email",
      "info": "Shown as a visible email link."
    },
    {
      "type": "header",
      "content": "Newsletter (right column)"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Stay in the loop"
    },
    {
      "type": "text",
      "id": "form_subtext",
      "label": "Form subtext",
      "default": "Be the first to know about restocks, markets, and new work."
    }
  ],
  "presets": [
    {
      "name": "Coming Soon"
    }
  ]
}
{% endschema %}
