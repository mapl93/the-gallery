{
  "$description": "Public Input visual customization API, also composed by Textarea. Defaults remain aliases to shared primitives and semantic roles.",
  "component": {
    "input": {
      "padding": {
        "x": { "$type": "dimension", "$value": "{dimension.12}" },
        "y": { "$type": "dimension", "$value": "{dimension.10}" }
      },
      "labelGap": { "$type": "dimension", "$value": "{dimension.4}", "$description": "Space between the visible label and the field." },
      "messageGap": { "$type": "dimension", "$value": "{dimension.4}", "$description": "Space between the field and its supporting message." },
      "borderWidth": { "$type": "dimension", "$value": "{dimension.1}" },
      "focusRingWidth": { "$type": "dimension", "$value": "{dimension.4}" },
      "focusRingOffset": { "$type": "dimension", "$value": "{dimension.0}" },
      "labelFontWeight": { "$type": "fontWeight", "$value": "{font.weight.medium}" },
      "marginBottom": { "$type": "dimension", "$value": "{dimension.4}" },
      "iconSize": { "$type": "dimension", "$value": "{dimension.20}" },
      "iconGap": { "$type": "dimension", "$value": "{dimension.8}" }
    }
  }
}
