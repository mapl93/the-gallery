{
  "$schema": "./contract.schema.json",
  "contractVersion": "0.2.0",
  "slug": "avatar",
  "name": "Avatar",
  "registryId": "A15",
  "category": "primitives",
  "status": "pilot",
  "summary": "Circular avatar primitive with image or initials anatomy and small, default, large, and extra-large size modifiers.",
  "dependencies": [],
  "source": {
    "registry": "registry.json#/components/avatar",
    "css": {
      "file": "components/css/primitives.css",
      "selector": ".avatar"
    },
    "docs": "site/src/content/components/avatar.mdx"
  },
  "anatomy": [
    {
      "name": "root",
      "selector": ".avatar",
      "className": ".avatar",
      "required": true,
      "description": "Circular avatar container."
    },
    {
      "name": "image",
      "selector": ".avatar img",
      "required": false,
      "description": "Optional image inside the avatar."
    }
  ],
  "variants": [
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default avatar."
    }
  ],
  "sizes": [
    {
      "name": "sm",
      "className": ".avatar--sm",
      "default": false,
      "description": "Small avatar size."
    },
    {
      "name": "default",
      "className": null,
      "default": true,
      "description": "Default avatar size."
    },
    {
      "name": "lg",
      "className": ".avatar--lg",
      "default": false,
      "description": "Large avatar size."
    },
    {
      "name": "xl",
      "className": ".avatar--xl",
      "default": false,
      "description": "Extra-large avatar size."
    }
  ],
  "states": [
    {
      "name": "default",
      "selectors": [".avatar"],
      "description": "Default avatar state."
    },
    {
      "name": "withImage",
      "selectors": [".avatar img"],
      "description": "Avatar image is present."
    }
  ],
  "behavior": [
    {
      "name": "imageAlternative",
      "selectors": [".avatar img"],
      "attributes": ["alt"],
      "description": "Avatar images should include useful alt text or an empty alt when the adjacent text already names the person."
    },
    {
      "name": "initialsFallback",
      "selectors": [".avatar"],
      "attributes": ["aria-label", "title"],
      "description": "Initials-only avatars should expose the represented person or entity name when it is not already visible."
    }
  ],
  "properties": [
    {
      "name": "size",
      "type": "enum",
      "required": false,
      "valuesFrom": "sizes",
      "description": "Visual avatar diameter selected from the canonical size list; default is the classless contract size.",
      "targetMappings": {
        "web": [
          {
            "kind": "optionClass",
            "selector": ".avatar",
            "source": "sizes"
          }
        ]
      }
    }
  ],
  "tokens": {
    "public": {
      "color": [
        "--color-surface-secondary",
        "--color-text-secondary"
      ],
      "radius": [
        "--radius-full"
      ],
      "typography": [
        "--font-family-body"
      ]
    }
  },
  "accessibility": [
    "Give avatar images descriptive alt text when the avatar conveys identity.",
    "Use empty alt text when nearby visible text already identifies the person.",
    "Expose an accessible name for initials-only avatars when identity is not otherwise present.",
    "Do not use avatar color alone to communicate status."
  ],
  "adapters": {
    "web": {
      "status": "implemented",
      "kind": "css",
      "notes": "Implemented by class composition in components/css/primitives.css."
    },
    "shopify": {
      "status": "implemented",
      "kind": "liquid-css-class"
    },
    "react": {
      "status": "planned",
      "kind": "component"
    },
    "figma": {
      "status": "planned",
      "kind": "component"
    },
    "swiftui": {
      "status": "planned",
      "kind": "style"
    },
    "compose": {
      "status": "planned",
      "kind": "composable"
    }
  }
}
