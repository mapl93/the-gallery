{
  "$schema": "./studio.schema.json", "studioVersion": "0.3.0", "slug": "tag",
  "groups": [
    { "id": "content", "label": "Content", "controls": [
      {"id": "label", "label": "Label", "kind": "text", "properties": ["label"]},
      {"id": "remove-label", "label": "Remove label", "kind": "text", "properties": ["removeLabel"], "visibleWhen": {"property": "removeAction", "equals": true}}
    ] },
    { "id": "presentation", "label": "Presentation", "controls": [
      {"id": "state", "label": "State", "kind": "state", "properties": ["removalDisabled"], "source": "states", "visibleWhen": {"property": "removeAction", "equals": true}, "optionLabels": {"default": "Default", "removeHover": "Remove hover", "removeFocusVisible": "Remove focus", "removeDisabled": "Remove disabled"}}
    ] },
    { "id": "behavior", "label": "Behavior", "controls": [
      {"id": "remove-action", "label": "Remove action", "kind": "toggle", "properties": ["removeAction"]}
    ] },
    { "id": "layout", "label": "Layout", "controls": [
      {"id": "radius", "label": "Radius", "kind": "token", "tokens": {"category": "radius", "names": ["--radius-full"]}}
    ] },
    { "id": "appearance", "label": "Appearance", "controls": [
      {"id": "background", "label": "Background", "kind": "token-swatch", "tokens": {"category": "color", "names": ["--color-surface-secondary"]}},
      {"id": "text", "label": "Text", "kind": "token-swatch", "tokens": {"category": "color", "names": ["--color-text-secondary"]}},
      {"id": "border", "label": "Border", "kind": "token-swatch", "tokens": {"category": "color", "names": ["--color-border-subtle"]}},
      {"id": "focus", "label": "Focus", "kind": "token-swatch", "tokens": {"category": "color", "names": ["--color-border-focus"]}},
      {"id": "type-size", "label": "Type size", "kind": "token", "tokens": {"category": "typography", "names": ["--typo-body-sm-size"]}},
      {"id": "line-height", "label": "Line height", "kind": "token", "tokens": {"category": "typography", "names": ["--typo-body-sm-line-height"]}},
      {"id": "type-family", "label": "Type family", "kind": "token", "tokens": {"category": "typography", "names": ["--font-family-body"]}},
      {"id": "disabled-opacity", "label": "Disabled opacity", "kind": "token", "tokens": {"category": "opacity", "names": ["--opacity-disabled"]}}
    ] },
    { "id": "geometry", "label": "Geometry", "controls": [
      {"id": "public-space-tag-gap", "label": "Tag action gap", "kind": "token", "tokens": {"category": "spacing", "names": ["--space-tag-gap"]}},
      {"id": "public-space-tag-padding-x", "label": "Tag horizontal padding", "kind": "token", "tokens": {"category": "spacing", "names": ["--space-tag-padding-x"]}},
      {"id": "public-space-tag-padding-y", "label": "Tag vertical padding", "kind": "token", "tokens": {"category": "spacing", "names": ["--space-tag-padding-y"]}},
      {"id": "public-space-tag-remove-icon-size", "label": "Remove icon size", "kind": "token", "tokens": {"category": "spacing", "names": ["--space-tag-remove-icon-size"]}},
      {"id": "public-space-tag-remove-padding-end", "label": "Tag action end padding", "kind": "token", "tokens": {"category": "spacing", "names": ["--space-tag-remove-padding-end"]}},
      {"id": "public-space-tag-remove-size", "label": "Remove target size", "kind": "token", "tokens": {"category": "spacing", "names": ["--space-tag-remove-size"]}},
      {"id": "public-border-tag-border-width", "label": "Tag border width", "kind": "token", "tokens": {"category": "border", "names": ["--border-tag-border-width"]}},
      {"id": "public-border-tag-focus-offset", "label": "Remove focus offset", "kind": "token", "tokens": {"category": "border", "names": ["--border-tag-focus-offset"]}},
      {"id": "public-border-tag-focus-width", "label": "Remove focus width", "kind": "token", "tokens": {"category": "border", "names": ["--border-tag-focus-width"]}}
    ] },
    { "id": "type-effects", "label": "Typography and effects", "controls": [
      {"id": "public-typo-body-weight", "label": "Text weight", "kind": "token", "tokens": {"category": "typography", "names": ["--typo-body-weight"]}},
      {"id": "public-opacity-tag-remove-opacity", "label": "Remove resting opacity", "kind": "token", "tokens": {"category": "opacity", "names": ["--opacity-tag-remove-opacity"]}}
    ] }
  ]
}
