{%- comment -%}
  Section: Main Page
  Generic page content section (About, Contact, etc.)
{%- endcomment -%}

<section class="section">
  <div class="container" style="max-width: 800px;">
    <h1 style="margin-bottom: var(--space-layout-section-gap);">{{ page.title }}</h1>

    <div class="page-content">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "tag": "section",
  "class": "section-main-page",
  "settings": []
}
{% endschema %}
