<footer class="footer">
  <div class="footer__grid">
    {%- comment -%} Brand Column {%- endcomment -%}
    <div class="footer__brand">
      <h2 class="footer__heading" id="footer-brand-{{ section.id }}">{{ shop.name }}</h2>
      {%- if section.settings.footer_text != blank -%}
        <p class="footer__copy">
          {{ section.settings.footer_text }}
        </p>
      {%- endif -%}
    </div>

    {%- comment -%} Navigation Columns {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' -%}
          {%- assign group_heading = block.settings.heading | default: block.settings.menu.title -%}
          <nav class="footer__group" aria-labelledby="footer-group-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
            <h2 class="footer__heading" id="footer-group-{{ section.id }}-{{ block.id }}">{{ group_heading }}</h2>
            {%- if block.settings.menu != blank -%}
              <ul class="footer__links">
                {%- for link in block.settings.menu.links -%}
                  <li><a class="footer__link" href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </nav>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer__bottom">
    <p class="footer__meta">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}</p>
    {%- if section.settings.social_instagram != blank -%}
      <span class="footer__meta">
        <a class="footer__meta-link" href="{{ section.settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
          {% render 'icon', name: 'instagram' %}
        </a>
      </span>
    {%- endif -%}
    {%- if section.settings.social_pinterest != blank -%}
      <span class="footer__meta">
        <a class="footer__meta-link" href="{{ section.settings.social_pinterest }}" aria-label="Pinterest" target="_blank" rel="noopener">
          {% render 'icon', name: 'pinterest' %}
        </a>
      </span>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "footer_text",
      "label": "Brand description",
      "default": "Handcrafted art ceramics. Each piece tells a story of fire, earth, and intention."
    },
    { "type": "url", "id": "social_instagram", "label": "Instagram URL" },
    { "type": "url", "id": "social_pinterest", "label": "Pinterest URL" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "max_blocks": 3
}
{% endschema %}
